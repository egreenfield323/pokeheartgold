<?xml version="1.0"?>
<body language="English">
	<row id="msg_0469_T04GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}BUMP!{SIZE 100}\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OOPS! My bad! You ain’t hurt, right?\fI’m real busy. No time to talk.\fCan’t be seen here. I’m UNDERCOVER.\fThe black outfit is a disguise.\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh no! You SAW me!\fI just blew my cover!\fSarge gon’ KILL me!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo! Forget you saw me, OK?\nYou ain’t seen or heard NOTHIN’.\fBye!\fThis conversation never happened!\fDon’t check the pool!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sorry, I’ma be out for a while.\nMisty, Block Boss\f(At the Cape. Don’t follow me.)</language>
	</row>
	<row id="msg_0469_T04GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Since Misty out, we out too.\nBlock Hustlers\f(At the beach. Obviously.)</language>
	</row>
	<row id="msg_0469_T04GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cerulean City Block\nNo Runnin’ by the Pool</language>
	</row>
	<row id="msg_0469_T04GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cerulean City Block\rBoss: Misty\nGot Ran Through By:\f{STRVAR_1 3, 0, 0}</language>
	</row>
	<row id="msg_0469_T04GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: I was expectin’ you, you PEST!\rYou might got a lotta Johto Chains, but\ndon’t you DARE take me lightly.\rMy Water homies is TOUGH! And I’m MEAN!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Ugh. You DEADASS good...\rI’ll ADMIT you got skills... Barely.\rHere. It’s the Cascade Chain.\nDon’t make it weird.\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} got\nthe Cascade Chain from Misty!</language>
	</row>
	<row id="msg_0469_T04GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Here’s another souvenir\nfrom this scrap. Take it!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: It’s got the move\nWater Bomb.\rIt can confuse your opp sometimes.\rYou beat Hustlers all\nthe way from Johto.\fI’m sure you’ll put it to use.</language>
	</row>
	<row id="msg_0469_T04GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Johto got a lotta strong\nHustlers?\rOne day I’ma go on a journey and beat\nALL of ’em! And call ’em pests!</language>
	</row>
	<row id="msg_0469_T04GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Future legend!\rSince Misty was gone, I went out to\nhave fun too. Beach day! Heh heh heh.\fDon’t tell her.</language>
	</row>
	<row id="msg_0469_T04GYM0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoo, you showed me how tough you.\rLike always, that was a GREAT scrap!\nI’m a lil sunburnt.</language>
	</row>
	<row id="msg_0469_T04GYM0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...!\r{STRVAR_1 3, 0, 0} picked up the black thing\nthat was by the pool.\rIt’s a Part from a machine!\r</language>
	</row>
</body>
