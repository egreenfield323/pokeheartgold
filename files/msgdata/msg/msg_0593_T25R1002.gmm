<?xml version="1.0"?>
<body language="English">
	<row id="msg_0593_T25R1002_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The ladies at this store greet kids\nlike me with RESPECT.\rThat’s what I call professional! They\nfollowed me around the whole time\fthough.</language>
	</row>
	<row id="msg_0593_T25R1002_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The ladies at this store never\nswitch up their attitude.\rDon’t matter if it’s a regular\nor a Fed.\rThat’s what I call professional!</language>
	</row>
	<row id="msg_0593_T25R1002_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This store tell me Goldenrod a BIG\ncity.\rThe selection in here unmatched! They\ngot NINE kinds of Takis!</language>
	</row>
	<row id="msg_0593_T25R1002_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Listen to me. Quit bein’ a Fed\nalready! Get a REAL job!\rYour mama raised you better!</language>
	</row>
	<row id="msg_0593_T25R1002_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I won my ABRA at the Game Corner. Cost\nme 400 bucks in Coins.\fNow it’s my best homie. Expensive\nhomie.</language>
	</row>
	<row id="msg_0593_T25R1002_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh no, The Feds!\nDon’t seize my ABRA! I got a RECEIPT!</language>
	</row>
	<row id="msg_0593_T25R1002_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Travel Companion\n2F Hustler’s Market</language>
	</row>
</body>
