<?xml version="1.0"?>
<body language="English">
	<row id="msg_0131_D45R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\rI don’t know why you here, lil one.\rBut I’ma tell you once:\nthis ain’t no place for kids.\r</language>
	</row>
	<row id="msg_0131_D45R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got a certain look...\rIt remind me of the lil brat who\nran up on me three years ago...\fSame eyes... Same attitude...\r...\rI’m on my way to Goldenrod to\npick up the phone and get back to\fmy team. You finna get in my way?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\nThis the Radio Tower.\fThis the Radio Tower.\fWe proud to announce\fThe Feds’ comeback.\f...Giovanni?\f...Can you hear us? Wassup?\fWe finally did it!\f...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My boys need me...\rWe ain’t repeatin’ the L\nfrom three years ago!\r{COLOR 1}The Feds{COLOR 0} gon’ be reborn, and I\nwill run the WHOLE WORLD!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: How is this possible...?\rThe last three years was a\nwaste...?\rHow a CHILD keep endin’ my\nwhole career?!\rThe precious dream of The Feds\nain’t nothin’ but a dream now...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n...Ayo!\fWhere Giovanni go?\fIs he even listenin’ to\four broadcast...?\f...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: Remember what I’m sayin’.\rNot knowin’ how strong you\nprove you still just\fa child.\r</language>
	</row>
	<row id="msg_0131_D45R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Huh?\rThat’s the dude we saw arguin’\nwith that boy!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Huh?\rThat’s the dude we saw arguin’\nwith that boy!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Three years ago...?\nGoldenrod City...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Three years ago...?\nGoldenrod City...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is this who the radio\nwas tryna reach?\fGiovanni, their boss?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is this who the radio\nwas tryna reach?\fGiovanni, their boss?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You hear that, {STRVAR_1 3, 0, 0}?\nThe radio sayin’ somethin’ weird!\rThe Feds took over the Radio\nTower in Goldenrod City!\rIt can’t be! {STRVAR_1 3, 0, 0}, you already\nsolved this case!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You hear that, {STRVAR_1 3, 0, 0}?\nThe radio sayin’ somethin’ weird!\rThe Feds took over the Radio\nTower in Goldenrod City!\rIt can’t be! {STRVAR_1 3, 0, 0}, you already\nsolved this case!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: They keep callin’ their boss.\nI feel bad they don’t know he\fain’t comin’.\rAfter this, {STRVAR_1 3, 0, 0}, you gon’\nbeat ’em!\r...Wait a second!\r{STRVAR_1 3, 0, 0}, you still here.\nThen who gon’ beat The Feds...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: They keep callin’ their boss.\nI feel bad they don’t know he\fain’t comin’.\rAfter this, {STRVAR_1 3, 0, 0}, you gon’\nbeat ’em!\r...Wait a second!\r{STRVAR_1 3, 0, 0}, you still here.\nThen who gon’ beat The Feds...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not again...!\nI had ENOUGH!\fPlease lemme go back to my time!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not again...!\nI had ENOUGH!\fPlease lemme go back to my time!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CELEBI travelin’ through time!\nIt’s goin’ back to before\fthis weird adventure started...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This radio busted...</language>
	</row>
	<row id="msg_0131_D45R0102_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t turn the radio on.\nGiovanni musta left it here...</language>
	</row>
	<row id="msg_0131_D45R0102_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CELEBI...!\rWe need it to get better, or we\nain’t NEVER gettin’ back to our time!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CELEBI...!\rWe need it to get better, or we\nain’t NEVER gettin’ back to our time!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan used Narcan on CELEBI!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra used Narcan on CELEBI!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{COLOR 1}Time Travel{COLOR 0}......!\rThis it! Please take us to our time!\r</language>
	</row>
