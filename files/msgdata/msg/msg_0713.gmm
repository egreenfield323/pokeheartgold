<?xml version="1.0"?>
<body language="English">
	<row id="msg_0713_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Todd</language>
	</row>
	<row id="msg_0713_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We should both train our homies\nmore and scrap again!\rSo we should deadass swap\nnumbers. Don’t you agree? {YESNO 0}</language>
	</row>
	<row id="msg_0713_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK!\nSee you later!</language>
	</row>
	<row id="msg_0713_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you ain’t got the confidence that\nyou can beat me again?</language>
	</row>
	<row id="msg_0713_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm? You decide you want\nmy number after all? {YESNO 0}</language>
	</row>
	<row id="msg_0713_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Is it just me, or your voice\nreal loud?\fDon’t tell me...you right nearby?</language>
	</row>
	<row id="msg_0713_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} lookin’ more and\nmore like me. It’s gettin’ cuter!\rAnd, you know?\nNow we can KO {STRVAR_1 0, 11, 0} easy.\rI should hit the Goldenrod Block.\rLater!</language>
	</row>
	<row id="msg_0713_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} lookin’ more and\nmore like me. It’s gettin’ cuter!\rAnd, you know?\nWe JUST barely lost to {STRVAR_1 0, 11, 0}.\rI’m guessin’ my homies’ levels\nain’t high enough yet...\rLater!</language>
	</row>
	<row id="msg_0713_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You must be WAY better now, huh?\rHow ’bout showin’ me your technique\nin a real scrap with me?\rI’ll be waitin’ on {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0713_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where you at?\nLet’s have our scrap soon!\rI’ll be waitin’ on {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0713_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup!\rYou know, I was on the sixth floor of\nthe Goldenrod Dept. Store tryin’\fthe drawin’. It’s SO hype!</language>
	</row>
</body>
