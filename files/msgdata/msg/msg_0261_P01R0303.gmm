<?xml version="1.0"?>
<body language="English">
	<row id="msg_0261_P01R0303_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A comfy bed!\nTime to sleep...\r</language>
	</row>
	<row id="msg_0261_P01R0303_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, refreshed and restored!\r</language>
	</row>
	<row id="msg_0261_P01R0303_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\njust pulled up to Olivine City.</language>
	</row>
	<row id="msg_0261_P01R0303_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\njust pulled up to Vermilion City.</language>
	</row>
	<row id="msg_0261_P01R0303_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz... Zzz...\rWh-what?\nI’m WOKE, obviously...\rZzz... Zzz...</language>
	</row>
	<row id="msg_0261_P01R0303_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What? You sayin’ I was SLEEP? Show\nsome RESPECT!\rA crewman on duty would NEVER be\ncaught nappin’ in a passenger bed!\rI’m OFFENDED! I’m callin’ you OUT!\nAfter I finish this nap!\r</language>
	</row>
	<row id="msg_0261_P01R0303_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Losin’ to you woke me up. I’ma get\nmy act together. Tomorrow.\rKeep it a secret I was nappin’?\fDon’t tell the Captain. PLEASE.\fHe sleep too, but he the Captain.\r</language>
	</row>
</body>
