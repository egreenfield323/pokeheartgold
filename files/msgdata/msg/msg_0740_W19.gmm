<?xml version="1.0"?>
<body language="English">
	<row id="msg_0740_W19_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I moved the boulder that was in the\nway, but it’s gon’ take a while to\fflatten\fthe ground... I’m on break. Forever.</language>
	</row>
	<row id="msg_0740_W19_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The roadwork FINALLY done.\rNow I can go fishin’ again. Six\nmonths.</language>
	</row>
	<row id="msg_0740_W19_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My bad. This road closed for\nconstruction. City contract.\rIf you tryna get to Cinnabar, go\nsouth from Pallet Town. Or swim. Your\fchoice.</language>
	</row>
	<row id="msg_0740_W19_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m ALL sweaty.\nTime for a swim! Clothes on!</language>
	</row>
	<row id="msg_0740_W19_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rt. 19 Fuchsia City to\nSeafoam Islands</language>
	</row>
	<row id="msg_0740_W19_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What’s this notice?\rBe careful swimmin’ to Seafoam\nIslands. We ain’t got lifeguards.\fBudget.\fFuchsia Police</language>
	</row>
</body>
