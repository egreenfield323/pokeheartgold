<?xml version="1.0"?>
<body language="English">
	<row id="msg_0708_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Parry</language>
	</row>
	<row id="msg_0708_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh, the way you attacked! That was\nsomethin’ else! We should meet again!\rHow ’bout givin’ me your number?{YESNO 0}</language>
	</row>
	<row id="msg_0708_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll call when I feel like scrappin’!</language>
	</row>
	<row id="msg_0708_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No? That’s fine.\nA straight no is easy to take!\fI been divorced twice. I’m used to it.\rI’ll be right here for a rematch.</language>
	</row>
	<row id="msg_0708_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So you wanna save my number\nfor a rematch, huh?{YESNO 0}</language>
	</row>
	<row id="msg_0708_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, you special, aight.\rIf only I started trainin’ homies when I\nwas a lil younger... like 60 years ago.\rWin for both of us.\fSo, take this, OK?\r</language>
	</row>
	<row id="msg_0708_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-huh?\nIs that a river I hear in the\fbackground? You right nearby!</language>
	</row>
	<row id="msg_0708_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NOTHIN’ can match my {STRVAR_1 0, 10, 0} now.\rYeah, we KO’d a wild {STRVAR_1 0, 11, 0}!\rThat was cool, but what I wanted was\nto catch it...\rOK, gimme a call again!</language>
	</row>
	<row id="msg_0708_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NOTHIN’ can match my {STRVAR_1 0, 10, 0} now.\rYesterday we spotted a wild {STRVAR_1 0, 11, 0}.\rWe was debatin’ whether to catch it or\nscrap it for exp.\rThen another guy walked up and CAUGHT\nit! Right in front of us!\fThe disrespect. OK, call me again!</language>
	</row>
	<row id="msg_0708_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You thinkin’ you wanna scrap me.\nAm I right or what?\rYup! We’ll meet on {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0708_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ain’t made it to\n{STRVAR_1 4, 3, 0} yet?\rWaitin’ here ain’t no problem,\nbut I’d sure like to scrap!</language>
	</row>
	<row id="msg_0708_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gon’ scrap me again, right?</language>
	</row>
</body>
