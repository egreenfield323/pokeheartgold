		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0626_T29_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I only catch the same kinda homie. No\nmatter HOW long I fish! It’s a curse!</language>
	</row>
	<row id="msg_0626_T29_00022" index="22">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0626_T29_00023" index="23">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0626_T29_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When you spot a Hustler, it’s time to\nscrap! That’s the Hustler way!\fI’m a Hustler. You a Hustler. SCRAP!</language>
	</row>
	<row id="msg_0626_T29_00025" index="25">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0626_T29_00026" index="26">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0626_T29_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What happened to the red GYARADOS?!\rIt’s GONE?!\nI drove six hours for it!\rAight, I’m scrappin’ YOU then!</language>
	</row>
	<row id="msg_0626_T29_00028" index="28">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXX</language>
	</row>
	<row id="msg_0626_T29_00029" index="29">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0626_T29_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lake of Rage\nAlso Called GYARADOS Lake</language>
	</row>
	<row id="msg_0626_T29_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fishin’ Guru’s House</language>
	</row>
	<row id="msg_0626_T29_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fishing Guru’s House\rCurrent Record\n{STRVAR_1 52, 0, 0}.{STRVAR_1 50, 1, 0} in. {STRVAR_1 3, 2, 0}</language>
	</row>
	<row id="msg_0626_T29_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} found\n{STRVAR_1 8, 1, 0}!</language>
	</row>
	<row id="msg_0626_T29_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} put the {STRVAR_1 8, 1, 0}\nin the {COLOR 2}{STRVAR_1 31, 2, 0}{COLOR 0} Pocket.</language>
	</row>
	<row id="msg_0626_T29_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Got the {STRVAR_1 8, 0, 0}!\rToo bad!\nThe Bag full...</language>
	</row>
</body>
