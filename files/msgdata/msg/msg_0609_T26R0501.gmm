<?xml version="1.0"?>
<body language="English">
	<row id="msg_0609_T26R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bro picked the lock...\nYou got some nerve, kid.\rOn the way to Cianwood, there’s four\ndeserted islands.\rThey send bad kids out there as\npunishment! So BEHAVE!</language>
	</row>
	<row id="msg_0609_T26R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whenever I get in trouble, Daddy\nalways scare me with the islands.\rI been bad SO many times. I think he\nlyin’.</language>
	</row>
	<row id="msg_0609_T26R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My sister gave me MAD Seals!\fToo many! Here, have some!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SHEESH! You got so many Seals!\nCover your Nap Sacks! Bedazzle ’em!</language>
	</row>
	<row id="msg_0609_T26R0501_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got cameras, homie. Smile.\nNow what you want?\rI can give you better ones tomorrow!\nMy sister get ’em from a guy.</language>
	</row>
	<row id="msg_0609_T26R0501_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nYou ain’t got a Seal Case?\fI was gon’ give you some Seals...</language>
	</row>
	<row id="msg_0609_T26R0501_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There!\nI’ll give you this!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Have another!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Have more!\r</language>
	</row>
	<row id="msg_0609_T26R0501_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stick ’em on your Sack Patches!</language>
	</row>
	<row id="msg_0609_T26R0501_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Seal Case full!</language>
	</row>
	<row id="msg_0609_T26R0501_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The {STRVAR_1 10, 0, 0} went\nin the Seal Case.\r</language>
	</row>
</body>
