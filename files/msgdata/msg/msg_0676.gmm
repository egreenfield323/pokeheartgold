<?xml version="1.0"?>
<body language="English">
	<row id="msg_0676_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wilton</language>
	</row>
	<row id="msg_0676_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, that was a interestin’ scrap,\nwasn’t it?\rWhen I’m fishin’, sometimes I catch\nstuff people dropped.\fBoots. Phones. A whole bike once.\rIf it’s good, it’s yours.\nGimme your number? {YESNO 0}</language>
	</row>
	<row id="msg_0676_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I snag anythin’ good, I’ll hit you\nup. Prob’ly a boot.</language>
	</row>
	<row id="msg_0676_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight... Come back if you change your\nmind. The fish ain’t goin’ nowhere.</language>
	</row>
	<row id="msg_0676_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I snag a item while fishin’, it’s\nyours. Swap numbers? {YESNO 0}</language>
	</row>
	<row id="msg_0676_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! Here it is!\rC’mon!\nI caught a Nap Sack!\rIt’s covered in algae and seaweed.\nCan’t tell what kinda Nap Sack it is,\fbut bet you know!\fIt smells like a crime scene.\r</language>
	</row>
	<row id="msg_0676_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SHHH!!!\nThe POLIWHIRL gon’ dip!\rDon’t CALL me, come talk to me in\nperson so we can whisper!</language>
	</row>
	<row id="msg_0676_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} grew up nice!\nMy fishin’ skills got better too!\rWe beat a wild {STRVAR_1 0, 11, 0}...\nBut I’d rather fish than fight.\fFish don’t hit back. Usually.\rAight, later.</language>
	</row>
	<row id="msg_0676_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} grew up nice!\nMy fishin’ skills got better too!\rWe came THIS close to landin’ a\nwild {STRVAR_1 0, 11, 0}.\fIt was HUGE. Like, car-sized.\fNo cap. ...Some cap.\rAight, later.</language>
	</row>
	<row id="msg_0676_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m fishin’ on {STRVAR_1 4, 3, 0}, but nothin’\nbitin’ today.\rHelp me pass the time--come over\nfor a scrap. Bring sandwiches.</language>
	</row>
	<row id="msg_0676_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sigh... They ain’t bitin’ like before on\n{STRVAR_1 4, 3, 0}...\rYou gotta come scrap! I’m SO bored!</language>
	</row>
	<row id="msg_0676_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nah, I ain’t found nothin’ worth your\ntime. Just a boot.\fYou gotta be patient.</language>
	</row>
	<row id="msg_0676_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I snagged a item while fishin’!\nCome grab it on {STRVAR_1 4, 3, 0}! It’s not\fa boot this time! I checked!</language>
	</row>
	<row id="msg_0676_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You don’t want this item?\nHuh? You don’t know where?\r{STRVAR_1 4, 3, 0}...\nJust head from Mahogany toward\fBlackthorn! Follow the fish smell!</language>
	</row>
</body>
