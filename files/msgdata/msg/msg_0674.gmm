<?xml version="1.0"?>
<body language="English">
	<row id="msg_0674_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huey</language>
	</row>
	<row id="msg_0674_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DOPE! That’s the first time I lost in a\nminute!\rAyo, gimme your number.\rI’ll call you when I get stronger! {YESNO 0}</language>
	</row>
	<row id="msg_0674_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, let’s scrap again!\nANCHORS AWEIGH!</language>
	</row>
	<row id="msg_0674_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Look like you soft...\nLike a jellyfish.</language>
	</row>
	<row id="msg_0674_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, gimme your number.\rI’ll call you when I get stronger! {YESNO 0}</language>
	</row>
	<row id="msg_0674_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Man! You TOUGH as ever!\rI scrapped you over and over, but\n{STRVAR_1 3, 0, 0}, I ain’t won ONCE.\rI bought TONS of items to toughen up\nmy homies. Didn’t work.\rItems alone ain’t the answer.\nThat must be it...\rHere, take this, {STRVAR_1 3, 0, 0}.\nI ain’t gon’ need it no more...\fI’m becomin’ a fisherman.\r</language>
	</row>
	<row id="msg_0674_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh, when you call from inside the\nLighthouse, your voice ECHOES.\fIt’s hard! Say somethin’ deep!</language>
	</row>
	<row id="msg_0674_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How your homies doin’?\nMine a lil TOO energetic.\r{STRVAR_1 0, 10, 0}, especially.\rEvery time it see a Hustler, it\ncharge straight into a scrap!\fIt charged a mailman yesterday.\rLater!</language>
	</row>
	<row id="msg_0674_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} lookin’ tougher than ever.\rIt look tougher than ME!\nIt’s takin’ my parkin’ spot now.\rLater!</language>
	</row>
	<row id="msg_0674_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, I challenge you to a scrap!\nIt ain’t gon’ be like last time!\r{STRVAR_1 4, 3, 0} is where I’m waitin’.\nGet over here pronto!</language>
	</row>
	<row id="msg_0674_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you better not forgot about our\nscrap!\r{STRVAR_1 4, 3, 0}!\nHurry up! The tide’s comin’ in!</language>
	</row>
	<row id="msg_0674_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We gotta scrap again sometime.\nI’m finna keep challengin’ you till I\fwin. Or till I’m 90.</language>
	</row>
</body>
