<?xml version="1.0"?>
<body language="English">
	<row id="msg_0674_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huey</language>
	</row>
	<row id="msg_0674_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dope! That’s the first time I lost in\na minute!\rAyo, gimme your number.\rYou’d be fun to scrap, so I’ll call\nyou when I get stronger! {YESNO 0}</language>
	</row>
	<row id="msg_0674_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, let’s scrap again!</language>
	</row>
	<row id="msg_0674_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Look like you soft...</language>
	</row>
	<row id="msg_0674_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, gimme your number.\rYou’d be fun to scrap, so I’ll call\nyou when I get stronger! {YESNO 0}</language>
	</row>
	<row id="msg_0674_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Man! You tough as ever!\rI scrapped you over and over, but\n{STRVAR_1 3, 0, 0}, I ain’t won ONCE.\rI copped tons of items to toughen up\nmy homies, but it ain’t work...\rItems alone ain’t the answer.\nThat must be it...\rHere, take this, {STRVAR_1 3, 0, 0}.\nI ain’t gon’ need it no more...\r</language>
	</row>
	<row id="msg_0674_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh, when you call from inside the\nLighthouse, your voice kinda\fechoes. It’s hard!</language>
	</row>
	<row id="msg_0674_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How your homies doin’?\nMine a lil TOO energetic.\r{STRVAR_1 0, 10, 0}, especially.\rEvery time it see a Hustler, it just\ncharge straight into a scrap!\rIt’s a lot for me!\nLater!</language>
	</row>
	<row id="msg_0674_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} lookin’ tougher\nthan ever.\rIt look tougher than ME!\nLater!</language>
	</row>
	<row id="msg_0674_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, I challenge you to a scrap!\nIt ain’t gon’ be like last time!\r{STRVAR_1 4, 3, 0} is where I’m waitin’\nfor you. Get over here pronto!</language>
	</row>
	<row id="msg_0674_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you better not forgot\nabout our scrap!\r{STRVAR_1 4, 3, 0}!\nHurry up! I’m waitin’!</language>
	</row>
	<row id="msg_0674_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We gotta scrap again sometime.\nBet I’m finna keep\fchallengin’ you till I win.</language>
	</row>
</body>
