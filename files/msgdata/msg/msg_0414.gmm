<?xml version="1.0"?>
<body language="English">
	<row id="msg_0414_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Homie Talk</language>
	</row>
	<row id="msg_0414_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary and Oak</language>
	</row>
	<row id="msg_0414_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: We reachin’ out to all you\nhomie fans out there! Here go the\nleadin’ expert on homies, Professor\nOak, and of course me, Mary!</language>
	</row>
	<row id="msg_0414_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Homies! Homies!\nHomie Channel...</language>
	</row>
	<row id="msg_0414_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Professor Oak: {STRVAR_1 0, 1, 0} might be\nseen around {STRVAR_1 4, 0, 0}!</language>
	</row>
	<row id="msg_0414_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: {STRVAR_1 0, 1, 0},\n{STRVAR_1 28, 2, 0}\n{STRVAR_1 28, 3, 0}</language>
	</row>
	<row id="msg_0414_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When you first peep ’em</language>
	</row>
	<row id="msg_0414_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So many you’ll think you trippin’</language>
	</row>
	<row id="msg_0414_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">For no reason at all</language>
	</row>
	<row id="msg_0414_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Only when you pull up</language>
	</row>
	<row id="msg_0414_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whether you see ’em up top or down low,</language>
	</row>
	<row id="msg_0414_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If one roll with you as a homie</language>
	</row>
	<row id="msg_0414_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you just holla its name</language>
	</row>
	<row id="msg_0414_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you look at it sideways</language>
	</row>
	<row id="msg_0414_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’ll remind you of your old teacher</language>
	</row>
	<row id="msg_0414_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You won’t be able to resist</language>
	</row>
	<row id="msg_0414_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Anytime, any day</language>
	</row>
	<row id="msg_0414_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you poke it real light,</language>
	</row>
	<row id="msg_0414_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">More than you expected</language>
	</row>
	<row id="msg_0414_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you won’t be able to stop laughin’!</language>
	</row>
	<row id="msg_0414_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll feel mad chill.</language>
	</row>
	<row id="msg_0414_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll feel blessed fr.</language>
	</row>
	<row id="msg_0414_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you won’t be able to look away.</language>
	</row>
	<row id="msg_0414_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll be held hostage!</language>
	</row>
	<row id="msg_0414_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll make a real one!</language>
	</row>
	<row id="msg_0414_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">everybody gon’ respect you!</language>
	</row>
	<row id="msg_0414_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">it’ll never stop amazin’ you!</language>
	</row>
	<row id="msg_0414_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll be lowkey irresistible.</language>
	</row>
	<row id="msg_0414_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll think it’s SO fire...</language>
	</row>
	<row id="msg_0414_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll be so hard.</language>
	</row>
	<row id="msg_0414_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll feel kinda weird...</language>
	</row>
	<row id="msg_0414_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">you’ll think it’s a regular homie.</language>
	</row>
	<row id="msg_0414_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: This BREAKIN’ news!\nA bunch of {STRVAR_1 0, 1, 0} decided to\npull up at\n{STRVAR_1 4, 0, 0}! If you a Hustler\nwho REALLY been wantin’ {STRVAR_1 0, 1, 0},\nhurry over to {STRVAR_1 4, 0, 0}! That’s\nthe end of the breakin’ news!</language>
	</row>
</body>
