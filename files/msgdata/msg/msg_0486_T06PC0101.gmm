<?xml version="1.0"?>
<body language="English">
	<row id="msg_0486_T06PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a SLEEPIN’ homie in the middle\nof the road. Big one.\rPerfect chance to get it, but how you\nwake it up? Tried yellin’. Tried\fpokin’. Nothin’.</language>
	</row>
	<row id="msg_0486_T06PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There used to be a sleepin’ homie in\nthe middle of the road.\fIt’s gone now. Traffic movin’. Praise.</language>
	</row>
	<row id="msg_0486_T06PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship a great place to meet\nand scrap Hustlers. Like a cruise but\fviolent.</language>
	</row>
	<row id="msg_0486_T06PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? You got Chains I ain’t never seen.\rOh, I get it. Johto Chains. Foreign\ndrip.</language>
	</row>
</body>
