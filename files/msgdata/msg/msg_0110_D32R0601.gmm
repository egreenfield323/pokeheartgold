<?xml version="1.0"?>
<body language="English">
	<row id="msg_0110_D32R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Battle Arcade!\rI run the Single and\nDouble Battle challenges.\rHeads up, these challenges\nis for one Hustler. Solo dolo.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Which challenge you want\nto run?{YESNO 0}</language>
	</row>
	<row id="msg_0110_D32R0601_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">At the Battle Arcade, you can run a\nSingle or Double Battle challenge.\rHere, a game board spin\nbefore every scrap.\rDependin’ on what come up on the\nboard, somethin’ go down.\rSome events help the challenger,\nsome straight-up don’t.\rThe goal is to keep a win streak\nalive as long as you can.\rDuring your run, any items your\nhomies holdin’ get held by us.\rWin seven in a row, and you\nget Battle Points (BP).\rIf you wanna dip mid-run,\nsave the game first.\rIf you don’t save, you\ngettin’ disqualified. No cap.\rDon’t say I ain’t warn you!\r</language>
	</row>
	<row id="msg_0110_D32R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Battle Arcade!\rI run the Multi Battle\nchallenge.\rHeads up, this challenge\nneed two Hustlers.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You tryna run the Battle Arcade\nMulti Battle challenge?{YESNO 0}</language>
	</row>
	<row id="msg_0110_D32R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can team up with a homie for a\nMulti Battle challenge.\rHere, a game board spin\nbefore every scrap.\rDependin’ on what come up on the\nboard, somethin’ go down.\rThe events can swing the\nscrap big time, good or bad.\rThe goal is to keep a win streak\nalive as long as you can.\rDuring your run, any items your\nhomies holdin’ get held by us.\rWin seven in a row, and you\nget Battle Points (BP).\rHeads up: a Battle Arcade Multi\nBattle run can’t get paused.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back when you got the heart!</language>
	</row>
	<row id="msg_0110_D32R0601_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pick the homies you\nrollin’ in with.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo!\rYou ain’t got {STRVAR_1 50, 0, 0} homies\nthat qualify.\rYou need {STRVAR_1 50, 1, 0} different homies\nto get in.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Also, Eggs can’t get in. Obviously.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eggs and {STRVAR_1 0, 1, 0} are not allowed\nto enter.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eggs, {STRVAR_1 0, 1, 0}, and {STRVAR_1 0, 2, 0}\nare not allowed to enter.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eggs, {STRVAR_1 0, 1, 0}, {STRVAR_1 0, 2, 0},\nand {STRVAR_1 0, 3, 0} are not allowed\fto enter.\r</language>
	</row>
