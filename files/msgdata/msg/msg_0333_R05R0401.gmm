	<row id="msg_0333_R05R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">EEYAAAAH!\rI sense a EVIL shadow hoverin’ over\nyou! It’s BLACK! It’s ANGRY! It’s\fyour aura!\fTake this to keep it away!\r</language>
	</row>
	<row id="msg_0333_R05R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You was in MORTAL danger, but you\nprotected now. That’ll be $20.\fJK. Unless?</language>
	</row>
	<row id="msg_0333_R05R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My grandma into wardin’ off evil\nspirits.\rShe ward off the mailman. Every day.\nMy bad she scared you.</language>
	</row>
