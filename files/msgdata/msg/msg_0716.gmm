	<row id="msg_0716_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, is this {STRVAR_1 3, 0, 0}?\rJust one more Chain before you\ncollect ALL the Johto Chains!\rBlackthorn’s Block Boss supposed to be\na real powerful Drama Queen!</language>
	</row>
	<row id="msg_0716_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, is this {STRVAR_1 3, 0, 0}?\rJust one more Chain before you\ncollect ALL the Johto Chains!\rBlackthorn’s Block Boss supposed to be\na real powerful Drama Queen!</language>
	</row>
	<row id="msg_0716_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\nYou seem to be doin’ good.\rYou doin’ SO good, I ain’t got nothin’\nto worry about.\rI think you could do anythin’ you try!</language>
	</row>
	<row id="msg_0716_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\nYou seem to be doin’ good.\rYou doin’ SO good, I ain’t got nothin’\nto worry about.\rI think you could do anythin’ you try!</language>
	</row>
	<row id="msg_0716_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\rI got somethin’ here for you from\nProfessor Oak.\rCould you swing by my Lab?\nLater!</language>
	</row>
