	<row id="msg_0716_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\rWe checkin’ the Egg now. It do\nlook like a homie Egg.\rWe gon’ run a few more tests!</language>
	</row>
	<row id="msg_0716_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\rWe checkin’ the Egg now. It do\nlook like a homie Egg.\rWe gon’ run a few more tests!</language>
