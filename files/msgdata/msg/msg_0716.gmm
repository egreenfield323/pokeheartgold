	<row id="msg_0716_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\rThere’s somethin’ weird on\nthe radio.\rIs somethin’ goin’ down in Goldenrod?</language>
	</row>
	<row id="msg_0716_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\rThere’s somethin’ weird on\nthe radio.\rIs somethin’ goin’ down in Goldenrod?</language>
