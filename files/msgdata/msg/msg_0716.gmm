	<row id="msg_0716_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, {STRVAR_1 3, 0, 0}?\rYou see my assistant? He at the\nCorner Store in Violet City.\rHe got somethin’ REAL important, so\nmake sure you grab it!</language>
	</row>
	<row id="msg_0716_00010" index="10">
		<attribute name="window_context_name">used</attribute>
