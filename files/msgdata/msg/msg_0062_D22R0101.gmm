	<row id="msg_0062_D22R0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Relaxation Square for Everybody\nNational Park. No Drama.</language>
	</row>
	<row id="msg_0062_D22R0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What’s this notice?\rOnly scrap in the park grass.\r           National Park\n           Warden’s Office</language>
	</row>
	<row id="msg_0062_D22R0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What’s this notice?\rNo ball playin’ allowed\nexcept Nap Sacks.\r           National Park\n           Warden’s Office</language>
