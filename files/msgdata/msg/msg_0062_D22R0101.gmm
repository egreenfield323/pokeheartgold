	<row id="msg_0062_D22R0101_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: Ayo, {STRVAR_1 3, 0, 0}! Bug-Catching\nContest tomorrow!\rI won it so many times they BEGGED me\nto stop enterin’.\rBut you should go. You might win! Not\nlike ME, but win.</language>
	</row>
	<row id="msg_0062_D22R0101_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: Ayo, {STRVAR_1 3, 0, 0}! Bug-Catching\nContest tomorrow!\rI won it so many times they BEGGED me\nto stop enterin’.\rBut you should go. You might win!\rBy the way, take a pic with me? For my\nfans. I got four. {YESNO 0}</language>
	</row>
	<row id="msg_0062_D22R0101_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: Aight! Say “BUGS!”\nDon’t say “cheese,” cheese is for mice.\r</language>
	</row>
	<row id="msg_0062_D22R0101_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: Yay! This a good one!</language>
	</row>
	<row id="msg_0062_D22R0101_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: Oh, I see...\nThat’s fine. I ain’t sad. I’m FINE.\fI’m just gon’ go stare at some ants.</language>
	</row>
	<row id="msg_0062_D22R0101_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete\nsome pics.</language>
	</row>
</body>
