<?xml version="1.0"?>
<body language="English">
	<row id="msg_0062_D22R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Only ONE homie can Stroll in a\nPokéwalker?!\rThat’s favoritism! They ALL my babies!\nThis how custody battles start!</language>
	</row>
	<row id="msg_0062_D22R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got eleven Pokéwalkers on me right\nnow.\rI beep when I walk. People think I’m a\ntruck backin’ up.</language>
	</row>
	<row id="msg_0062_D22R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eyes up here, please! EYES UP HERE!\r...Oops, my bad. Thirty years of\nteachin’ middle school. It don’t turn\foff.\rYou a Hustler? You workin’ hard? You\nget a gold star. And this.\r</language>
	</row>
	<row id="msg_0062_D22R0101_00003" index="3">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0062_D22R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let a homie hold that Quick Claw.\rSometimes it swing first. Like my\nuncle at Thanksgiving.</language>
	</row>
	<row id="msg_0062_D22R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walkin’ your homie outside the sack is\ncute, but the Pokéwalker?\fThat’s a whole lifestyle. I’m in a\ncult.</language>
	</row>
	<row id="msg_0062_D22R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My mama said NO homies in the house.\rSo I keep mine in my Pokéwalker.\nShe don’t know. It’s in my sock.</language>
	</row>
	<row id="msg_0062_D22R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I walk in the park, but I NEVER go\nin the grass.\rThe grass got Hustlers in it.\nThey JUMP you. For fun.</language>
	</row>
	<row id="msg_0062_D22R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PERSIAN: Fufushaa!</language>
	</row>
	<row id="msg_0062_D22R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huff...puff...huff...\rI been runnin’ laps for six hours\nto charge my Pokéwalker.\fI don’t even like my homie that much.</language>
	</row>
