<body language="English">
	<row id="msg_0263_P01R0307_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, youngblood. Find my partner.\rHe chillin’ somewhere, that no-good\nlazy BUM! He owe me a shift!\rI’m on guard duty and can’t move.\nIf I move, I’m fired.\r</language>
	</row>
	<row id="msg_0263_P01R0307_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, youngblood. Find my partner.\rHe chillin’ somewhere, that no-good\nlazy BUM! He owe me a shift!\fI’m on guard duty and can’t move.\fIf I move, I’m fired.</language>
	</row>
	<row id="msg_0263_P01R0307_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks, youngblood! I yelled at\nhim SO good. He cried.\fHe back to work now. Cryin’, but\nworkin’.</language>
	</row>
