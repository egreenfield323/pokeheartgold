<?xml version="1.0"?>
<body language="English">
	<row id="msg_0396_R39_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rt. 39\nSouth to Olivine City</language>
	</row>
	<row id="msg_0396_R39_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moomoo Farm\nFresh Chocolate Milk. From the Cow.</language>
	</row>
	<row id="msg_0396_R39_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hustler Tips\rUse Dome Check on trees to shake\nhomies out.\rDifferent homies fall out\nof different trees.\rDome Check every tree you see!</language>
	</row>
	<row id="msg_0396_R39_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MILTANK: MOOO! (Get off my farm.)</language>
	</row>
	<row id="msg_0396_R39_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Baoba: ...OHH! What you holdin’ is...\nwhat they call...a POKÉDEX!\fAin’t seen one since the ’90s!\rMy name is Baoba! Talk backwards, I\ndo. A condition it is.\rRan a Safari Zone in Fuchsia I did, but\nold it got. Like me.\rSo overseas I went, to learn the\nnewest tech, and a BRAND NEW Safari\fZone\fopen in Cianwood I will!\rNo coincidence this is.\rNumbers we swap, yes?\rCall you first I will when it open!\nBefore my own kids even!\r</language>
	</row>
	<row id="msg_0396_R39_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wanna save my number? {YESNO 0}</language>
	</row>
	<row id="msg_0396_R39_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s what I’m talkin’ about!\nPleased, I’m!\r</language>
	</row>
	<row id="msg_0396_R39_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh, expect a no I did not.\nRare homies there, there will be.\rBig for your Pokédex it would be.\nRegret this you will...\r</language>
	</row>
	<row id="msg_0396_R39_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Baoba’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0396_R39_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Baoba: Call you on the Pokégear I\nwill, when ready it is!\r</language>
	</row>
	<row id="msg_0396_R39_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: AYO, PRIVATE!\rYou want a memory of us together?\nA pic with the LIEUTENANT?\fIt’s an order. Kinda. {YESNO 0}</language>
	</row>
	<row id="msg_0396_R39_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: OK! OK!\rGimme a big smile, soldier!\nSAY “HOO-AH!”\r</language>
	</row>
	<row id="msg_0396_R39_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: SHEESH! That came out REAL\ngood! Framin’ it for the barracks!\rWe ride for Route 39!</language>
	</row>
	<row id="msg_0396_R39_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: That’s OK, private...\rLemme know if you change your mind.\nI’ll be here. Salutin’.</language>
	</row>
	<row id="msg_0396_R39_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete some\npics before you come back.</language>
	</row>
</body>
