	<row id="msg_0374_R29R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ledges is one-way, like my ex.\rYou can jump DOWN ’em, but you\nain’t never climbin’ back up.</language>
	</row>
	<row id="msg_0374_R29R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Different homies posted up\npast here.\rI’m a gatekeeper. Not a real job.\nI just stand here. Unpaid.</language>
	</row>
