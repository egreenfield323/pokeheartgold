<?xml version="1.0"?>
<body language="English">
	<row id="msg_0091_D26R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: THAT’S how you do it, {STRVAR_1 3, 0, 0}!\rThe Feds done ran off like roaches.\rMy back feel better too.\nLet’s get outta here.\r</language>
	</row>
	<row id="msg_0091_D26R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proton: Well, well, well...\nLook what crawled in the well.\rThey call me the coldest,\nmeanest Fed on the WHOLE payroll...\rI’m finna tell you ONE time, lil bro:\nmind your business!\r</language>
	</row>
	<row id="msg_0091_D26R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proton: Tch... Okay, real talk.\nThe Feds DID get shut down\fthree years back. Budget cuts.\rBut we been movin’ in the cut\nsince then. Off the books.\rA lil speed bump like you\nain’t stoppin’ NOTHIN’.\rWatch your back, bruh!\nWe got your address!\r</language>
	</row>
	<row id="msg_0091_D26R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A SLOWPOKE with no tail...\rHuh? It got Mail. Read it? {YESNO 0}</language>
	</row>
	<row id="msg_0091_D26R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} read the Mail.\rBe good and hold down the house\nwith Grandpa and SLOWPOKE.\f           Love, Dad</language>
	</row>
	<row id="msg_0091_D26R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A SLOWPOKE with no tail...\nThat’s foul.</language>
	</row>
</body>
