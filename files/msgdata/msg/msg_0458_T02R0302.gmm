<?xml version="1.0"?>
<body language="English">
	<row id="msg_0458_T02R0302_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, welcome to the Training Hall.\rYou can scrap our best Hustlers and\ntheir favorite homies once\fa day.\rWanna join? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0458_T02R0302_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ready!\nGo right through.\r</language>
	</row>
	<row id="msg_0458_T02R0302_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see...\nCome back now.\r</language>
	</row>
	<row id="msg_0458_T02R0302_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna leave? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for playin’!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see.\nGood luck!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, ayo!\nRight this way!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the Hustler House--\nthe spot for Hustlers.\rThe Pokéwalker bring your\nhomies here!\rYou can challenge Hustlers\nonce a day.\rYou earn Battle Points when you win.\fBring your best!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Lemme borrow your Vs. Recorder\nfor a sec.\rLet’s see... Slide this part open\nhere, and ticka-tacka-kachunk there!\rAll done!\rNow you can check your Battle Points\non your Vs. Recorder!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}’s Vs. Recorder got\nupgraded.</language>
	</row>
	<row id="msg_0458_T02R0302_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can trade your Battle Points\nfor hard prizes at the Johto\fBattle Frontier!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Now that you ready,\nyou wanna train? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna scrap? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See you tomorrow!</language>
	</row>
</body>
