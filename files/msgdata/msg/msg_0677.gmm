<?xml version="1.0"?>
<body language="English">
	<row id="msg_0677_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jamie</language>
	</row>
	<row id="msg_0677_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You real good at scrappin’.\nWe should scrap again sometime.\rTakin’ on a tough Hustler like you,\nI’ll get better too.\rSo wassup?\nYou gon’ gimme your number? {YESNO 0}</language>
	</row>
	<row id="msg_0677_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s scrap again sometime!\nI’ll get there FAST.</language>
	</row>
	<row id="msg_0677_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s too bad...\nLmk if you change your mind.\fQuickly. I don’t wait.</language>
	</row>
	<row id="msg_0677_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Takin’ on a tough Hustler like you,\nI think I can get better too.\rSo wassup? You gon’ gimme\nyour number? {YESNO 0}</language>
	</row>
	<row id="msg_0677_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0677_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? You... Ain’t you right nearby?\rWhy not come here and just talk\nface-to-face? I’ll race you over!</language>
	</row>
	<row id="msg_0677_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You remember my sweet {STRVAR_1 0, 10, 0}?\r{STRVAR_1 0, 10, 0} run SO fast.\rIt’s a RUSH ridin’ on its back\nwhen it get goin’.\fI got a speedin’ ticket. On a homie.\rBye-bye!</language>
	</row>
	<row id="msg_0677_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ever seen a {STRVAR_1 0, 11, 0}?\rI just scrapped one...\nIt was WAY faster than I expected.\rI was kinda shook.\nI still won, obviously. I’m faster.\rBye-bye!</language>
	</row>
	<row id="msg_0677_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I just saw a wild {STRVAR_1 0, 11, 0}.\nI went to catch it and I was all outta\fNap Sacks.\rCheck your items or you’ll run out at\nthe worst time. Learn from me.\fI threw my shoe at it instead.\rBye-bye!</language>
	</row>
	<row id="msg_0677_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna scrap? I’m finna win this\ntime!\rI’ll be waitin’ around {STRVAR_1 4, 3, 0}.\nLook for me! I’ll be a blur!</language>
	</row>
	<row id="msg_0677_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um... {STRVAR_1 3, 0, 0}? What’s wrong?\nYou forget our deal?\r{STRVAR_1 4, 3, 0}.\nThat’s where I’m waitin’. Impatiently.</language>
	</row>
	<row id="msg_0677_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um... {STRVAR_1 3, 0, 0}? What’s wrong?\nYou forget our deal?\r{STRVAR_1 4, 3, 0}.\nThat’s where I’m waitin’. Impatiently.</language>
	</row>
	<row id="msg_0677_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s scrap again sometime!\nSoon! Like, NOW soon!</language>
	</row>
</body>
