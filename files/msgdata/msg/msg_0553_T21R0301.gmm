<?xml version="1.0"?>
<body language="English">
	<row id="msg_0553_T21R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Another one?! Third break-in\nthis week. I’m moving.\rYou’re trying to see how good you\nare as a Pokémon Hustler?\rYou better visit the blocks\nall over Johto and collect Chains.</language>
	</row>
	<row id="msg_0553_T21R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-uh. Not in MY house.\nState your business. Quick.\rWhen I get older, I’m finna be a\nBlock Boss!\rI make my Pokémon battle with my\nfriends’ to make them tougher!</language>
	</row>
</body>
