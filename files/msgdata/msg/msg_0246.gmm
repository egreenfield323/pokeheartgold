<?xml version="1.0"?>
<body language="English">
	<row id="msg_0246_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DING-DING! Time’s UP!\nThe Bug-Catching Contest is OVER!\fPut the nets down!\r</language>
	</row>
	<row id="msg_0246_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DING-DING! You outta Sport Sacks!\nThe Bug-Catching Contest over for YOU!\r</language>
	</row>
	<row id="msg_0246_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0246_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You still have {STRVAR_1 51, 0, 0} minute(s) left.\nDo you wanna finish now?{YESNO 0}</language>
	</row>
	<row id="msg_0246_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Tuesday.\rThat mean the Bug-Catching Contest is\nON!\rRules is simple.\rUse one homie to catch a Bug-type\nhomie. Judges rate it.\rBiggest, baddest bug wins. You wanna\ntry? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Thursday.\rThat mean the Bug-Catching Contest is\nON!\rRules is simple.\rUse one homie to catch a Bug-type\nhomie. Judges rate it.\rBiggest, baddest bug wins. You wanna\ntry? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Saturday.\rThat mean the Bug-Catching Contest is\nON!\rRules is simple.\rUse one homie to catch a Bug-type\nhomie. Judges rate it.\rBiggest, baddest bug wins. You wanna\ntry? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Bug-Catching Contest happen\nTuesday, Thursday, and Saturday.\rYou get a prize just for showin’ up, AND\nyou keep the last bug you catch.\fIt’s basically free bugs.</language>
	</row>
	<row id="msg_0246_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXX</language>
	</row>
	<row id="msg_0246_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXX</language>
	</row>
	<row id="msg_0246_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-oh... You got more than one homie.\rYou gotta use {STRVAR_1 1, 0, 0}, the first homie\nin your crew.\rThat cool with you? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00011" index="11">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXX</language>
	</row>
	<row id="msg_0246_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXX</language>
	</row>
	<row id="msg_0246_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fine, we’ll hold your other homies while\nyou compete. They safe with us. Mostly.\r{STRVAR_1 3, 0, 0}’s homies got left with the\nContest Helper.\r</language>
	</row>
	<row id="msg_0246_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here go the Sport Sacks for the\nContest.\r{STRVAR_1 3, 0, 0} got 20 Sport Sacks. Don’t\nthrow ’em at people.\r</language>
	</row>
	<row id="msg_0246_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whoever get the STRONGEST bug wins.\rYou got 20 minutes.\rRun outta Sport Sacks, you done.\rYou keep the last homie you catch.\nGo out there and catch the BADDEST\fBug-type homie you can find!\r</language>
	</row>
	<row id="msg_0246_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh no!\rMy bad, you ain’t got room to catch no\nmore homies. Your PC is FULL. Sheesh.</language>
	</row>
	<row id="msg_0246_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Hope you join next time.\nThe bugs’ll be here.</language>
	</row>
	<row id="msg_0246_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today’s Bug-Catching Contest is OVER.\rCome back next time! Bring a bigger net.</language>
	</row>
	<row id="msg_0246_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Some homies only show up in the Park.\nThey shy.</language>
	</row>
	<row id="msg_0246_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\rHere’s the prize we were holdin’\nfor you.\r</language>
	</row>
	<row id="msg_0246_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-oh...\nYour Bag is full, {STRVAR_1 3, 0, 0}.\rWe’ll hold on to your prize.\nPlease make room, then come see me.</language>
	</row>
	<row id="msg_0246_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We hope you’ll take part in a\nBug-Catching Contest in the future!</language>
	</row>
	<row id="msg_0246_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You still have {STRVAR_1 51, 0, 0} minute(s) left.\nDo you wanna finish now? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00024" index="24">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXX</language>
	</row>
	<row id="msg_0246_00025" index="25">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXX</language>
	</row>
	<row id="msg_0246_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Please go back outside and\nfinish up.\r</language>
	</row>
	<row id="msg_0246_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Wait in the National Park for the\nwinners announcement. No cheatin’.\r</language>
	</row>
	<row id="msg_0246_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Please reorder your Pokémon,\nthen come see me.</language>
	</row>
	<row id="msg_0246_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We will now judge your bugs!\r......\n......\rWe got the winners!\nYou READY for this?!\r</language>
	</row>
	<row id="msg_0246_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Placing third is {STRVAR_1 3, 0, 0}, who\ncaught a writhin’ {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Placing third is the {STRVAR_1 14, 2, 0}\n{STRVAR_1 3, 0, 0}, who caught a writhin’\f{STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The score was {STRVAR_1 52, 3, 0} points!\r</language>
	</row>
	<row id="msg_0246_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Placing second is {STRVAR_1 3, 0, 0}, who\ncaught a wrigglin’ {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Placing second is the {STRVAR_1 14, 2, 0}\n{STRVAR_1 3, 0, 0}, who caught a\fwrigglin’ {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Bug-Catching Contest winner is...\r{STRVAR_1 3, 0, 0}, who caught a whoppin’\n{STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Bug-Catching Contest winner is...\rThe {STRVAR_1 14, 2, 0} {STRVAR_1 3, 0, 0}, who\ncaught a whoppin’ {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, the First Place\nfinisher, wins the {STRVAR_1 8, 3, 0}!\r</language>
	</row>
	<row id="msg_0246_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, the Second Place\nfinisher, wins the {STRVAR_1 8, 3, 0}!\r</language>
	</row>
	<row id="msg_0246_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, the Third Place\nfinisher, wins the {STRVAR_1 8, 3, 0}!\r</language>
	</row>
	<row id="msg_0246_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everybody else get a {STRVAR_1 8, 3, 0} as a\nconsolation prize! Participation\ftrophy!\r</language>
	</row>
	<row id="msg_0246_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-oh...\nYour Bag is full, {STRVAR_1 3, 0, 0}.\rWe’ll hold on to your prize.\nPlease make room, then come see me.\r</language>
	</row>
	<row id="msg_0246_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We hope you’ll take part in a\nBug-Catching Contest in the future!\r</language>
	</row>
	<row id="msg_0246_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Give the {STRVAR_1 0, 1, 0} you caught\na street name? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\rHere’s the prize we were holdin’\nfor you.\r</language>
	</row>
	<row id="msg_0246_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-oh...\nYour Bag is full, {STRVAR_1 3, 0, 0}.\rWe’ll hold on to your prize.\nPlease make room, then come see me.\r</language>
	</row>
	<row id="msg_0246_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your party’s full, so {STRVAR_1 1, 5, 0} was\nsent to your Box in Bill’s PC.\r</language>
	</row>
	<row id="msg_0246_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We’ll return the Pokémon we kept for\nyou. Here you go!\r</language>
	</row>
	<row id="msg_0246_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: Got it? I’m finna WIN!\nGet out my aura!</language>
	</row>
	<row id="msg_0246_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: Luck play a BIG part in this.\rYou never know if homies gon’ show up.\nI prayed this mornin’.</language>
	</row>
	<row id="msg_0246_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: You WON?! YOU?!\rI’m SO jealous... I’m gon’ go cry in the\nbushes.</language>
	</row>
	<row id="msg_0246_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ed: My PARASECT put homies to sleep\nwith Knockout Gas. It’s legal. Barely.</language>
	</row>
	<row id="msg_0246_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ed: You can’t win with homies that’s\nbeat up. Heal up, bro.</language>
	</row>
	<row id="msg_0246_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ed: I’m jealous. I couldn’t do it this\ntime. Or any time.</language>
	</row>
	<row id="msg_0246_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abby: I been trainin’ homies that cause\nstatus problems. For the Contest.\fAnd for my ex.</language>
	</row>
	<row id="msg_0246_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abby: I heard colorful homies win\neasier.\rSo I painted mine. Is that cheatin’?</language>
	</row>
	<row id="msg_0246_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abby: WONDERFUL! You sparkle and gleam\nright now. You DEADASS do!</language>
	</row>
	<row id="msg_0246_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">William: Winnin’? Nah, I’m here for RARE\nhomies. And the free juice.</language>
	</row>
	<row id="msg_0246_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">William: Well, I’m satisfied. I caught\nthe homie I wanted. Namaste.</language>
	</row>
	<row id="msg_0246_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">William: YOU won? What you catch?\nShow me, show me! SHOW ME!</language>
	</row>
	<row id="msg_0246_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Benny: ...... ...... ......\n...... ...... SSSSH!\rYou gon’ scare off SCYTHER.\nTalk to me later. Whisper.</language>
	</row>
	<row id="msg_0246_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Benny: Listen, I caught a SCYTHER once,\nand I STILL ain’t win. The judges is\fcrooked.</language>
	</row>
	<row id="msg_0246_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Benny: I just came to see how things\nwas goin’, you know?\rI’ll REALLY try next time. Maybe.</language>
	</row>
	<row id="msg_0246_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Barry: Rough the bug up first, then\nthrow the Nap Sack. That’s just\fmanners.</language>
	</row>
	<row id="msg_0246_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Barry: High-level bugs help. But they\njudge other stuff too. Vibes, prob’ly.</language>
	</row>
	<row id="msg_0246_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Barry: That homie you caught...\nIt’s AWESOME! Can I touch it?</language>
	</row>
	<row id="msg_0246_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cindy: I REALLY love Bug-type homies!</language>
	</row>
	<row id="msg_0246_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cindy: I REALLY love Bug-type homies!\rDid I already say that? I’ll say it\nagain.</language>
	</row>
	<row id="msg_0246_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cindy: Congrats on winnin’!\nBy the way...\rDid I mention I REALLY love Bug-type\nhomies? ’cause I do.</language>
	</row>
	<row id="msg_0246_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Josh: I been collectin’ bugs since I was\na baby.\rAin’t NO way I’m losin’! It’s my\ndestiny!</language>
	</row>
	<row id="msg_0246_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Josh: I heard somebody WON with a\nCATERPIE! A CATERPIE! The disrespect!</language>
	</row>
	<row id="msg_0246_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Josh: It’s a Bug-Catching Contest, not\na Bird-Catching Contest!\rYou should know that. After all, you\nwon! Smh.</language>
	</row>
	<row id="msg_0246_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samuel: What?\nIf you got time to chat, you got time to\ffind bugs! MOVE!</language>
	</row>
	<row id="msg_0246_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samuel: So... I thought I’d score\nhigher... I fed it protein and\feverythin’...</language>
	</row>
	<row id="msg_0246_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samuel: It’s SO disappointin’...\nI won’t forget this. Ever. I’m petty.</language>
	</row>
	<row id="msg_0246_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kipp: I studied bugs at a REAL college.\nI’m finna win for sure. I got loans.</language>
	</row>
	<row id="msg_0246_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kipp: I study a LOT, but it ain’t\nenough. Education is a scam.</language>
	</row>
	<row id="msg_0246_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kipp: Could you gimme tips? PLEASE?\nI’ll pay you in bugs.</language>
	</row>
