<?xml version="1.0"?>
<body language="English">
	<row id="msg_0059_D17R1101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: The legendary homie ain’t\npick me...\rBut that don’t mean I lost\nmy future.\rI’ma keep trainin’ till I\nfind a new path.\rSay, you wanna be part of my\ntrainin’? {YESNO 0}</language>
	</row>
	<row id="msg_0059_D17R1101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Morty’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0059_D17R1101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: Hit me up Tuesday night if\nyou want a scrap!</language>
	</row>
	<row id="msg_0059_D17R1101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: Oh...\nThat’s a shame...</language>
	</row>
	<row id="msg_0059_D17R1101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: So, you gon’ be part of my\ntrainin’? {YESNO 0}</language>
	</row>
	<row id="msg_0059_D17R1101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: Ayo, it’s you!\rHow ’bout a pic\nwith me to remember this? {YESNO 0}</language>
	</row>
	<row id="msg_0059_D17R1101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: Aight!\nCome stand next to me.\r</language>
	</row>
	<row id="msg_0059_D17R1101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: Mmmm...\nThis a pretty good pic! Spooky.</language>
	</row>
	<row id="msg_0059_D17R1101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Morty: I get it...\nyou must be busy.</language>
	</row>
	<row id="msg_0059_D17R1101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete\nsome pics.</language>
	</row>
</body>
