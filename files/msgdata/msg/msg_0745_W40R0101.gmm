<?xml version="1.0"?>
<body language="English">
	<row id="msg_0745_W40R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHAT? I’m FIRST in line!\rThere’s gon’ be a Battle Frontier\npast here.\rI been camped out for weeks. Like a\nsneaker drop. Ain’t slept. Ain’t\fshowered.\rGet in line if you wanna be second! And\nstand downwind!\r</language>
	</row>
	<row id="msg_0745_W40R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz...\n...\rHe standin’...but he SLEEP!\nThat’s dedication. Or a medical issue.\r</language>
	</row>
	<row id="msg_0745_W40R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz... Zzz...\n...\rHe ain’t wakin’ up\nanytime soon!</language>
	</row>
	<row id="msg_0745_W40R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the entrance to the\nBattle Frontier.\fYou can’t make a line here.</language>
	</row>
	<row id="msg_0745_W40R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Battle Frontier open!\rGo ’head.</language>
	</row>
</body>
