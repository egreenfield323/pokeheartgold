<body language="English">
	<row id="msg_0563_T22R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lately, nobody been comin’\nthrough from Goldenrod. Weird.</language>
	</row>
	<row id="msg_0563_T22R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It been busy lately, ’cause\nmad people comin’ through\ffrom Goldenrod and Ecruteak!</language>
	</row>
	<row id="msg_0563_T22R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plants is alive too!\nThey wanna get up and move\faround sometimes!</language>
	</row>
</body>
