<?xml version="1.0"?>
<body language="English">
	<row id="msg_0574_T24GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: OOOMPH! The waterfall poundin’\nmy head... ARRGH! I LOVE IT!\rWHY YOU TURN OFF MY WATERFALL?!\rYou ruined my trainin’!\nI’m warnin’ you, I’m a STRONG Hustler\fwho train under this waterfall DAILY!\rWhat? That ain’t got nothin’ to do\nwith it?\r...\nThat’s TRUE!\r...\n...\rC’mon. Let’s scrap!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Urggh!\n...\rOooarrgh!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">THERE! Scared now, huh?! LOOK AT\nTHESE MUSCLES!\rWhat? That ain’t got nothin’ to do\nwith it?\fThat’s TRUE!\fC’mon. Let’s scrap!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Hmm... I lost?\rHOW ’BOUT THAT! My wife gon’ roast me\nfor WEEKS!\rAight. You worthy of the Storm Chain!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} got\nthe Storm Chain from Chuck!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: The Storm Chain let your\nhomies Catch Flight to any city or\ftown you been to!\rHere, take this too!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: That’s One Punch.\rIt miss if they hit you first,\nbut if it land, it’s LIGHTS OUT!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh... Your Bag jammed full!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: WAHAHAH!\nI had FUN scrappin’ you!\rBut an L is an L!\rFrom now on, I train 24 hours a day!\nNo more cake. ...Okay, a lil cake.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">He so into his trainin’ he don’t notice\nyou. He don’t notice his wife either.\fShe told me.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a big winch.\nYou gon’ turn it? {YESNO 0}</language>
	</row>
	<row id="msg_0574_T24GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} turned the winch\nwith pure muscle!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It won’t turn no more.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cianwood City Block\nWet Floor. Always.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cianwood City Block\rBoss: Chuck\nGot Ran Through By:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
