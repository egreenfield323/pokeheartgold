<?xml version="1.0"?>
<body language="English">
	<row id="msg_0724_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">And we OFF!</language>
	</row>
	<row id="msg_0724_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We DID it, yeah!\r</language>
	</row>
	<row id="msg_0724_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">UNCLE!\nI give! Uncle!\r</language>
	</row>
	<row id="msg_0724_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies is a CUT above the\nusual. Maybe even TWO cuts!</language>
	</row>
	<row id="msg_0724_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That cuttin’ intensity and solid\nattack... TOP class, yeah?\r</language>
	</row>
	<row id="msg_0724_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grr... Rendered harmless... Like a\nbutter knife.\r</language>
	</row>
	<row id="msg_0724_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The PRINCE among shorts-wearin’\nYoungsters, that’s ME!</language>
	</row>
	<row id="msg_0724_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hope I lived up to my title as\nthe prince of shorts.\r</language>
	</row>
	<row id="msg_0724_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t lose here! Not as the PRINCE\nof shorts! The crown is slippin’!\r</language>
	</row>
	<row id="msg_0724_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t take this tension.\nWould they be mad if I went home?</language>
	</row>
	<row id="msg_0724_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I DID it!\nI won somehow! Don’t ask how!\r</language>
	</row>
	<row id="msg_0724_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s past my limit!\nI need to be excused! Bathroom!\r</language>
	</row>
	<row id="msg_0724_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t hella good at this, but\nplease don’t hold back.</language>
	</row>
	<row id="msg_0724_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, didn’t I say?\nYou shouldn’t have held back.\r</language>
	</row>
	<row id="msg_0724_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWEH! I wish you woulda held back\na lil bit! I was lyin’!\r</language>
	</row>
	<row id="msg_0724_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Romance, fashion, AND homies!\nToday’s girls want it ALL!</language>
	</row>
	<row id="msg_0724_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The greed of today’s girls\nknow NO bounds!\r</language>
	</row>
	<row id="msg_0724_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Did bein’ greedy cost me\neverythin’? ...Yes. Clearly.\r</language>
	</row>
	<row id="msg_0724_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m thinkin’ hard about why\neverybody love scrappin’ so much.</language>
	</row>
	<row id="msg_0724_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why does winnin’ make people\nhappy? I’m happy. Weird.\r</language>
	</row>
	<row id="msg_0724_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why is losin’ so downright\nINFURIATIN’?! I’m thinkin’ about it!\r</language>
	</row>
	<row id="msg_0724_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m balancin’ homie trainin’\nand my own schoolin’.</language>
	</row>
	<row id="msg_0724_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I think I struck the right balance\nof fun and education.\r</language>
	</row>
	<row id="msg_0724_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This ain’t workin’?\nMy grades is the BEST in class, but...\r</language>
	</row>
	<row id="msg_0724_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I CRAMMED hard for this.\nI can’t possibly fail!</language>
	</row>
	<row id="msg_0724_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES! I get the W!\nGlad I pulled the all-nighter!\r</language>
	</row>
	<row id="msg_0724_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Means I gotta study at home\nsome more. *sobs into textbook*\r</language>
	</row>
	<row id="msg_0724_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies is my TREASURES.\nI’ll let you see ’em. Just you.</language>
	</row>
	<row id="msg_0724_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See? Cute AND strong!\nEheheheh.\r</language>
	</row>
	<row id="msg_0724_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See? Cute even when losin’.\nEheheheh.\r</language>
	</row>
	<row id="msg_0724_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I won’t EVER lose!\nPlease follow my rule!</language>
	</row>
	<row id="msg_0724_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks SO much!\nI owe this W to you!\r</language>
	</row>
	<row id="msg_0724_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I SO did not wanna lose...\nYou broke the rule.\r</language>
	</row>
	<row id="msg_0724_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can do this...\nI can SHINE here too!</language>
	</row>
	<row id="msg_0724_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES! I won!\nI’m finna be a STAR!\r</language>
	</row>
	<row id="msg_0724_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One day I’mma shine as the\nbrightest star in the world! Not today.\r</language>
	</row>
	<row id="msg_0724_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t be shy.\nYou can bring it any way you want.</language>
	</row>
	<row id="msg_0724_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah, I figured you’d be like this.\nHeh.\r</language>
	</row>
	<row id="msg_0724_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W-well, sometimes I lose so I don’t\ncrush everybody. Ahaha... (I tried.)\r</language>
	</row>
	<row id="msg_0724_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My father’s WEALTHY.\nThere’s NOTHIN’ he can’t afford.</language>
	</row>
	<row id="msg_0724_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My father’s bread bought\nmy homies. And this W.\r</language>
	</row>
	<row id="msg_0724_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s things bread can’t buy.\nI know that... now.\r</language>
	</row>
	<row id="msg_0724_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, shall we?\nTime is bread. The meter’s runnin’.</language>
	</row>
	<row id="msg_0724_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll take my leave. Another fancy\ndinner date, you know. Adieu!\r</language>
	</row>
	<row id="msg_0724_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My loss, is it? So be it.\nI had a date anyway. With a yacht.\r</language>
	</row>
	<row id="msg_0724_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Etiquette and courtesy...\nThat’s what a lady does.</language>
	</row>
	<row id="msg_0724_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I couldn’t unwind this way, I’d\nlose my ladylike composure.\r</language>
	</row>
	<row id="msg_0724_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wish I was free like the bird\nhomies... and not related to my mother.\r</language>
	</row>
	<row id="msg_0724_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I was Honey, you’d be\nGooey Mulch, I would think.</language>
	</row>
	<row id="msg_0724_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You see now?\nHow different we in class?\r</language>
	</row>
	<row id="msg_0724_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How DARE you!\nI won’t EVER forget this humiliation!\r</language>
	</row>
	<row id="msg_0724_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Partyin’, shoppin’, dinin’...\nDarling, I’m BORED of it all.</language>
	</row>
	<row id="msg_0724_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Excitement is SO lackin’ in my life.\nWhat will make my heart race?\r</language>
	</row>
	<row id="msg_0724_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Only scrappin’ lifts me from this\nidle life of boredom... and yachts.\r</language>
	</row>
	<row id="msg_0724_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Glad to meet you!\nMay this friendship be fruitful!</language>
	</row>
	<row id="msg_0724_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks HELLA much!\nGood looks SO hella much!\r</language>
	</row>
	<row id="msg_0724_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks hella much...\n...Pah.\r</language>
	</row>
	<row id="msg_0724_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The most NATURAL Hustler is...\nOh, why hide it? ME!</language>
	</row>
	<row id="msg_0724_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is the natural outcome.\nInevitable!\r</language>
	</row>
	<row id="msg_0724_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was scrappin’ naturally, and\nnaturally lost. Natural.\r</language>
	</row>
	<row id="msg_0724_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES! Not a grown-up!\nLucky me! I got a chance!</language>
	</row>
	<row id="msg_0724_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yup, scrappin’ another youngblood\nis WAY less scary.\r</language>
	</row>
	<row id="msg_0724_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I get DEADASS nervous in front of\ngrown-ups. You count apparently.\r</language>
	</row>
	<row id="msg_0724_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s hard to keep the streak alive,\nbut the scraps is fun.</language>
	</row>
	<row id="msg_0724_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s more fun to WIN, of course!\r</language>
	</row>
	<row id="msg_0724_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Even losin’ is fun.\nThat’s the wonder of homies!\r</language>
	</row>
	<row id="msg_0724_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My daddy’s a mountain man. Does that\nmake my mom a mountain woman?</language>
	</row>
	<row id="msg_0724_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mountain woman sounds ICKY.\nNot for me, good looks!\r</language>
	</row>
	<row id="msg_0724_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m their daughter. Is bein’ a\nmountain woman my DESTINY?\r</language>
	</row>
	<row id="msg_0724_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got a packed lunch ready, and\nof course SNACKS.</language>
	</row>
	<row id="msg_0724_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My favorite homie make winnin’\nSO easy!\r</language>
	</row>
	<row id="msg_0724_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh no, no! I forgot to bring my favorite\nhomie! I brought snacks though!\r</language>
	</row>
	<row id="msg_0724_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I swim with my water homie in\na pool ALL the time.</language>
	</row>
	<row id="msg_0724_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It makes me SO happy winnin’ with\nmy favorite homies.\r</language>
	</row>
	<row id="msg_0724_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’d love to swim in a pool FULL\nof water homies. Is that weird?\r</language>
	</row>
	<row id="msg_0724_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I promised Mommy I’d practice\nswimmin’ if I lose.</language>
	</row>
	<row id="msg_0724_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YAY! I don’t gotta go to the pool\nwith Mommy today!\r</language>
	</row>
	<row id="msg_0724_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, I lost. Now I gotta go to\nswim practice. The water’s COLD.\r</language>
	</row>
	<row id="msg_0724_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I caught my homies with\nmy daddy.</language>
	</row>
	<row id="msg_0724_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I WON, Daddy!\nDaddy, good looks!\r</language>
	</row>
	<row id="msg_0724_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maybe Daddy will show me how to\ntrain my homies next? He’s busy.\r</language>
	</row>
	<row id="msg_0724_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m on the way home from the pool,\nbut OK, I can scrap.</language>
	</row>
	<row id="msg_0724_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hope I can go home soon.\nI need dry clothes! I’m drippin’!\r</language>
	</row>
	<row id="msg_0724_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah-ah-ATCHOO! Aww...\nATCHOO! We lost... and I got a cold.\r</language>
	</row>
	<row id="msg_0724_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m the CAPTAIN of a heroic ship in\nthe crashin’ waves of a storm!</language>
	</row>
	<row id="msg_0724_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Made it to shore like a REAL\nswashbuckler!\r</language>
	</row>
	<row id="msg_0724_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was a BIGGER crash than\nI wanted! Abandon ship!\r</language>
	</row>
	<row id="msg_0724_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I JUST got back from vacation.</language>
	</row>
	<row id="msg_0724_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The beach is a good place to\nshow off. Like right now.\r</language>
	</row>
	<row id="msg_0724_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, my sunburn is ITCHIN’.\nDon’t touch me.\r</language>
	</row>
	<row id="msg_0724_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hunh? A scrap, is that it?\nSure thing, sure thing.</language>
	</row>
	<row id="msg_0724_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you somethin’ special, huh?\r</language>
	</row>
	<row id="msg_0724_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah, good looks for your time.\r</language>
	</row>
	<row id="msg_0724_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This goin’ out to all the ladies.\nBabes, I sing AND scrap for you!</language>
	</row>
	<row id="msg_0724_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My ladies, my babes, I won for you.\nYour love is my POWER, right?\r</language>
	</row>
	<row id="msg_0724_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I lost, but my love for the babes\ncan’t be beat... maybe. Call me?\r</language>
	</row>
	<row id="msg_0724_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This ain’t a guitar.\nIt’s traditional Japanese.</language>
	</row>
	<row id="msg_0724_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Only got three strings.\nCan you tell what this is?\r</language>
	</row>
	<row id="msg_0724_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s called a shamisen.\nNow you know. Learn somethin’.\r</language>
	</row>
	<row id="msg_0724_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Us teen Idols got a secret code of\nconduct. STRICTLY enforced.</language>
	</row>
	<row id="msg_0724_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Like, if a Idol wins, she gotta\nsqueal and jump around! EEEE!\r</language>
	</row>
	<row id="msg_0724_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If a Idol loses, she can NEVER act\nmad. That’s a no-no. *smiles angrily*\r</language>
	</row>
	<row id="msg_0724_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do the MONSTER Moon Punch!\nIt’s my catchphrase!</language>
	</row>
	<row id="msg_0724_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My Moon Punch go straight to\nyour heart!\r</language>
	</row>
	<row id="msg_0724_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Every Idol need a catchphrase,\nespecially after debut. Mine’s workin’.\r</language>
	</row>
	<row id="msg_0724_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You SO lucky to get the chance\nto scrap with me.</language>
	</row>
	<row id="msg_0724_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You SUPER lucky to even scrap\na Idol like me. Don’t you get it?\r</language>
	</row>
	<row id="msg_0724_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Huh? Why you WIN? I’m supposed to\nwin! It’s in my contract!\r</language>
	</row>
	<row id="msg_0724_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Krink... Krak... Heheheh.\nLemme limber up for this.</language>
	</row>
	<row id="msg_0724_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAH!\nWeak, even for a joke!\r</language>
	</row>
	<row id="msg_0724_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gnnrrr... I only got myself to blame...\nand my back.\r</language>
	</row>
	<row id="msg_0724_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t they pretty? Adorable?\nMy beloved homies.</language>
	</row>
	<row id="msg_0724_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You worked SO hard! I’ll give you\na nice massage at home.\r</language>
	</row>
	<row id="msg_0724_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you doin’ to my homies?!\nWhat if you hurt ’em?! Lawyer!\r</language>
	</row>
	<row id="msg_0724_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I come before you as a member of\nthe Pokémon Fan Club! En garde!</language>
	</row>
	<row id="msg_0724_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Long live the Pokémon Fan Club!\nMay it always be GLORIOUS!\r</language>
	</row>
	<row id="msg_0724_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This barely a taste of what the\nFan Club can bring down...\r</language>
	</row>
	<row id="msg_0724_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fan Club Department Manager...\nI hereby accept your challenge.</language>
	</row>
	<row id="msg_0724_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heheh... You thought you stood a\nchance against the FAN CLUB?\r</language>
	</row>
	<row id="msg_0724_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GWAH! I will be avenged...\nB-by the Division Manager... Corporate!\r</language>
	</row>
	<row id="msg_0724_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Raisin’ homies with love ain’t the\nsame as coddlin’. Don’t you see?</language>
	</row>
	<row id="msg_0724_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, you DID it! I love you SO!\nMy luvly, wuvly homie!\r</language>
	</row>
	<row id="msg_0724_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How COULD you?!\nWhat if my homies is injured?!\r</language>
	</row>
	<row id="msg_0724_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On behalf of my village, I take\non this challenge!</language>
	</row>
	<row id="msg_0724_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks, everybody!\nGood looks for the vocal support!\r</language>
	</row>
	<row id="msg_0724_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fellow villagers, I’m SORRY!\nMy best wasn’t enough! Don’t exile me!\r</language>
	</row>
	<row id="msg_0724_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for your patience.\nHere’s the scrap you ordered.</language>
	</row>
	<row id="msg_0724_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I trust you was satisfied?\nI feel shortchanged somewhat.\r</language>
	</row>
	<row id="msg_0724_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I trust you was satisfied?\nI had my fill. Check, please.\r</language>
	</row>
	<row id="msg_0724_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Work is fun, and homie also.\nI happy I come to this country.</language>
	</row>
	<row id="msg_0724_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Havin’ fun I’m!\nI hopin’ to live here forever.\r</language>
	</row>
	<row id="msg_0724_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, why you beat me? So mean!\nI want go home to my country.\r</language>
	</row>
	<row id="msg_0724_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m FINE, right? So everywhere I\nwork, they make me the maitre d’...</language>
	</row>
	<row id="msg_0724_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a good scrapper too. I can’t\nhelp it the ladies fall for me.\r</language>
	</row>
	<row id="msg_0724_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I dream of evolvin’ from a maitre d’\nto a celebrity chef. With a show.\r</language>
	</row>
	<row id="msg_0724_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No free deals on a scrap.\nYou’ll get the full course though.</language>
	</row>
	<row id="msg_0724_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where’s the fun if you don’t scrap\nlike you mean it?\r</language>
	</row>
	<row id="msg_0724_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I take work AND play seriously.\nThat’s what sparks my passion!\r</language>
	</row>
	<row id="msg_0724_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi, can I interest you in a meal\ncombo? ...I’m SO used to sayin’ that.</language>
	</row>
	<row id="msg_0724_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks, and have a great day!\n...What am I sayin’?\r</language>
	</row>
	<row id="msg_0724_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We look forward to your next visit!\n...What am I THINKIN’?\r</language>
	</row>
	<row id="msg_0724_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your team look IMPRESSIVE.\nWill I be OK...?</language>
	</row>
	<row id="msg_0724_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, what?\nThem homies only for Contests?\r</language>
	</row>
	<row id="msg_0724_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUCH! I said OUCH!\nThat was too much! WAY too much!\r</language>
	</row>
	<row id="msg_0724_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE bug homies!\nI love my bug net EVEN MORE!</language>
	</row>
	<row id="msg_0724_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I caught my homies with my\ntrusty bug net.\r</language>
	</row>
	<row id="msg_0724_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’d be hard if there was a bug net\nhomie. ...I’d still catch it.\r</language>
	</row>
	<row id="msg_0724_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The bugs is my minions, and I’m the\nBOSS. You prepared to lose?</language>
	</row>
	<row id="msg_0724_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAHAHA!\nWell done, my minions!\r</language>
	</row>
	<row id="msg_0724_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We got MOWED down...\nMy minions learned the hard way!\r</language>
	</row>
	<row id="msg_0724_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m breakin’ outta my SHELL!\nTakin’ it to the next level!</language>
	</row>
	<row id="msg_0724_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s like I sprouted WINGS!\nViva the new me!\r</language>
	</row>
	<row id="msg_0724_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is it not my time yet?\nBack in the shell I go.\r</language>
	</row>
	<row id="msg_0724_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You TRANSGRESSOR!\nHold still, I say!</language>
	</row>
	<row id="msg_0724_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I willed myself to victory!\r</language>
	</row>
	<row id="msg_0724_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C-curses...\nI brought dishonor on us... and my dog.\r</language>
	</row>
	<row id="msg_0724_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, ayo, what’s that over there?\nIt’s... a LEGENDARY homie!</language>
	</row>
	<row id="msg_0724_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KEKEKE... Ninjutsu misdirection!\nWorked to PERFECTION!\r</language>
	</row>
	<row id="msg_0724_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ninjutsu misdirection FAILED! I’ll\ndisappear in a puff of smoke! *cough*\r</language>
	</row>
	<row id="msg_0724_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You’ll be confused by my\nDAZZLIN’ speed!</language>
	</row>
	<row id="msg_0724_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your movements...\nLike you movin’ through syrup.\r</language>
	</row>
	<row id="msg_0724_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t need to do all that runnin’\naround, did I? I’m so tired.\r</language>
	</row>
	<row id="msg_0724_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been wearin’ these clothes a LONG\ntime. Baths is for the birds!</language>
	</row>
	<row id="msg_0724_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Changin’ clothes is too much effort.\nBaths is even worse!\r</language>
	</row>
	<row id="msg_0724_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NO, NO, NO!\nI WON’T take a bath! You can’t make me!\r</language>
	</row>
	<row id="msg_0724_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I like my mommy, PIKACHU, and my\ndaddy, too. In that order.</language>
	</row>
	<row id="msg_0724_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A weak Hustler ain’t hard.\nI don’t like you.\r</language>
	</row>
	<row id="msg_0724_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A not-wimpy Hustler is hard.\nI like you. Don’t tell Daddy.\r</language>
	</row>
	<row id="msg_0724_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikapika PIKAAH!\nPikka! PIKACHUUUH!</language>
	</row>
	<row id="msg_0724_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piika pikapikka!\nPikka pikkachuuh!\r</language>
	</row>
	<row id="msg_0724_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikka ppi pi piii...\n(He’s sad.)\r</language>
	</row>
	<row id="msg_0724_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I scrap, I picture the vast\nsea in my mind.</language>
	</row>
	<row id="msg_0724_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I see the sea, I feel like\nI could NEVER lose.\r</language>
	</row>
	<row id="msg_0724_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I see the sea, I don’t feel\nthe sting of defeat. Just the salt.\r</language>
	</row>
	<row id="msg_0724_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">In scraps AND love, you gotta know\nwhen to back off.</language>
	</row>
	<row id="msg_0724_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Both scraps and romance can turn\ninto swamps of despair.\r</language>
	</row>
	<row id="msg_0724_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I lost, but I said somethin’ deep,\nin a endless swamp kinda way.\r</language>
	</row>
	<row id="msg_0724_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I think I got CURSED on our last\nexploration of the ruins. Ehehe.</language>
	</row>
	<row id="msg_0724_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Even now, I got NO idea how I won.\nHeeheehee.\r</language>
	</row>
	<row id="msg_0724_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I may be cursed, but this is FUN.\nHella good. Heeheehee. *twitch*\r</language>
	</row>
	<row id="msg_0724_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Old buildings and towns send my\npulse racin’.</language>
	</row>
	<row id="msg_0724_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People into old architecture is\npotential Ruin Maniacs.</language>
	</row>
	<row id="msg_0724_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Open your eyes in towns. There’s\nexcitin’ discoveries. I MEAN it.</language>
	</row>
	<row id="msg_0724_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I put this team together with my\nInternet homies. Took ALL day!</language>
	</row>
	<row id="msg_0724_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We WON! I gotta thank my Internet\nhomies for the advice!\r</language>
	</row>
	<row id="msg_0724_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, DARN it! We lost?! I’m reportin’\nthis to my Internet homies!\r</language>
	</row>
	<row id="msg_0724_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m the MAIN CHARACTER of this story.\nIt’s impossible for me to lose.</language>
	</row>
	<row id="msg_0724_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You good! Though for a side\ncharacter, you a bit too strong.\r</language>
	</row>
	<row id="msg_0724_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...The hero gotta suffer a bit so\nthe audience feel more empathy.\r</language>
	</row>
	<row id="msg_0724_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m HELLA fickle. I can’t stick with\nnothin’ for hella long.</language>
	</row>
	<row id="msg_0724_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I won, and that’s enough for me.\nI’m off to the Wi-Fi Plaza.\r</language>
	</row>
	<row id="msg_0724_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I lost, so that’s enough. I’ll go\nto the Safari Zone. Or bed.\r</language>
	</row>
	<row id="msg_0724_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got a TON more experience than\nyou. What you gon’ do about it?</language>
	</row>
	<row id="msg_0724_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not bad, but you need more\nmaturin’. Like cheese.\r</language>
	</row>
	<row id="msg_0724_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Experience alone don’t guarantee\nWs, I’m learnin’. At my age.\r</language>
	</row>
	<row id="msg_0724_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t you think homie scraps is\na lot like the weather?</language>
	</row>
	<row id="msg_0724_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Winnin’ make me warm and cheerful\nlike a sunny day!\r</language>
	</row>
	<row id="msg_0724_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Losin’ make me sad like a dreary,\ncloudy Monday.\r</language>
	</row>
	<row id="msg_0724_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was out ALL night at a party\nagain. I’m dizzy from games!</language>
	</row>
	<row id="msg_0724_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m SO bored of fancy parties\nand silly games too.\r</language>
	</row>
	<row id="msg_0724_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">URP...!\nToo much punch.\r</language>
	</row>
	<row id="msg_0724_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, ain’t you the most DARLING\nthing! Can you win a smile from me?</language>
	</row>
	<row id="msg_0724_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, sweetie, I won, so no smile!\nBe sure to win next time!\r</language>
	</row>
	<row id="msg_0724_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t feel like smilin’ now... but\nI’ll happily wave goodbye!\r</language>
	</row>
	<row id="msg_0724_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Oh, wait one second.\nI gotta take this call.</language>
	</row>
	<row id="msg_0724_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi, yup... Yeah, scrappin’...\nUh-huh... Yup, I won... LOL...\r</language>
	</row>
	<row id="msg_0724_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, yup... Yes, just scrapped...\nNope... Kid beat me... Uh-huh... *hangs\fup*\r</language>
	</row>
	<row id="msg_0724_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snivel! Hnurrff! Snort!\nThis hay fever is a WICKED misery...</language>
	</row>
	<row id="msg_0724_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hnurrff! Snivel! Snivel!\nI won, but the misery continues!\r</language>
	</row>
	<row id="msg_0724_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sniffle. Snivel. Snort.\nI ain’t cryin’. My nose is runnin’.\r</language>
	</row>
	<row id="msg_0724_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My nose can tell how tough\na Hustler is.</language>
	</row>
	<row id="msg_0724_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Keep tryin’. My nose tell me\nyou got GREAT potential.\r</language>
	</row>
	<row id="msg_0724_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sniff, sniff... Snort! My nose tell\nme you been workin’ hard!\r</language>
	</row>
	<row id="msg_0724_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KYAHAHA! I smell a powerful scrap\nin the makin’!</language>
	</row>
	<row id="msg_0724_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The sweet smell of success!\r</language>
	</row>
	<row id="msg_0724_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Defeat smells like a SKUNTANK!\r</language>
	</row>
	<row id="msg_0724_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I like hard, fast beats in my scraps\nand my rock ’n’ roll! Let’s wail!</language>
	</row>
	<row id="msg_0724_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">And, BAM! That rhythm RULED,\nif I say so myself!\r</language>
	</row>
	<row id="msg_0724_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUCH! That’s a insult to the ears!\nThose beats was OFFENSIVE, man!\r</language>
	</row>
	<row id="msg_0724_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To show you how much this mean,\nI’ll use sound effects from now on.</language>
	</row>
	<row id="msg_0724_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RAAAAH! Dun dun! Dun dun!\nOompa-oompa-oompapa!\r</language>
	</row>
	<row id="msg_0724_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blip-bip, blip-bip... Blip...\nBweeee...\r</language>
	</row>
	<row id="msg_0724_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wait, please wait...\nThe winds... I hear them...</language>
	</row>
	<row id="msg_0724_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can hear them...\nThe winds is LAUGHIN’...\r</language>
	</row>
	<row id="msg_0724_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can hear them...\nThe winds... They in tears...\r</language>
	</row>
	<row id="msg_0724_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t fly...\nBut these babies can SOAR...</language>
	</row>
	<row id="msg_0724_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My spirit has been lifted to the\nskies... Good looks, everybody...\r</language>
	</row>
	<row id="msg_0724_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You broke my wings...\nI won’t EVER forget you...\r</language>
	</row>
	<row id="msg_0724_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Every day I’m like a migratin’ bird,\nbut I go in ALL directions.</language>
	</row>
	<row id="msg_0724_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got experience travelin’ to\nall kinds of places.\r</language>
	</row>
	<row id="msg_0724_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’d love to live somewhere with\nmore Hustlers like you.\r</language>
	</row>
	<row id="msg_0724_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was born to rollin’ waves, with\nthe beach as my cradle.</language>
	</row>
	<row id="msg_0724_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Born and raised on the seas.\nThat’s what made me the BIG man I’m.\r</language>
	</row>
	<row id="msg_0724_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I lost, did I? Time to go to the sea\nand stare at it mysteriously.</language>
	</row>
	<row id="msg_0724_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Youths of today aim for the WORLD!\nHow’s that for deep!</language>
	</row>
	<row id="msg_0724_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s MIGHTY hard Hustlers all over\nthe world. I’m sure of that.\r</language>
	</row>
	<row id="msg_0724_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Go on, youngblood! Take on the world!\nI’ll be waitin’ for your return!\r</language>
	</row>
	<row id="msg_0724_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What? I smell DUSTY?\nYou don’t know the aroma of soil?</language>
	</row>
	<row id="msg_0724_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See, that’s what you get!\nYour team ate DIRT, get it?\r</language>
	</row>
	<row id="msg_0724_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dropped in the dirt by some youngblood\nwho don’t know the smell of soil!\r</language>
	</row>
	<row id="msg_0724_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sorry I look scruffy and dirty.\nI been holed up in the mountains.</language>
	</row>
	<row id="msg_0724_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wasn’t holed up on purpose.\nI was LOST out there. For a month.\r</language>
	</row>
	<row id="msg_0724_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Better to be holed up in the mountains\nthan in your room, I say.\r</language>
	</row>
	<row id="msg_0724_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t supposed to be here.\nCan we do this on the low?</language>
	</row>
	<row id="msg_0724_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Even scrappin’ draw attention.\nIt ain’t easy bein’ a pop star.\r</language>
	</row>
	<row id="msg_0724_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pop stars is regular girls at heart.\nWe wanna enjoy our homies too!\r</language>
	</row>
	<row id="msg_0724_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a SELF-MADE celebrity.\nYou got a problem with that?</language>
	</row>
	<row id="msg_0724_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A celebrity is a celebrity, even\nif it’s only in my own mind.\r</language>
	</row>
	<row id="msg_0724_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanna be the center of attention.\nJust me. ONLY me.\r</language>
	</row>
	<row id="msg_0724_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m retirin’ soon...\nI was never admired as a Idol.</language>
	</row>
	<row id="msg_0724_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m finna shine as a STAR scrapper!\r</language>
	</row>
	<row id="msg_0724_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I woulda liked to end my career\nwith a W in this match...</language>
	</row>
	<row id="msg_0724_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trainin’ homies is a LOT like a\nmarathon. You agree?</language>
	</row>
	<row id="msg_0724_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s meanin’ in stickin’ with your\ntrainin’ every day.\r</language>
	</row>
	<row id="msg_0724_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you don’t pace yourself, you\ncan’t win. I went too fast.\r</language>
	</row>
	<row id="msg_0724_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Howdy! Let’s keep it clean, fair,\nrefreshin’, and pleasant!</language>
	</row>
	<row id="msg_0724_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whew, I feel INVIGORATED!\nHomies is the GREATEST!\r</language>
	</row>
	<row id="msg_0724_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh, haha... ha... It actually feels\nkinda cleansin’ to get thrashed this\fbad.\r</language>
	</row>
	<row id="msg_0724_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s Workers like us who keep\nthe world goin’.</language>
	</row>
	<row id="msg_0724_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sometimes we just wanna drop our\ntools and rest.\r</language>
	</row>
	<row id="msg_0724_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t forget how Workers like us\nwork for you. Tip your Workers.\r</language>
	</row>
	<row id="msg_0724_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My wife and boy waitin’ on me at\nhome. I can’t afford to lose!</language>
	</row>
	<row id="msg_0724_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sorry, I had to. You’ll get tougher\nwith a family behind you.\r</language>
	</row>
	<row id="msg_0724_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, NO! How I’m supposed to face\nmy dear wife and boy now?!\r</language>
	</row>
	<row id="msg_0724_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Homies is like family to me.\n...Nah, they ARE family.</language>
	</row>
	<row id="msg_0724_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES! My family, you did it!\nWe beat that MEAN Hustler!\r</language>
	</row>
	<row id="msg_0724_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAAAAH! That’s CRUEL!\nMy family’s hurtin’!\r</language>
	</row>
	<row id="msg_0724_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was too soft on my homies.\nThey grew up all SELFISH on me.</language>
	</row>
	<row id="msg_0724_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, now, ENOUGH. Stop attackin’!\nThe scrap’s been over!\r</language>
	</row>
	<row id="msg_0724_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, now, the scrap’s over.\nNo attackin’ the Hustler. Bad homie.\r</language>
	</row>
	<row id="msg_0724_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You, there. Don’t look around.\nPay attention to ME. Focus.</language>
	</row>
	<row id="msg_0724_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kid, you WAY underpowered.\nYou oughta train with me.\r</language>
	</row>
	<row id="msg_0724_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, yeah. You better than you look.\nI was wrong about you, youngblood.\r</language>
	</row>
	<row id="msg_0724_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Go, my homies.\nBut don’t strain yourselves.</language>
	</row>
	<row id="msg_0724_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, sheesh, I like how tough everybody\nwas. Our homies and you, yup.\r</language>
	</row>
	<row id="msg_0724_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, nice try, gang.\nThanks much for tryin’. Pizza on me.\r</language>
	</row>
	<row id="msg_0724_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My papa’s dream...\nI’m finna make it REAL.</language>
	</row>
	<row id="msg_0724_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa, did you SEE?\nWe did it all for you...\r</language>
	</row>
	<row id="msg_0724_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We lost...\nPapa, I’m SO sorry...\r</language>
	</row>
	<row id="msg_0724_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’d like to take a break.\n...No? We gotta start RIGHT away?</language>
	</row>
	<row id="msg_0724_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, see? You shoulda took a\nbreak with me before.\r</language>
	</row>
	<row id="msg_0724_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, ain’t you a tough one? You should\ntake breaks though. Self-care.\r</language>
	</row>
	<row id="msg_0724_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yes, yes, lookin’ GOOD!\nI need a smile now. Can you do that?</language>
	</row>
	<row id="msg_0724_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, no, no. I need a SMILE.\nLet’s see them teeth sparkle!\r</language>
	</row>
	<row id="msg_0724_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES, that’s a good smile!\nNow tilt your head toward me.\r</language>
	</row>
	<row id="msg_0724_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t tell, but I can see\nright down to your pores.</language>
	</row>
	<row id="msg_0724_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yes, I see it, indeed.\nI can see you CLEARLY.\r</language>
	</row>
	<row id="msg_0724_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I zoomed in on you too much.\nI couldn’t see your homies.\r</language>
	</row>
	<row id="msg_0724_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">While we scrap, I’ll keep lookin’\nfor the best shot of you.</language>
	</row>
	<row id="msg_0724_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There! And there again!\nDecisive moments in time!\r</language>
	</row>
	<row id="msg_0724_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shots of me losin’?\nThose get deleted IMMEDIATELY.\r</language>
	</row>
	<row id="msg_0724_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll bring you LIVE coverage of\nmy imminent scrap!</language>
	</row>
	<row id="msg_0724_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Our fearless and beautiful Reporter\nhas WON! Go, me!\r</language>
	</row>
	<row id="msg_0724_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Our fearless and beautiful Reporter\nwent DOWN. Take pity on me!\r</language>
	</row>
	<row id="msg_0724_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hate admittin’ it, but I wanted\nto be a Idol too.</language>
	</row>
	<row id="msg_0724_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t wanna lose to NO Idol.\nThat’s what motivated me to train.\r</language>
	</row>
	<row id="msg_0724_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is CRUSHIN’... I work SO much\nharder than any silly Idol...\r</language>
	</row>
	<row id="msg_0724_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This mic made me a STAR.\nIt’s my everythin’.</language>
	</row>
	<row id="msg_0724_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Even in a scrap, this mic don’t\nleave my hand.\r</language>
	</row>
	<row id="msg_0724_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Thud. Bzzzzt...\n(The mic died.)\r</language>
	</row>
	<row id="msg_0724_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, ’sup. Warnin’: I’m RIGHT fast,\nHustler. Hold on to your hat.</language>
	</row>
	<row id="msg_0724_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">From now on, you can start addin’\n“Mister” to my name.\r</language>
	</row>
	<row id="msg_0724_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was a real learnin’ experience.\nGood looks, seriously.\r</language>
	</row>
	<row id="msg_0724_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Bike is a extension of\nmy HELLA bein’.</language>
	</row>
	<row id="msg_0724_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Any damage to my Bike, I feel the\npain like it’s mine.\r</language>
	</row>
	<row id="msg_0724_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Please! Keep your FILTHY hands\noff my Bike. Don’t touch the spokes.\r</language>
	</row>
	<row id="msg_0724_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I was lil, I HATED cyclin’.\nCouldn’t get the hang of it.</language>
	</row>
	<row id="msg_0724_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE cyclin’ now.\nMade mad homies ridin’.\r</language>
	</row>
	<row id="msg_0724_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can ride a Bike? It’s healthy and a\nLOTTA fun. No trainin’ wheels.\r</language>
	</row>
	<row id="msg_0724_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll ride toward the breakin’ dawn\nwith you on my mind.</language>
	</row>
	<row id="msg_0724_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll shift my gears higher and higher\ntill I catch up to you...\r</language>
	</row>
	<row id="msg_0724_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My tires deflated, and\nso did my heart...\r</language>
	</row>
	<row id="msg_0724_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let the curtain rise on the festival\nof MUSCLES and homies!</language>
	</row>
	<row id="msg_0724_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You enjoy our demonstration of\nmuscles and homies?\r</language>
	</row>
	<row id="msg_0724_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Though I lost, my muscles and homies\nis BURNED into your mind. Flex.\r</language>
	</row>
	<row id="msg_0724_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">They say I got fists of STEEL and\nthe heart of a child.</language>
	</row>
	<row id="msg_0724_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, YAY! Yippee!\nI won, I won!\r</language>
	</row>
	<row id="msg_0724_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, boo! Boo! This STINKS!\nI ain’t talkin’ to you!\r</language>
	</row>
	<row id="msg_0724_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hwoaaah...\nHwoaaah...</language>
	</row>
	<row id="msg_0724_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HOWATCHAH!\nHOWAAATCHAAH!\r</language>
	</row>
	<row id="msg_0724_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fweeeh...\nFweeehhh...\r</language>
	</row>
	<row id="msg_0724_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">In my dictionary, there ain’t no\nentry for “restraint.”</language>
	</row>
	<row id="msg_0724_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The greatest respect between\nHustlers is scrappin’ ALL out.\r</language>
	</row>
	<row id="msg_0724_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I went ALL out and still lost.\nOf course it stings.\r</language>
	</row>
	<row id="msg_0724_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A pro martial artist is ALWAYS in\ncontrol of his body.</language>
	</row>
	<row id="msg_0724_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A martial artist gotta be more than\nstrong. He gotta be WISE.\r</language>
	</row>
	<row id="msg_0724_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GAH! I overtrained and ran outta\nstamina early... Leg day was a mistake.\r</language>
	</row>
	<row id="msg_0724_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I close my eyes, I can picture\nyou losin’. C’mon.</language>
	</row>
	<row id="msg_0724_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why be sad?\nYou KNEW this was comin’.\r</language>
	</row>
	<row id="msg_0724_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I scold myself for my own\ncarelessness...\r</language>
	</row>
	<row id="msg_0724_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t like to move much.\nI trained usin’ the Net and TV.</language>
	</row>
	<row id="msg_0724_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">UHIHI! I’m a NATURALLY talented pro\nat karate AND homies!\r</language>
	</row>
	<row id="msg_0724_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh man, this is ROTTEN! I’m tired and\nhungry and wanna go home!\r</language>
	</row>
	<row id="msg_0724_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...To get this far, I made sacrifices.\nMany, MANY sacrifices.</language>
	</row>
	<row id="msg_0724_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s for this ONE moment that I live.\r</language>
	</row>
	<row id="msg_0724_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What else I gotta give up so I can\nbeat you? I already gave up carbs.\r</language>
	</row>
	<row id="msg_0724_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First, let’s scrap.\nTalkin’ can wait.</language>
	</row>
	<row id="msg_0724_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That wasn’t bad at all, yup.\nYou and your homies.\r</language>
	</row>
	<row id="msg_0724_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You a tough one, yup.\nWhere you do your trainin’?\r</language>
	</row>
	<row id="msg_0724_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cute lil Hustler!\nWe’ll squash you FLAT.</language>
	</row>
	<row id="msg_0724_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eheh! You SO cute when you look\nmad and frustrated!\r</language>
	</row>
	<row id="msg_0724_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you think you DOIN’?\nI HATE to lose, I’ll have you know!\r</language>
	</row>
	<row id="msg_0724_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My precious homie gon’ set you\nRIGHT!</language>
	</row>
	<row id="msg_0724_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies got NO flaws you\ncan exploit!\r</language>
	</row>
	<row id="msg_0724_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I apologize, my dear homie...\nI was caught slippin’...\r</language>
	</row>
	<row id="msg_0724_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwo-fwo-fwo. Youngster, what’s most\nimportant is NEVER give up.</language>
	</row>
	<row id="msg_0724_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you give up, that’s it.\nGame over.\r</language>
	</row>
	<row id="msg_0724_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwo-fwo-fwo.\nYou a admirable Hustler already.\r</language>
	</row>
	<row id="msg_0724_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can tell by your face, you\ntaken with my DANDY style!</language>
	</row>
	<row id="msg_0724_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t be so mesmerized by me.\nLike a MOTHIM to a flame!\r</language>
	</row>
	<row id="msg_0724_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you NOT interested in me?\nYou just a SHELLOS, if I say so myself.\r</language>
	</row>
	<row id="msg_0724_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, wassup, ain’t you a sweetie!\nYou SURE you up to this?</language>
	</row>
	<row id="msg_0724_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, now, don’t cry.\nYou should be proud of yourself, dear.\r</language>
	</row>
	<row id="msg_0724_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my... You QUITE the capable\npractitioner of the art.\r</language>
	</row>
	<row id="msg_0724_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You and your homies could use a\nobedience lesson from me.</language>
	</row>
	<row id="msg_0724_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This ain’t over till I SAY.\nOnce more.\r</language>
	</row>
	<row id="msg_0724_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You DEFY me?\nHow HELLA amusin’.\r</language>
	</row>
	<row id="msg_0724_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Over the years, I crossed paths\nwith MANY a Hustler.</language>
	</row>
	<row id="msg_0724_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">They was all wonderful in their\nown way. Fond memories now...\r</language>
	</row>
	<row id="msg_0724_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You one of them many Hustlers.\nI’m sorry I wasn’t younger.\r</language>
	</row>
	<row id="msg_0724_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a Psychic, though I don’t look\nlike one. Watch me do somethin’ psychic.</language>
	</row>
	<row id="msg_0724_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t use NO psychic power to win.\nNo, deadass.\r</language>
	</row>
	<row id="msg_0724_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You notice? I was LEVITATIN’ while\nwe was scrappin’. You ain’t notice?\r</language>
	</row>
	<row id="msg_0724_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAZZAM!\nSo! You my next VICTIM!</language>
	</row>
	<row id="msg_0724_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAZZAM!\nYou got NO spine?!\r</language>
	</row>
	<row id="msg_0724_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwizzle... Don’t think there’s gon’ be\na next time!</language>
	</row>
	<row id="msg_0724_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can use psychic power, but I prefer\nregular magic tricks.</language>
	</row>
	<row id="msg_0724_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Psychic power should be left to\nthe homies. I do card tricks.\r</language>
	</row>
	<row id="msg_0724_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a Psychic, but I’m also a student\nat magician school. Pick a card.\r</language>
	</row>
	<row id="msg_0724_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">In the next few minutes, you gon’\nlearn TRUE terror at my hands!</language>
	</row>
	<row id="msg_0724_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAH! Too weak! Too weak!\nWhat PITIFUL resistance!\r</language>
	</row>
	<row id="msg_0724_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NOOOO!\nI can’t LOSE!</language>
	</row>
	<row id="msg_0724_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see what I got no right seein’...\nLike there. Behind you.</language>
	</row>
	<row id="msg_0724_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? You can’t see it?\nThen you lucky. Giggle...\r</language>
	</row>
	<row id="msg_0724_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wouldn’t ask about what I see.\nBetter not to know. Deadass.\r</language>
	</row>
	<row id="msg_0724_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The great unseeable power...\nI beg you for help...</language>
	</row>
	<row id="msg_0724_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, great unseeable power...\nGood looks for comin’ through...\r</language>
	</row>
	<row id="msg_0724_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... Great unseeable power...\nWhy you leave me on read...\r</language>
	</row>
	<row id="msg_0724_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why I raise homies?\n’Cause they THERE!</language>
	</row>
	<row id="msg_0724_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I think I said somethin’ deep and\nhard! Didn’t I?\r</language>
	</row>
	<row id="msg_0724_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s no reason at all?\nThat’s the reason ITSELF!\r</language>
	</row>
	<row id="msg_0724_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My team been raised with care.\nI got ABSOLUTE confidence in ’em.</language>
	</row>
	<row id="msg_0724_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You should pay closer attention to\nyour homies’ unique traits.\r</language>
	</row>
	<row id="msg_0724_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you like my homies?\nYou notice their significance?\r</language>
	</row>
	<row id="msg_0724_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everybody, it’s SHOWTIME!\nGet out there and clobber!</language>
	</row>
	<row id="msg_0724_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, BRAVO!\nNicely won!\r</language>
	</row>
	<row id="msg_0724_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ARRGH! How HUMILIATIN’!\nQuick! Outta the spotlight!\r</language>
	</row>
	<row id="msg_0724_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE raisin’ homies.\nIt’s what I live for!</language>
	</row>
	<row id="msg_0724_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seein’ ’em try so hard to please...\nIt’s SO unbearably adorable.\r</language>
	</row>
	<row id="msg_0724_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t you DARE do that again!\r</language>
	</row>
	<row id="msg_0724_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been figurin’ out ways to raise\ntough homies from the GENETIC level.</language>
	</row>
	<row id="msg_0724_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t overlook knowledge in\nraisin’ tough homies.\r</language>
	</row>
	<row id="msg_0724_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta study what genetics is\nabout first. Back to school.\r</language>
	</row>
	<row id="msg_0724_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Raise ’em with love, and homies\nanswer in kind. Prob’ly.</language>
	</row>
	<row id="msg_0724_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">They responded to my love.\nProb’ly.\r</language>
	</row>
	<row id="msg_0724_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You raisin’ your homies with a lot\nof love. I think. Prob’ly.\r</language>
	</row>
	<row id="msg_0724_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll approach this scrap from the\nperspective of a newborn.</language>
	</row>
	<row id="msg_0724_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abuboo dah.\r</language>
	</row>
	<row id="msg_0724_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ababaa.\nManmaa. *cries*\r</language>
	</row>
	<row id="msg_0724_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you win, I’ll tell you a tale\nfrom my youth.</language>
	</row>
	<row id="msg_0724_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seein’ you bring back a flood of\nmemories. Ah, yes, indeed...\r</language>
	</row>
	<row id="msg_0724_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Hm?\nI seem to have forgotten... Where am I?\r</language>
	</row>
	<row id="msg_0724_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s no end to either bein’\nyoung or homies.</language>
	</row>
	<row id="msg_0724_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See ya! That was fun!\nEnjoy your youth!\r</language>
	</row>
	<row id="msg_0724_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m still a dreamer.\nA precious, unspoiled snowflake...\r</language>
	</row>
	<row id="msg_0724_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daddy... Mommy... You hear me?\nPlease watch over me...</language>
	</row>
	<row id="msg_0724_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daddy... Mommy... You see?\nI won, and it’s all for you...\r</language>
	</row>
	<row id="msg_0724_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... Daddy... Mommy...\nI couldn’t win...\r</language>
	</row>
	<row id="msg_0724_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FINALLY... Time to test the fruits\nof my research...</language>
	</row>
	<row id="msg_0724_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Success...\nSacrificin’ my youth was worth it.\r</language>
	</row>
	<row id="msg_0724_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No! NOOOOOOO!\nGimme back my YOUTH!\r</language>
	</row>
	<row id="msg_0724_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I made a SPECIAL homie drink.\nHave some! Bottoms up!</language>
	</row>
	<row id="msg_0724_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Glug, glug... BELCH!\nIt make you STRONG! Don’t waste it!\r</language>
	</row>
	<row id="msg_0724_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homie drink contains no actual\nhomies or their byproducts. Promise.\r</language>
	</row>
	<row id="msg_0724_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A analogy for scrappin’ is...\nI’d say a bachelor guy.</language>
	</row>
	<row id="msg_0724_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heheh, you get it?\nI doubt you’d get it. Nobody does.\r</language>
	</row>
	<row id="msg_0724_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You get what I’m sayin’?\nI doubt it. Nobody EVER does.\r</language>
	</row>
	<row id="msg_0724_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been born, raised, and lived my\nwhole life under a circus tent.</language>
	</row>
	<row id="msg_0724_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies too. Born and raised under\na circus tent. Clowns everywhere.\r</language>
	</row>
	<row id="msg_0724_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The outside world is SO cruel...\nWe goin’ back to our circus tent.</language>
	</row>
	<row id="msg_0724_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oi, YOU! Yeah, you! Snap to it!\nI’ll be trainin’ you!</language>
	</row>
	<row id="msg_0724_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What?! You down already?!\nThis ain’t no bed! GET UP!\r</language>
	</row>
	<row id="msg_0724_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GOOD! Enough!\nThat’ll do for today! Hydrate!\r</language>
	</row>
	<row id="msg_0724_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwah? You mean to challenge ME?</language>
	</row>
	<row id="msg_0724_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAHAHA! I win!\nBetter luck next time, punk!\r</language>
	</row>
	<row id="msg_0724_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAAH?! You beat me?\nWho are YOU to do that?!\r</language>
	</row>
	<row id="msg_0724_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, it gimme shivers...\nI live for this moment.</language>
	</row>
	<row id="msg_0724_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, yeah... That’s it...\nPerfection don’t come better...\r</language>
	</row>
	<row id="msg_0724_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It got so I can’t live without\nscrappin’ anymore. Send help.\r</language>
	</row>
	<row id="msg_0724_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! I’m finna DO it!\nI’m finna show you my best!</language>
	</row>
	<row id="msg_0724_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gasp, gasp...\nThat was my best. Sheesh.\r</language>
	</row>
	<row id="msg_0724_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Never AGAIN!\nForget about a next time!\r</language>
	</row>
	<row id="msg_0724_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um... I’m honestly quite tough.\nPlease keep up.</language>
	</row>
	<row id="msg_0724_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m sorry.\nYou don’t measure up after all.\r</language>
	</row>
	<row id="msg_0724_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m amazed.\nI ain’t think you’d win...\r</language>
	</row>
	<row id="msg_0724_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s go, ME! Go, me, go!\nDon’t lose, don’t lose, rah, rah, rah!</language>
	</row>
	<row id="msg_0724_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Way to go, ME! I’m SO wonderful!\nRah, rah, rah! Gooooooo, me!\r</language>
	</row>
	<row id="msg_0724_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s OK, me! Don’t cry! Don’t cry!\nGo home, go home, goooooo!\r</language>
	</row>
	<row id="msg_0724_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WOOHOO! Here come a hard Hustler!\nLet’s see what you got!</language>
	</row>
	<row id="msg_0724_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES! Bravo!\nYou got good attacks, Hustler!\r</language>
	</row>
	<row id="msg_0724_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHAAAAAT?! NOOOOO!\nI can’t get over how tough you!\r</language>
	</row>
	<row id="msg_0724_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To serve and protect homies and\nnature. That’s my MISSION!</language>
	</row>
	<row id="msg_0724_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My skills was built in the arms of\nMother Nature!\r</language>
	</row>
	<row id="msg_0724_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My mission needs me!\nThis is where we say goodbye!\r</language>
	</row>
	<row id="msg_0724_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Never fear, this Ranger is here to\nprotect my OWN personal peace!</language>
	</row>
	<row id="msg_0724_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My personal peace has been\nPROTECTED!\r</language>
	</row>
	<row id="msg_0724_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You VILE Hustler, you!\nYou shattered my peace!\r</language>
	</row>
	<row id="msg_0724_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Any bad kids litterin’ the fields?\nAny bad kids foulin’ the sea?</language>
	</row>
	<row id="msg_0724_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Be sure to sort your recyclables\nfrom the trash!</language>
	</row>
	<row id="msg_0724_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trash is like a scrap.\nDon’t be too quick to throw it!</language>
	</row>
	<row id="msg_0724_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Watch me, darling!\nI’m puttin’ my BEST into this!</language>
	</row>
	<row id="msg_0724_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See, darling? You see?\nI did my best for YOU.\r</language>
	</row>
	<row id="msg_0724_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t let my darling see me like\nthis. How pathetic I must look...\r</language>
	</row>
	<row id="msg_0724_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So I lead with this... then counter...\nUgh, I can’t get this strategy right!</language>
	</row>
	<row id="msg_0724_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Overthinkin’ can be bad,\nI guess.\r</language>
	</row>
	<row id="msg_0724_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAAAH! Couldn’t you have WAITED?\nTill I was ready at least?\r</language>
	</row>
	<row id="msg_0724_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you like my CAPE?\nI had it specially made!</language>
	</row>
	<row id="msg_0724_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What’s my cape made of?\nI can’t tell you. It’s a secret.\r</language>
	</row>
	<row id="msg_0724_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rip... RIIIIIIIIIIIIPPPPPP!\n...What?! My CAPE! WAAAAAH!\r</language>
	</row>
	<row id="msg_0724_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know what REAL terror is?\nI do. Intimately...</language>
	</row>
	<row id="msg_0724_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You learned somethin’ today, yes?\nThe true meanin’ of terror.\r</language>
	</row>
	<row id="msg_0724_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AIYEEH! What’s WITH you?\nI’m beggin’ for mercy here!\r</language>
	</row>
	<row id="msg_0724_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See it! Hear it! SMELL it!\nMarvel at my power!</language>
	</row>
	<row id="msg_0724_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s right! Use ALL your senses and\nsee what you was up against!\r</language>
	</row>
	<row id="msg_0724_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t see nothin’! I ain’t listenin’!\nAnd I DON’T smell a thing!\r</language>
	</row>
	<row id="msg_0724_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Unlucky for you, your win streak\nends with ME.</language>
	</row>
	<row id="msg_0724_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You lost to me, but you still on your\nfeet. Kudos to you!\r</language>
	</row>
	<row id="msg_0724_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This can’t be. I won’t accept it.\nThere’s gotta be a mistake somewhere.\r</language>
	</row>
	<row id="msg_0724_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I c-c-can’t stop shiverin’.\nB-but this a s-scrap. I gotta.</language>
	</row>
	<row id="msg_0724_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urrff... Ch-chatter...\nI won, I won... Where’s my blanket?\r</language>
	</row>
	<row id="msg_0724_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sh-shiver... Urf...\nMy eyelids gettin’ droopy...\r</language>
	</row>
	<row id="msg_0724_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll say goodbye now.\nScraps ALWAYS end in tears.</language>
	</row>
	<row id="msg_0724_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWEEEEH!\nMy tears of joy flow freely!\r</language>
	</row>
	<row id="msg_0724_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWEEEEH!\nMy tears of anguish flow freely!\r</language>
	</row>
	<row id="msg_0724_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How amusin’! You came here knowin’\nyou gon’ lose?</language>
	</row>
	<row id="msg_0724_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AHAHAHAH! HELLA entertainin’!\nHappy to see you again!\r</language>
	</row>
	<row id="msg_0724_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wh-what’s happenin’...?\nM-my vision turnin’ milky white...\r</language>
	</row>
	<row id="msg_0724_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Hustler am I, a new ray of hope\nfrom the land of the midnight sun.</language>
	</row>
	<row id="msg_0724_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">In the frozen falls up north I honed my\nskills. With ’em, I made you FALL.\r</language>
	</row>
	<row id="msg_0724_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your foul trickery deserves contempt.\nBut it was effective, too.\r</language>
	</row>
	<row id="msg_0724_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been thinkin’ lately... How much\nlonger I’mma be wearin’ shorts?</language>
	</row>
	<row id="msg_0724_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Will I still be in shorts as\na grown-up?\r</language>
	</row>
	<row id="msg_0724_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I grow old like this, will they call\nme somethin’ silly like “Shorts Man”?\r</language>
	</row>
	<row id="msg_0724_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s right, I’m the LEGENDARY kid in\nshorts that’s the talk of the town.</language>
	</row>
	<row id="msg_0724_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Even a Youngster in shorts like me\ncan be the stuff of legends.\r</language>
	</row>
	<row id="msg_0724_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My legend is over...\nThe shorts stay though.\r</language>
	</row>
	<row id="msg_0724_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... Um... H-wassup.\nP-pleased to meet you.</language>
	</row>
	<row id="msg_0724_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">S-s-sorry.\nI’m r-r-real n-nervous.\r</language>
	</row>
	<row id="msg_0724_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... Th-good looks.\nThat was f-fun.\r</language>
	</row>
	<row id="msg_0724_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, this place is SO passé now.\nI’m missin’ out on shoppin’.</language>
	</row>
	<row id="msg_0724_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You kinda stylish, actually.\nOh, I wish I had new clothes.\r</language>
	</row>
	<row id="msg_0724_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maybe I’ll collect Accessories for\nsome Contests... Retail therapy.\r</language>
	</row>
	<row id="msg_0724_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Exam season comin’ up, but I’m\nneck-deep in scrappin’...</language>
	</row>
	<row id="msg_0724_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mom’s finna cut me off.\nI just KNOW it...\r</language>
	</row>
	<row id="msg_0724_00494" index="494">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta keep up on BOTH my studyin’\nand my homies... Help.\r</language>
	</row>
	<row id="msg_0724_00495" index="495">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hiya, you! Slip on some glasses.\nThey’ll make you look better.</language>
	</row>
	<row id="msg_0724_00496" index="496">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t nothin’ wrong with my eyes.\nI wear glasses for the LOOKS.\r</language>
	</row>
	<row id="msg_0724_00497" index="497">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whoops! My glasses, my glasses.\nWhere’d they go?\r</language>
	</row>
	<row id="msg_0724_00498" index="498">
		<attribute name="window_context_name">used</attribute>
		<language name="English">They taught me every opponent got\na weakness. If I find yours...</language>
	</row>
	<row id="msg_0724_00499" index="499">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eheheh.\nI found your weakness.\r</language>
	</row>
	<row id="msg_0724_00500" index="500">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Did YOU find my weakness?\nIt’s losin’. That’s my weakness.\r</language>
	</row>
	<row id="msg_0724_00501" index="501">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s been SO long since my last\nscrap.</language>
	</row>
	<row id="msg_0724_00502" index="502">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know, scrappin’ is fun\nafter all.\r</language>
	</row>
	<row id="msg_0724_00503" index="503">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ is SO much fun, but...\nnot like this.\r</language>
	</row>
	<row id="msg_0724_00504" index="504">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The age of MONEY has come to homie\nscraps. I’ll teach you who’s right.</language>
	</row>
	<row id="msg_0724_00505" index="505">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You understand, don’t you?\nWhat’s right, and who’s stronger?\r</language>
	</row>
	<row id="msg_0724_00506" index="506">
		<attribute name="window_context_name">used</attribute>
		<language name="English">M-my homies! What you DO?\nWhat am I gon’ do?! Call my accountant!\r</language>
	</row>
	<row id="msg_0724_00507" index="507">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You my opponent? Oh, aight...\nTry not to disappoint me too bad.</language>
	</row>
	<row id="msg_0724_00508" index="508">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies is ALL top luxury.\nThis is what power is about.\r</language>
	</row>
	<row id="msg_0724_00509" index="509">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nyah! I don’t care! I got enough bread\nto fill a swimmin’ pool!\r</language>
	</row>
	<row id="msg_0724_00510" index="510">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You there. Yes, you.\nI’m feelin’ rather BORED.</language>
	</row>
	<row id="msg_0724_00511" index="511">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I suppose that was enjoyable for what\nit was. Good looks for it.\r</language>
	</row>
	<row id="msg_0724_00512" index="512">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You rather good.\nQuite remarkable, even.\r</language>
	</row>
	<row id="msg_0724_00513" index="513">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can sink your kind with minimal\neffort.</language>
	</row>
	<row id="msg_0724_00514" index="514">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Took the BAREST of efforts to win.\r</language>
	</row>
	<row id="msg_0724_00515" index="515">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You swamped us with no effort at all...\nRude.\r</language>
	</row>
	<row id="msg_0724_00516" index="516">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My room ALWAYS full of bugs.\nThat drives my mom WILD.</language>
	</row>
	<row id="msg_0724_00517" index="517">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanna collect more bug homies for\nmy bug appreciation station.\r</language>
	</row>
	<row id="msg_0724_00518" index="518">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugs is loose under my shirt.\nI’m startin’ to itch... AAH.\r</language>
	</row>
	<row id="msg_0724_00519" index="519">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People say I’m like a ADULT.\nWhatever could they mean?</language>
	</row>
	<row id="msg_0724_00520" index="520">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, yes, QUITE enjoyable!\nWe must do this again, surely.\r</language>
	</row>
	<row id="msg_0724_00521" index="521">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, yes! SMASHING!\nThat chilled me to my toes, it did!\r</language>
	</row>
	<row id="msg_0724_00522" index="522">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I made my choice.\nWhen I fall, it shall be FORWARD!</language>
	</row>
	<row id="msg_0724_00523" index="523">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You lack conviction.\r</language>
	</row>
	<row id="msg_0724_00524" index="524">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Thud.\n(Forward, as promised.)\r</language>
	</row>
	<row id="msg_0724_00525" index="525">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So what exactly IS a ninja,\nyou may ask.</language>
	</row>
	<row id="msg_0724_00526" index="526">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A ninja is POWERFUL.\nThat’ll do as a start.\r</language>
	</row>
	<row id="msg_0724_00527" index="527">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maybe some ninjas is weak?\nLike me?\r</language>
	</row>
	<row id="msg_0724_00528" index="528">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I once saw a lady wearin’ the SAME\noutfit as me.</language>
	</row>
	<row id="msg_0724_00529" index="529">
		<attribute name="window_context_name">used</attribute>
		<language name="English">She said, “You showin’ serious\nfashion chops.”\r</language>
	</row>
	<row id="msg_0724_00530" index="530">
		<attribute name="window_context_name">used</attribute>
		<language name="English">She said, “You kiddin’ me,\nright?” I was not.\r</language>
	</row>
	<row id="msg_0724_00531" index="531">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Would you believe inside this costume\nis a grown-up Beauty?</language>
	</row>
	<row id="msg_0724_00532" index="532">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My dream is to live as a homie one day.\nTo BECOME a homie!\r</language>
	</row>
	<row id="msg_0724_00533" index="533">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a adult, but I wanna be a homie.\nDoes that make me weird? Don’t answer.\r</language>
	</row>
	<row id="msg_0724_00534" index="534">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My profile’s ridin’ HIGH, so my\nschedule’s booked solid!</language>
	</row>
	<row id="msg_0724_00535" index="535">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh no! It’s this late already?\nI gotta check my schedule!\r</language>
	</row>
	<row id="msg_0724_00536" index="536">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Talent manager!\nDo I got time for a rematch?\r</language>
	</row>
	<row id="msg_0724_00537" index="537">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You another one of my fans? I’ll give\nyou a autograph if you lose?</language>
	</row>
	<row id="msg_0724_00538" index="538">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here’s your autograph! Cherish it!\nOh, sorry! I don’t do handshakes.\r</language>
	</row>
	<row id="msg_0724_00539" index="539">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m sorry, I was actin’ GASTLY!\nIt was hella DELCATTY of me!\r</language>
	</row>
	<row id="msg_0724_00540" index="540">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta diet.\nI gotta get out and jog.</language>
	</row>
	<row id="msg_0724_00541" index="541">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, I guess I’ll go for a quick jog\naround here... after a snack.\r</language>
	</row>
	<row id="msg_0724_00542" index="542">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your homies punch HARD.\nSee, I’m actually a boxer.\r</language>
	</row>
	<row id="msg_0724_00543" index="543">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I look to bug homies for tips on\nrunnin’ all the time.</language>
	</row>
	<row id="msg_0724_00544" index="544">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I admire the light, quick footwork\nof bug homies.\r</language>
	</row>
	<row id="msg_0724_00545" index="545">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skitter...\n(He ran away.)\r</language>
	</row>
	<row id="msg_0724_00546" index="546">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Listen, I’m BUSHED today.\nCan we do this tomorrow mornin’?</language>
	</row>
	<row id="msg_0724_00547" index="547">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, aight. You impatient.\nCouldn’t wait till tomorrow, oh no.\r</language>
	</row>
	<row id="msg_0724_00548" index="548">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s why I said tomorrow.\nI can barely stay awake. Zzz...\r</language>
	</row>
	<row id="msg_0724_00549" index="549">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Feed the homies you catch, or they\nwill flee. You see?</language>
	</row>
	<row id="msg_0724_00550" index="550">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Once a homie flees, it NEVER\ncomes back. You see?\r</language>
	</row>
	<row id="msg_0724_00551" index="551">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What I said about homies--it’s a\nparable. You see? ...You don’t see.\r</language>
	</row>
	<row id="msg_0724_00552" index="552">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I was younger, I went on digs\nchasin’ rumors of hidden treasure.</language>
	</row>
	<row id="msg_0724_00553" index="553">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Of course, there’s no such thing.\nBut it’s about chasin’ a dream.\r</language>
	</row>
	<row id="msg_0724_00554" index="554">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It sure left HUGE holes...\nIn the ground and in my bank account.\r</language>
	</row>
	<row id="msg_0724_00555" index="555">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll launch a AVALANCHE of moves!\nI’ll test the limits of your endurance!</language>
	</row>
	<row id="msg_0724_00556" index="556">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, Hustler?\nShould I try some more moves?\r</language>
	</row>
	<row id="msg_0724_00557" index="557">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s it! I’m all outta stock!\nI’d like you to leave so I can close up!\r</language>
	</row>
	<row id="msg_0724_00558" index="558">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I collect and scrap homies so I can\nbrag to my homies.</language>
	</row>
	<row id="msg_0724_00559" index="559">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t that interested in winnin’\nor losin’ to begin with.\r</language>
	</row>
	<row id="msg_0724_00560" index="560">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You won the scrap. But in terms of\nhomies, I CLEARLY win. Cope.</language>
	</row>
	<row id="msg_0724_00561" index="561">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna see my homies?\nOK, sure. Just a peek though.</language>
	</row>
	<row id="msg_0724_00562" index="562">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How’s that for CLASSY? My homies is\ntops in moves AND character.\r</language>
	</row>
	<row id="msg_0724_00563" index="563">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hold it right there!\nYou can look, but don’t TOUCH!\r</language>
	</row>
	<row id="msg_0724_00564" index="564">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock? Samba? Folk?\nI can play ANY style. It’s all good!</language>
	</row>
	<row id="msg_0724_00565" index="565">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Music and homies lift me up!\nI’m carried up to the stars!\r</language>
	</row>
	<row id="msg_0724_00566" index="566">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sigh... I’m seein’ stars...\nYou got me singin’ the blues...\r</language>
	</row>
	<row id="msg_0724_00567" index="567">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let my EXQUISITE melody ring out!\nHear my homies shout!</language>
	</row>
	<row id="msg_0724_00568" index="568">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The melody from my homies and me...\nDid it touch your heart?\r</language>
	</row>
	<row id="msg_0724_00569" index="569">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been known to throw matches, but I’ll\nNEVER throw a guitar on stage!\r</language>
	</row>
	<row id="msg_0724_00570" index="570">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m free like a BIRD!\nI feel like I could fly!</language>
	</row>
	<row id="msg_0724_00571" index="571">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s how I became a Bird Keeper.\r</language>
	</row>
	<row id="msg_0724_00572" index="572">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Like most birds, I can’t see\nhella good at night.\r</language>
	</row>
	<row id="msg_0724_00573" index="573">
		<attribute name="window_context_name">used</attribute>
		<language name="English">As a Hustler, I’m fragile as a egg.\nPlease be gentle.</language>
	</row>
	<row id="msg_0724_00574" index="574">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You think I’m gettin’ ready to\ntake flight?\r</language>
	</row>
	<row id="msg_0724_00575" index="575">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One of these days, I’ll break outta\nmy shell and beat you.\r</language>
	</row>
	<row id="msg_0724_00576" index="576">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bear witness to my display of\nMACHISMO and MANLINESS!</language>
	</row>
	<row id="msg_0724_00577" index="577">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There!\nThat’s how a REAL man lives and scraps!\r</language>
	</row>
	<row id="msg_0724_00578" index="578">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAAAAH! WAAAAH!\nMOMMY!\r</language>
	</row>
	<row id="msg_0724_00579" index="579">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got a showdown comin’ up with a\nHiker. Lemme see if I’m ready!</language>
	</row>
	<row id="msg_0724_00580" index="580">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yep, my team about ready.\nThat Hiker won’t know what hit him!\r</language>
	</row>
	<row id="msg_0724_00581" index="581">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, blast it, no!\nI can’t beat that Hiker like this!\r</language>
	</row>
	<row id="msg_0724_00582" index="582">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My showdown with a man of the sea is\ncomin’! Lemme test my team!</language>
	</row>
	<row id="msg_0724_00583" index="583">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everything went as calculated...\nBe ready for me, man of the sea!\r</language>
	</row>
	<row id="msg_0724_00584" index="584">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beatin’ the man of the sea is\nimpossible with a result this lame...\r</language>
	</row>
	<row id="msg_0724_00585" index="585">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uhho uho-uho uhho HOHOI!\nThis dance get me HYPE.</language>
	</row>
	<row id="msg_0724_00586" index="586">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uhho uho-uho uhho HOHOI!\nSO much fun, I can’t stop.\r</language>
	</row>
	<row id="msg_0724_00587" index="587">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uhho uho-uho uhho hohoi!\nI dance to hold back my tears...\r</language>
	</row>
	<row id="msg_0724_00588" index="588">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t actually the police.\nI’m a uniform collector.</language>
	</row>
	<row id="msg_0724_00589" index="589">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ as a Policeman made for\na HELLA fun scrap.\r</language>
	</row>
	<row id="msg_0724_00590" index="590">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s it for me.\nI bid you a fond farewell. No ticket.\r</language>
	</row>
	<row id="msg_0724_00591" index="591">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a Policeman. But on holidays,\nI’m a WHOLE different guy.</language>
	</row>
	<row id="msg_0724_00592" index="592">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Usually I chase bad guys as a\nPoliceman.\r</language>
	</row>
	<row id="msg_0724_00593" index="593">
		<attribute name="window_context_name">used</attribute>
		<language name="English">On my days off, I chase the waves\nand the ladies as a Swimmer.\r</language>
	</row>
	<row id="msg_0724_00594" index="594">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perseverance pays off.\nA case can turn on that.</language>
	</row>
	<row id="msg_0724_00595" index="595">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s more excitin’ when you come\nfrom behind to take the W.\r</language>
	</row>
	<row id="msg_0724_00596" index="596">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was more thrillin’ than any\nstakeout! Good looks!\r</language>
	</row>
	<row id="msg_0724_00597" index="597">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My current case can go either way.\nIt’s a coin toss.</language>
	</row>
	<row id="msg_0724_00598" index="598">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So I won this time...\nAll decided by a fickle coin...\r</language>
	</row>
	<row id="msg_0724_00599" index="599">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Best two outta three?\nPlease?\r</language>
	</row>
	<row id="msg_0724_00600" index="600">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I live in the woods.\nYou know, I’m a Camper. By choice.</language>
	</row>
	<row id="msg_0724_00601" index="601">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m workin’ on makin’ camp life more\ncomfy. I got a mini fridge.\r</language>
	</row>
	<row id="msg_0724_00602" index="602">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m SICK of campin’ in the woods...\nI want a hotel.\r</language>
	</row>
	<row id="msg_0724_00603" index="603">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, no, I can’t do this!\nI’m not built for scrappin’!</language>
	</row>
	<row id="msg_0724_00604" index="604">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, SHEESH! I won! What I do?\nYou ain’t mad, are you?\r</language>
	</row>
	<row id="msg_0724_00605" index="605">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See! I TOLD you before we started!\nScrappin’ just ain’t for me.\r</language>
	</row>
	<row id="msg_0724_00606" index="606">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hustler spotted!\nTime to get COOKIN’!</language>
	</row>
	<row id="msg_0724_00607" index="607">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap should be enjoyed like a\ntasty meal!\r</language>
	</row>
	<row id="msg_0724_00608" index="608">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ended up gettin’ COOKED!\nWell done. Like a steak.\r</language>
	</row>
	<row id="msg_0724_00609" index="609">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fweeoo-fwee-fwee-fyoo...\nI stroll into the scrap, whistlin’...</language>
	</row>
	<row id="msg_0724_00610" index="610">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Too easy! I was whistlin’ the whole\ntime.\r</language>
	</row>
	<row id="msg_0724_00611" index="611">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwee-ooo fwee-ooo fwee-ooo...\nNow it’s a ambulance siren...\r</language>
	</row>
	<row id="msg_0724_00612" index="612">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can hear it... The SCREAMIN’ of\n100,000 fans risin’ as one...</language>
	</row>
	<row id="msg_0724_00613" index="613">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RIGHT ON, everybody! You saw that!\nI dedicate my win to you!\r</language>
	</row>
	<row id="msg_0724_00614" index="614">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You SCORCHIN’...\nYou made a fan outta me.\r</language>
	</row>
	<row id="msg_0724_00615" index="615">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Number one WORLDWIDE, that’s my dream.\nWell, to start, anyway.</language>
	</row>
	<row id="msg_0724_00616" index="616">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“Number one worldwide,” don’t that\ngot a nice ring to it?\r</language>
	</row>
	<row id="msg_0724_00617" index="617">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t decide what I should be\nnumber one worldwide AT.\r</language>
	</row>
	<row id="msg_0724_00618" index="618">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t some cheap Idol!\nI’m a ACTRESS! Remember that!</language>
	</row>
	<row id="msg_0724_00619" index="619">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My career ain’t NOTHIN’ like your\ntypical Idol’s career!\r</language>
	</row>
	<row id="msg_0724_00620" index="620">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a actress...\nIt sounds so deliciously right...\r</language>
	</row>
	<row id="msg_0724_00621" index="621">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We ain’t here for a long time, so\nlet’s make it a GOOD time!</language>
	</row>
	<row id="msg_0724_00622" index="622">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks! That was SOOOO fun!\nI hope we can scrap again!\r</language>
	</row>
	<row id="msg_0724_00623" index="623">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It makes me sad sayin’ goodbye...\nPlease come see me again!\r</language>
	</row>
	<row id="msg_0724_00624" index="624">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m the Fan Club Division Manager...\nBring your best...</language>
	</row>
	<row id="msg_0724_00625" index="625">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KNEEL before the might of the\nFan Club!\r</language>
	</row>
	<row id="msg_0724_00626" index="626">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GWEH! But I did my best!\nRegrets, I have none!\r</language>
	</row>
	<row id="msg_0724_00627" index="627">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I welcome you, young Hustler.\nAllow me to show my power.</language>
	</row>
	<row id="msg_0724_00628" index="628">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Young Hustler, you got ANY idea\nwhat my power means?\r</language>
	</row>
	<row id="msg_0724_00629" index="629">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You passed me in your love of\nhomies. You the truest of fans.\r</language>
	</row>
	<row id="msg_0724_00630" index="630">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’mma try the TM the lady next door\ngave me.</language>
	</row>
	<row id="msg_0724_00631" index="631">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m impressed. That lady actually gave\nme somethin’ useful.\r</language>
	</row>
	<row id="msg_0724_00632" index="632">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, that NASTY woman! This TM is\nWORTHLESS! I’m tellin’ the HOA!\r</language>
	</row>
	<row id="msg_0724_00633" index="633">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard that! I’m old enough to be\nyour mom, but I’m still YOUNG!</language>
	</row>
	<row id="msg_0724_00634" index="634">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Look at my skin AND my homies!\nBoth firm but supple!\r</language>
	</row>
	<row id="msg_0724_00635" index="635">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t make that mistake again!\nI’m YOUNG, I tell you!\r</language>
	</row>
	<row id="msg_0724_00636" index="636">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Work or play, I’m with my homies\nALL day.</language>
	</row>
	<row id="msg_0724_00637" index="637">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Life without homies?\nI can’t picture that.\r</language>
	</row>
	<row id="msg_0724_00638" index="638">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s like I’m married to my homies.\nI ain’t married, though. Don’t ask.\r</language>
	</row>
	<row id="msg_0724_00639" index="639">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You get to be the best by workin’\nharder than everybody else.</language>
	</row>
	<row id="msg_0724_00640" index="640">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I reckon I been a hard worker.\r</language>
	</row>
	<row id="msg_0724_00641" index="641">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Work at scrappin’ over and over.\nYour star will shine one day.\r</language>
	</row>
	<row id="msg_0724_00642" index="642">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m finna get FAMOUS here so I can\nrebuild the ranch.</language>
	</row>
	<row id="msg_0724_00643" index="643">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t lose.\nIt’s for my pa and ma.\r</language>
	</row>
	<row id="msg_0724_00644" index="644">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I get famous, folks’ll pay to\nvisit my ranch... Not today.\r</language>
	</row>
	<row id="msg_0724_00645" index="645">
		<attribute name="window_context_name">used</attribute>
		<language name="English">After sundown, I live by candlelight\ntill bed.</language>
	</row>
	<row id="msg_0724_00646" index="646">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That ain’t to say we ain’t got\nelectricity on the homestead.\r</language>
	</row>
	<row id="msg_0724_00647" index="647">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Candlelight can be HELLA romantic.\nAlso a fire hazard.\r</language>
	</row>
	<row id="msg_0724_00648" index="648">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’d like to introduce you to my\ncherished partners.</language>
	</row>
	<row id="msg_0724_00649" index="649">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good, good. Good goin’, gang.\nY’all did great.\r</language>
	</row>
	<row id="msg_0724_00650" index="650">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wheeze... Wheeze...\nI’m feelin’ faint...\r</language>
	</row>
	<row id="msg_0724_00651" index="651">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t got no green thumb for Berries.\nRaisin’ homies is where I shine.</language>
	</row>
	<row id="msg_0724_00652" index="652">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can give you tips on raisin’ homies\nso they grow up TOUGH.\r</language>
	</row>
	<row id="msg_0724_00653" index="653">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Raisin’ a livin’ thing is never\na easy job...\r</language>
	</row>
	<row id="msg_0724_00654" index="654">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Homies is homies, no matter how\ntough, weak, cute, or scary.</language>
	</row>
	<row id="msg_0724_00655" index="655">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Raise homies with love, and they’ll\nreturn it.\r</language>
	</row>
	<row id="msg_0724_00656" index="656">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I think it’s the Hustler who gotta\npick up the pace here. That’s me.\r</language>
	</row>
	<row id="msg_0724_00657" index="657">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Raisin’ a homie right takes bread\nand time.</language>
	</row>
	<row id="msg_0724_00658" index="658">
		<attribute name="window_context_name">used</attribute>
		<language name="English">But it’s all worth it when the\nhomie grows up.\r</language>
	</row>
	<row id="msg_0724_00659" index="659">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To raise the ideal homie,\nI’m willin’ to work hard. And broke.\r</language>
	</row>
	<row id="msg_0724_00660" index="660">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s right, I’m TOUGH. I won’t lose.\nI don’t think losin’ is possible.</language>
	</row>
	<row id="msg_0724_00661" index="661">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yup, I’m SO tough...\nEhehe... Heeheehee...\r</language>
	</row>
	<row id="msg_0724_00662" index="662">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I lost? But, how...?\nWhat now? What do I DO?\r</language>
	</row>
	<row id="msg_0724_00663" index="663">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a Ace Hustler, so this is for\nbraggin’ rights.</language>
	</row>
	<row id="msg_0724_00664" index="664">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yup, you did good.\nNo, seriously.\r</language>
	</row>
	<row id="msg_0724_00665" index="665">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heh...\nI got a LONG way to go...\r</language>
	</row>
	<row id="msg_0724_00666" index="666">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been lookin’ forward to a scrap\nwith you!</language>
	</row>
	<row id="msg_0724_00667" index="667">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was right! You pretty decent.\nWhy not be a Ace Hustler?\r</language>
	</row>
	<row id="msg_0724_00668" index="668">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You as good as the rumors say...\nCan I get a rematch one day?\r</language>
	</row>
	<row id="msg_0724_00669" index="669">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Look at me.\nI’m what you should aspire to be.</language>
	</row>
	<row id="msg_0724_00670" index="670">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You expected anythin’ else?\r</language>
	</row>
	<row id="msg_0724_00671" index="671">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You already passed me.\nBut you can aim SO much higher.\r</language>
	</row>
	<row id="msg_0724_00672" index="672">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My WHOLE life hinges on this scrap!\n...Lose for me, pretty please?</language>
	</row>
	<row id="msg_0724_00673" index="673">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YEAH! I won!\nIt’s ALL smooth sailin’ for me now!\r</language>
	</row>
	<row id="msg_0724_00674" index="674">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wasn’t supposed to lose...\nThat’s my life derailed...\r</language>
	</row>
	<row id="msg_0724_00675" index="675">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m runnin’ a fever here.\nJust so you know.</language>
	</row>
	<row id="msg_0724_00676" index="676">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oogh, my head’s burnin’ up.\nMakes me feel more inspired.\r</language>
	</row>
	<row id="msg_0724_00677" index="677">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Like I said, I got a cold.\nI ain’t on top of my game. *cough*\r</language>
	</row>
	<row id="msg_0724_00678" index="678">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When we scrap, be HELLA careful.\nMy coat’s HELLA expensive.</language>
	</row>
	<row id="msg_0724_00679" index="679">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yikes! EEK! Watch out! You almost got\nhomie sweat on my coat!\r</language>
	</row>
	<row id="msg_0724_00680" index="680">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was worried about my coat.\nWho cares about your scrap?\r</language>
	</row>
	<row id="msg_0724_00681" index="681">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wish you’d leave.\nI don’t wanna see you lose.</language>
	</row>
	<row id="msg_0724_00682" index="682">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I TOLD you so...\nCan you leave, please?\r</language>
	</row>
	<row id="msg_0724_00683" index="683">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Listen... is bein’ tough not always\na good thing?\r</language>
	</row>
	<row id="msg_0724_00684" index="684">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whoa-whoa-whoa... Careful now!\nBalance is the KEY!</language>
	</row>
	<row id="msg_0724_00685" index="685">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whoops...! Almost went over!\nGotta be careful here...\r</language>
	</row>
	<row id="msg_0724_00686" index="686">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...WAAAAAAH...\nTHUD!\r</language>
	</row>
	<row id="msg_0724_00687" index="687">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Now don’t you worry about a thing.\nYou leave everythin’ to me, OK?</language>
	</row>
	<row id="msg_0724_00688" index="688">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you say? Fun, ayo?\nIt’d be nice if we met again.\r</language>
	</row>
	<row id="msg_0724_00689" index="689">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, I’ll be!\nYou sure got the best of me!\r</language>
	</row>
	<row id="msg_0724_00690" index="690">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I will scrap. It’s not likely I’ll lose.\nI’m tough.</language>
	</row>
	<row id="msg_0724_00691" index="691">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I win.\nI could do a dance right now.\r</language>
	</row>
	<row id="msg_0724_00692" index="692">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What is the matter?\nWhy couldn’t I win?\r</language>
	</row>
	<row id="msg_0724_00693" index="693">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mother Nature, I beg you!\nPlease, lend me strength!</language>
	</row>
	<row id="msg_0724_00694" index="694">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, Mother Nature, good looks!\nTo you, I dedicate this W!\r</language>
	</row>
	<row id="msg_0724_00695" index="695">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m sorry, Mother Nature!\nI’m sorry I let you down!\r</language>
	</row>
	<row id="msg_0724_00696" index="696">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A good Hustler takes on ALL challenges,\nno matter the opp or the rules.</language>
	</row>
	<row id="msg_0724_00697" index="697">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No Hustler is bad if they scrap the\nbest they can.\r</language>
	</row>
	<row id="msg_0724_00698" index="698">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A good Hustler don’t gloat over a W.\nThey prep for the next scrap.\r</language>
	</row>
	<row id="msg_0724_00699" index="699">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come hither, my homies!\nGet rid of this MEAN Hustler!</language>
	</row>
	<row id="msg_0724_00700" index="700">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, yes, I love you, my sweeties!\rCome here and gimme a kiss!</language>
	</row>
	<row id="msg_0724_00701" index="701">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How COULD you?!\nYou hurt my sweet lil ones!\r</language>
	</row>
	<row id="msg_0724_00702" index="702">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m fine with practice, but I fold\nwhen it counts.</language>
	</row>
	<row id="msg_0724_00703" index="703">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I feel SICK from tension!\nI’d rather be home practicin’!\r</language>
	</row>
	<row id="msg_0724_00704" index="704">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If it was practice, I’d be the champ\nwithout a doubt.\r</language>
	</row>
	<row id="msg_0724_00705" index="705">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HI-YAH! HAH! HAH!\nOne more! HAH! HAH!</language>
	</row>
	<row id="msg_0724_00706" index="706">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BOO-YAH!\r</language>
	</row>
	<row id="msg_0724_00707" index="707">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi-yah! ...No, wait!\nNo!\r</language>
	</row>
	<row id="msg_0724_00708" index="708">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wanna?</language>
	</row>
	<row id="msg_0724_00709" index="709">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heh...\r</language>
	</row>
	<row id="msg_0724_00710" index="710">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You beat me?\nWhere’s your dojo at?\r</language>
	</row>
	<row id="msg_0724_00711" index="711">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come OOOON! C’mon, c’mon!\nAyo! Ayo! C’mon, AYO!</language>
	</row>
	<row id="msg_0724_00712" index="712">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, YESSSSS!\r</language>
	</row>
	<row id="msg_0724_00713" index="713">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, NOOOOOO!\r</language>
	</row>
	<row id="msg_0724_00714" index="714">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your eyes is clear, no doubt.\nThis match gon’ be entertainin’...</language>
	</row>
	<row id="msg_0724_00715" index="715">
		<attribute name="window_context_name">used</attribute>
		<language name="English">From the bottom of my heart, I look\nforward to your return.\r</language>
	</row>
	<row id="msg_0724_00716" index="716">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whew... A most entertainin’ match.\nI hope you grant me a rematch.\r</language>
	</row>
	<row id="msg_0724_00717" index="717">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You need to be taught what wisdom\nof age means in a scrap!</language>
	</row>
	<row id="msg_0724_00718" index="718">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll have you know no child can hope\nto beat me!\r</language>
	</row>
	<row id="msg_0724_00719" index="719">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That did NOT happen! Unfair!\nI demand a rematch RIGHT NOW!\r</language>
	</row>
	<row id="msg_0724_00720" index="720">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m feelin’ CRANKY today!\nHelp me get my mind off it!</language>
	</row>
	<row id="msg_0724_00721" index="721">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whew... A scrap is the perfect\nstress reliever!\r</language>
	</row>
	<row id="msg_0724_00722" index="722">
		<attribute name="window_context_name">used</attribute>
		<language name="English">EEEEEEEEEH!\nYou pushed me straight to FURIOUS!\r</language>
	</row>
	<row id="msg_0724_00723" index="723">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cue scrap music, please!\nI wanna trumpet my victory!</language>
	</row>
	<row id="msg_0724_00724" index="724">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE the scrap music.\nIt set my heart racin’.\r</language>
	</row>
	<row id="msg_0724_00725" index="725">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fine, that’ll do.\nBack to the regular theme music.\r</language>
	</row>
	<row id="msg_0724_00726" index="726">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When you been a Hustler as long as me,\nlet’s just say you see a LOT.</language>
	</row>
	<row id="msg_0724_00727" index="727">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Things like this happen.\nDon’t let it get you down.\r</language>
	</row>
	<row id="msg_0724_00728" index="728">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People and homies is all different.\nAin’t that what make it beautiful?</language>
	</row>
	<row id="msg_0724_00729" index="729">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My big brother told me to go for the\nEYES! Aim for the EYES!</language>
	</row>
	<row id="msg_0724_00730" index="730">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I DID it, big brother!\r</language>
	</row>
	<row id="msg_0724_00731" index="731">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My big brother told me to wreck the\nother Hustler’s accuracy! He lied\fAGAIN!\r</language>
	</row>
	<row id="msg_0724_00732" index="732">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hear my homies callin’...\nThey cravin’ a scrap...</language>
	</row>
	<row id="msg_0724_00733" index="733">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hear my homies callin’...\nThey call for your return...\r</language>
	</row>
	<row id="msg_0724_00734" index="734">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hear my homies callin’...\nThey tellin’ me how fun it was...\r</language>
	</row>
	<row id="msg_0724_00735" index="735">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Behind you, I see light.\nWhat could it mean?</language>
	</row>
	<row id="msg_0724_00736" index="736">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I thought I saw a aura of invincibility.\nI musta been wrong.\r</language>
	</row>
	<row id="msg_0724_00737" index="737">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Now I see...\nYou glow with the light of victory...\r</language>
	</row>
	<row id="msg_0724_00738" index="738">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll deliver your defeat ELEGANTLY\nand SPEEDILY.</language>
	</row>
	<row id="msg_0724_00739" index="739">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for your patience!\r</language>
	</row>
	<row id="msg_0724_00740" index="740">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m SO terribly sorry.\nI got the defeat meant for you.\r</language>
	</row>
	<row id="msg_0724_00741" index="741">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Great, ANOTHER tough-lookin’ Hustler.\nThe fun never ends for me.</language>
	</row>
	<row id="msg_0724_00742" index="742">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BLEAH, that was too close.\nNothin’ ever come easy for me.\r</language>
	</row>
	<row id="msg_0724_00743" index="743">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah, see? I KNEW I’d lose.\nIf only that move landed...\r</language>
	</row>
	<row id="msg_0724_00744" index="744">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everybody got too much to say about\nhomies! If it’s fun, that’s enough!</language>
	</row>
	<row id="msg_0724_00745" index="745">
		<attribute name="window_context_name">used</attribute>
		<language name="English">’Scuse me, but you OK?\nMaybe you a lil too tired?\r</language>
	</row>
	<row id="msg_0724_00746" index="746">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Get too caught up in winnin’ and losin’\nand you’ll burn yourself out.\r</language>
	</row>
	<row id="msg_0724_00747" index="747">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t you the CUTEST guest! Expect\nthe BEST service from me!</language>
	</row>
	<row id="msg_0724_00748" index="748">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, was you impressed by the\nlevel of service?\r</language>
	</row>
	<row id="msg_0724_00749" index="749">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, wait, please!\nI ain’t done servin’ you!\r</language>
	</row>
	<row id="msg_0724_00750" index="750">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I keep a journal on every Hustler that\ncome through here. It’s a burn book.</language>
	</row>
	<row id="msg_0724_00751" index="751">
		<attribute name="window_context_name">used</attribute>
		<language name="English">In this big world, how many Hustlers\ngon’ cross my path? Too many.\r</language>
	</row>
	<row id="msg_0724_00752" index="752">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Every link-up end in a partin’.\nThat’s why I keep the burn book.\r</language>
	</row>
	<row id="msg_0724_00753" index="753">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I waited my WHOLE life for somebody like\nyou. I’m never lettin’ you go.</language>
	</row>
	<row id="msg_0724_00754" index="754">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was a ploy. I got them lines\noutta some romance movie.\r</language>
	</row>
	<row id="msg_0724_00755" index="755">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Go on, don’t lemme hold you back.\nGo be happy. ...Text me though.\r</language>
	</row>
	<row id="msg_0724_00756" index="756">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gimme a interview if you win?\nIt’s for my podcast.</language>
	</row>
	<row id="msg_0724_00757" index="757">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You made my job too easy.\nLock in, youngblood.\r</language>
	</row>
	<row id="msg_0724_00758" index="758">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your feelings right now, in one word!\nYell it in the mic! Like and subscribe!\r</language>
	</row>
	<row id="msg_0724_00759" index="759">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m on a diet...\nI’m SO starvin’...</language>
	</row>
	<row id="msg_0724_00760" index="760">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m happy, but if I get hype, I get\nhungry. No thanks...\r</language>
	</row>
	<row id="msg_0724_00761" index="761">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ohh...\nYour homies look DELICIOUS...\r</language>
	</row>
	<row id="msg_0724_00762" index="762">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lemme make it clear: I’m tougher\nthan you can STAND!</language>
	</row>
	<row id="msg_0724_00763" index="763">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See?\nI wasn’t cappin’!\r</language>
	</row>
	<row id="msg_0724_00764" index="764">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who ARE you, deadass?!\r</language>
	</row>
	<row id="msg_0724_00765" index="765">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Move! Outta the way!\nWait! Don’t go! We gotta scrap!</language>
	</row>
	<row id="msg_0724_00766" index="766">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’mon, shift up a gear!\nKeep up with me!\r</language>
	</row>
	<row id="msg_0724_00767" index="767">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, move! Outta the way!\nLet this L-taker RUN!\r</language>
	</row>
	<row id="msg_0724_00768" index="768">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drive safe, scrap safer.\nThat’s my motto. Seatbelt on.</language>
	</row>
	<row id="msg_0724_00769" index="769">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Be patient in a scrap.\nThe W come eventually.\r</language>
	</row>
	<row id="msg_0724_00770" index="770">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’mma keep my own pace.\nI’ll catch up one day. Speed limit.\r</language>
	</row>
	<row id="msg_0724_00771" index="771">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I only got this Bike to look fly for\nthe guys. I can’t actually ride it.</language>
	</row>
	<row id="msg_0724_00772" index="772">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gettin’ this Bike here was a PAIN.\nI pushed it the WHOLE way!\r</language>
	</row>
	<row id="msg_0724_00773" index="773">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I only care about lookin’ good.\nI don’t practice. At all.\r</language>
	</row>
	<row id="msg_0724_00774" index="774">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t lookin’ for excitement.\nI don’t need NO drama.</language>
	</row>
	<row id="msg_0724_00775" index="775">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap is all the drama I need.\r</language>
	</row>
	<row id="msg_0724_00776" index="776">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I just realized I ain’t built\nfor this scary job. I quit.\r</language>
	</row>
	<row id="msg_0724_00777" index="777">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I scrap my way.\nYou scrap yours.</language>
	</row>
	<row id="msg_0724_00778" index="778">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People is people.\nI’mma do me.\r</language>
	</row>
	<row id="msg_0724_00779" index="779">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People is people.\nYou do you.\r</language>
	</row>
	<row id="msg_0724_00780" index="780">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today I got a SPECIAL treat for all\nmy fans! Merch drop!</language>
	</row>
	<row id="msg_0724_00781" index="781">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks!\nI love the support! Stream my album!\r</language>
	</row>
	<row id="msg_0724_00782" index="782">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You REALLY one of my fans?\nName three of my songs. Exactly.\r</language>
	</row>
	<row id="msg_0724_00783" index="783">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m burnt out bein’ a Idol.\nI wanna go home to the country...</language>
	</row>
	<row id="msg_0724_00784" index="784">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t quit now!\nKids dream of bein’ me!\r</language>
	</row>
	<row id="msg_0724_00785" index="785">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I miss hearin’ my mama’s voice...\nI’m callin’ her after this.\r</language>
	</row>
	<row id="msg_0724_00786" index="786">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m one of a kind.\nThat’s what I’m sayin’.</language>
	</row>
	<row id="msg_0724_00787" index="787">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I keep it REAL.\nThat’s what make me tough.\r</language>
	</row>
	<row id="msg_0724_00788" index="788">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I kept it real, but you won anyway.\nYour real was realer.\r</language>
	</row>
	<row id="msg_0724_00789" index="789">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi! You my next opp?\nLet’s keep it clean and fair!</language>
	</row>
	<row id="msg_0724_00790" index="790">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Feels GREAT goin’ all out with no\ndirty tricks.\r</language>
	</row>
	<row id="msg_0724_00791" index="791">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was a AWESOME workout!\nWe gotta run it back sometime!\r</language>
	</row>
	<row id="msg_0724_00792" index="792">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My needs is simple.\nFishin’ and Moomoo Milk. That’s it.</language>
	</row>
	<row id="msg_0724_00793" index="793">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Winnin’ or losin’ ain’t somethin’\nI pay attention to.\r</language>
	</row>
	<row id="msg_0724_00794" index="794">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I could use a Moomoo Milk right\nabout now. Two percent.\r</language>
	</row>
	<row id="msg_0724_00795" index="795">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You! Peep the homie I fished up\nthe other day.</language>
	</row>
	<row id="msg_0724_00796" index="796">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can tell you impressed. Took me\nI don’t KNOW how long to land him.\r</language>
	</row>
	<row id="msg_0724_00797" index="797">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tip: when a old head is braggin’,\nact interested. It’s free.\r</language>
	</row>
	<row id="msg_0724_00798" index="798">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You a Hustler.\nLet your homies do the talkin’.</language>
	</row>
	<row id="msg_0724_00799" index="799">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where your SPIRIT at?\nThat ain’t speak to me at all.\r</language>
	</row>
	<row id="msg_0724_00800" index="800">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Great! GREAT!\nYour feelings came through!\r</language>
	</row>
	<row id="msg_0724_00801" index="801">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here come your prey!\nGET ’EM! Chaaaarge!</language>
	</row>
	<row id="msg_0724_00802" index="802">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GAAHAHAHA!\nThat’s it! Good job, gang!\r</language>
	</row>
	<row id="msg_0724_00803" index="803">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We outmatched!\nFall back, guys! RUN!\r</language>
	</row>
	<row id="msg_0724_00804" index="804">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bring it on!\nOoooh! Haaah!</language>
	</row>
	<row id="msg_0724_00805" index="805">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks, foreal!\r</language>
	</row>
	<row id="msg_0724_00806" index="806">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for havin’ me!\r</language>
	</row>
	<row id="msg_0724_00807" index="807">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The mountains got me CAPTIVATED.\nThey my whole life!</language>
	</row>
	<row id="msg_0724_00808" index="808">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The mountains mean more to me\nthan ANY scrap, no matter how fun!\r</language>
	</row>
	<row id="msg_0724_00809" index="809">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You nice, but I can’t wait to get\nback to the mountains. No signal.\r</language>
	</row>
	<row id="msg_0724_00810" index="810">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We finna hammer you, kid.\nDon’t freeze up and close your eyes.</language>
	</row>
	<row id="msg_0724_00811" index="811">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I like how you still mean-muggin’\nafter losin’. Good attitude, kid.\r</language>
	</row>
	<row id="msg_0724_00812" index="812">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Deadass, I ain’t let up one bit just\n’cause you a kid.\r</language>
	</row>
	<row id="msg_0724_00813" index="813">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I scrap all over the globe.\nI’m a WORLDWIDE bad boy!</language>
	</row>
	<row id="msg_0724_00814" index="814">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t lose at scrappin’.\nI can’t get over how cold I’m!\r</language>
	</row>
	<row id="msg_0724_00815" index="815">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m hittin’ the road after that L.\nBye to the old me!\r</language>
	</row>
	<row id="msg_0724_00816" index="816">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’, I’m good at.\nMusic? Forget it.</language>
	</row>
	<row id="msg_0724_00817" index="817">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ is cool, but I wish I could\nmake beats too.\r</language>
	</row>
	<row id="msg_0724_00818" index="818">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Music or homies...\nIt’s a tough choice. Homies don’t pay.\r</language>
	</row>
	<row id="msg_0724_00819" index="819">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I made a TRACK usin’ homie cries.\nI need you to hear it.</language>
	</row>
	<row id="msg_0724_00820" index="820">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Graaah wagyaaah! Wagyaaaah! Chu! Chu!\nGyaroooh-gah! (That’s the hook.)\r</language>
	</row>
	<row id="msg_0724_00821" index="821">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giiyaaaah! Drundundun!\nGaroo-gah! Wawawaaah! (Bridge.)\r</language>
	</row>
	<row id="msg_0724_00822" index="822">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m bored of collectin’ and hoardin’.\nI’m gettin’ rid of EVERYTHING.</language>
	</row>
	<row id="msg_0724_00823" index="823">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s nothin’ I want no more.\nMaybe I’ll become a clown...</language>
	</row>
	<row id="msg_0724_00824" index="824">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I threw the match for a start.\nFeels nice bein’ unburdened.</language>
	</row>
	<row id="msg_0724_00825" index="825">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, hold up!\nI got a text!</language>
	</row>
	<row id="msg_0724_00826" index="826">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ticka-ticka-ticka... Ticka-tick...\nHuh? It’s over already?\r</language>
	</row>
	<row id="msg_0724_00827" index="827">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, STOP!\nNo peekin’ at my texts! It’s my ex!\r</language>
	</row>
	<row id="msg_0724_00828" index="828">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s no POINT to this scrap!\nHomies should be about LOVE!</language>
	</row>
	<row id="msg_0724_00829" index="829">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ leave me empty.\nHug your homies and show love!\r</language>
	</row>
	<row id="msg_0724_00830" index="830">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ create NOTHIN’.\nHug your homies and show love!\r</language>
	</row>
	<row id="msg_0724_00831" index="831">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You challengin’ ME? ...You.\nKids these days...</language>
	</row>
	<row id="msg_0724_00832" index="832">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Now run on home and help your\nmama with the chores!\r</language>
	</row>
	<row id="msg_0724_00833" index="833">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo... if you think playtime last\nforever, you gon’ end up like me.\r</language>
	</row>
	<row id="msg_0724_00834" index="834">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you gon’ counter my\nUNSTOPPABLE logic?</language>
	</row>
	<row id="msg_0724_00835" index="835">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everything went to calculation...\nA complete W.\r</language>
	</row>
	<row id="msg_0724_00836" index="836">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You outcalculated me.\nI’m incredulous. Look it up.\r</language>
	</row>
	<row id="msg_0724_00837" index="837">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been holed up in the lab.\nMy shoulders all knotted up.</language>
	</row>
	<row id="msg_0724_00838" index="838">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What a refreshin’ break!\nI feel loose now.\r</language>
	</row>
	<row id="msg_0724_00839" index="839">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Me and my homies need to go outside\nand touch grass more.\r</language>
	</row>
	<row id="msg_0724_00840" index="840">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm... So young...\nI might gotta go easy...</language>
	</row>
	<row id="msg_0724_00841" index="841">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You SO depressin’ly young...\nIt’s fine. You may go.\r</language>
	</row>
	<row id="msg_0724_00842" index="842">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Think about the loser’s feelin’s.\nThat’s where y’all young folks fail...\r</language>
	</row>
	<row id="msg_0724_00843" index="843">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You see a old man, yes?\nDon’t get fooled by how I look.</language>
	</row>
	<row id="msg_0724_00844" index="844">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I find it NASTY to lose to any\nyoung Hustler.\r</language>
	</row>
	<row id="msg_0724_00845" index="845">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got fooled by your youth.\nFoolish, foolish me...\r</language>
	</row>
	<row id="msg_0724_00846" index="846">
		<attribute name="window_context_name">used</attribute>
		<language name="English">As a Worker, my job is to build AND\ndemolish. Mostly demolish.</language>
	</row>
	<row id="msg_0724_00847" index="847">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why don’t you become a Worker too?\nIt’s fun. Dental’s good.\r</language>
	</row>
	<row id="msg_0724_00848" index="848">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buildin’ is harder than demolishin’,\nbut it’s more satisfyin’.\r</language>
	</row>
	<row id="msg_0724_00849" index="849">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You and your homies?\nI’ll clean up on you EASY.</language>
	</row>
	<row id="msg_0724_00850" index="850">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, well, how pathetic was that.\nTake your passengers and go home.\r</language>
	</row>
	<row id="msg_0724_00851" index="851">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gwaah... So heavy...\nMy guys buckled under the load.\r</language>
	</row>
	<row id="msg_0724_00852" index="852">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elite athleticism and a GREAT sense\nof humor. That’s a CLOWN!</language>
	</row>
	<row id="msg_0724_00853" index="853">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clownin’ is a job of GREATNESS.\nOnly the chosen become one!\r</language>
	</row>
	<row id="msg_0724_00854" index="854">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laughin’ off a L is another\nrequirement for a clown!\r</language>
	</row>
	<row id="msg_0724_00855" index="855">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laugh with the face, cry with the\nheart. That’s the clown life.</language>
	</row>
	<row id="msg_0724_00856" index="856">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AHAHAHAHAHA!\r</language>
	</row>
	<row id="msg_0724_00857" index="857">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gah! ...AHAHAHAHA!\n(He’s cryin’ inside.)\r</language>
	</row>
	<row id="msg_0724_00858" index="858">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oi, listen! I’m a Cop, sure,\nbut a Hustler BEFORE that!</language>
	</row>
	<row id="msg_0724_00859" index="859">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What?\nA Cop can’t lose his temper?\r</language>
	</row>
	<row id="msg_0724_00860" index="860">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah, I’m a Cop, but I got dreams and\naspirations, and, and... *sniffle*\r</language>
	</row>
	<row id="msg_0724_00861" index="861">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hands UP! Where I can see ’em!\nY’all ALL under arrest!</language>
	</row>
	<row id="msg_0724_00862" index="862">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Case CLOSED!\r</language>
	</row>
	<row id="msg_0724_00863" index="863">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This a gross miscarriage of justice!\nI’m callin’ my union!\r</language>
	</row>
	<row id="msg_0724_00864" index="864">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll have you know I’m a\nInternet detective.</language>
	</row>
	<row id="msg_0724_00865" index="865">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My powers of observation and\nlogic PREVAILED! Smash that like!\r</language>
	</row>
	<row id="msg_0724_00866" index="866">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Think you outsmarted me?\nMaybe this was a STING operation!\r</language>
	</row>
	<row id="msg_0724_00867" index="867">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wherever, whenever, whoever.\nThat’s my motto!</language>
	</row>
	<row id="msg_0724_00868" index="868">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When, where, or who...\nDon’t matter at all to me.\r</language>
	</row>
	<row id="msg_0724_00869" index="869">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAHAHA! This is GREAT!\nI wanna keep this goin’!\r</language>
	</row>
	<row id="msg_0724_00870" index="870">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The loser gotta do a STUNKY\nimpression, OK?</language>
	</row>
	<row id="msg_0724_00871" index="871">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giggle, you lose.\nLemme see that STUNKY impression!\r</language>
	</row>
	<row id="msg_0724_00872" index="872">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, here’s my STUNKY impression!\nThree, two, one... *pfffft*\r</language>
	</row>
	<row id="msg_0724_00873" index="873">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A good breeze just picked up...\nThis is good! I can win this!</language>
	</row>
	<row id="msg_0724_00874" index="874">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The tailwind put us over the top!\n...As they say!\r</language>
	</row>
	<row id="msg_0724_00875" index="875">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The headwind worked against us!\n...As they say!\r</language>
	</row>
	<row id="msg_0724_00876" index="876">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I always got my parasol up, but\nI actually LIKE sunny days.</language>
	</row>
	<row id="msg_0724_00877" index="877">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hope it’s sunny tomorrow...\r</language>
	</row>
	<row id="msg_0724_00878" index="878">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The heavy downpour in my heart...\nWhen will it EVER stop...?\r</language>
	</row>
	<row id="msg_0724_00879" index="879">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My, you eager to go. I better\nturn the tension up too!</language>
	</row>
	<row id="msg_0724_00880" index="880">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was HELLA fun!\nI’d love to see you again!\r</language>
	</row>
	<row id="msg_0724_00881" index="881">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You so full of energy!\nNow I’m energized too!\r</language>
	</row>
	<row id="msg_0724_00882" index="882">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How much longer I gotta wait for a\nHustler that’s actually good?</language>
	</row>
	<row id="msg_0724_00883" index="883">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m SO bored of the weak competition.\nMaybe I’ll just retire.\r</language>
	</row>
	<row id="msg_0724_00884" index="884">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, wassup there.\nNow YOU a lil special.\r</language>
	</row>
	<row id="msg_0724_00885" index="885">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My ladylike charm don’t mean a thing\nto a lil kid...</language>
	</row>
	<row id="msg_0724_00886" index="886">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was too close for comfort!\nDon’t sleep on nobody.\r</language>
	</row>
	<row id="msg_0724_00887" index="887">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ fair and square don’t\nappeal to me. I’d rather WIN.\r</language>
	</row>
	<row id="msg_0724_00888" index="888">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Like everythin’ else, people got likes\nand dislikes when it come to smells.</language>
	</row>
	<row id="msg_0724_00889" index="889">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE how homies smell after a\nscrap.\r</language>
	</row>
	<row id="msg_0724_00890" index="890">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I get a lil thrill catchin’ a whiff of\nintense effort after a scrap. Musk.\r</language>
	</row>
	<row id="msg_0724_00891" index="891">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sniff, sniff... YES! Here it come!\nAROMA POWER!</language>
	</row>
	<row id="msg_0724_00892" index="892">
		<attribute name="window_context_name">used</attribute>
		<language name="English">With aroma power, I’m invincible!\r</language>
	</row>
	<row id="msg_0724_00893" index="893">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fizzle...\nI’m outta aroma power... Need cologne.\r</language>
	</row>
	<row id="msg_0724_00894" index="894">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Turn, step, turn, turn... I’ll practice\nmy dance steps while we scrap!</language>
	</row>
	<row id="msg_0724_00895" index="895">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I dance with PASSION and PRECISION.\nWhere the weakness at?\r</language>
	</row>
	<row id="msg_0724_00896" index="896">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You throwin’ off my rhythm!\nMy whole routine RUINED!\r</language>
	</row>
	<row id="msg_0724_00897" index="897">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m always ready for the cameras.\nCome at me at your own pace.</language>
	</row>
	<row id="msg_0724_00898" index="898">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s why people call me the\nPERFECT Idol.\r</language>
	</row>
	<row id="msg_0724_00899" index="899">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t know losin’ felt this bad.\nThis a first for me.\r</language>
	</row>
