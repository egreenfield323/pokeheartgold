	<row id="msg_0724_00916" index="916">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, BEAUTIFUL! That was fire!\nCome back anytime!\r</language>
	</row>
	<row id="msg_0724_00917" index="917">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got NO problem losin’ to a\nspectacular Hustler like you!\r</language>
	</row>
	<row id="msg_0724_00918" index="918">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXX</language>
	</row>
	<row id="msg_0724_00919" index="919">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, BEAUTIFUL! That was fire!\nCome back anytime!\r</language>
	</row>
	<row id="msg_0724_00920" index="920">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got NO problem losin’ to a\nspectacular Hustler like you!\r</language>
	</row>
	<row id="msg_0724_00921" index="921">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What homies you puttin’ on stage?\nI can’t WAIT!</language>
	</row>
	<row id="msg_0724_00922" index="922">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was a MOST enjoyable time!\nGood looks! Come again, please.\r</language>
	</row>
	<row id="msg_0724_00923" index="923">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ohh... I HATE how fun times end\nso quick.\r</language>
	</row>
	<row id="msg_0724_00924" index="924">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What homies you showin’ off\nthis time?\fI can’t WAIT!</language>
	</row>
	<row id="msg_0724_00925" index="925">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How WONDERFUL that was!\nGood looks! Come again, please.\r</language>
	</row>
	<row id="msg_0724_00926" index="926">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s so sad how the realest fun\nonly last a moment.\r</language>
	</row>
	<row id="msg_0724_00927" index="927">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t matter what you throw at me.\nI ALWAYS win.\rMy investigative and analytical system\nis TRULY amazin’.</language>
	</row>
	<row id="msg_0724_00928" index="928">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See?\nJust as analyzed.\r</language>
	</row>
	<row id="msg_0724_00929" index="929">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHOA!\nYou sure showed me! Recalculatin’...\r</language>
	</row>
	<row id="msg_0724_00930" index="930">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t matter what you throw at me.\nI ALWAYS win.\rI’ll stake my investigative and\nanalytical system on it!</language>
	</row>
	<row id="msg_0724_00931" index="931">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See?\nJust as analyzed.\r</language>
	</row>
	<row id="msg_0724_00932" index="932">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHOA!\nYou sure showed me! Recalculatin’...\r</language>
	</row>
	<row id="msg_0724_00933" index="933">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Always be smilin’!\nLuck come to those who happy!\rThat’s why I keep a BIG smile and\nbelieve in my homies when I scrap.</language>
	</row>
	<row id="msg_0724_00934" index="934">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You VERY good!\nI had a LOT of fun!\r</language>
	</row>
	<row id="msg_0724_00935" index="935">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You so hella, VERY good!\nMy homies had a good time too!\r</language>
	</row>
	<row id="msg_0724_00936" index="936">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whenever I scrap somebody tough,\nI smile. I can’t help it!\rHow ’bout you? What you do?\nYou laugh? Cry? Get mad?</language>
	</row>
	<row id="msg_0724_00937" index="937">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Win or lose, whenever I scrap\nsomebody dope, I’m happy!\r</language>
	</row>
	<row id="msg_0724_00938" index="938">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ a dope Hustler is always\na happy occasion!\r</language>
	</row>
	<row id="msg_0724_00939" index="939">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hella well...\nShall we begin?</language>
	</row>
	<row id="msg_0724_00940" index="940">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, a MOST valiant effort.\rThough I was lucky enough to win this\ntime, the next time...\r</language>
	</row>
	<row id="msg_0724_00941" index="941">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies could not be faulted in any\nway, shape, or form.\rMy hat’s off to you.\r</language>
	</row>
	<row id="msg_0724_00942" index="942">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This for Lady Caitlin’s sake.\nI’m afraid I gotta go ALL out.</language>
	</row>
	<row id="msg_0724_00943" index="943">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, a MOST valiant effort.\rThough I was lucky enough to win this\ntime, the next time...\r</language>
	</row>
	<row id="msg_0724_00944" index="944">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your skills is superlative as ever!\nMy admiration knows no bounds.\r</language>
	</row>
</body>
