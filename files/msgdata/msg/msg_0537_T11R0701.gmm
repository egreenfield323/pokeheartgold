<?xml version="1.0"?>
<body language="English">
	<row id="msg_0537_T11R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome. This Silph Co.’s head office.\nNo Feds allowed. We learned our lesson.</language>
	</row>
	<row id="msg_0537_T11R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you! The elevator over there\nBROKE.\rSomethin’ wrong with the electricity.\nIt shocked the CEO. Twice.\rMy bad you wasted a trip, so here’s a\ngift!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s Silph Co.’s NEWEST product.\nIt ain’t for sale nowhere yet.\fYou got a exclusive. Don’t post it.</language>
	</row>
	<row id="msg_0537_T11R0701_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This elevator broke.\rIt might shock you. Stay AWAY.\nIt ate a intern.</language>
	</row>
	<row id="msg_0537_T11R0701_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0537_T11R0701_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0537_T11R0701_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0537_T11R0701_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: We meet again!\nYou ever been to Hoenn?\rIt’s so beautiful, with the\nclearest ocean you ever seen.\rYou should visit sometime.\fAyo!\rWhy don’t we trade homies?\rI been lookin’ for a FORRETRESS.\nI can trade my BELDUM for it. {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You gon’ trade FORRETRESS\nfor my BELDUM? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Aight, let’s trade!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: That’s too bad.</language>
	</row>
	<row id="msg_0537_T11R0701_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You tellin’ me you think\nthat’s a FORRETRESS?</language>
	</row>
	<row id="msg_0537_T11R0701_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You don’t see FORRETRESS in\nHoenn.\rFirst time I ever seen one for real.\nGood looks!\rOh, look at the time. I gotta go.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: This homie seem to like you a\nLOT. You like Steel-type homies?\rI KNEW it. That TEXTURE!\rThe hard, shiny bodies! Only Steel\ntypes got that!\rThe lonely, noble vibe you feel through\nthat rugged body, almost pushin’ you\faway when you hug it... nothin’ come\fclose to BELDUM...\rLong story short, my METAGROSS is\nSTRONG and HARD!\r... Oh, I got carried away. AGAIN.\rIt was a pleasure. Bye!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup... You breakin’ up...\fIt depend on my dad’s mood. He own\fthe phone company.\rI see... I’ll be on my way. See you\nsoon.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You...\nI remember your eyes.\rWhen I see a Hustler with eyes\nthat shine, I never forget.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You got a Pokédex!\nSo you searchin’ for homies too.\fLemme see...\rI think I can help you out.\rSay you got stones in\nfront of you.\fWhich color you pick? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GREEN STONE</language>
	</row>
	<row id="msg_0537_T11R0701_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RED STONE</language>
	</row>
	<row id="msg_0537_T11R0701_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BLUE STONE</language>
	</row>
	<row id="msg_0537_T11R0701_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You picked right!\nI’ma give you {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} got\nthe {STRVAR_1 0, 1, 0} from Steven!</language>
	</row>
	<row id="msg_0537_T11R0701_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Take care of it.\nYou carin’ for it gon’ make me\fhella happy.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: I see...\nFor the choice you made,\fI wanna give you this homie.\rBut your crew full.\rWhy don’t you hit the PC to make\nsome room? I’ll wait here.</language>
	</row>
	<row id="msg_0537_T11R0701_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: I’ma ask again.\nWhich color you pick? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wanna give a nickname\nto {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You named it GREAT!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">QUIT</language>
	</row>
	<row id="msg_0537_T11R0701_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: You real careful.\rYou dodgin’ any chance somebody\nmight trick you?\fYou smarter than I thought.</language>
	</row>
	<row id="msg_0537_T11R0701_00029" index="29">
