<?xml version="1.0"?>
<body language="English">
	<row id="msg_0262_P01R0306_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see. So you playin’ hide-and-seek\nwith my granddaughter.\rAs long as she on the ship, I ain’t\nworried. Ain’t nowhere to go but the\focean.</language>
	</row>
	<row id="msg_0262_P01R0306_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, wassup... My granddaughter still\nmissin’.\rShe got MAD energy. She prob’ly\nbotherin’ somebody. Or the engine.</language>
	</row>
	<row id="msg_0262_P01R0306_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grandpa, here I’m!\rI was playin’ hide-and-seek\nwith this guy!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grandpa, here I’m!\rI was playin’ hide-and-seek\nwith this girl!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, was it?\nYou kept my granddaughter busy.\rI ain’t had peace in YEARS. That was\nthe best hour of my life.\rTake this. You earned it.\r</language>
	</row>
	<row id="msg_0262_P01R0306_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, was it?\nYou kept my granddaughter busy.\rI ain’t had peace in YEARS. That was\nthe best hour of my life.\rTake this. You earned it.\r</language>
	</row>
	<row id="msg_0262_P01R0306_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\njust pulled up to Vermilion City.</language>
	</row>
	<row id="msg_0262_P01R0306_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We travelin’ around the world.\nSpendin’ my retirement. All of it.\fShe chose this. I’m along for the ride.</language>
	</row>
	<row id="msg_0262_P01R0306_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I had SO much fun!</language>
	</row>
</body>
