<?xml version="1.0"?>
<body language="English">
	<row id="msg_0257_P01R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the S.S. Aqua!\rYour Ticket is...right there.\nC’mon through.\r</language>
	</row>
	<row id="msg_0257_P01R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Runnin’ a ship every day WEAR you out!\nIt ain’t runnin’ today. I’m tired.\rIt leave for Olivine on Wednesdays and\nSundays! Weather permittin’! Mood\fpermittin’!</language>
	</row>
	<row id="msg_0257_P01R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the S.S. Aqua!\rYour Ticket is...right there.\nC’mon through.</language>
	</row>
	<row id="msg_0257_P01R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You came from Johto?\rI’m JEALOUS! I heard mad rare homies\nlive there. And the food cheaper.</language>
	</row>
</body>
