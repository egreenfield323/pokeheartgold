<?xml version="1.0"?>
<body language="English">
	<row id="msg_0360_R22_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Big League\nVictory Road Entrance</language>
	</row>
	<row id="msg_0360_R22_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Looks like CELEBI made you\ntravel through time...\fto the past!\r</language>
	</row>
	<row id="msg_0360_R22_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: You told me...\nyou was number one in the world!\rYou just gon’ quit?\rWhat you finna do now?\r</language>
	</row>
	<row id="msg_0360_R22_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: What part of you was\nnumber one?\rAll them Feds, and you got beat\nby a lil KID!\r</language>
	</row>
	<row id="msg_0360_R22_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: I don’t understand you!\rYou don’t make no sense!\r</language>
	</row>
	<row id="msg_0360_R22_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: I don’t WANNA\nunderstand you!\rI ain’t never gon’ be like you.\rA coward when you alone and\na tyrant when you in\ffront of other cowards!\rI’ma be strong!\rI’ma be a stronger man all\nby myself!\r</language>
	</row>
	<row id="msg_0360_R22_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}All by myself!{SIZE 100}\r</language>
	</row>
	<row id="msg_0360_R22_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: ...What you\nstarin’ at?\r</language>
	</row>
	<row id="msg_0360_R22_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">..................\rA real boss gotta admit he took\na L before he can bounce back...\rI’m goin’ solo...for now...\nLike a mixtape.\rSo one day I can build\na STRONGER organization!\r</language>
	</row>
	<row id="msg_0360_R22_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Puttin’ a whole lotta people’s\npotential together make HUGE power...\fThat’s what a organization is...\rThat’s the power of\na organization! SYNERGY!\rI failed...to unlock\nmy employees’ potential...!\rBut one day you gon’ witness\nthe comeback of me and my {COLOR 1}The Feds{COLOR 0}!\r</language>
	</row>
	<row id="msg_0360_R22_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">..................\nOne day, you’ll understand.\r</language>
	</row>
	<row id="msg_0360_R22_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Where we at...?\r</language>
	</row>
	<row id="msg_0360_R22_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Where we at...?\r</language>
	</row>
	<row id="msg_0360_R22_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Ilex Forest DISAPPEARED!\r...Nah, that ain’t it.\nIt’s more like we got\fsent somewhere else...?\r</language>
	</row>
	<row id="msg_0360_R22_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Ilex Forest DISAPPEARED!\r...Nah, that ain’t it.\nIt’s more like we got\fsent somewhere else...?\r</language>
	</row>
	<row id="msg_0360_R22_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, somethin’ weird!\rI heard the radio say\nthe date from three years ago!\r</language>
	</row>
	<row id="msg_0360_R22_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, somethin’ weird!\rI heard the radio say\nthe date from three years ago!\r</language>
	</row>
	<row id="msg_0360_R22_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is that...am I lookin’ at...\nCELEBI?\rThat explains it!\nCELEBI musta caused all this!\rMy grandpa once told me\nCELEBI can travel through time with\fits mystic power called {COLOR 1}Time Travel{COLOR 0}!\rCELEBI took us back in time!\nLiterally!\r</language>
	</row>
	<row id="msg_0360_R22_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is that...am I lookin’ at...\nCELEBI?\rThat explains it!\nCELEBI musta caused all this!\rMy grandpa once told me\nCELEBI can travel through time with\fits mystic power called {COLOR 1}Time Travel{COLOR 0}!\rCELEBI took us back in time!\nLiterally!\r</language>
	</row>
	<row id="msg_0360_R22_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, there’s somebody else\nhere besides us! Let’s go see who!\r</language>
	</row>
	<row id="msg_0360_R22_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, there’s somebody else\nhere besides us! Let’s go see who!\r</language>
	</row>
	<row id="msg_0360_R22_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Who he think he is?\nThat was uncalled for!\rBut what was they talkin’ about?\nThe comeback of {COLOR 1}The Feds{COLOR 0}...?\rThey say The Feds got\nrun outta Kanto\fby a kid three years ago.\rSo this REALLY is three years ago!\r</language>
	</row>
	<row id="msg_0360_R22_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Who he think he is?\nThat was uncalled for!\rBut what was they talkin’ about?\nThe comeback of {COLOR 1}The Feds{COLOR 0}...?\rThey say The Feds got\nrun outta Kanto\fby a kid three years ago.\rSo this REALLY is three years ago!\r</language>
	</row>
	<row id="msg_0360_R22_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh no! It’s happenin’ again...!\rIt’s CELEBI’s {COLOR 1}Time Travel{COLOR 0}!\r</language>
	</row>
	<row id="msg_0360_R22_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh no! It’s happenin’ again...!\rIt’s CELEBI’s {COLOR 1}Time Travel{COLOR 0}!\r</language>
	</row>
