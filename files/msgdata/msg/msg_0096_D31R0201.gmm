<?xml version="1.0"?>
<body language="English">
	<row id="msg_0096_D31R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Battle Tower!\rI run the Single and Double\nBattle Rooms. Velvet rope and all.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You tryna run the Battle Room\nchallenge? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back when you got the heart!</language>
	</row>
	<row id="msg_0096_D31R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Battle Tower is where you\nscrap Single or Double Battles.\rOnce you in, the run keep goin’\ntill you take a L.\rSingle Battles, you roll in with\nthree homies.\rDouble Battles, you roll in with\nfour homies.\rThe scraps go down in Battle Rooms,\nand this tower got a LOT of ’em.\rIn every Battle Room, seven Hustlers\nwaitin’ to run you down.\rBeat all seven, and you get\nBattle Points (BP).\rIf you wanna dip mid-run,\nsave the game first.\rIf you don’t save, you\ngettin’ disqualified. No cap.\rDon’t say I ain’t warn you!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Which Battle Room you want?\nSingle or Double? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pick the homies you\nrollin’ in with.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your homies all gotta be\ndifferent. No clones.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Held items gotta be different too.\nNo double-dippin’.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight, follow me to the Battle Room.</language>
	</row>
	<row id="msg_0096_D31R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayyy, congrats!\nYou ran through all seven Hustlers!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayyy, congrats!\nYou beat the Tower Tycoon!\rHere go some Battle Points\n’cause you NASTY!\r{STRVAR_1 3, 0, 0} got\n{STRVAR_1 50, 1, 0} BP!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Savin’...\nDon’t you DARE turn it off.</language>
	</row>
	<row id="msg_0096_D31R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back when you got the heart.</language>
	</row>
	<row id="msg_0096_D31R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We been waitin’ on you!\rBefore you hit the Battle Room,\nI gotta save. Hold up.</language>
	</row>
	<row id="msg_0096_D31R0201_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00018" index="18">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo!\rYou ain’t save before you dipped\nlast time.\rSo that run is DONE. You\ndisqualified. Them the rules!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Battle Tower!\rI run the Multi Battle Rooms.\nBring a partner, no solos.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You tryna run the Multi Battle\nRoom challenge? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00022" index="22">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Multi Battle Rooms is for\ntag-team scraps with a partner.\rRoll in with another Hustler,\ntwo homies each.\rInside there’s the Battle Salon,\nwhere you can link up with\fother Hustlers.\rFind somebody there to be\nyour partner.\rOr link with a homie over\nwireless.\rOnce you got a partner, I’ll\nshow you to a Multi Battle Room.\rIn there, seven tag teams\nwaitin’ on you.\rBeat all seven teams, and you\nget Battle Points.\rIf you wanna dip mid-run,\nsave the game first.\rIf you don’t save, you\ngettin’ disqualified. No cap.\rAnd if you teamed with a homie,\nyou can’t dip mid-run.\fYou stuck together. Ride or die.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00024" index="24">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00025" index="25">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna link with a homie\nand form a tag team? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One Hustler pick\n“BECOME LEADER.”\rThe other Hustler pick\n“JOIN GROUP.” {YESNO 0}</language>
	</row>
