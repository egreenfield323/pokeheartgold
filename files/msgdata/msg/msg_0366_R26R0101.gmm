<?xml version="1.0"?>
<body language="English">
	<row id="msg_0366_R26R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You thought you was lucky to find a\nplace to rest right when you\fneeded it?\rDon’t be shy! I love seein’ people\nsmile. Let your homies rest here!\rI’m a retired nurse. Retired\n’cause I kept healin’ people\fwithout insurance.\r</language>
	</row>
	<row id="msg_0366_R26R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">THERE! Your homies lookin’ GOOD!\fNo copay. Keep at it!</language>
	</row>
	<row id="msg_0366_R26R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CHANSEY: Ch-Chansey!</language>
	</row>
</body>
