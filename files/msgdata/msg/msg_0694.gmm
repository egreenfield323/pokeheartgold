<?xml version="1.0"?>
<body language="English">
	<row id="msg_0694_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tully</language>
	</row>
	<row id="msg_0694_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you tryna be the ultimate\nHustler too? That make us comrades!\rIf I find more stuff by the water,\nI’ll give you some.\rJust gimme your number. {YESNO 0}</language>
	</row>
	<row id="msg_0694_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gon’ hear from me if I find\nsomethin’ good.</language>
	</row>
	<row id="msg_0694_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s how it is? Then I’ll just\nuse ’em myself.</language>
	</row>
	<row id="msg_0694_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I find more stuff by the water,\nI’ll give you some.\rJust gimme your number.{YESNO 0}</language>
	</row>
	<row id="msg_0694_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, there you!\nHere’s a gift, like I promised!\r</language>
	</row>
	<row id="msg_0694_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, if you right nearby, come chat\nwith me in person!</language>
	</row>
	<row id="msg_0694_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} grew AGAIN.\rIt was only this big when I caught\nit, but now it’s WAY bigger.\rOh yeah, I KO’d a wild {STRVAR_1 0, 11, 0}.\nIt was HUGE--like THIS big, even.\rHeh, I guess you can’t tell over\nthe phone...\rWell, I’ll see you.</language>
	</row>
	<row id="msg_0694_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} grew AGAIN.\rIt was only this big when I caught\nit, but now it’s WAY bigger.\rOh yeah, I lost a wild {STRVAR_1 0, 11, 0}.\nIt was HUGE--like THIS big, even.\rHeh, I guess you can’t tell over\nthe phone...\rWell, I’ll see you.</language>
	</row>
	<row id="msg_0694_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We should get a scrap goin’!\rI’ll be fishin’ on {STRVAR_1 4, 3, 0}.\nSwing by if you got time.</language>
	</row>
	<row id="msg_0694_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What? You lost or somethin’?\nOur scrap is on {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0694_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I found anythin’ good?\nNope, not yet.\rIt’s like fishin’--you need patience.</language>
	</row>
	<row id="msg_0694_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I picked up a hard lil thing by the\nwater. Like I promised, it’s yours.\fI’ll be waitin’ on {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0694_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got somethin’ good for you.\nHurry over to {STRVAR_1 4, 3, 0}.</language>
	</row>
</body>
