<?xml version="1.0"?>
<body language="English">
	<row id="msg_0054_D15R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Make it to the top and the Elder\nbless you with a hard move.</language>
	</row>
	<row id="msg_0054_D15R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprout Tower was built way back\nas a place to train homies.</language>
	</row>
	<row id="msg_0054_D15R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A BELLSPROUT over 100 feet tall...\rPeople say it turned into the\nmiddle pillar. Don’t ask me how.</language>
	</row>
	<row id="msg_0054_D15R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See the pillar shakin’?\rPeople upstairs scrappin’.</language>
	</row>
	<row id="msg_0054_D15R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A homie statue...\rIt look real distinguished.\nSomebody tagged it, though.</language>
	</row>
</body>
