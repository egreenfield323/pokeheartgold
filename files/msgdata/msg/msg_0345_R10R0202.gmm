<?xml version="1.0"?>
<body language="English">
	<row id="msg_0345_R10R0202_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Somebody broke into the Power Plant...\nWhat is the WORLD comin’ to?\fI blame phones.</language>
	</row>
	<row id="msg_0345_R10R0202_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I just got word from Cerulean.\nLooks like a shady character been\fhangin’ around.\r</language>
	</row>
	<row id="msg_0345_R10R0202_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Could you help us out?\rThe shady character was hangin’\naround the Cerulean Block...\r</language>
	</row>
	<row id="msg_0345_R10R0202_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Could you help us out?\rThe shady character was hangin’\naround the Cerulean Block...</language>
	</row>
	<row id="msg_0345_R10R0202_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Somebody ran off with a part the\ngenerator NEED.\rWithout it, the new generator useless!\nIt’s just a big metal box. A sad box.</language>
	</row>
	<row id="msg_0345_R10R0202_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Power Plant was abandoned back in\nthe day. Ghosts and all.\rWe got it back up to power the Magnet\nTrain. The ghosts still here though.</language>
	</row>
	<row id="msg_0345_R10R0202_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Manager up ahead.\rBut since somebody wrecked the\ngenerator, he been sad and, sometimes,\fFURIOUS...\rSometimes he just bust out laughin’\noutta desperation. We been through SO\fmuch...\fHe ate a lightbulb yesterday.</language>
	</row>
	<row id="msg_0345_R10R0202_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Magnet Train eat a LOTTA\nelectricity.\rIt can’t move if the generator ain’t\nrunnin’. It’s a hungry train.</language>
	</row>
	<row id="msg_0345_R10R0202_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I collect homies.\nYou got a DUGTRIO?\rWanna trade it for my MAGNETON? {YESNO 0}</language>
	</row>
	<row id="msg_0345_R10R0202_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yesss! I got me a DUGTRIO!\nGood looks!</language>
	</row>
	<row id="msg_0345_R10R0202_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? That ain’t DUGTRIO.\nYou tried to finesse me...</language>
	</row>
	<row id="msg_0345_R10R0202_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You don’t wanna trade? Aww...</language>
	</row>
	<row id="msg_0345_R10R0202_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, how my old MAGNETON doin’?</language>
	</row>
	<row id="msg_0345_R10R0202_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Manager: I-I-I’m ready to BLAST\nsomebody!\rWho would STEAL a part outta my\ngenerator?!\rI spent YEARS fixin’ it! If I catch him,\nhe gon’ see what I can do\fwith my Taser Beam! ZZZAP! *twitch*</language>
	</row>
	<row id="msg_0345_R10R0202_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Manager: AH! YEAH! That thing you\ngot...\rThat’s the PART they stole from my\nBELOVED generator?!\rYou FOUND it?! Good looks! I’m cryin’!\rNow all I gotta do is... put this part\nright here...\r</language>
	</row>
	<row id="msg_0345_R10R0202_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Manager: WHIRRRRRR!\rYES, it’s RUNNIN’!\nWhirrr, whirrr! I’m whirrin’ too!\r</language>
	</row>
	<row id="msg_0345_R10R0202_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Manager: WAHAH! Good looks!\rHere! Take this TM as a reward!\nIt’s my baby! Treat it right!\r</language>
	</row>
	<row id="msg_0345_R10R0202_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Manager: TM57 is my Taser Beam!\rIt shoot beams, and it can\nsometimes raise Special Attack!</language>
	</row>
	<row id="msg_0345_R10R0202_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Staff Mottos:\r1. Electricity ain’t infinite.\n2. Save it wherever you can.\f3. Look out for each other.\f4. No standin’ around.\f5. Wear shoes with rubber soles.\f6. The Manager is AWESOME.</language>
	</row>
	<row id="msg_0345_R10R0202_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Use electricity wisely\nfor a bright, good life.\f           Kanto Power Plant</language>
	</row>
</body>
