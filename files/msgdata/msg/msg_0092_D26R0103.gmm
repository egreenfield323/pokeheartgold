	</row>
	<row id="msg_0092_D26R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ma be like SLOWPOKE.\rReal patient. Just waitin’\nto see one evolve. Any day now.</language>
	</row>
</body>
