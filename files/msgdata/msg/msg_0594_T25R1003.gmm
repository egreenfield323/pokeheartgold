<?xml version="1.0"?>
<body language="English">
	<row id="msg_0594_T25R1003_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I-I-I’m REAL impatient!\rI use X Sneakers in scraps to speed my\nhomies up! And I drink six Red Bulls!</language>
	</row>
	<row id="msg_0594_T25R1003_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my... The Feds already in here!\nAct natural. ACT NATURAL.</language>
	</row>
	<row id="msg_0594_T25R1003_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo! You use X Special in scraps?\rIt’s HARD. It jack up Special Attack.\nLike energy drinks but legal.</language>
	</row>
	<row id="msg_0594_T25R1003_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I never thought about it, but The Feds\ndo go shoppin’... They need socks too.</language>
	</row>
	<row id="msg_0594_T25R1003_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">For Winners Only\n3F Battle Collection</language>
	</row>
</body>
