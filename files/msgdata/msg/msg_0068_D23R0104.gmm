<?xml version="1.0"?>
<body language="English">
	<row id="msg_0068_D23R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was listenin’ to the radio at\nthe ruins.\rI heard a weird broadcast there.</language>
	</row>
	<row id="msg_0068_D23R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Why? Why I gotta go\nthrough this?\rMEOWTH, help me!</language>
	</row>
	<row id="msg_0068_D23R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Oh! My lil hero! Will\nyou take this as my thanks?\r</language>
	</row>
	<row id="msg_0068_D23R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} got the Bright\nPowder from Mary!</language>
	</row>
	<row id="msg_0068_D23R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: When a homie hold it, it\nlower the other homie’s accuracy.</language>
	</row>
	<row id="msg_0068_D23R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nooo! Your Bag full!</language>
	</row>
	<row id="msg_0068_D23R0104_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Tune in to me on\nProfessor Oak’s Pokémon Talk show.</language>
	</row>
	<row id="msg_0068_D23R0104_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MEOWTH: Meowth...</language>
	</row>
	<row id="msg_0068_D23R0104_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">4F Production</language>
	</row>
	<row id="msg_0068_D23R0104_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">4F Studio 1</language>
	</row>
	<row id="msg_0068_D23R0104_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben: The Feds... They missin’\nsomethin’. It’s MUSIC!\rMusic feed people’s heart and soul.\rReal music lovers would never do\nfoul stuff like this at the\fRadio Tower! Not even on a remix!</language>
	</row>
	<row id="msg_0068_D23R0104_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben: You listen to our music?</language>
	</row>
	<row id="msg_0068_D23R0104_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proton, the big dog of this Radio\nTower op... He so cold. He wrote up\fhis own MAMA. For jaywalkin’.\r</language>
	</row>
	<row id="msg_0068_D23R0104_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO, who you?!\rIf you buggin’ Proton...\nI mean The Feds... it’s SMOKE!\fThis hallway on WIRETAP, bruh!\r</language>
	</row>
	<row id="msg_0068_D23R0104_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Feds and Proton all I need!\rHomies? I don’t care about no\nhomies! I got a PENSION, bruh!</language>
	</row>
</body>
