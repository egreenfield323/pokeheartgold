	<row id="msg_0466_T03R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Did you just walk in?! This a\nhouse, not a Poké Center!\rI used to love nappin’ with the\nradio on...\rIt’s broke and gettin’ fixed now.\r... ...\f...\f...\rIt’s TOO QUIET to sleep! I can\nhear my own THOUGHTS! They mean!</language>
	</row>
