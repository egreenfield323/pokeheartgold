<?xml version="1.0"?>
<body language="English">
	<row id="msg_0480_T05R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WASSUP, WASSUP! I’m the official Name\nRater! The Kanto branch!\rWant me to ROAST your homies’ names? {YESNO 0}</language>
	</row>
	<row id="msg_0480_T05R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Which homie’s name should\nI roast, youngblood?</language>
	</row>
	<row id="msg_0480_T05R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}, huh? MID!\rWant me to give it a WAY better name?\nWhat you think? {YESNO 0}</language>
	</row>
	<row id="msg_0480_T05R0401_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight! Then what’s the new\nnickname gon’ be?\r</language>
	</row>
	<row id="msg_0480_T05R0401_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There! From now on, this homie\ngo by {STRVAR_1 1, 0, 0}!\rThat’s WAY better than before!\nRight?</language>
	</row>
	<row id="msg_0480_T05R0401_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight. Suit yourself.\nKeep that mid name.</language>
	</row>
	<row id="msg_0480_T05R0401_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There! From now on, this homie\ngo by {STRVAR_1 1, 0, 0}!\rIt ain’t that different?\nYour eyes trippin’!\rThis one better.\nLucky you!</language>
	</row>
	<row id="msg_0480_T05R0401_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm.\n{STRVAR_1 1, 0, 0}, huh?\rThat name is FIRE. No notes!\rTake good care of {STRVAR_1 1, 0, 0}!</language>
	</row>
	<row id="msg_0480_T05R0401_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh... That’s just a Egg! It ain’t\neven got a name! Let it LIVE!</language>
	</row>
</body>
