<?xml version="1.0"?>
<body language="English">
	<row id="msg_0372_R28R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ALAS! You FOUND me...\rMy secret hideout to recover from the\nstress of the SPOTLIGHT... EXPOSED!\rI’m callin’ my publicist!\r</language>
	</row>
	<row id="msg_0372_R28R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What? You ain’t paparazzi? Then you\nmust be a FAN.\rWhy ain’t you say so? *giggle*... Sign\nhere.\rYou’ll keep it a secret I’m here,\nright? I’ll give you this for that!\fIt’s hush bread!\r</language>
	</row>
	<row id="msg_0372_R28R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s got Chicken Wing!\rI wore a dress inspired by this move\nat my debut show... The critics HATED\fit.\rAlas... Bein’ a legend is SO demandin’.\rI been retired a while, but people\nnever stop chasin’ me...\flike YOU! Get out! ...Come back!</language>
	</row>
	<row id="msg_0372_R28R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FEAROW: Feero!</language>
	</row>
</body>
