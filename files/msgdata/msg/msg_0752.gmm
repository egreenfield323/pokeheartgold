<?xml version="1.0"?>
<body language="English">
	<row id="msg_0752_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Glad to meet you. I’m Monica of\nMonday. The OLDEST. That make me the\fboss.\rAs a token of our friendship, I got a\ngift. Take it. That’s an order.\r</language>
	</row>
	<row id="msg_0752_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: It boost Flyin’-type moves.\rGive it to a bird homie.\nNot a fish. A BIRD. I see you.</language>
	</row>
	<row id="msg_0752_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: My brothers and sisters all\nover the place. They don’t LISTEN to\fme.\rSee if you can find ’em all. Report back.</language>
	</row>
	<row id="msg_0752_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Oh no! Today ain’t Monday.\nI don’t work on other days. Bye.</language>
	</row>
	<row id="msg_0752_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Please allow me to introduce\nmyself. I’m Tuscany of Tuesday.\rI studied abroad. In Paris. Twice.\rBy way of introduction, please accept\nthis TwistedSpoon. It is ARTISANAL.\r</language>
	</row>
	<row id="msg_0752_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Is it not most adorable?\rIt strengthens Psychic moves.\nI’m certain it will elevate you. Darling.</language>
	</row>
	<row id="msg_0752_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Have you met Monica, my older\nsister? She is SO bossy.\rOr my younger brother, Wesley?\nHe is SO basic.\rI’m the second of seven kids.\nThe classy one.</language>
	</row>
	<row id="msg_0752_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Tuesday ended before I\nnoticed... How GAUCHE. I shall see you\fnext Tuesday.</language>
	</row>
	<row id="msg_0752_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Yo. I’m Wesley of Wednesday.\nHump day, baby.\rTake a souvenir. Or don’t. It’s chill.\r</language>
	</row>
	<row id="msg_0752_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Black Belt beef up Fightin’\nmoves. It’s a belt. It’s black. It’s\fsimple.</language>
	</row>
	<row id="msg_0752_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Since you found me, you musta\nmet my siblings.\rOr you just got lucky. Either way, it’s\nchill. Everything’s chill.</language>
	</row>
	<row id="msg_0752_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: No WAY! Wednesday OVER?!\nThat’s my whole personality! See you\fnext week!</language>
	</row>
	<row id="msg_0752_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: Who are you?! Nobody EVER talk\nto me.\rI’m Arthur of Thursday. The middle\nchild. The FORGOTTEN one.\rHere, take this! Remember me!\r</language>
	</row>
	<row id="msg_0752_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: Use Rock moves? Give that to\nyour homie. It make Rock moves\fstronger.\rSee? I’m USEFUL. Tell Mom.</language>
	</row>
	<row id="msg_0752_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: I’m Arthur of Thursday!\nI’m the second son of seven!\fNobody remember that. NOBODY.</language>
	</row>
	<row id="msg_0752_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: You think the middle of the week\nis Wednesday or Thursday?\rIt’s Thursday. It’s ME. I’m the middle.\nI’m ALWAYS the middle. See you next\fThursday!</language>
	</row>
	<row id="msg_0752_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: YAHOO! It’s FRIDAY!\rI’m Frieda of Friday! Let’s PARTY! Nice\nto meet you! Wanna come to a party?\rHere’s a Poison Barb! Party favor!\r</language>
	</row>
	<row id="msg_0752_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: Give it to a homie with Poison\nmoves!\rOh! It’s WICKED!\rYour Poison moves gon’ go CRAZY!\nLike me on Friday night!</language>
	</row>
	<row id="msg_0752_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: HIYA! What day you like?\rI love FRIDAY. No doubt about it!\nPayday! Party day! Best day!\fDon’t you think so too?!</language>
	</row>
	<row id="msg_0752_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: Oh, today ain’t Friday?\rMan... I wish EVERY day was Friday.\nI’d be broke, but I’d be HAPPY!</language>
	</row>
	<row id="msg_0752_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: ...It’s Saturday...\rI’m Santos of Saturday...\nI just woke up... It’s 4 PM...\rTake this... I’m goin’ back to sleep...\r</language>
	</row>
	<row id="msg_0752_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: ...\rSoft Sand...\rGround moves get stronger...\nIt’ll startle you... *yawn*...\fI’m startled I’m awake...</language>
	</row>
	<row id="msg_0752_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: ...\rSee you again on another Saturday...\nIf I wake up...</language>
	</row>
	<row id="msg_0752_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: Today Saturday...\nNo... Wait... Huh?\rWhat day is it? What YEAR is it?\nI’ll see you next Saturday then...</language>
	</row>
	<row id="msg_0752_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: AYO! I’m Sunny of Sunday! That\nmean it’s Sunday today! I think!\rI was told to give you this if I saw you!\nI forget who told me!\r</language>
	</row>
	<row id="msg_0752_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: That thing...\rUm...\r...What was it now...\r...\rOh! I REMEMBER now!\rGive it to a homie with Electric moves!\rMy sis Monica said it power up Electric\nmoves! She yelled it at me!</language>
	</row>
	<row id="msg_0752_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: My sister Monica...\nMy sister Tuscany...\fMy brother Wesley...\fMy brother... um... Arthur!\fMy sister Frieda...\fAnd my brother Santos.\rThey ALL older than me!</language>
	</row>
	<row id="msg_0752_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: Huh? Ain’t today Sunday?\nUm... I forgot! I forget everythin’!</language>
	</row>
	<row id="msg_0752_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Ayo, YOU!\nThe one who found ALL my siblings!\fYeah, you!\rWe pretty good homies now, I DECIDED.\rSince we homies, here’s a Alert Ribbon!\nWear it. That’s an order.\r</language>
	</row>
	<row id="msg_0752_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: That Alert Ribbon looks great\non your Pokémon...</language>
	</row>
	<row id="msg_0752_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} put on the Alert Ribbon!</language>
	</row>
	<row id="msg_0752_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can only get one ribbon per week...\rIf you want another ribbon, come find\nme again next week!</language>
	</row>
	<row id="msg_0752_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Darling, YOU!\nThe one who found all of my siblings!\fYes, you!\rWe quite good homies now, are we not?\rTherefore, a Shock Ribbon. Imported.\r</language>
	</row>
	<row id="msg_0752_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: That Shock Ribbon looks great\non your Pokémon...</language>
	</row>
	<row id="msg_0752_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} put on the Shock Ribbon!</language>
	</row>
	<row id="msg_0752_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can only get one ribbon per week...\rIf you want another ribbon, come find\nme again next week!</language>
	</row>
	<row id="msg_0752_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Yo, you!\nYou found all my siblings. That’s chill.\fYeah, you!\rWe homies now, it’s whatever.\rHere’s a Downcast Ribbon. It’s chill.\r</language>
	</row>
	<row id="msg_0752_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: That Downcast Ribbon looks\ngreat on your Pokémon...</language>
	</row>
	<row id="msg_0752_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} put on the\nDowncast Ribbon!</language>
	</row>
	<row id="msg_0752_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can only get one ribbon per week...\rIf you want another ribbon, come find\nme again next week!</language>
	</row>
	<row id="msg_0752_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: You found ALL my siblings?! And\nyou REMEMBERED me?!\rWe homies now! My first homie!\rHere’s a Careless Ribbon! Don’t forget\nme!\r</language>
	</row>
	<row id="msg_0752_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: That Careless Ribbon looks\ngreat on your Pokémon...</language>
	</row>
	<row id="msg_0752_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} put on the\nCareless Ribbon!</language>
	</row>
	<row id="msg_0752_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can only get one ribbon per week...\rIf you want another ribbon, come find\nme again next week!</language>
	</row>
	<row id="msg_0752_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: AYO, you found ALL my siblings!\nThat’s a PARTY!\rWe homies now! Party homies!\rHere’s a Relax Ribbon! Let’s GO!\r</language>
	</row>
	<row id="msg_0752_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: That Relax Ribbon looks great\non your Pokémon...</language>
	</row>
	<row id="msg_0752_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} put on the Relax Ribbon!</language>
	</row>
	<row id="msg_0752_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can only get one ribbon per week...\rIf you want another ribbon, come find\nme again next week!</language>
	</row>
	<row id="msg_0752_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: ...\nYou found all my siblings... *yawn*\rWe homies... Right?\n...Right...\rHere... A Snooze Ribbon... Fitting...\r</language>
	</row>
	<row id="msg_0752_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: That Snooze Ribbon looks good\non your Pokémon...</language>
	</row>
