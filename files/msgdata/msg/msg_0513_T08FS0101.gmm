<?xml version="1.0"?>
<body language="English">
	<row id="msg_0513_T08FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanted Safari Zone souvenirs, but it\nain’t open!\rI thought it was just closed today,\nbut it’s GONE! Moved! To JOHTO!\rNever saw it comin’. I came from\nHoenn.</language>
	</row>
	<row id="msg_0513_T08FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Safari Zone moved to Johto...\rThe Warden’s son runnin’ Pal Park\nnow. Family business. Nepotism.</language>
	</row>
	<row id="msg_0513_T08FS0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You been to Pal Park?\rThe Warden’s son run it with his wife.\nRunnin’ parks in the family.\fParks and divorce. Big family.</language>
	</row>
</body>
