	<row id="msg_0642_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bike Shop</language>
	</row>
	<row id="msg_0642_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}...is that you?\rYou somethin’ else, ain’t you?</language>
	</row>
	<row id="msg_0642_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}...is that you?\rYou somethin’ else, ain’t you?</language>
	</row>
	<row id="msg_0642_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, this the Bike Shop! I been\nsellin’ a LOT of Bikes lately!\rIt’s ’cause you ridin’ around on that\nBike advertisin’ for me!\fFree promo! Can’t beat it!\rSo I’m just GIVIN’ you the Bike you\nbeen ridin’.\rIt’s yours! Don’t ask where it’s from!\nDon’t ask the cops either.</language>
	</row>
</body>
