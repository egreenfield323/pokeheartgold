<?xml version="1.0"?>
<body language="English">
	<row id="msg_0700_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dana</language>
	</row>
	<row id="msg_0700_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You real good with homies!\rBoys gimme stuff after scraps, but\nsometimes they gimme TOO much.\rNext time, I can share some if you\nwant. Lemme get your\fnumber. {YESNO 0}</language>
	</row>
	<row id="msg_0700_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Next time a boy gimme somethin’ after\na scrap, I’ll share with you!\rDoes that make me sound ungrateful?</language>
	</row>
	<row id="msg_0700_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, you don’t want nothin’?\nBut it’s all FREE...</language>
	</row>
	<row id="msg_0700_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll share my gifts with you.\rLemme get your number.{YESNO 0}</language>
	</row>
	<row id="msg_0700_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo! You here for your gift?\rThis should deadass make your day!\r</language>
	</row>
	<row id="msg_0700_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, tell me, ain’t a girl on the\nphone just charmin’?\rIt’s not?\rHa ha ha, you right nearby, ain’t you?\nWhy not come over here and talk in\fperson?</language>
	</row>
	<row id="msg_0700_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} gettin’ prettier!\nI been takin’ TONS of pics!\rIt only took a second to beat a wild\n{STRVAR_1 0, 11, 0}.\r...Prob’ly ’cause you gave me some\nscrap tips last time!\rLater!</language>
	</row>
	<row id="msg_0700_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} gettin’ prettier!\nI been takin’ TONS of pics!\rYou know what? A wild {STRVAR_1 0, 11, 0}\ngot away from me AGAIN.\rIt was SO close!\nFr, just a lil more, and I\fwoulda...\rLater!</language>
	</row>
	<row id="msg_0700_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Right now, I’m on {STRVAR_1 4, 3, 0}.\rIf you close by, let’s scrap!\nI’ll be waitin’ for you!</language>
	</row>
	<row id="msg_0700_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo! You ain’t forget your\npromise to scrap me, did you?\rI’m waitin’ on {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0700_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! You wanted a gift, right?\nI got one, but I wanna keep this one.\rCan you wait a lil longer?</language>
	</row>
	<row id="msg_0700_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know what? I got a good gift!\nLike I promised, it’s yours!\rI KNOW you gon’ like it. Come pick it\nup! I’m waitin’ on {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0700_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rIf you don’t come get your present\nsoon, I’mma give it to somebody else.\rI’m waitin’ on {STRVAR_1 4, 3, 0}!</language>
	</row>
</body>
