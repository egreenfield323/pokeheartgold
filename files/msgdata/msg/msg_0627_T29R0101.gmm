<?xml version="1.0"?>
<body language="English">
	<row id="msg_0627_T29R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Did you just walk in?! This a\nhouse, not a Poké Center!\r...You strayed far, child... I\nbeen meditatin’ here. For eleven\fyears.\fInside me, a new power woke up.\rIt’s hunger. But also POWER.\rLemme share it with your homie.\nTake this, child.\r</language>
	</row>
	<row id="msg_0627_T29R0101_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0627_T29R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You see it? It’s Hidden Strap!\rIt pull out the power homies\nkeep hidden.\rRemember: its type and power\ndepend on the homie usin’ it.</language>
	</row>
	<row id="msg_0627_T29R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ain’t got room for it...</language>
	</row>
	<row id="msg_0627_T29R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m meditatin’... Shh.\nI can hear you breathin’. Stop.</language>
	</row>
</body>
