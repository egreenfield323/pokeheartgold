	<row id="msg_0405_R45_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You heard of the Battle Frontier?\rHuge spot with mad battle\nfacilities, west of Olivine!\rLet’s see...\rWin your way up the Big League\nfirst. Then go get humbled at the\fFrontier.\fThat’s the circle of life.</language>
	</row>
	<row id="msg_0405_R45_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rt. 45\nMountain Road Ahead. Leg Day.</language>
	</row>
