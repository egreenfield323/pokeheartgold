<?xml version="1.0"?>
<body language="English">
	<row id="msg_0066_D23R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radio is good, you know?\rHard music and homie info...\nWild news and dramatic stories...\fIt got everythin’!\rThe only thing missin’ is pictures.\r..................\nOops, they call that a TV!</language>
	</row>
	<row id="msg_0066_D23R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lullabies on the radio make wild\nhomies sleepy.\rThat’s why you don’t see many homies\nin the tall grass when the\fradio playin’ lullabies.</language>
	</row>
	<row id="msg_0066_D23R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why would anybody wanna take over\nthe Radio Tower? Who listen to radio?</language>
	</row>
	<row id="msg_0066_D23R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">JIGGLYPUFF: Jiggly...</language>
	</row>
	<row id="msg_0066_D23R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sorry. Authorized staff only\npast this point.\rIt wasn’t like this before. Somethin’\nwrong with the Director...</language>
	</row>
	<row id="msg_0066_D23R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Look around anywhere you want.\nThe Director nice again, like\fhe used to be.</language>
	</row>
	<row id="msg_0066_D23R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">2F Sales</language>
	</row>
	<row id="msg_0066_D23R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon Talk with Professor Oak\nThe Hottest Show on the Air!</language>
	</row>
	<row id="msg_0066_D23R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">2F Studio 2</language>
	</row>
	<row id="msg_0066_D23R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Huh?\nToday’s password?\rHELP, obviously!</language>
	</row>
	<row id="msg_0066_D23R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Ayo! I’m Buena!\rYou know the radio show\ncalled Buena’s Password?\rTell me the password from\nthe show, and you get points.\rStack them points and trade ’em\nwith that sweet lady over there\ffor some hard prizes!\rHere you go!\nYour hella own point card!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Good looks for listenin’\nevery day!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: {STRVAR_1 3, 0, 0}!\nGood looks for listenin’ to my show!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: {STRVAR_1 3, 0, 0}!\nGood looks for tunin’ in to my show!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: You remember today’s\npassword? {YESNO 0}</language>
	</row>
	<row id="msg_0066_D23R0102_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Oh, sheesh! Good looks!\nWhat was your name again?\r...{STRVAR_1 3, 0, 0}!\rC’mon, {STRVAR_1 3, 0, 0}.\nJoin the show.\r</language>
	</row>
	<row id="msg_0066_D23R0102_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Oh, sheesh! Good looks!\nWhat was your name again?\r...{STRVAR_1 3, 0, 0}!\rC’mon, {STRVAR_1 3, 0, 0}.\nJoin the show.\r</language>
	</row>
	<row id="msg_0066_D23R0102_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Good looks, {STRVAR_1 3, 0, 0}!\rJoin the show like you always do!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Good looks, {STRVAR_1 3, 0, 0}!\rJoin the show like you always do!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Come back after you listen\nto my show, OK? Later!</language>
	</row>
	<row id="msg_0066_D23R0102_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Everybody ready?\rI wanna hear y’all shout today’s\npassword for {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Everybody ready?\rI wanna hear y’all shout today’s\npassword for {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Yippee! That’s right!\rYou was tuned in! I’m so happy!\nYou earned one point! Congrats!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Aww... That ain’t it...\nYou forgot the password?</language>
	</row>
	<row id="msg_0066_D23R0102_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Oh! Your Blue Card hit 30\npoints today! That’s so wild!\rHmm... You come by so much,\n{STRVAR_1 3, 0, 0}, I’ma give you a\fspecial deal!\rHow ’bout my phone number?\r</language>
	</row>
	<row id="msg_0066_D23R0102_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Oh! Your Blue Card hit 30\npoints today! That’s so wild!\rHmm... You come by so much,\n{STRVAR_1 3, 0, 0}, I’ma give you a\fspecial deal!\rHow ’bout my phone number?\r</language>
	</row>
	<row id="msg_0066_D23R0102_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Buena’s number\nin the Pokégear!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: I can’t wait to hear\nfrom you!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Tune in to my password show!</language>
	</row>
	<row id="msg_0066_D23R0102_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Sorry...\nYou only get one shot a day.\rCome back tomorrow and try again!</language>
	</row>
	<row id="msg_0066_D23R0102_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Your Bag full!</language>
	</row>
	<row id="msg_0066_D23R0102_00031" index="31">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0066_D23R0102_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Tune in to my show again\ntomorrow!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stack up them Blue Card points\nfor some hard prizes!</language>
	</row>
	<row id="msg_0066_D23R0102_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Blue Card points total\nis now {STRVAR_1 51, 0, 0}.</language>
	</row>
	<row id="msg_0066_D23R0102_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Congrats!\rYour points total is now {STRVAR_1 51, 0, 0}. The prize\nis this {STRVAR_1 8, 1, 0}. Here you go!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Blue Card points maxed\nout.\fI’ma give you a new card!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00037" index="37">
		<attribute name="window_context_name">used</attribute>
