<?xml version="1.0"?>
<body language="English">
	<row id="msg_0541_T11R0802_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who are you?! Put my remote\ndown. Slowly. Real slow.\r{STRVAR_1 3, 0, 0}: Ayo! You like homies?\r{STRVAR_1 3, 0, 0}: Uh, no, I just asked YOU.\r{STRVAR_1 3, 0, 0}: Huh? You weird!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Ayo. You must like\nhomies.\r{STRVAR_1 3, 0, 0}: No, not me. I asked you.\r{STRVAR_1 3, 0, 0}: Huh? You weird!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Copycat: Hmm? Quit copyin’?\nBut that’s my main hobby!\fAnd my side hustle! I do parties!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Ayo! I heard you\nlost your favorite Poké Doll.\r{STRVAR_1 3, 0, 0}: If I find it, you’ll give\nme a Magnet Train Pass?\r{STRVAR_1 3, 0, 0}: I’ll go find it for you.\r{STRVAR_1 3, 0, 0}: You think you lost it\nwhen you went to Vermilion City?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Ayo! I heard you\nlost your favorite Poké Doll.\r{STRVAR_1 3, 0, 0}: If I find it, you’ll give\nme a Magnet Train Pass?\r{STRVAR_1 3, 0, 0}: I’ll go find it for you.\r{STRVAR_1 3, 0, 0}: You think you lost it\nwhen you went to Vermilion City?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Copycat: Huh?\rI shouldn’t decide what you do?\rBut I’m SO worried...\nWhat if somebody find it?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Copycat: YAY! That’s my CLEFAIRY Poké\nDoll!\rSee the rip where the right arm got\nsewn on? That’s PROOF!\rAight. Here’s the Magnet Train Pass\nlike I promised!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0541_T11R0802_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Copycat: Show it at the ticket\ngate to get on the Magnet Train.\rThe train company man gave me that\nwhen they tore down our old house\ffor the station.</language>
	</row>
	<row id="msg_0541_T11R0802_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Ayo!\nGood looks for the Magnet Train Pass!\r{STRVAR_1 3, 0, 0}: Huh?\r{STRVAR_1 3, 0, 0}: Is it that fun to copy\nevery move I make?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Ayo!\nGood looks for the Magnet Train Pass!\r{STRVAR_1 3, 0, 0}: Huh?\r{STRVAR_1 3, 0, 0}: Is it that fun to copy\nevery move I make?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Copycat: BET! It’s HILARIOUS! You\nshould see your face! Wait, I can do it!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got cameras, homie. Smile.\nNow what you want?\rThis Poké Doll look just like the real\nthing...\rAW! It MOVED!\nIt’s a REAL BANETTE! WHY IS IT HERE?!</language>
	</row>
	<row id="msg_0541_T11R0802_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BANETTE: *giggle*!</language>
	</row>
	<row id="msg_0541_T11R0802_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This a flower-lookin’ Poké Doll...\nIt’s a CHERRIM Poké Doll!</language>
	</row>
	<row id="msg_0541_T11R0802_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This a nose-lookin’ Poké Doll...\nIt’s a NOSEPASS Poké Doll!</language>
	</row>
	<row id="msg_0541_T11R0802_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a CLEFAIRY!\nHuh?\rOh, right. It’s a CLEFAIRY Poké Doll.</language>
	</row>
	<row id="msg_0541_T11R0802_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a CLEFAIRY Poké Doll.\rIt got a rip where the right arm\ngot sewn on.</language>
	</row>
</body>
