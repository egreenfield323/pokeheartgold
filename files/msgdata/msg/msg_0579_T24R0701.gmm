<?xml version="1.0"?>
<body language="English">
	<row id="msg_0579_T24R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Did you just walk in?! This a\nhouse, not a Poké Center!\rYou came from Olivine?\rDo you remember the four islands\nalong the way?\rI heard that a mythical sea creature is\nhiding in them.</language>
	</row>
	<row id="msg_0579_T24R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-uh. Not in MY house.\nState your business. Quick.\rI heard that you can only see it if\nyou have a Silver Wing.\rIt must have the same scent as\nthe creature.</language>
	</row>
	<row id="msg_0579_T24R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Did you just walk in?! This a\nhouse, not a Poké Center!\rI’ve heard that the whirlpools around\nthe islands are caused by the\fsea creature.\rYou might need a special move to\nget past them.</language>
	</row>
</body>
