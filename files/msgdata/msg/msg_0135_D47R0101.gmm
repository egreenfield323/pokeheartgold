	<row id="msg_0135_D47R0101_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Safari Zone Areas got\nswapped.</language>
	</row>
	<row id="msg_0135_D47R0101_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the front desk for the\nSafari Zone Link.\r...Or should I say...it’s finna be.\rWe still ain’t ready.\nCome back later.</language>
	</row>
	<row id="msg_0135_D47R0101_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boss!\nThis the Safari Zone Link desk.\rYou wanna know about the\nSafari Zone Link? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the Safari Zone Link desk.\rYou wanna know about\nthe Safari Zone Link? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can swap Safari Zones with your\nhomies with the Safari Zone Link.\rYou get to play in their\nSafari Zone!\rAreas and homies gon’ be different.\nHeads up!\rThe Safari Zone you get gon’\ndisappear after 24 hours or if you\fget another Safari Zone.\rTo your right is the desk for the\nSafari Zone Link.\rTo your left is the desk to play in\nyour homie’s Safari Zone.\rEnjoy the Safari Zone Link!</language>
	</row>
	<row id="msg_0135_D47R0101_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight! Enjoy the Safari Zone Link!</language>
	</row>
</body>
