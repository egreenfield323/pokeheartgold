<?xml version="1.0"?>
<body language="English">
	<row id="msg_0449_T01R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Ayo! My lil brother is the Block\nBoss in Viridian City.\rBut he leave town SO much. He just\nwander off. Like a cat.</language>
	</row>
	<row id="msg_0449_T01R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Ayo! Good timin’. I’m ’bout to\nhave some tea. It’s 3:00. It’s ALWAYS\f3:00.\rOh, your homies kinda DIRTY. How you\nlet ’em walk around like that?\rGroomin’ make ’em beautiful AND\nfriendly. Want me to groom one? {YESNO 0}</language>
	</row>
	<row id="msg_0449_T01R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Which one should I groom?\r</language>
	</row>
	<row id="msg_0449_T01R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} look content.</language>
	</row>
	<row id="msg_0449_T01R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: There you go! All done.\rSee? Don’t it look NICE? I groom\neverythin’. My brother hate it.</language>
	</row>
	<row id="msg_0449_T01R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: I always have tea around this\ntime. Come join. Bring gossip.</language>
	</row>
	<row id="msg_0449_T01R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: You don’t want one\ngroomed? OK, we’ll just have tea.</language>
	</row>
	<row id="msg_0449_T01R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Oh, sorry. I can’t\ngroom a Egg.</language>
	</row>
	<row id="msg_0449_T01R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: You REALLY into groomin’!\nSay!\fWant my lil brother’s number?\rHe the Block Boss in Viridian City.\nYou challenged him yet?\rWanna save his number? {YESNO 0}</language>
	</row>
	<row id="msg_0449_T01R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Blue’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0449_T01R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Call him whenever.\rHe can be COCKY, but he lonely. He talk\nto his homies like they people.\rHe said he ain’t got plans Sunday\nnights. He NEVER got plans.\f*giggle*!</language>
	</row>
	<row id="msg_0449_T01R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: For real? You won’t?\nI see...\fHow disappointin’.</language>
	</row>
	<row id="msg_0449_T01R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Wanna save my\nlil brother’s number? {YESNO 0}</language>
	</row>
</body>
