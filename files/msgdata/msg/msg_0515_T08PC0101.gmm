<?xml version="1.0"?>
<body language="English">
	<row id="msg_0515_T08PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO! You got a Pokédex!\nProfessor Oak gave you that?\fDid he have pants on?</language>
	</row>
	<row id="msg_0515_T08PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got a real shock at the Block.\rAll these girls lookin’ EXACTLY the\nsame. And one boy. Also lookin’ the\fsame.</language>
	</row>
	<row id="msg_0515_T08PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m Janine! Hocus-pocus...\nPOOF!\r</language>
	</row>
	<row id="msg_0515_T08PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See? I look just like her now!\r...?\rHuh? It ain’t work?\nI’m still me? DANG.</language>
	</row>
</body>
