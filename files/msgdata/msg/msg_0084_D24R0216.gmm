<?xml version="1.0"?>
<body language="English">
	<row id="msg_0084_D24R0216_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a replica of an ancient homie.</language>
	</row>
	<row id="msg_0084_D24R0216_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm.\rI been studyin’ the ruins for\nyears, but somethin’ feel...\fdifferent.\r</language>
	</row>
	<row id="msg_0084_D24R0216_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh!\rThe UNOWN pictures on the wall...\rFeel like they starin’ at me!\r</language>
	</row>
	<row id="msg_0084_D24R0216_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What is this?\nSomethin’ creepy makin’\fmy legs shake.\fI can’t stop ’em!\r</language>
	</row>
	<row id="msg_0084_D24R0216_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, you good?\nYou vanished right in front of me.\fI almost passed out!\r</language>
	</row>
	<row id="msg_0084_D24R0216_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see.\rThe power of ARCEUS and UNOWN\nmixed up into a huge energy,\fand sent you to the Sinjoh Ruins...?\rUNOWN, the Ruins, and ARCEUS...\fThe mystery get deeper...\rNow I’m even MORE nosy!\rOne day I’ma crack every mystery!\r</language>
	</row>
</body>
