<?xml version="1.0"?>
<body language="English">
	<row id="msg_0696_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vance</language>
	</row>
	<row id="msg_0696_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You strong for real. But I don’t\nwanna just slink away...\rI know! Can I get your number?\nLet’s link up for more scraps!{YESNO 0}</language>
	</row>
	<row id="msg_0696_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t forget to come see me\nwhen I challenge you!</language>
	</row>
	<row id="msg_0696_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Bird Keeper homie ain’t bad to\nhave, I’d say...\rWon’t you reconsider?</language>
	</row>
	<row id="msg_0696_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanna scrap tough Hustlers as\noften as I can!\rCan I get your number?\nLet’s link up for more scraps!{YESNO 0}</language>
	</row>
	<row id="msg_0696_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You REALLY, REALLY strong!\rGood looks for scrappin’ me so much--\nI learned a whole lot from you.\rI know! This’ll be my thanks!\r</language>
	</row>
	<row id="msg_0696_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You right nearby, ain’t you?\rWhy not come talk in person?</language>
	</row>
	<row id="msg_0696_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} got tougher.\nWe achieved liftoff!\rWe can easily beat {STRVAR_1 0, 11, 0}!\r...Huh? You too? Ain’t that great?\nLet’s talk later!</language>
	</row>
	<row id="msg_0696_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} got tougher.\nWe achieved liftoff!\rBut a wild {STRVAR_1 0, 11, 0} just\nbarely got away.\fI wanted to fly after it...\rLet’s talk later!</language>
	</row>
	<row id="msg_0696_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Right now, I’m on {STRVAR_1 4, 3, 0}.\nYou know--where I first met you?\rWanna scrap? I’ll wait here.</language>
	</row>
	<row id="msg_0696_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, {STRVAR_1 3, 0, 0}!\nHurry, hurry!\r{STRVAR_1 4, 3, 0}! Fly over NOW!</language>
	</row>
	<row id="msg_0696_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, {STRVAR_1 3, 0, 0}!\nHurry, hurry!\r{STRVAR_1 4, 3, 0}! Fly over NOW!</language>
	</row>
	<row id="msg_0696_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m lookin’ forward to our\nnext scrap!</language>
	</row>
</body>
