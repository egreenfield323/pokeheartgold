<body language="English">
	<row id="msg_0323_R02R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So you {STRVAR_1 3, 0, 0}?\nProfessor Oak waitin’ on you in his\flab in Pallet Town.\rAlso, I got this from him.\nHe want you to have it.\r</language>
	</row>
	<row id="msg_0323_R02R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So you {STRVAR_1 3, 0, 0}?\nProfessor Oak waitin’ on you in his\flab in Pallet Town.\rAlso, I got this from him.\nHe want you to have it.\r</language>
	</row>
	<row id="msg_0323_R02R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sacred Ash is crazy--it can\nrevive ALL your fainted homies!</language>
	</row>
	<row id="msg_0323_R02R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">North is Pewter City.\nSouth is Viridian City.\rI know, I know. I sound like a sign.\nI AM a sign. Emotionally.</language>
	</row>
