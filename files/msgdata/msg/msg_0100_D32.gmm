	</row>
	<row id="msg_0100_D32_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Tower\nNever Lose! Keep Winnin’!</language>
	</row>
	<row id="msg_0100_D32_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Hall\nLet Every Homie Go for No. 1</language>
	</row>
	<row id="msg_0100_D32_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Castle\nRun Your Scraps with Castle Points</language>
	</row>
	<row id="msg_0100_D32_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Arcade\nWhere Luck Run the Block</language>
	</row>
	<row id="msg_0100_D32_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Factory\nWin Streaks with Rental Homies</language>
	</row>
	<row id="msg_0100_D32_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Hustler who just recruited a homie.\nThat’s what this statue is.</language>
	</row>
	<row id="msg_0100_D32_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“Braggin’ About the Catch”...\nThat’s the title, apparently.</language>
	</row>
	<row id="msg_0100_D32_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This...!\nA lil model of the Battle Frontier.</language>
	</row>
</body>
