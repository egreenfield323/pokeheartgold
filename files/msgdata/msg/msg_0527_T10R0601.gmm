	<row id="msg_0527_T10R0601_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Let’s interview the BRAND-NEW\nKingpin! Mic check! One two! Is this\fon?!\r</language>
	</row>
	<row id="msg_0527_T10R0601_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: This gettin’ a lil too loud...\rReporters. Paparazzi. Mary.\n{STRVAR_1 3, 0, 0}, come with me. Quick.\fThrough the\fback. My cape can’t handle flash\nphotography.\r</language>
	</row>
