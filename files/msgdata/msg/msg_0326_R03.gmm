<?xml version="1.0"?>
<body language="English">
	<row id="msg_0326_R03_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mt. Moon Ahead.\rMt. Moon Square Is on\nthe Way to the Top!</language>
	</row>
	<row id="msg_0326_R03_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t NEVER seen a rock like this!\rCould it be...\na METEORITE from SPACE?!\fI’m takin’ it home. It’s mine now.</language>
	</row>
	<row id="msg_0326_R03_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touchin’ the meteorite boosted\nthe Speed of a certain homie.</language>
	</row>
	<row id="msg_0326_R03_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touchin’ the meteorite boosted\nthe defense of\fa certain homie.</language>
	</row>
	<row id="msg_0326_R03_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touchin’ the meteorite boosted\nthe offense of\fa certain homie.</language>
	</row>
	<row id="msg_0326_R03_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touchin’ the meteorite balanced out\na certain homie.</language>
	</row>
</body>
