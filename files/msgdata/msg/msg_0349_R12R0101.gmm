<?xml version="1.0"?>
<body language="English">
	<row id="msg_0349_R12R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who are you?! Put my remote\ndown. Slowly. Real slow.\rI’m the Fishin’ Guru’s lil brother.\nThe good-lookin’ one.\rYou look like you like fishin’.\nAm I right, or am I right?\fPeople say I got SHARP eyes! {YESNO 0}</language>
	</row>
	<row id="msg_0349_R12R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YEAH, YEAH. Just like I thought!\rHere, fishin’ fan!\nTake this--it’s a Super Rod.\fIt’s SUPER. It’s in the name.\r</language>
	</row>
	<row id="msg_0349_R12R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Try fishin’ wherever there’s\nwater.\rRemember--you catch different\nhomies dependin’ on the Rod.</language>
	</row>
	<row id="msg_0349_R12R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? My own eyes LIED to me?\nI need glasses. I been sayin’ it.</language>
	</row>
</body>
