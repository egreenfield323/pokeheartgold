	<row id="msg_0336_R07_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a notice!\r...Rude Hustlers been scrappin’ in\nthe Underground Path.\rThe neighbors complained, so it’s\nSEALED until further notice.\fSigned, the Celadon Police\f(Also, stop peein’ in it.)</language>
	</row>
	<row id="msg_0336_R07_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It won’t open!\rIt’s locked...</language>
