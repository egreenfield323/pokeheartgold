<?xml version="1.0"?>
<body language="English">
	<row id="msg_0455_T02PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where in the WORLD is Viridian’s\nBlock Boss? I been waitin’ three\fweeks!</language>
	</row>
	<row id="msg_0455_T02PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Viridian’s Block Boss don’t need\nNOBODY!\rHis thing is losin’ to nobody without\nhavin’ no crew.\rThat made him so popular, a whole\ncrew showed up to work for him.\fIronic.</language>
	</row>
	<row id="msg_0455_T02PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Block in Cinnabar GONE.\rWhat happened to Blaine? Did he make\nit? Is he OK? Is his mustache OK?</language>
	</row>
	<row id="msg_0455_T02PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My dream is to be a Block Boss. I\nalready got the attitude. And the\fdebt.</language>
	</row>
</body>
