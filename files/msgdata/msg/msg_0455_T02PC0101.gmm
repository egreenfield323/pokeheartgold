<?xml version="1.0"?>
<body language="English">
	<row id="msg_0455_T02PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where in the world is Viridian’s\nBlock Boss?\fI wanted to challenge him...</language>
	</row>
	<row id="msg_0455_T02PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Viridian’s Block Boss does not\nrely on others!\rThe Block Boss claims that his policy\nis to lose to no one without having\fany underlings.\rThat makes him even more popular,\nand many Hustlers have come to work\ffor him.</language>
	</row>
	<row id="msg_0455_T02PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard that the Block in Cinnabar\nis gone.\rI wonder what became of Blaine,\nthe Block Boss.</language>
	</row>
	<row id="msg_0455_T02PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My dream is to become a Block Boss.</language>
	</row>
</body>
