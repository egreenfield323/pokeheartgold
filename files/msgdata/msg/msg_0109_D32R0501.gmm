<?xml version="1.0"?>
<body language="English">
	<row id="msg_0109_D32R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Battle Castle!\rI run the Single and\nDouble Battle challenges.\rHeads up, these challenges\nis for one Hustler. Solo dolo.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Which challenge you\nwant? {YESNO 0}</language>
	</row>
	<row id="msg_0109_D32R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">At the Battle Castle, you can run a\nSingle or Double Battle challenge.\rHere, you get Castle Points (CP)\nand you gotta budget ’em.\rCP is for healin’ homies,\nrentin’ items or Berries, all that.\rYou earn CP by winnin’ scraps.\nHow much depend on HOW you win.\rThe goal is to keep a win streak\nalive while you manage your CP.\rWin seven in a row, and you\nget Battle Points (BP).\rIf you wanna dip mid-run,\nsave the game first.\rIf you don’t save, you\ngettin’ disqualified. No cap.\rDon’t say I ain’t warn you!\r</language>
	</row>
	<row id="msg_0109_D32R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Battle Castle!\rI run the Multi Battle\nchallenge.\rHeads up, this challenge\nneed two Hustlers.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You tryna run the Battle Castle\nMulti Battle challenge? {YESNO 0}</language>
	</row>
	<row id="msg_0109_D32R0501_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can team up with a homie for a\nMulti Battle challenge.\rBoth Hustlers get Castle Points\n(CP) to budget.\rCP is for healin’ homies,\nrentin’ items or Berries, all that.\rHustlers can spend CP on their own\nhomies AND their partner’s.\rBoth Hustlers earn CP by winnin’\nscraps.\rThe goal is to keep a win streak\nalive while you manage your CP.\rWin seven in a row, and you\nget Battle Points (BP).\rHeads up: a Battle Castle Multi\nBattle run can’t get paused.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back when you got the heart!</language>
	</row>
	<row id="msg_0109_D32R0501_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pick the homies you\nrollin’ in with.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo!\rYou ain’t got {STRVAR_1 50, 0, 0} homies\nthat qualify.\rYou need {STRVAR_1 50, 1, 0} different homies\nto get in.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Also, Eggs can’t get in. Obviously.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eggs and {STRVAR_1 0, 1, 0} are not allowed\nto enter.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eggs, {STRVAR_1 0, 1, 0}, and {STRVAR_1 0, 2, 0}\nare not allowed to enter.\r</language>
	</row>
	<row id="msg_0109_D32R0501_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eggs, {STRVAR_1 0, 1, 0}, {STRVAR_1 0, 2, 0},\nand {STRVAR_1 0, 3, 0} are not allowed\fto enter.\r</language>
	</row>
