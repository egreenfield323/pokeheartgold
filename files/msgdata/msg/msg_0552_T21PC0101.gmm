<?xml version="1.0"?>
<body language="English">
	<row id="msg_0552_T21PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Storin’ homies in the PC is free,\nunlimited, and nobody ask questions.\fBest deal in the whole city.</language>
	</row>
	<row id="msg_0552_T21PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That PC free for any Hustler.\nDon’t look at my search history tho.</language>
	</row>
	<row id="msg_0552_T21PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">They buildin’ a Communication Center\nupstairs.\rBeen “almost done” for six months.\nCity contract. You know how it is.</language>
	</row>
	<row id="msg_0552_T21PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Communication Center upstairs\nFINALLY done.\rI already traded my cousin a\nhomie. He ain’t know it was sick.</language>
	</row>
	<row id="msg_0552_T21PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Pokémon Wireless\nClub Union Room.\r...Oh, I’m just practicin’ my line.\nI been practicin’ for a year.\rUnion Room ain’t open yet. Union\nstill negotiatin’.</language>
	</row>
	<row id="msg_0552_T21PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Pokémon\nCommunication Club Colosseum.\r...Oh, I’m just practicin’ my line.\nI got a callback for this job!\rColosseum ain’t open yet.\nI’m just standin’ here. Unpaid.</language>
	</row>
</body>
