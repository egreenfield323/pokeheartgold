<?xml version="1.0"?>
<body language="English">
	<row id="msg_0411_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena’s Password</language>
	</row>
	<row id="msg_0411_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena</language>
	</row>
	<row id="msg_0411_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drama and documentaries!\nThis the Variety Hour Guy! Hi!</language>
	</row>
	<row id="msg_0411_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Variety Channel, a treasure\nchest full of laughs and tears!\nMostly tears!</language>
	</row>
	<row id="msg_0411_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Wassup, y’all! It’s Buena!\nTime for today’s password!\nToday’s password is...\n{STRVAR_34 18, 0, 0}!\nDon’t forget it!\nPull up on me at the\nGoldenrod City Radio Tower!</language>
	</row>
	<row id="msg_0411_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Wassup, y’all! It’s Buena!\nAll my listeners out there, y’all been\nto the Goldenrod City Radio Tower to\nget your Blue Card yet? Remember the\npassword we drop on the show, and\nslide to the Goldenrod Radio Tower.\nPull up on me on the second floor\nand tell me the password, you get\npoints on your card! Stack enough\npoints, and you can cash ’em in for\nsome FIRE prizes! Go hard stackin’\nthem points, y’all!</language>
	</row>
</body>
