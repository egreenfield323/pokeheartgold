<?xml version="1.0"?>
<body language="English">
	<row id="msg_0590_T25R0801_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One time in a scrap, my homie\ncouldn’t use NONE of its moves.\rIts PP was all gone. Outta ammo. It\njust stood there. Embarrassin’.</language>
	</row>
	<row id="msg_0590_T25R0801_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sometimes a healthy homie can’t use\nits moves. No PP. Like me with no\fcoffee.\rHeal it at a Trap House or use\nsomethin’.</language>
	</row>
</body>
