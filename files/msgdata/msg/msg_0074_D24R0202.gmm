<body language="English">
	<row id="msg_0074_D24R0202_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to this chamber!\rWe rebuildin’ old homie\nstone panels.\rTap a piece and hold it\nto spin it.\rTap a piece and slide it\nto move it around.\rWe think we can put ’em back\nwhere they was...</language>
	</row>
	<row id="msg_0074_D24R0202_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You rebuilt the stone panel?\rThat’s crazy!\nWe got an archaeology genius here!</language>
	</row>
