	<row id="msg_0265_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} said: “Kyuu~”\f(Ayo on GOD we up right now. Pockets\nfat, belly full, no opps in sight. It’s a\fbeautiful day in the hood, gang.)</language>
