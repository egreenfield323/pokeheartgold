	<row id="msg_0265_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} said: “Pyaa!”\f(Deadass you the realest trainer on\nthe block. You ain’t never traded me,\fnever boxed me. That’s day one loyalty,\nfr fr.)</language>
