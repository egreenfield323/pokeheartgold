<?xml version="1.0"?>
<body language="English">
	<row id="msg_0461_T03FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LOOK! I got a GYARADOS!\rI raised it SLOW from a MAGIKARP.\nTook me four years. My wife left.\fWorth it.</language>
	</row>
	<row id="msg_0461_T03FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There used to be a weird old man\nsellin’ MAGIKARP. Scammer. $500 a\fpop.\rThat boy got one and kept it\nFOREVER! Sunk cost fallacy, baby!</language>
	</row>
</body>
