<?xml version="1.0"?>
<body language="English">
	<row id="msg_0706_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kenji</language>
	</row>
	<row id="msg_0706_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Our scrap was REMARKABLE!\rI wish for somethin’ to remember you\nby!\rPerhaps your number will do?\rMy trainin’ make it impossible to chat\nmuch, but... HAI! {YESNO 0}</language>
	</row>
	<row id="msg_0706_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I must train harder to become the\nMIGHTIEST! HIYAAAH!</language>
	</row>
	<row id="msg_0706_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you decide you want my number, come\nfind me.</language>
	</row>
	<row id="msg_0706_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My trainin’ make chattin’ tough.\nSo, take down my number? {YESNO 0}</language>
	</row>
	<row id="msg_0706_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today I say good looks, {STRVAR_1 3, 0, 0}!\rI train alone... Nobody calls.\nNot even my mom.\r{STRVAR_1 3, 0, 0}! Take this! HAI!\r</language>
	</row>
	<row id="msg_0706_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your strength can’t let you carry\nanother thing! I’ll hold this till you\flighten your Bag!</language>
	</row>
	<row id="msg_0706_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">’Scuse me?\nIf you right nearby, I’d appreciate\fthe respect of talkin’ face-to-face!</language>
	</row>
	<row id="msg_0706_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You still on your journey?\nI remain locked in on my trainin’.\fOOOOOOAAARRRGH!\f...Sorry. That was a punch.</language>
	</row>
	<row id="msg_0706_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My apologies, but I ain’t got time to\nchat while I’m trainin’!\rI’ll have time tomorrow!\nYIIIHAH! ...I hit the phone. Hold on.</language>
	</row>
	<row id="msg_0706_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m finna take a lunch break, so come\nvisit me then!\fAYIIIYAH! That’s how I order lunch.</language>
	</row>
	<row id="msg_0706_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m takin’ a break on Route 45!\nWhy not slide through? We can scrap!</language>
	</row>
	<row id="msg_0706_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I rested up on my lunch break.\nNow, back to trainin’!\fOOORYAAH! I’m full. I’m VERY full.</language>
	</row>
</body>
