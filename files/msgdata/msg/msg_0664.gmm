<?xml version="1.0"?>
<body language="English">
	<row id="msg_0664_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mother</language>
	</row>
	<row id="msg_0664_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup? {STRVAR_1 3, 0, 0}?\rI’m so used to hearin’ your\nvoice, but you sound like\fa whole different person on the phone.\fIt’s so weird...</language>
	</row>
	<row id="msg_0664_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup? {STRVAR_1 3, 0, 0}?\rI’m so used to hearin’ your\nvoice, but you sound like\fa whole different person on the phone.\fIt’s so weird...</language>
	</row>
	<row id="msg_0664_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nThat sound real tough.\rBut, {STRVAR_1 3, 0, 0}, I know you\nlocked in. You gon’ be OK, right?</language>
	</row>
	<row id="msg_0664_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}!\nAin’t Professor Elm waitin’ on you?</language>
	</row>
	<row id="msg_0664_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}!\nSo, how that errand goin’ you\fhelpin’ Professor Elm with?\rI know you locked in. You gon’ be OK!</language>
	</row>
	<row id="msg_0664_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rAyo, {STRVAR_1 3, 0, 0}! If you done with\nyour errand, c’mon home, baby.</language>
	</row>
	<row id="msg_0664_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}!\nWhat’s goin’ on? How you gettin’\falong with your homies?\rYou know, I found if you show\nyour homies love, they\fshow it right back.\r</language>
	</row>
	<row id="msg_0664_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nYou in Cherrygrove City?\rYou know, you real close...\nWhy not come home for a bit?\r</language>
	</row>
	<row id="msg_0664_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nOh, so you in Violet City...\rAin’t that where Sprout Tower\nat? You go check it out?\r</language>
	</row>
	<row id="msg_0664_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nOh, so you in Azalea Town...\rAin’t that where the SLOWPOKE Well\nat? You go check it out?\r</language>
	</row>
	<row id="msg_0664_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nOh, so you in Cianwood City...\rAin’t that where they buildin’ that\nSafari Zone? It open yet?\r</language>
	</row>
	<row id="msg_0664_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nOh, so you in Goldenrod City...\rAin’t that where the Radio Tower\nat? You go check it out?\r</language>
	</row>
	<row id="msg_0664_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nOh, so you in Olivine City...\rAin’t that where that big Lighthouse\nat? You go check it out?\r</language>
	</row>
	<row id="msg_0664_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nOh, so you in Ecruteak City...\rAin’t that where the Bell Tower\nat? You go check it out?\r</language>
	</row>
	<row id="msg_0664_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nSheesh, you in {STRVAR_1 4, 2, 0}?\rGood luck on your homie quest!\r</language>
	</row>
	<row id="msg_0664_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\rSheesh, you in {STRVAR_1 4, 2, 0}?\rWell, as your mama, I know you doin’\nyour best wherever you go!\r</language>
	</row>
	<row id="msg_0664_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! You sound happy!\nI feel SO much better!\r</language>
	</row>
	<row id="msg_0664_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\nThat sound real tough.\rBut, {STRVAR_1 3, 0, 0}, I know you\nlocked in. You gon’ be OK, right?\r</language>
	</row>
	<row id="msg_0664_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! Grindin’?\rYou in KANTO?! Sheesh, that’s\nwonderful, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0664_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! You tryin’\nthe Pokéathlon? Do your best!\fMama cheerin’ you on!\r</language>
	</row>
	<row id="msg_0664_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ain’t picked up that stuff\nI bought you yet, have you?\rDon’t forget to hit the Corner\nStore and holla at the delivery guy.</language>
	</row>
	<row id="msg_0664_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\r...{STRVAR_1 3, 0, 0}?\rProfessor Elm told me you\nwent on a long trip.\rI wish you woulda told me...\nWhat about your bread? Want me to\fstash it?</language>
	</row>
	<row id="msg_0664_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By the way, you got ${STRVAR_1 55, 10, 0} stashed.\nYou wanna keep stackin’?</language>
	</row>
	<row id="msg_0664_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By the way, {STRVAR_1 3, 0, 0}, you got\n${STRVAR_1 55, 10, 0} stashed.\fWanna start stackin’ again?</language>
	</row>
	<row id="msg_0664_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. I’ll stash your bread.\r{STRVAR_1 3, 0, 0}, keep goin’! I’m rootin’\nfor you, baby!</language>
	</row>
	<row id="msg_0664_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. I won’t stash your bread.\r{STRVAR_1 3, 0, 0}, keep goin’! I’m rootin’\nfor you, baby!</language>
	</row>
	<row id="msg_0664_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s important to\nstack your bread.</language>
	</row>
	<row id="msg_0664_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, {STRVAR_1 3, 0, 0}, you ain’t stackin’\nno bread. You wanna stack? {YESNO 0}</language>
	</row>
	<row id="msg_0664_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\rOh, ayo, {STRVAR_1 3, 0, 0}! How you livin’?\rI found somethin’ useful shoppin’,\nso I copped it with YOUR bread. Sorry!\rBut I told the delivery guy to drop it\nto you, so stop by the\fclosest Corner Store or Dept. Store\fand grab it! It’s gon’ be useful!</language>
	</row>
</body>
