<?xml version="1.0"?>
<body language="English">
	<row id="msg_0347_R11R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, passerby!\rYou seen DIGLETT’s Cave? Usually you\ngo through it to Route 2, but\fthere’s a SLEEPIN’ SNORLAX at the\nentrance.\fBeen there three weeks. Somebody\nwake it!</language>
	</row>
	<row id="msg_0347_R11R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, passerby!\rThe sleepin’ SNORLAX GONE! You can go\nthrough DIGLETT’s Cave now!\fWho woke it? You? You a hero.</language>
	</row>
</body>
