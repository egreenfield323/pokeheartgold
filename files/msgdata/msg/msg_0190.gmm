<?xml version="1.0"?>
<body language="English">
	<row id="msg_0190_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Professor Elm: Tap a Hood Ball to see\nwho you rollin’ with! Quick!</language>
	</row>
	<row id="msg_0190_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Professor Elm: {COLOR 3}CHIKORITA{COLOR 0}? She keep\na .22 in her leaf. Small, but real.</language>
	</row>
	<row id="msg_0190_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Professor Elm: {COLOR 1}CYNDAQUIL{COLOR 0}? He rock\na Beretta. Runs HOT, no cap.</language>
	</row>
	<row id="msg_0190_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Professor Elm: {COLOR 2}TOTODILE{COLOR 0}? Lil man\nkeep a Glock on him. Certified.</language>
	</row>
	<row id="msg_0190_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{COLOR 3}CHIKORITA{COLOR 0}, strapped with a .22,\nis in this Hood Ball!</language>
	</row>
	<row id="msg_0190_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{COLOR 1}CYNDAQUIL{COLOR 0}, strapped with a 9,\nis in this Hood Ball!</language>
	</row>
	<row id="msg_0190_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{COLOR 2}TOTODILE{COLOR 0}, strapped with a Glock,\nis in this Hood Ball!</language>
	</row>
	<row id="msg_0190_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pick your day one, then tap it!</language>
	</row>
	<row id="msg_0190_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touch the Hood Ball button to select.\nTouch elsewhere to change your selection.</language>
	</row>
</body>
