<?xml version="1.0"?>
<body language="English">
	<row id="msg_0500_T07R0107_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup.\rWhat floor you goin’ to? {YESNO 0}</language>
	</row>
	<row id="msg_0500_T07R0107_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Can’t wait to serve you again.</language>
	</row>
	<row id="msg_0500_T07R0107_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bet.\nGoin’ up!\r</language>
	</row>
	<row id="msg_0500_T07R0107_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bet.\nGoin’ down!\r</language>
	</row>
	<row id="msg_0500_T07R0107_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... We already on that floor?</language>
	</row>
	<row id="msg_0500_T07R0107_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First floor got the Service Counter\nand the main entrance.</language>
	</row>
	<row id="msg_0500_T07R0107_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Second floor got the Hustler’s Market\nwhere you buy everythin’ you need.</language>
	</row>
	<row id="msg_0500_T07R0107_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Third floor got the TM Shop\nto power up your homies.</language>
	</row>
	<row id="msg_0500_T07R0107_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fourth floor got Wiseman Gifts,\nwith the perfect gifts.</language>
	</row>
	<row id="msg_0500_T07R0107_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fifth floor got the Battle Collection\nto raise stats.</language>
	</row>
	<row id="msg_0500_T07R0107_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sixth floor got the Rooftop Atrium\nfor a nice break.</language>
	</row>
</body>
