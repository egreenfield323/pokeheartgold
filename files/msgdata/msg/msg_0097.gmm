<?xml version="1.0"?>
<body language="English">
	<row id="msg_0097_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your homies healed to full.\nThe Tower take care of its own.</language>
	</row>
	<row id="msg_0097_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You will be facin’ opponent no. {STRVAR_1 50, 0, 0}.\nAre you ready?</language>
