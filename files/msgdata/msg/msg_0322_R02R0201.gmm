	<row id="msg_0322_R02R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s a Gold Grill.\rI can’t give you no wisdom, so that\ngon’ gotta do. Bite down. Feel rich.</language>
