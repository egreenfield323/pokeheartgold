	<row id="msg_0322_R02R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my GOOD GRILLS! You the first\nvisitor I had in YEARS.\rI’m goin’ CRAZY with joy! My cat left!\rYou look bright as a Gold Grill, so\nlemme give you a lil present.\r</language>
