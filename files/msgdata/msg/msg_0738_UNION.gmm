		<language name="English">The chat ended.</language>
	</row>
	<row id="msg_0738_UNION_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You have an offer to see\n{STRVAR_1 3, 0, 0}’s Trainer Card.\rWould you like to show your\nTrainer Card? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is the Trainer Card of\n{STRVAR_1 3, 0, 0}, who lives in\f{STRVAR_1 37, 4, 0},\f{STRVAR_1 36, 3, 0}.</language>
	</row>
	<row id="msg_0738_UNION_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is the Trainer Card of\n{STRVAR_1 3, 0, 0}, who lives in\f{STRVAR_1 36, 3, 0}.\n</language>
	</row>
	<row id="msg_0738_UNION_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is the Trainer Card of\n{STRVAR_1 3, 0, 0}, who lives in\f{STRVAR_1 37, 4, 0}.\n</language>
	</row>
	<row id="msg_0738_UNION_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is {STRVAR_1 3, 0, 0}’s\nTrainer Card.</language>
	</row>
	<row id="msg_0738_UNION_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waitin’ on the other player to finish.</language>
	</row>
	<row id="msg_0738_UNION_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You said nah.</language>
	</row>
	<row id="msg_0738_UNION_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} has invited you to draw\nsomethin’.\rWould you like to join the other\nplayer and draw? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s get drawin’!</language>
	</row>
	<row id="msg_0738_UNION_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You said nah.</language>
	</row>
	<row id="msg_0738_UNION_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} wanna scrap\nyou.\rYou down to\nscrap? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The scrap ’bout to start.</language>
	</row>
	<row id="msg_0738_UNION_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You said nah.</language>
	</row>
	<row id="msg_0738_UNION_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">For a scrap, you need two\nhomies that’s Lv. 30 or below.</language>
	</row>
	<row id="msg_0738_UNION_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The scrap got canceled.</language>
	</row>
	<row id="msg_0738_UNION_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} has offered to\nmake a trade.\rWill you accept this trade offer? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The trade ’bout to start.</language>
	</row>
	<row id="msg_0738_UNION_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You said nah.</language>
	</row>
	<row id="msg_0738_UNION_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To trade, you gotta have at\nleast two homies with you.</language>
	</row>
	<row id="msg_0738_UNION_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} invites you to mix\nrecords.\rWould you like to mix records with\nthe other player? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Record mixin’ will be started.</language>
	</row>
	<row id="msg_0738_UNION_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You said nah.</language>
	</row>
	<row id="msg_0738_UNION_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} has invited you to join\na Spin Trade session.\rWould you like to take part in the\nSpin Trade? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starting the Spin Trade!</language>
	</row>
	<row id="msg_0738_UNION_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You said nah.</language>
	</row>
	<row id="msg_0738_UNION_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ain’t got a Egg.\nThe invite got turned down.</language>
	</row>
	<row id="msg_0738_UNION_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 2, 0}{PAUSE 15}\rThis is {STRVAR_1 3, 0, 0}! Is there\nsomethin’ that you wanted to do?</language>
	</row>
	<row id="msg_0738_UNION_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whoops! My bad, I gotta go do\nsomethin’ else.\fAnother time, OK?</language>
	</row>
	<row id="msg_0738_UNION_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna do\nanythin’ else?</language>
	</row>
	<row id="msg_0738_UNION_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">... ...\nThe Hustler look busy...</language>
	</row>
	<row id="msg_0738_UNION_00041" index="41">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0738_UNION_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bet! To say wassup, lemme\nshow you my Trainer Card.</language>
	</row>
	<row id="msg_0738_UNION_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? My Trainer Card...\nWhere it go?\rMy bad! I’ll show you another time!</language>
	</row>
	<row id="msg_0738_UNION_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m just showin’ my Trainer Card\nto say wassup.</language>
	</row>
	<row id="msg_0738_UNION_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hope I get to know you better!</language>
	</row>
	<row id="msg_0738_UNION_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you wanna draw with me?\nBet, but hold up a sec.</language>
	</row>
	<row id="msg_0738_UNION_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for waitin’!\nLet’s get drawin’!</language>
	</row>
	<row id="msg_0738_UNION_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, my bad! I can’t right now.\nLet’s draw another time.</language>
	</row>
	<row id="msg_0738_UNION_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: We drawin’ right\nnow.\rOh, I know! {STRVAR_1 3, 1, 0}, would\nyou like to draw with us? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, aight.\nCome see me anytime, OK?</language>
	</row>
	<row id="msg_0738_UNION_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! Let’s do some drawin’\ntogether!</language>
	</row>
	<row id="msg_0738_UNION_00052" index="52">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0738_UNION_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The last letter of what you draw\ngotta be the first letter of mine?</language>
	</row>
	<row id="msg_0738_UNION_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stop drawin’ funny faces!\nIt hurt to laugh this much!</language>
	</row>
	<row id="msg_0738_UNION_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh, you nice!\nI’mma copy you!</language>
	</row>
	<row id="msg_0738_UNION_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Uh-huh... What is that?\nThat’s supposed to be ME?</language>
	</row>
	<row id="msg_0738_UNION_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap? Bet, but I need\ntime to get ready.</language>
	</row>
	<row id="msg_0738_UNION_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for waitin’!\nLet’s get this scrap goin’!</language>
	</row>
	<row id="msg_0738_UNION_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My bad! My homies ain’t\nfeelin’ too good right now.\fLet’s scrap another time.</language>
	</row>
	<row id="msg_0738_UNION_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you wanna scrap, you need two\nhomies that’s Lv. 30 or lower.\r</language>
	</row>
	<row id="msg_0738_UNION_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whoa!\nI can tell you tough!</language>
	</row>
	<row id="msg_0738_UNION_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You used THAT move?\nThat’s big brain!</language>
	</row>
	<row id="msg_0738_UNION_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Way to go!\nThat was a eye-opener!</language>
	</row>
	<row id="msg_0738_UNION_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! How you gon’ use that\nhomie in that situation?</language>
	</row>
	<row id="msg_0738_UNION_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You tryna trade, huh?\nBet, hold up a sec.</language>
	</row>
	<row id="msg_0738_UNION_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight!\nLet’s trade!</language>
	</row>
	<row id="msg_0738_UNION_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My bad! I ain’t got a homie I\ncan trade right now.\rLet’s trade some other time.</language>
	</row>
	<row id="msg_0738_UNION_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh yeah!\nI REALLY wanted this homie!</language>
	</row>
	<row id="msg_0738_UNION_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Finally, I got that homie\nI wanted for SO long.</language>
	</row>
	<row id="msg_0738_UNION_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t trade if you only got one\nhomie with you.\r</language>
	</row>
	<row id="msg_0738_UNION_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you wanna do somethin’ with\nme, just holla!</language>
	</row>
	<row id="msg_0738_UNION_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna mix records with me?\nOK, I just need a lil time.</language>
	</row>
	<row id="msg_0738_UNION_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for waitin’!\nLet’s mix our records, then.</language>
	</row>
	<row id="msg_0738_UNION_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, my bad.\nI got too much goin’ on right now.\fAnother time, OK?</language>
	</row>
	<row id="msg_0738_UNION_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: We finna mix our\nrecords now.\rI know! {STRVAR_1 3, 1, 0}, do you want\nto mix your records with us, too? {YESNO 0}</language>
	</row>
	<row id="msg_0738_UNION_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, aight.\nCome see me anytime, OK?</language>
	</row>
	<row id="msg_0738_UNION_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! Let’s mix our records!</language>
	</row>
	<row id="msg_0738_UNION_00078" index="78">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0738_UNION_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mixin’ records is fun!</language>
	</row>
	<row id="msg_0738_UNION_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m finna mix records with\neverybody!</language>
	</row>
	<row id="msg_0738_UNION_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mix it up! Keep mixin’!</language>
	</row>
	<row id="msg_0738_UNION_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You should mix records too!</language>
	</row>
	<row id="msg_0738_UNION_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spin Trade? Bet!\nOK, just hold up a sec!</language>
	</row>
	<row id="msg_0738_UNION_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, all set!\nLet’s do a Spin Trade!</language>
	</row>
	<row id="msg_0738_UNION_00085" index="85">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0738_UNION_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You need a Egg if you wanna\njoin a Spin Trade.\r</language>
	</row>
	<row id="msg_0738_UNION_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: We finna do a Spin\nTrade now.\rAyo, {STRVAR_1 3, 1, 0}! Do you wanna join\nus for a Spin Trade, too?</language>
	</row>
	<row id="msg_0738_UNION_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, OK.\nCome see us anytime!</language>
	</row>
	<row id="msg_0738_UNION_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK!\nLet’s do a Spin Trade together!</language>
	</row>
	<row id="msg_0738_UNION_00090" index="90">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
