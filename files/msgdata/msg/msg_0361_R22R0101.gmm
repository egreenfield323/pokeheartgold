<?xml version="1.0"?>
<body language="English">
	<row id="msg_0361_R22R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Only Hustlers who PROVED themselves\ncan go through.\rOh! The eight Chains of Johto! Go\nright on through! Watch your neck.</language>
	</row>
	<row id="msg_0361_R22R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This way go to Mt. Silver.\rScary-strong homies out there. You\nain’t ready. I can tell by your face.</language>
	</row>
	<row id="msg_0361_R22R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This way go to Mt. Silver.\rScary-strong homies out there. You\nain’t ready. I can tell by your face.\r</language>
	</row>
	<row id="msg_0361_R22R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This way go to Mt. Silver.\rScary-strong homies out there.\rBut you should be aight. Just bring a\ncoat. It’s COLD up there.</language>
	</row>
	<row id="msg_0361_R22R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nThis way go to Kanto...\fBut this path blocked for\fnow, I’m afraid.</language>
	</row>
	<row id="msg_0361_R22R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hold up!\rThis way go to Kanto...\nBut this path blocked for\fnow, I’m afraid.\r</language>
	</row>
	<row id="msg_0361_R22R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">West to Mt. Silver.\nEast to the Kanto region.\rGo north for the Elite Four!\nBut you know that already,\fsince you beat the Kingpin!</language>
	</row>
	<row id="msg_0361_R22R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: I’m bringin’ my dad his lunch.\nThe Elite Four don’t get no breaks!\rHe’d starve without me. He a ninja\nwho can’t cook.\rSay! Wanna swap numbers? {YESNO 0}</language>
	</row>
	<row id="msg_0361_R22R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Janine’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0361_R22R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Call me Monday around noon\nif you wanna scrap!</language>
	</row>
	<row id="msg_0361_R22R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: You don’t look scared, but\nyou scared, ain’t you? I can tell.\fNinja senses.</language>
	</row>
	<row id="msg_0361_R22R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Now you want\nmy number, huh? {YESNO 0}</language>
	</row>
	<row id="msg_0361_R22R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: I’m done bringin’ my dad\nlunch. He ate it in two seconds. Ninja\fspeed.\rWanna take a pic with me? {YESNO 0}</language>
	</row>
	<row id="msg_0361_R22R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Can you look as HARD as me\nfor the pic? Ninja face. Like this.\r</language>
	</row>
	<row id="msg_0361_R22R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Don’t you think we look\ngood in the pic?</language>
	</row>
	<row id="msg_0361_R22R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: That’s a shame!</language>
	</row>
	<row id="msg_0361_R22R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete\nsome pics.</language>
	</row>
</body>
