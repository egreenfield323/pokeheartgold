	</row>
	<row id="msg_0441_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} chose to retire.</language>
	</row>
	<row id="msg_0441_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You cleared your TENTH Battle Hall\nmatch! Congratulations!\rFor that stupendous streak, you AND\n{STRVAR_1 0, 0, 0} get BP!\r</language>
	</row>
	<row id="msg_0441_00015" index="15">
		<attribute name="window_context_name">used</attribute>
