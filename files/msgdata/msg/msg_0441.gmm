	<row id="msg_0441_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} will be fully restored.\nIt deserve it. It’s the star.</language>
	</row>
	<row id="msg_0441_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle no. {STRVAR_1 53, 0, 0} is next!\nAre you ready?</language>
	</row>
	<row id="msg_0441_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Would you like to save the last battle\nas your Battle Video?</language>
	</row>
	<row id="msg_0441_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}’s battle has been saved\nas a Battle Video.\r</language>
	</row>
	<row id="msg_0441_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There was an error.\nThe Battle Video couldn’t be saved.</language>
	</row>
	<row id="msg_0441_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Delete your existin’ Battle Video and\nsave the last battle?</language>
	</row>
	<row id="msg_0441_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saving...\nDon’t turn off the power.</language>
	</row>
	<row id="msg_0441_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Would you like to save and take a break\nfrom playin’?</language>
	</row>
	<row id="msg_0441_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Would you like to retire from this\nBattle Hall challenge?</language>
	</row>
	<row id="msg_0441_00011" index="11">
		<attribute name="window_context_name">used</attribute>
