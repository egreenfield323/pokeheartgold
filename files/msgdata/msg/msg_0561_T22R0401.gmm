	<row id="msg_0561_T22R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">She name ALL her homies after\nfood.\rLike ALL of ’em. Her RATTATA name\nChicken Alfredo. It’s a problem.</language>
	</row>
	<row id="msg_0561_T22R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who are you?! Put my remote\ndown. Slowly. Real slow.\rI named my PIDGEY Strawberry.\nLaugh and I’m callin’ my brother.</language>
	</row>
	<row id="msg_0561_T22R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strawberry: PIJJI!!</language>
	</row>
