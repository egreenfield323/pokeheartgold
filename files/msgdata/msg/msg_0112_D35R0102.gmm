<?xml version="1.0"?>
<body language="English">
	<row id="msg_0112_D35R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO!\nIntruder! INTRUDER! Code red!\fSomebody call for backup!\r</language>
	</row>
	<row id="msg_0112_D35R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My turn, lil bro!\nYou under ARREST! Hands behind\fyour back! Or whatever!\r</language>
	</row>
	<row id="msg_0112_D35R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a PERSIAN statue...\nIts eyes glowin’ red...\rYou feel like somebody\nwatchin’... A Fed in the van, prob’ly.</language>
	</row>
	<row id="msg_0112_D35R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a PERSIAN statue...\nIts eyes glowin’ blue...\rYou don’t feel nobody\nwatchin’ you...</language>
	</row>
	<row id="msg_0112_D35R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The PERSIAN statue’s eyes\nain’t glowin’ no more...</language>
	</row>
	<row id="msg_0112_D35R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A secret switch!\rThe red switch flashin’ real\nsuspicious.\fYou gon’ press it? {YESNO 0}</language>
	</row>
	<row id="msg_0112_D35R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A secret switch!\rThe blue switch lit.\fYou gon’ press it? {YESNO 0}</language>
	</row>
	<row id="msg_0112_D35R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Better press it.\r</language>
	</row>
	<row id="msg_0112_D35R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The secret switch ain’t lit no more...</language>
	</row>
	<row id="msg_0112_D35R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The surveillance system off!</language>
	</row>
	<row id="msg_0112_D35R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The surveillance system on!</language>
	</row>
</body>
