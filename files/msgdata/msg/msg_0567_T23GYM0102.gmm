<?xml version="1.0"?>
<body language="English">
	<row id="msg_0567_T23GYM0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: I’m Bugsy! I NEVER lose when\nit come to Bug-type homies.\rI’m gon’ be THE authority on bugs.\nI got a podcast. Two listeners.\rLemme show you what I learned!\r</language>
	</row>
	<row id="msg_0567_T23GYM0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: Whoa! You a homie EXPERT!\rMy research ain’t done yet...\nAight, you win. Take this Chain.\fDon’t tell my podcast.\r</language>
	</row>
	<row id="msg_0567_T23GYM0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} got\nthe Hive Chain from Bugsy!</language>
	</row>
	<row id="msg_0567_T23GYM0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: You know what the\nHive Chain do?\rWith it, homies up to Lv. 30\nlisten to you, even traded ones.\rHomies that know Shank can use\nit outside of battle too.\rHere, I want you to have this too.\r</language>
	</row>
	<row id="msg_0567_T23GYM0102_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0567_T23GYM0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: TM89 is U-Turn.\rYour homie hit ’em, then tag\nout with the next homie\fin your crew.\rAin’t that hard?</language>
	</row>
	<row id="msg_0567_T23GYM0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bug types go DEEP. Mad mysteries.\rStudy your favorites, fr. Like I study\nbugs. Instead of goin’ outside.</language>
	</row>
</body>
