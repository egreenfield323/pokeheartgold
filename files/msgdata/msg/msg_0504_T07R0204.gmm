	<row id="msg_0504_T07R0204_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How’d you even get in here?!\nI keep a bat by the door, bro.\rHigh places--I do love them so!\rI’d say the only thing that loves\nheights as much as me is smoke!</language>
	</row>
</body>
