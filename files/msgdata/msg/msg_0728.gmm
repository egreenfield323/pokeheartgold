	<row id="msg_0728_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmph. Just like I thought. You’re\nnobody.\n</language>
	</row>
	<row id="msg_0728_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not in front of the whole block,\nman...\n</language>
	</row>
	<row id="msg_0728_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s what I thought. Stay off my\nblock!\n</language>
	</row>
	<row id="msg_0728_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The pigeons stay with me till the\nend!\n</language>
	</row>
	<row id="msg_0728_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t fold, birds! Don’t fold!\n</language>
	</row>
	<row id="msg_0728_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My pops ran this block with\npigeons... and I lost it.\n</language>
	</row>
	<row id="msg_0728_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One lookout left! He sees\nEVERYTHING!\n</language>
	</row>
	<row id="msg_0728_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hang in there, lil homie!\n</language>
	</row>
	<row id="msg_0728_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Man... I’m too young for this.\n</language>
	</row>
	<row id="msg_0728_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My MILTANK is undefeated! Don’t\nyou DARE!\n</language>
	</row>
	<row id="msg_0728_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay UP! I’ll cry, I swear!\n</language>
	</row>
	<row id="msg_0728_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waaaah! You BULLY! I’m tellin’\nEVERYBODY!\n</language>
	</row>
	<row id="msg_0728_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t fight what you can’t\nsee...\n</language>
	</row>
	<row id="msg_0728_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay ghost, homie.\n</language>
	</row>
	<row id="msg_0728_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ve been ghosted... by YOU.\n</language>
	</row>
	<row id="msg_0728_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um... my last homie is made of\nsteel. Sorry.\n</language>
	</row>
	<row id="msg_0728_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">P-please be okay...\n</language>
	</row>
	<row id="msg_0728_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You’re... really good. Um. Bye.\n</language>
	</row>
	<row id="msg_0728_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAHAHAHA! One more! I can do push-\nups between rounds!\n</language>
	</row>
	<row id="msg_0728_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PAIN IS JUST WEAKNESS LEAVING THE\nBODY!\n</language>
	</row>
	<row id="msg_0728_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...My wife is gonna clown me so\nhard.\n</language>
	</row>
	<row id="msg_0728_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ve been ice cold since before\nyour parents was born.\n</language>
	</row>
	<row id="msg_0728_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hold firm. Like winter.\n</language>
	</row>
	<row id="msg_0728_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmph. The young blood got heat.\n</language>
	</row>
	<row id="msg_0728_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m the Drama Queen! I NEVER lose!\n</language>
	</row>
	<row id="msg_0728_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t you dare embarrass me!\n</language>
	</row>
	<row id="msg_0728_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is NOT happening right now!\n</language>
	</row>
	<row id="msg_0728_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The pigeons stay with me till the\nend!\n</language>
	</row>
	<row id="msg_0728_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t fold, birds! Don’t fold!\n</language>
	</row>
