	<row id="msg_0728_01140" index="1140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Youngblood! Let the Old Head teach\nyou somethin’.\r</language>
	</row>
	<row id="msg_0728_01141" index="1141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Man, I’m finna move to the\nsuburbs.\n</language>
	</row>
	<row id="msg_0728_01142" index="1142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t come back around here.\n...Unless you got snacks.\n</language>
	</row>
	<row id="msg_0728_01143" index="1143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Back in MY day, we battled uphill\nboth ways!\r</language>
	</row>
	<row id="msg_0728_01144" index="1144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah, yeah, take your little win\nand go.\n</language>
	</row>
	<row id="msg_0728_01145" index="1145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If your homies is hurt, hit up the\nTrap House. They patch you up\ffree.\n</language>
	</row>
	<row id="msg_0728_01146" index="1146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you vote? Me neither. Let’s\nfight about it anyway!\r</language>
	</row>
	<row id="msg_0728_01147" index="1147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not in front of the whole block,\nman...\n</language>
	</row>
	<row id="msg_0728_01148" index="1148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m just out here tryna get my\nbread up, man.\n</language>
	</row>
	<row id="msg_0728_01149" index="1149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aye! You lookin’ at me? Nah, you\nwas DEFINITELY lookin’ at me.\r</language>
	</row>
	<row id="msg_0728_01150" index="1150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nah, my controller was off.\n</language>
	</row>
	<row id="msg_0728_01151" index="1151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Real recognize real. Go ’head and\npass.\n</language>
	</row>
	<row id="msg_0728_01152" index="1152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Square up! My homies ready, I’m\nready, my grandma’s ready.\r</language>
