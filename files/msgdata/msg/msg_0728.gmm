	<row id="msg_0728_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This why I don’t leave the porch.\n</language>
	</row>
	<row id="msg_0728_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My landlord got a “Love Is Love”\nsign AND raised my rent 40%.\fBattle me!\r</language>
	</row>
	<row id="msg_0728_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bro really came in here and did\nthat.\n</language>
	</row>
	<row id="msg_0728_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m just out here tryna get my\nbread up, man.\n</language>
	</row>
	<row id="msg_0728_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s always the quiet ones...\nLet’s get it!\r</language>
	</row>
	<row id="msg_0728_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Okay, okay. I was lettin’ you win.\n</language>
	</row>
	<row id="msg_0728_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t tell my mama I lost.\n</language>
	</row>
	<row id="msg_0728_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nah, nah. You gotta pay the toll\nto walk past me.\r</language>
	</row>
	<row id="msg_0728_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Man, I’m finna move to the\nsuburbs.\n</language>
	</row>
	<row id="msg_0728_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My uncle voted for both parties in\nthe same election. Respect.\n</language>
	</row>
	<row id="msg_0728_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Me and my twin run this block!\r</language>
	</row>
	<row id="msg_0728_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twin... we cooked.\n</language>
	</row>
	<row id="msg_0728_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We still run this block. Just...\nnot today.\n</language>
	</row>
	<row id="msg_0728_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You need at least two homies to\nfight us!\n</language>
	</row>
	<row id="msg_0728_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah! Two-on-one! Wait, it’s two-\non-two.\r</language>
	</row>
	<row id="msg_0728_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bro, it’s your fault.\n</language>
	</row>
	<row id="msg_0728_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t tell Mama.\n</language>
	</row>
	<row id="msg_0728_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back with backup!\n</language>
	</row>
	<row id="msg_0728_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You stepped on my J’s! Now we\ngotta battle.\r</language>
	</row>
	<row id="msg_0728_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m tellin’ my cousin about you.\n</language>
	</row>
	<row id="msg_0728_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got hands, I’ll give you that.\n</language>
	</row>
	<row id="msg_0728_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Back in MY day, we battled uphill\nboth ways!\r</language>
	</row>
	<row id="msg_0728_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t no way. AIN’T NO WAY.\n</language>
	</row>
	<row id="msg_0728_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t come back around here.\n...Unless you got snacks.\n</language>
	</row>
	<row id="msg_0728_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This my block. You ain’t from\naround here, huh?\r</language>
	</row>
	<row id="msg_0728_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not in front of the whole block,\nman...\n</language>
	</row>
	<row id="msg_0728_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Politicians been promisin’ this\nblock a park since ’04. Still\fwaitin’.\n</language>
	</row>
	<row id="msg_0728_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You walked down the wrong street,\nlil bro.\r</language>
	</row>
	<row id="msg_0728_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nah, my controller was off.\n</language>
	</row>
	<row id="msg_0728_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Taxes took half my bread and the\npothole still there.\n</language>
	</row>
	<row id="msg_0728_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stop right there! This a no-\nloitering zone. Except for me.\r</language>
	</row>
	<row id="msg_0728_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My whole crew just got sent to the\nshadow realm.\n</language>
	</row>
	<row id="msg_0728_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You alright, I guess. For a\nnobody.\n</language>
	</row>
	<row id="msg_0728_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t no Wi-Fi out here. Only\nsmoke.\r</language>
	</row>
	<row id="msg_0728_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You fight like my grandma. That’s\na compliment.\n</language>
	</row>
	<row id="msg_0728_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My liberal arts degree said I’d be\na winner. Lies.\n</language>
	</row>
	<row id="msg_0728_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who let YOU out the house?\r</language>
	</row>
	<row id="msg_0728_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bro really came in here and did\nthat.\n</language>
	</row>
	<row id="msg_0728_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t come back around here.\n...Unless you got snacks.\n</language>
	</row>
	<row id="msg_0728_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your rent is LATE. We settle this\nthe old-fashioned way.\r</language>
	</row>
	<row id="msg_0728_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bruh... that’s crazy.\n</language>
	</row>
	<row id="msg_0728_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I swear my crew is better on\nTuesdays.\n</language>
	</row>
	<row id="msg_0728_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tell your gang I said wassup...\nafter I beat ’em.\r</language>
	</row>
	<row id="msg_0728_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies is cooked...\n</language>
	</row>
	<row id="msg_0728_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t mad. I’m just disappointed\nin my crew.\n</language>
	</row>
	<row id="msg_0728_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies been waitin’ all day for\nsomebody to pull up.\r</language>
	</row>
	<row id="msg_0728_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Respect. ...Don’t tell nobody.\n</language>
	</row>
	<row id="msg_0728_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My liberal arts degree said I’d be\na winner. Lies.\n</language>
	</row>
	<row id="msg_0728_00345" index="345">
		<attribute name="window_context_name">used</attribute>
