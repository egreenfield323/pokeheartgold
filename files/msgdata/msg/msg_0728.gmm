<body language="English">
	<row id="msg_0728_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay up, homie! Stay up!\n</language>
	</row>
	<row id="msg_0728_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Man, I’m finna move to the\nsuburbs.\n</language>
	</row>
	<row id="msg_0728_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Too easy. Too easy!\n</language>
	</row>
	<row id="msg_0728_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nah, you good! Walk it off!\n</language>
	</row>
	<row id="msg_0728_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My whole crew just got sent to the\nshadow realm.\n</language>
	</row>
	<row id="msg_0728_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Haha! Go home and tell your mama!\n</language>
	</row>
	<row id="msg_0728_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nah, you good! Walk it off!\n</language>
	</row>
	<row id="msg_0728_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight, you got that. ONE time.\n</language>
	</row>
	<row id="msg_0728_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s what I thought. Stay off my\nblock!\n</language>
	</row>
	<row id="msg_0728_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t need a whole gang. I can\ndo this by myself!\n</language>
	</row>
	<row id="msg_0728_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Get up! I didn’t steal you from a\nlab to lose!\n</language>
	</row>
	<row id="msg_0728_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch... You only won ’cause your\nhomies is soft.\n</language>
	</row>
	<row id="msg_0728_00012" index="12">
		<attribute name="window_context_name">used</attribute>
