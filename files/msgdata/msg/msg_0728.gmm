		<language name="English">My MILTANK is undefeated! Don’t\nyou DARE!\n</language>
	</row>
	<row id="msg_0728_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay UP! I’ll cry, I swear!\n</language>
	</row>
	<row id="msg_0728_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waaaah! You BULLY! I’m tellin’\nEVERYBODY!\n</language>
	</row>
	<row id="msg_0728_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t fight what you can’t\nsee...\n</language>
	</row>
	<row id="msg_0728_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay ghost, homie.\n</language>
	</row>
	<row id="msg_0728_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ve been ghosted... by YOU.\n</language>
	</row>
	<row id="msg_0728_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um... my last homie is made of\nsteel. Sorry.\n</language>
	</row>
	<row id="msg_0728_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">P-please be okay...\n</language>
	</row>
	<row id="msg_0728_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You’re... really good. Um. Bye.\n</language>
	</row>
	<row id="msg_0728_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAHAHAHA! One more! I can do push-\nups between rounds!\n</language>
	</row>
	<row id="msg_0728_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PAIN IS JUST WEAKNESS LEAVING THE\nBODY!\n</language>
	</row>
	<row id="msg_0728_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...My wife is gonna clown me so\nhard.\n</language>
	</row>
	<row id="msg_0728_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ve been ice cold since before\nyour parents was born.\n</language>
	</row>
	<row id="msg_0728_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hold firm. Like winter.\n</language>
	</row>
	<row id="msg_0728_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmph. The young blood got heat.\n</language>
	</row>
	<row id="msg_0728_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m the Drama Queen! I NEVER lose!\n</language>
	</row>
	<row id="msg_0728_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t you dare embarrass me!\n</language>
	</row>
	<row id="msg_0728_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is NOT happening right now!\n</language>
	</row>
	<row id="msg_0728_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You walked down the wrong street,\nlil bro.\r</language>
	</row>
	<row id="msg_0728_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s cap! ...No, that was real.\n</language>
	</row>
	<row id="msg_0728_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The mayor came through once. For a\nphoto. Then he dipped.\n</language>
	</row>
	<row id="msg_0728_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This block is a safe space. For\nME. Not you.\r</language>
	</row>
	<row id="msg_0728_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Respect. ...Don’t tell nobody.\n</language>
	</row>
	<row id="msg_0728_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homie said Hot Chips heal you\nbetter than Band-Aids.\n</language>
	</row>
	<row id="msg_0728_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Me and my twin run this block!\r</language>
	</row>
	<row id="msg_0728_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twin... we cooked.\n</language>
	</row>
	<row id="msg_0728_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We still run this block. Just...\nnot today.\n</language>
	</row>
	<row id="msg_0728_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You need at least two homies to\nfight us!\n</language>
	</row>
	<row id="msg_0728_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah! Two-on-one! Wait, it’s two-\non-two.\r</language>
	</row>
	<row id="msg_0728_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bro, it’s your fault.\n</language>
	</row>
	<row id="msg_0728_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t tell Mama.\n</language>
	</row>
	<row id="msg_0728_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back with backup!\n</language>
	</row>
	<row id="msg_0728_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m watchin’ the block for the big\nhomies. Five-oh or YOU, same\fthing.\r</language>
	</row>
	<row id="msg_0728_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lag! That was lag!\n</language>
	</row>
	<row id="msg_0728_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay dangerous out here, lil bro.\n</language>
	</row>
