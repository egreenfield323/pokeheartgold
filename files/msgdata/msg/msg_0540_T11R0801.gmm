<?xml version="1.0"?>
<body language="English">
	<row id="msg_0540_T11R0801_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My daughter love copyin’ people.\rShe SO good at it, they call her\nCopycat. She did my voice and canceled\fmy cable.</language>
	</row>
	<row id="msg_0540_T11R0801_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My daughter is...unique...\rShe’d make homies, then her copyin’\nwould scare ’em off...\fShe only got a few homies. And a lawyer.</language>
	</row>
	<row id="msg_0540_T11R0801_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">She lost the Poké Doll a boy gave her\nthree years ago.\rSince then, her copyin’ got even\nBETTER. She grievin’ through\fimpressions.</language>
	</row>
	<row id="msg_0540_T11R0801_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BLISSEY: Bliisii!</language>
	</row>
</body>
