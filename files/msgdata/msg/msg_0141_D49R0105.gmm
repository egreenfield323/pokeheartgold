<?xml version="1.0"?>
<body language="English">
	<row id="msg_0141_D49R0105_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the “Trust” room.\rIt show how homies and people\nrely on each other.</language>
	</row>
	<row id="msg_0141_D49R0105_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Only Pokéathletes who came\nfirst in five courses with\fone homie can come in here.</language>
	</row>
	<row id="msg_0141_D49R0105_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the “Potential” room.\nGo on ahead.</language>
	</row>
	<row id="msg_0141_D49R0105_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To win Medals with different kinds\nof homies, you GOTTA believe in\fyour homies.</language>
	</row>
	<row id="msg_0141_D49R0105_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’d love to see my own shoes in here!</language>
	</row>
	<row id="msg_0141_D49R0105_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Dome got SO many\nother Domes inside it...</language>
	</row>
	<row id="msg_0141_D49R0105_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} checked the Medal!\r</language>
	</row>
	<row id="msg_0141_D49R0105_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People who entered the Pokéathlon\n50 times get honored here\ffor their never-quit spirit.</language>
	</row>
	<row id="msg_0141_D49R0105_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s your jersey with\nyour autograph on it!</language>
	</row>
	<row id="msg_0141_D49R0105_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People who dashed 5,000 times\nget honored here for\fbreakin’ the\flegendary record.</language>
	</row>
	<row id="msg_0141_D49R0105_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clean shoes!\nAnd they your model!</language>
	</row>
	<row id="msg_0141_D49R0105_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People who switched 200 times\nget honored here for great\fteamwork and their bond with\ftheir homies.</language>
	</row>
	<row id="msg_0141_D49R0105_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a hard flag!\nAnd it’s yours!</language>
	</row>
	<row id="msg_0141_D49R0105_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokéathlon Medals...\rThat’s proof of the grind\nof Pokéathletes AND homies.\rHomies that won all five\nMedals get called “Medalist Pokémon”\fto honor the trust they\fearned from their Pokéathlete.</language>
	</row>
	<row id="msg_0141_D49R0105_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ABRA: ...\n...\f...\rIt must be sleep!</language>
	</row>
	<row id="msg_0141_D49R0105_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DRATINI: Achoo!</language>
	</row>
</body>
