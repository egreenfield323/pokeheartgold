<?xml version="1.0"?>
<body language="English">
	<row id="msg_0511_T07SP0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My name Mr. Game! The Kanto location!\rMy heart RACE when people play my Coin\ngame! Literally! I got a pacemaker!\rMatter fact, that’s what I live for!\nYou look like a REAL challenger!\rPlay my Coin game! Win hard prizes!\fOr lose your house! {YESNO 0}</language>
	</row>
	<row id="msg_0511_T07SP0101_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XX</language>
	</row>
	<row id="msg_0511_T07SP0101_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXX</language>
	</row>
	<row id="msg_0511_T07SP0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AIGHT! Here go your Coin Case!\nFirst one’s free! They always are!\r</language>
	</row>
	<row id="msg_0511_T07SP0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Show me how you play and make my heart\nRACE! My pacemaker can take it!\r</language>
	</row>
	<row id="msg_0511_T07SP0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Playin’ my Coin game make your\nheart and my heart BOTH race,\fyou know?</language>
	</row>
	<row id="msg_0511_T07SP0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My name Mr. Game! The Kanto location!\rMy heart RACE when people play my Coin\ngame! Literally! I got a pacemaker!\rMatter fact, that’s what I live for!\nGo ’head and play!\fMake my heart RACE!</language>
	</row>
	<row id="msg_0511_T07SP0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Go ’head and play my Coin game!\nMake my heart RACE! My doctor said no!</language>
	</row>
	<row id="msg_0511_T07SP0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHAT A FEELIN’!\nNothin’ beat watchin’ the Coin game!\rOh! Almost forgot!\rGo to the buildin’ next door and trade\nyour Coins for prizes. Or keep playin’.\fKeep playin’.</language>
	</row>
	<row id="msg_0511_T07SP0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You came back to play\nmy Coin game?</language>
	</row>
	<row id="msg_0511_T07SP0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Looks like you need a Coin Case\nto play...\r</language>
	</row>
	<row id="msg_0511_T07SP0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mr. Game: Aha!\nYou must be here to play my Coin game!\rCome here, I’ll give you a Coin Case!</language>
	</row>
	<row id="msg_0511_T07SP0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mr. Game: Show me how you play and\nmake my heart race!\r</language>
	</row>
	<row id="msg_0511_T07SP0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mr. Game: Huh?\rWhy don’t you sit across from me\nand show me how you play?</language>
	</row>
	<row id="msg_0511_T07SP0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, future legend! You play this too?\rI been tryin’ for the prize homie for\nthree MONTHS. That game is RIGGED.\fI’m still playin’ though.</language>
	</row>
</body>
