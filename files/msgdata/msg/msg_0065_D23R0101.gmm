<?xml version="1.0"?>
<body language="English">
	<row id="msg_0065_D23R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to Goldenrod’s Radio Tower!</language>
	</row>
	<row id="msg_0065_D23R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to Goldenrod’s Radio Tower!\r...Or nah.\nMy bad, ain’t nobody gettin’\fin right now. The Feds said so.</language>
	</row>
	<row id="msg_0065_D23R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um, yes sir. I been tellin’ folks\nto kick rocks like you said...\fPlease don’t audit me. I got kids.</language>
	</row>
	<row id="msg_0065_D23R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We got a special Quiz promo!\rAnswer five questions right in a\nrow and win a Radio Card!\rLoad it in your Pokégear and you\ncan listen to the radio...\fanytime, anywhere!\rWanna try our Quiz? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First question!\rCan you check the Town Map on\nyour Pokégear? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Correct.\nSecond question!\rNIDORINA can only be female.\nTrue? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Correct.\nThird question!\rKurt, the Hood Ball plug, use\napricots to make ’em? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Correct again.\nFourth question!\rYou can’t use a TM on\nMAGIKARP. True? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh!\nOnly one more question.\rOn Professor Oak’s show,\nPokémon Talk, is he on with Marie? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bingo! You got it!\nCongrats!\fHere go your prize, a Radio Card!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} can listen to the\nradio on the Pokégear now!</language>
	</row>
	<row id="msg_0065_D23R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay tuned to our radio shows!</language>
	</row>
	<row id="msg_0065_D23R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, dear.\nSorry, that’s wrong.\fTry again!</language>
	</row>
	<row id="msg_0065_D23R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh. I see.\nCome see me if you change your mind.</language>
	</row>
	<row id="msg_0065_D23R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Ayooo!\nMy name Whitney!\rI heard about the Quiz for a Radio\nCard, so I came to get one...\rBut this Quiz is SO hard!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Sheesh, you did it!\nI was SURE the answer to the third\fone was apricots!\rOops!\nTime to get back to the Block!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben a fabulous DJ!\nHis sweet voice make me melt!</language>
	</row>
	<row id="msg_0065_D23R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I love Mary from Pokémon Talk.\rI only know what she sound like,\nthough!</language>
	</row>
	<row id="msg_0065_D23R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO. Who you?\nThis a FEDERAL op, lil bro.\rI was told don’t let NOBODY\nslide through but The Feds!\rYou understand?\rYou only get in if you\nrockin’ the official black\fFed fit! WITH the lanyard!</language>
	</row>
	<row id="msg_0065_D23R0101_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayyy, you the new hire!\nThat Fed fit go CRAZY on you,\fon foenem!\rGo ’head! HR upstairs!\nTell ’em Big Fed sent you!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fam, what you doin’?\nGet upstairs and clock in!\fYou on the clock, bruh!</language>
	</row>
	<row id="msg_0065_D23R0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: Ayo, Feds!\rQuit rollin’ ’round in packs\nbotherin’ people. Cowards!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: ...Huh?\nIs that {STRVAR_1 3, 0, 0}?\fWhat you doin’ here?\rNo way... You think you hard\nnow that you dress like them?\rThat’s corny!\nYou lookin’ like a mall cop!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHAT? You!\nYou ain’t the new hire?!\fYou got the right to remain\fLIL BRO! Run me that fade!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bruh, you too strong.\rYou could ruin the whole op.\nI gotta file a report... triplicate...\fSarge gon’ be HEATED.\r</language>
	</row>
	<row id="msg_0065_D23R0101_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: I see.\nYou was tryna be sneaky...\rHuh!\nThat’s how the weak think!\rDon’t matter.\nI’ll let you handle this.\rI gotta beat the Drama Queen...\nWhat’s his name...? Lance!\rAfter that...it’s your turn.\nBe ready!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1F Reception\n2F Sales\f3F Personnel\f4F Production\f5F Director’s Office\f6F Observation Deck</language>
	</row>
	<row id="msg_0065_D23R0101_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lucky Channel!\nWin with homie ID numbers!\rTrade your homies to collect\ndifferent ID numbers!</language>
	</row>
	<row id="msg_0065_D23R0101_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the Pokémon Lottery Corner.\nI’m Felicity, your attendant today.\rIf the drawn number match the ID No.\nof any of your homies, you could win\fhard prizes.\rWanna check today’s\nlucky number? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You already drew a Loto Ticket\ntoday. Come back tomorrow.</language>
	</row>
	<row id="msg_0065_D23R0101_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh. I see.\nCome back now.</language>
	</row>
	<row id="msg_0065_D23R0101_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First, I’ma look up today’s\nlucky number.\r...\r</language>
	</row>
	<row id="msg_0065_D23R0101_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Loto Ticket number is {STRVAR_1 54, 0, 0}.\rNow, let’s see if it match the\nID No. of any of your homies.\r</language>
	</row>
	<row id="msg_0065_D23R0101_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Congrats!\rThe ID No. of your crew’s\n{STRVAR_1 1, 0, 0} match your Loto\fTicket number!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Congrats!\rThe ID No. of your PC-boxed\n{STRVAR_1 1, 0, 0} match your Loto\fTicket number!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My bad.\nYou ain’t get a match...</language>
	</row>
	<row id="msg_0065_D23R0101_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The last digit matched, so you\nwin the fourth prize!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got a new Backdrop for\nthe Fitting Rooms.</language>
	</row>
	<row id="msg_0065_D23R0101_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The last two digits matched, so\nyou win the third prize!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The last three digits matched, so\nyou win the second prize!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The last four digits matched, so\nyou win the first prize!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, my goodness, all five digits\nmatched!\rYou hit the JACKPOT!\nThis is just so incredible!\r...Oh, my bad! Your prize!\nI got carried away.\rHere you go!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Oh?\nYou ain’t got room for this.\rMake room in your Bag and\nlemme know.</language>
	</row>
	<row id="msg_0065_D23R0101_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\nYes, I been expectin’ you.\rHere’s the prize we been holdin’\nfor you. Here you go!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back now!\nBye-bye from Felicity, your attendant!</language>
	</row>
	<row id="msg_0065_D23R0101_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the Pokémon Lottery Corner.\rWanna check today’s\nlucky number again? {YESNO 0}</language>
	</row>
</body>
