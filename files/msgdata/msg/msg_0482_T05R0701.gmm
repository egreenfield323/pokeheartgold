<?xml version="1.0"?>
<body language="English">
	<row id="msg_0482_T05R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome!\rLook around ANYWHERE on this floor.\nOnly this floor.</language>
	</row>
	<row id="msg_0482_T05R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sorry, you can only tour the ground\nfloor.\rEver since Johto’s Radio Tower got\nraided by The Feds, we stepped up\fsecurity.\fWe got a guard now. Ron. He 70.</language>
	</row>
	<row id="msg_0482_T05R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mad people workin’ hard here in the\nRadio Tower. Puttin’ on good shows.\fAnd ghost stories. It’s Lavender.</language>
	</row>
	<row id="msg_0482_T05R0701_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, no, no, NO!\rWe been off air since the Power Plant\nshut down.\rAll my work startin’ this station...\nWASTED.\fI’m finished! I’m movin’ back in with\nmy\fmama!</language>
	</row>
	<row id="msg_0482_T05R0701_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! So you the {STRVAR_1 3, 0, 0} who\nfixed the Power Plant?\rThanks to you, I kept my job.\nYou a real lifesaver!\fTake this as a thank-you.\r</language>
	</row>
	<row id="msg_0482_T05R0701_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah! So you the {STRVAR_1 3, 0, 0} who\nfixed the Power Plant?\rThanks to you, I kept my job.\nYou a real lifesaver!\fTake this as a thank-you.\r</language>
	</row>
	<row id="msg_0482_T05R0701_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Director loaded the EXPN Card\non {STRVAR_1 3, 0, 0}’s Pokégear!\r{STRVAR_1 3, 0, 0}’s Pokégear got\nupgraded!</language>
	</row>
	<row id="msg_0482_T05R0701_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">With that, you can tune in to\neven more radio shows here in\fKanto.\fGahahahaha!</language>
	</row>
	<row id="msg_0482_T05R0701_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO! I’m the SUPER Music Director!\rHuh? Your Pokégear can’t pick up my\nshows. TRAGIC!\rUpgrade with the EXPN Card and tune\nin.\fYou NEED my music. Everybody need it.</language>
	</row>
	<row id="msg_0482_T05R0701_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO! I’m the SUPER Music Director!\rI’m responsible for the GORGEOUS\nmelodies on the air.\rDon’t be square. Grab my music off the\nair! It’s free! Unlike my divorce!</language>
	</row>
	<row id="msg_0482_T05R0701_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1F Reception\n2F Sales\f3F Personnel\f4F Production\f5F Director’s Office\n</language>
	</row>
	<row id="msg_0482_T05R0701_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perk Up Homies with the Smooth\nSounds of the Poké Flute.\rThe Poké Flute broadcast only\nplay around Kanto.\rTry tunin’ in around the top\nof the radio!</language>
	</row>
</body>
