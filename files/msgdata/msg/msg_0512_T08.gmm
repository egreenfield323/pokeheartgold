<?xml version="1.0"?>
<body language="English">
	<row id="msg_0512_T08_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One of the Elite Four used to be\nBoss of Fuchsia’s Block. Koga. The\fninja.\fHe’s prob’ly watchin’ us right\nnow.</language>
	</row>
	<row id="msg_0512_T08_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Koga’s daughter took over the\nBlock when he joined the Elite\fFour.\rShe talk about him NONSTOP. It’s a\nlot.</language>
	</row>
	<row id="msg_0512_T08_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Safari Zone was closed for a\nwhile.\rThen it MOVED to Johto before I\neven knew.\fNobody told me. I’m the mayor.\rIt was this city’s main\nattraction. Now we got... a park.\fPal Park.</language>
	</row>
	<row id="msg_0512_T08_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fuchsia City\nHappenin’ and Passin’ City</language>
	</row>
	<row id="msg_0512_T08_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fuchsia City Block\nBoss: Janine\fNinja. Prob’ly Behind You.</language>
	</row>
	<row id="msg_0512_T08_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a notice here...\rThe Safari Zone is closed.\fInstead, we got Pal Park.</language>
	</row>
	<row id="msg_0512_T08_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Home of the Pal Park Warden</language>
	</row>
	<row id="msg_0512_T08_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shards for Berries!\nShards for Berries!\rYeah, yeah!\nI flip Shards into Berries.\rBring me Shards and I’ll\nbless you with three Berries!\r</language>
	</row>
	<row id="msg_0512_T08_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shards for Berries!\nShards for Berries!\rYeah, yeah!\nI flip Shards into Berries.\rBring me Shards and I’ll\nbless you with three Berries!\rWhich Shard you tradin’\nfor Berries? {YESNO 0}</language>
	</row>
	<row id="msg_0512_T08_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Got more Shards to flip\nfor Berries? {YESNO 0}</language>
	</row>
	<row id="msg_0512_T08_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bet, bet!\nCome back when you\fchange your mind!\r</language>
	</row>
	<row id="msg_0512_T08_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Berry set E for the\nRed Shard. Deal!\r</language>
	</row>
	<row id="msg_0512_T08_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Berry set F for the\nBlue Shard. Deal!\r</language>
	</row>
	<row id="msg_0512_T08_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Berry set G for the\nYellow Shard. Deal!\r</language>
	</row>
	<row id="msg_0512_T08_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Berry set H for the\nGreen Shard. Deal!\r</language>
	</row>
	<row id="msg_0512_T08_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You already got a lotta\nBerries from this set.\rCome back when you run out!\r</language>
	</row>
</body>
