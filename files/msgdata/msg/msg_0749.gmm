	<row id="msg_0749_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The user retaliates\nagainst the foe that\nlast inflicted damage\non it with much\ngreater power.</language>
	</row>
	<row id="msg_0749_00369" index="369">
		<attribute name="window_context_name">used</attribute>
