<?xml version="1.0"?>
<body language="English">
	<row id="msg_0749_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">\n\n\n\n</language>
	</row>
	<row id="msg_0749_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stomps the foe out\nwith whatever’s\nhandy. Basic but\ndisrespectful.\n</language>
	</row>
	<row id="msg_0749_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strip mall dojo chop.\nLands critical hits\neasy.\n</language>
	</row>
	<row id="msg_0749_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Backhands the foe two\nto five times. Pure\ndisrespect.\n</language>
	</row>
	<row id="msg_0749_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A two-piece and then\nsome. Hits two to five\ntimes.\n</language>
	</row>
	<row id="msg_0749_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Asks if the foe wants\na fade. They get one.\n</language>
	</row>
	<row id="msg_0749_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Makes it rain on the\nfoe. Picks up cash\nafter the battle.\n</language>
	</row>
	<row id="msg_0749_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hands too hot to\nhold. May leave the\nfoe burned.\n</language>
	</row>
	<row id="msg_0749_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cold cocks the foe\nwith a frozen turkey.\nMay freeze them.\n</language>
	</row>
	<row id="msg_0749_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A punch with a taser\ntaped to the fist. May\nparalyze.\n</language>
	</row>
	<row id="msg_0749_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walks up and pistol\nwhips the foe. Old\nschool.\n</language>
	</row>
	<row id="msg_0749_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A clothespin on the\nfoe. Then a bigger\none.\n</language>
	</row>
	<row id="msg_0749_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lights out. If it\nlands, the foe is\ndone. Rarely lands.\n</language>
	</row>
	<row id="msg_0749_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blow dryer on HIGH,\nthen it blasts next\nturn. High crit ratio.\n</language>
	</row>
	<row id="msg_0749_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spins the gun on a\nfinger like a movie.\nSharply raises\nAttack.\n</language>
	</row>
	<row id="msg_0749_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shanks the foe with a\nbox cutter. Can clear\nsmall trees outside.\n</language>
	</row>
	<row id="msg_0749_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fans the foe with a\nblast of wind. Hits\nflyers mid-air.\n</language>
	</row>
	<row id="msg_0749_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rolls up on the foe’s\nside and lets off a\nshot.\n</language>
	</row>
	<row id="msg_0749_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Runs the foe off the\nblock. Ends wild\nbattles.\n</language>
	</row>
	<row id="msg_0749_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Catches a flight on\nturn one, dive-bombs\nthe foe on turn two.\n</language>
	</row>
	<row id="msg_0749_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zip ties the foe for\ntwo to five turns.\nThey ain’t going\nnowhere.\n</language>
	</row>
	<row id="msg_0749_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Body bags the foe with\na full-weight slam.\n</language>
	</row>
	<row id="msg_0749_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Takes off the belt and\nwhips the foe with it.\n</language>
	</row>
	<row id="msg_0749_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A curb stomp. May\nmake the foe flinch.\n</language>
	</row>
	<row id="msg_0749_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Two quick shots, pop\npop. Hits twice.\n</language>
	</row>
	<row id="msg_0749_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kicks the door off its\nhinges onto the foe.\n</language>
	</row>
	<row id="msg_0749_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jumps out the bushes\nwith a kick. Hurts the\nuser if it misses.\n</language>
	</row>
	<row id="msg_0749_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rolls up on skates\nwith a spin kick. May\nmake the foe flinch.\n</language>
	</row>
	<row id="msg_0749_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pocket sand to the\neyes. Lowers the\nfoe’s accuracy.\n</language>
	</row>
	<row id="msg_0749_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Checks the foe’s dome\nwith a running\nheadbutt. May make\nthem flinch.\n</language>
	</row>
	<row id="msg_0749_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leans on the air horn\nright in the foe’s\near.\n</language>
	</row>
	<row id="msg_0749_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spray and pray, two\nto five shots.\nSomebody’s getting\nhit.\n</language>
	</row>
	<row id="msg_0749_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A drill, a bigger drill,\nan industrial drill. If\nit hits, the foe is\ndone.\n</language>
	</row>
	<row id="msg_0749_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Full metal jacket. A\nbasic shot that\nalways shows up.\n</language>
	</row>
	<row id="msg_0749_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A belly flop off the\ndiving board, right\nonto the foe. May\nparalyze.\n</language>
	</row>
	<row id="msg_0749_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Duct tapes the foe\nfor two to five turns.\n</language>
	</row>
	<row id="msg_0749_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Charges in swinging a\nfolding chair. Hurts\nthe user too.\n</language>
	</row>
	<row id="msg_0749_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Crashes out for two\nto three turns, then\ngets confused.\n</language>
	</row>
	<row id="msg_0749_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Goes kamikaze. Big\ndamage but the user\ntakes some recoil.\n</language>
	</row>
	<row id="msg_0749_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twerks on the foe. So\ndisrespectful their\nDefense drops.\n</language>
	</row>
	<row id="msg_0749_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A quick shiv dipped in\nsomething nasty. May\npoison.\n</language>
	</row>
	<row id="msg_0749_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Two buzzes of a\ntattoo gun. MOM. It\ngets infected: may\npoison.\n</language>
	</row>
	<row id="msg_0749_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fires a nail gun two to\nfive times.\n</language>
	</row>
	<row id="msg_0749_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A cold stare down.\nLowers the foe’s\nDefense.\n</language>
	</row>
	<row id="msg_0749_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chomps down with a\nfull set of gold grillz.\nMay make the foe\nflinch.\n</language>
	</row>
	<row id="msg_0749_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Talks trash until the\nfoe’s Attack drops.\n</language>
	</row>
	<row id="msg_0749_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Woop woop. The foe\nruns off. Ends wild\nbattles.\n</language>
	</row>
	<row id="msg_0749_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drops a track so\nsmooth the foe falls\nasleep.\n</language>
	</row>
	<row id="msg_0749_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bass boosted till the\nfoe’s head rattles.\nMay confuse.\n</language>
	</row>
	<row id="msg_0749_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pops the trunk on a\nwall of subs. Always\ndoes 20 damage.\n</language>
	</row>
	<row id="msg_0749_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jams the foe’s gun.\nTheir last move can’t\nbe used for a while.\n</language>
	</row>
	<row id="msg_0749_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Throws battery acid.\nMay lower the foe’s\nSp. Def.\n</language>
	</row>
	<row id="msg_0749_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A hot shot. May leave\nthe foe burned.\n</language>
	</row>
	<row id="msg_0749_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lobs a Molotov.\nFlames everywhere.\nMay burn the foe.\n</language>
	</row>
	<row id="msg_0749_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blows a vape cloud\nover the team. Stats\ncan’t be lowered for 5\nturns.\n</language>
	</row>
	<row id="msg_0749_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cracks open a fire\nhydrant on the foe.\n</language>
	</row>
	<row id="msg_0749_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opens a fire hose on\nthe foe, full blast.\nMassive pressure.\n</language>
	</row>
	<row id="msg_0749_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A hydrant wave floods\nthe whole block. Hits\neverybody. Rides\nacross water outside.\n</language>
	</row>
	<row id="msg_0749_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ices the foe out in\ndiamonds. May freeze\nthem solid.\n</language>
	</row>
	<row id="msg_0749_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A shaved-ice machine\nburies the block. May\nfreeze.\n</language>
	</row>
	<row id="msg_0749_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Puts the laser sight\nright on them. May\nconfuse.\n</language>
	</row>
	<row id="msg_0749_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A stream of spit to\nthe face. May lower\nthe foe’s Speed.\n</language>
	</row>
	<row id="msg_0749_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The liquor store neon\nsign lights them up.\nMay lower Attack.\n</language>
	</row>
	<row id="msg_0749_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pistol jams, so out\ncomes the minigun.\nFull auto. Has to\nreload next turn.\n</language>
	</row>
	<row id="msg_0749_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokes the foe hard in\nthe chest.\n</language>
	</row>
	<row id="msg_0749_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A jackhammer at 6\na.m., right on the\nfoe.\n</language>
	</row>
	<row id="msg_0749_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gets the foe to sign a\n360 deal. The user\ntakes recoil.\n</language>
	</row>
	<row id="msg_0749_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sweeps the leg. Hits\nharder on heavier\nfoes.\n</language>
	</row>
	<row id="msg_0749_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Claps back on a\nphysical hit for\ndouble the damage.\n</language>
	</row>
	<row id="msg_0749_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Suplexes the foe.\nDamage equals the\nuser’s level.\n</language>
	</row>
	<row id="msg_0749_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pure muscle. Can push\nboulders outside\nbattle.\n</language>
	</row>
	<row id="msg_0749_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Taxes the foe. The\nuser gets half of it\nback.\n</language>
	</row>
	<row id="msg_0749_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Big tax. The receipt\nnever ends. The user\nkeeps half the damage\nas HP.\n</language>
	</row>
	<row id="msg_0749_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The freeloading cousin\nmoves in. Drains the\nfoe’s HP every turn.\n</language>
	</row>
	<row id="msg_0749_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bulks up. Raises\nAttack and Sp. Atk.\n</language>
	</row>
	<row id="msg_0749_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Flings razor-sharp\nzaza leaves. High\ncritical-hit ratio.\n</language>
	</row>
	<row id="msg_0749_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bakes in the tanning\nbed one turn, fires\nthe tan the next.\n</language>
	</row>
	<row id="msg_0749_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pepper spray to the\nface. Poisons the foe.\n</language>
	</row>
	<row id="msg_0749_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clamps a parking boot\non the foe. Paralyzes\nthem.\n</language>
	</row>
	<row id="msg_0749_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hands the foe a fat\ncigar. One drag and\nthey’re out cold.\n</language>
	</row>
	<row id="msg_0749_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Takes a victory lap\nfor two to three\nturns, then gets\nconfused.\n</language>
	</row>
	<row id="msg_0749_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Silly string\neverywhere. Lowers\nthe foe’s Speed.\n</language>
	</row>
	<row id="msg_0749_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Road rage. Always\ndoes 40 damage.\n</language>
	</row>
	<row id="msg_0749_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doughnuts around the\nfoe for two to five\nturns. They’re\ntrapped.\n</language>
	</row>
	<row id="msg_0749_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tases the foe. May\nparalyze.\n</language>
	</row>
	<row id="msg_0749_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The big taser. May\nparalyze the foe.\n</language>
	</row>
	<row id="msg_0749_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A stun taser.\nParalyzes the foe.\n</language>
	</row>
	<row id="msg_0749_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drops a live power line\non the foe. May\nparalyze.\n</language>
	</row>
	<row id="msg_0749_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tosses a brick at the\nfoe’s head.\n</language>
	</row>
	<row id="msg_0749_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drops the bass so\nhard the whole block\nshakes. Hits\neverybody.\n</language>
	</row>
	<row id="msg_0749_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opens a sinkhole\nunder the foe. If it\nlands, they’re done.\n</language>
	</row>
	<row id="msg_0749_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lays low underground,\nthen pops up on turn\ntwo.\n</language>
	</row>
	<row id="msg_0749_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A double cup of the\ndirty stuff, to the\nface. Badly poisons\nthe foe.\n</language>
	</row>
	<row id="msg_0749_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dangles the chain in\nfront of the foe’s\nface. May confuse.\n</language>
	</row>
	<row id="msg_0749_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swings the chain like a\nhypnotist. May lower\nSp. Def.\n</language>
	</row>
	<row id="msg_0749_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Smooth talks the foe\nstraight to sleep.\n</language>
	</row>
	<row id="msg_0749_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yoga class. Something\ncracks, but it works.\nRaises Attack.\n</language>
	</row>
	<row id="msg_0749_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laces up the fresh\npair. Sharply raises\nSpeed.\n</language>
	</row>
	<row id="msg_0749_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rolls up in the whip,\nlets off, peels out.\nAlways goes first.\n</language>
	</row>
	<row id="msg_0749_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starts beef with a\nT-bone. Attack goes\nup every time the\nuser gets hit.\n</language>
	</row>
	<row id="msg_0749_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dips out of a wild\nbattle.\n</language>
	</row>
	<row id="msg_0749_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clocks in for the\nnight shift, mops the\nfoe. Damage = the\nuser’s level.\n</language>
	</row>
	<row id="msg_0749_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bites the foe’s whole\nstyle and copies its\nlast move.\n</language>
	</row>
	<row id="msg_0749_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sets off the car\nalarm. Sharply lowers\nthe foe’s Defense.\n</language>
	</row>
	<row id="msg_0749_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Calls the squad up.\nRaises evasion.\n</language>
	</row>
	<row id="msg_0749_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reloads and patches\nup. Restores half its\nmax HP.\n</language>
	</row>
	<row id="msg_0749_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Throws on the Kevlar.\nRaises Defense.\n</language>
	</row>
	<row id="msg_0749_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ducks into a clothing\nrack. Sharply raises\nevasion.\n</language>
	</row>
	<row id="msg_0749_00108" index="108">
