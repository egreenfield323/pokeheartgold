<?xml version="1.0"?>
<body language="English">
	<row id="msg_0493_T07PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That Pokégear you got--it’s WAY\ntoo hard! Is that the latest model?\fI still got the one with the\nantenna.</language>
	</row>
	<row id="msg_0493_T07PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika a MASTER of Grass homies.\rShe’ll make you PAY if you don’t\nwatch yourself. Then she’ll fall\fasleep.</language>
	</row>
	<row id="msg_0493_T07PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Game Corner here used to be run\nby The Feds...\rWhen they got kicked out, a rich man\nwho love games bought it. Just for\ffun.\fThe slots is still rigged. Some\nthings\fdon’t change.</language>
	</row>
</body>
