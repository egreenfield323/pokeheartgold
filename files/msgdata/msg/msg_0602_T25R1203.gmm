<?xml version="1.0"?>
<body language="English">
	<row id="msg_0602_T25R1203_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you see here is how much people\naround the world love homies.\rWatchin’ Battle Videos let you share\nthe fun these people had.</language>
	</row>
	<row id="msg_0602_T25R1203_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This a great idea.\nAnybody and everybody can join.\rEven if you lose, that scrap could\nstill be a fire Battle Video.</language>
	</row>
	<row id="msg_0602_T25R1203_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">These Battle Videos is CRAZY!\nShould I go home and retrain\fmy homies?</language>
	</row>
	<row id="msg_0602_T25R1203_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My Battle Videos with only cute\nlil MARILL is my faves.</language>
	</row>
	<row id="msg_0602_T25R1203_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What a crazy collection!\nI see why this so popular.\rJust seein’ some of these Battle\nVideos make me feel tougher!</language>
	</row>
	<row id="msg_0602_T25R1203_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To treat oneself to Battle Videos\nevery day...\rI’d call that a hobby worthy\nof a true gentleman.</language>
	</row>
	<row id="msg_0602_T25R1203_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My mysterious Battle Video.\nMy mysterious Battle Video.\rWhat’s on it?\nWhat’s on it?\rIt’s a mystery!\nIt’s a mystery! And I mean it!</language>
	</row>
	<row id="msg_0602_T25R1203_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lemme spit the alphabet rap with\nGoldenrod, dig?\rG... Go south from here for the\nIlex Forest.\rO... Over land ain’t where you’ll find\nthe Goldenrod Tunnel.\rL... Lookin’ like cops in their black\nwindbreakers is The Feds.\rD... Um... D... is...\nYeah, I know, that’s weak.\fYou try it!</language>
	</row>
	<row id="msg_0602_T25R1203_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Hiker peepin’ the Box Data down\non 2F is my lil brother.</language>
	</row>
	<row id="msg_0602_T25R1203_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Warps to the GTS and the Hustler\nRankings on 1F.</language>
	</row>
	<row id="msg_0602_T25R1203_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Warps to the studios for Box Data and\nDress-Up Data on 2F.</language>
	</row>
	<row id="msg_0602_T25R1203_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Connect to Nintendo Wi-Fi\nConnection for Battle Videos? {YESNO 0}</language>
	</row>
	<row id="msg_0602_T25R1203_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here, you can post a Battle Video of\nyour homies.\rYou can also watch Battle Videos\nother Hustlers posted.\rYou can sort Battle Videos by\nhomie, battle facility, and all that.\rThe Battle Video you post get\na 12-digit number.\rYour homies can watch your video\nby enterin’ that 12-digit code here.\r</language>
	</row>
	<row id="msg_0602_T25R1203_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">USE</language>
	</row>
	<row id="msg_0602_T25R1203_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">INFO</language>
	</row>
	<row id="msg_0602_T25R1203_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CANCEL</language>
	</row>
</body>
