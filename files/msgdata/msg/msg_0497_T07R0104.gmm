<?xml version="1.0"?>
<body language="English">
	<row id="msg_0497_T07R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Outta every Hustler out\nthere, the BEST Hustler gotta be my\fDAD.\r</language>
	</row>
	<row id="msg_0497_T07R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: HA! You don’t know NOTHIN’!\rThe best Hustler in the world is Koga,\none of the Elite Four!\fA.K.A.--MY DAD!\r</language>
	</row>
	<row id="msg_0497_T07R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: You mistaken.\nMy dad treat homies like--\r</language>
	</row>
	<row id="msg_0497_T07R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: STOP!\nJust admit my dad the TRUE Hustler!\fHe got SMOKE BOMBS!\r</language>
	</row>
	<row id="msg_0497_T07R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: You was listenin’, right?\nYou agree my dad better, RIGHT? {YESNO 0}</language>
	</row>
	<row id="msg_0497_T07R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: You do? Just like I thought!\rWe gon’ have SO much fun talkin’ about\nmy dad! I got stories! I got\fPICTURES!\fHere go my number!\r</language>
	</row>
	<row id="msg_0497_T07R0104_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Falkner’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0497_T07R0104_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Hit me up Saturday\nmornin’ if you wanna hear about\fmy dad!</language>
	</row>
	<row id="msg_0497_T07R0104_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: You don’t?\nI thought you was smarter than that.\rOh, well. You’ll come around.\fEverybody come around.</language>
	</row>
	<row id="msg_0497_T07R0104_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: So you DID change your mind.\nYou think my dad\fis better now? {YESNO 0}</language>
	</row>
	<row id="msg_0497_T07R0104_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Ayo, why don’t we take\na pic together? {YESNO 0}</language>
	</row>
	<row id="msg_0497_T07R0104_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Aight!\nYou ready?\r</language>
	</row>
	<row id="msg_0497_T07R0104_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Yes!\nWe look good.</language>
	</row>
	<row id="msg_0497_T07R0104_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: That’s aight.\nI’ll just take one with my dad...\fHe always say yes.</language>
	</row>
	<row id="msg_0497_T07R0104_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete\nsome pics.</language>
	</row>
	<row id="msg_0497_T07R0104_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: BAH!\nYou picked HIM?! Ugh!</language>
	</row>
	<row id="msg_0497_T07R0104_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m here to buy Bloom Mail for my\ngirl. I’m writin’ her a poem. It don’t\frhyme.</language>
	</row>
	<row id="msg_0497_T07R0104_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know what?\rTunnel Mail FINALLY at this store!\rBefore, you could only get it in\nViolet. The REVOLUTION.</language>
	</row>
	<row id="msg_0497_T07R0104_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gifts to Express Yourself!\n4F: Wiseman Gifts</language>
	</row>
</body>
