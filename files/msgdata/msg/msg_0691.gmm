<?xml version="1.0"?>
<body language="English">
	<row id="msg_0691_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Irwin</language>
	</row>
	<row id="msg_0691_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You the BEST I EVER scrapped!\rHuh? You the one who saved all the\nSLOWPOKE?\rNo wonder I couldn’t beat you!\nCould I get your number?\rI don’t wanna miss NOTHIN’ you do from\nnow on! NOTHIN’! {YESNO 0}</language>
	</row>
	<row id="msg_0691_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SHEESH! Good looks!\rNow I can call you ANYTIME, whether\nanythin’ goin’ on or not.\fJust to chat! Every day! Hourly!</language>
	</row>
	<row id="msg_0691_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, but...\nI ain’t dangerous!\rI just wanna call and chat about\neverythin’ and nothin’!\fAnd know where you. At all times.</language>
	</row>
	<row id="msg_0691_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gon’ gimme your number?{YESNO 0}</language>
	</row>
	<row id="msg_0691_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Wait, ain’t you right nearby?\nI know. I can see you. Hi!</language>
	</row>
	<row id="msg_0691_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, you heard?\rGoldenrod’s Radio Tower got taken\nover by The Feds!\r...Wait, like the REAL feds?\nI ain’t even do nothin’! I’m hidin’!</language>
	</row>
	<row id="msg_0691_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, you heard?\rGoldenrod’s Radio Tower got taken\nover by The Feds!\r...Wait, like the REAL feds?\nI ain’t even do nothin’! I’m hidin’!</language>
	</row>
	<row id="msg_0691_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\nYou beat Whitney?\rIt make me proud to be your homie!\nI made a scrapbook! Call you later!</language>
	</row>
	<row id="msg_0691_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\nYou beat Whitney?\rIt make me proud to be your homie!\nI made a scrapbook! Call you later!</language>
	</row>
	<row id="msg_0691_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I heard!\rYou beat Morty of Ecruteak Block!\nTh-that’s CRAZY!\rI went to the Block’s entrance to\ncheer you on.\rBut everybody had candles on their\nheads, it was kinda creepy...\rSo I punked out and ran home...\fI cheered from my room. LOUD.\rCall you later!</language>
	</row>
	<row id="msg_0691_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I heard!\rYou beat Morty of Ecruteak Block!\nTh-that’s CRAZY!\rI went to the Block’s entrance to\ncheer you on.\rBut everybody had candles on their\nheads, it was kinda creepy...\rSo I punked out and ran home...\fI cheered from my room. LOUD.\rCall you later!</language>
	</row>
	<row id="msg_0691_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, I heard about you!\rYou saved that homie at the Lighthouse,\ndidn’t you?\r{STRVAR_1 3, 0, 0}, I wish you’d come see me when\nI’m sick in bed!\fI’m not sick. I could BE sick.\rCall you later!</language>
	</row>
	<row id="msg_0691_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, I heard about you!\rYou saved that homie at the Lighthouse,\ndidn’t you?\r{STRVAR_1 3, 0, 0}, I wish you’d come see me when\nI’m sick in bed!\fI’m not sick. I could BE sick.\rCall you later!</language>
	</row>
	<row id="msg_0691_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rYou ran up in The Feds’ hideout!\nYou like a movie hero, even!\rBut, um... Was they the REAL feds?\rI deleted my whole search history\njust in case.</language>
	</row>
	<row id="msg_0691_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rYou ran up in The Feds’ hideout!\nYou like a movie hero, even!\rBut, um... Was they the REAL feds?\rI deleted my whole search history\njust in case.</language>
	</row>
	<row id="msg_0691_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rAbout how you freed the Radio Tower!\nYou go SO hard!\rI just wanted to make sure you knew\nyou AWESOME!\fI made a song about it. 11 minutes.\rCall you later!</language>
	</row>
	<row id="msg_0691_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rAbout how you freed the Radio Tower!\nYou go SO hard!\rI just wanted to make sure you knew\nyou AWESOME!\fI made a song about it. 11 minutes.\rCall you later!</language>
	</row>
	<row id="msg_0691_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw you, {STRVAR_1 3, 0, 0}!\nI saw you go in the Dragon’s Den!\rI KNOW you passed! Ain’t no need to be\nhumble! You can’t fail!\fI was in the bushes. Supportively.\rCall you later!</language>
	</row>
	<row id="msg_0691_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw you, {STRVAR_1 3, 0, 0}!\nI saw you go in the Dragon’s Den!\rI KNOW you passed! Ain’t no need to be\nhumble! You can’t fail!\fI was in the bushes. Supportively.\rCall you later!</language>
	</row>
	<row id="msg_0691_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yesterday I went to New Bark Town.\nThere was a lady who looked a lot like\fyou, {STRVAR_1 3, 0, 0}.\rWhat? That lady was your MOM?\nAww, I shoulda introduced myself!\fI waved. From across the street.\fFor an hour.\rCall you later!</language>
	</row>
	<row id="msg_0691_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yesterday I went to New Bark Town.\nThere was a lady who looked a lot like\fyou, {STRVAR_1 3, 0, 0}.\rWhat? That lady was your MOM?\nAww, I shoulda introduced myself!\fI waved. From across the street.\fFor an hour.\rCall you later!</language>
	</row>
	<row id="msg_0691_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw!\rYou walkin’ onto a ship, {STRVAR_1 3, 0, 0}!\rYou look SO good with the sea behind\nyou!\fI took 300 pictures.\rI HATE havin’ to hang up on you!\nCall you later!</language>
	</row>
	<row id="msg_0691_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw!\rYou walkin’ onto a ship, {STRVAR_1 3, 0, 0}!\rYou look SO good with the sea behind\nyou!\fI took 300 pictures.\rI HATE havin’ to hang up on you!\nCall you later!</language>
	</row>
	<row id="msg_0691_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard!\rYou got a Magnet Train Pass!\rWhen I saw you leavin’ on the ship, I\nwas sad I wouldn’t see\fyou for a while.\rBut since you got that Pass, you can\nzip back anytime!\fThat’s a relief!\rWhat? You can Catch Flight back\nanytime?\rWhat’s that?\rCall you later!</language>
	</row>
	<row id="msg_0691_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard!\rYou got a Magnet Train Pass!\rWhen I saw you leavin’ on the ship, I\nwas sad I wouldn’t see\fyou for a while.\rBut since you got that Pass, you can\nzip back anytime!\fThat’s a relief!\rWhat? You can Catch Flight back\nanytime?\rWhat’s that?\rCall you later!</language>
	</row>
	<row id="msg_0691_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw!\rYou wakin’ up SNORLAX!\rI was watchin’ from far away, so I\ncouldn’t see exactly.\fThe binoculars was foggy.\rYou played a flute to wake it?\nSHEESH! That’s like magic!\rCall you later!</language>
	</row>
	<row id="msg_0691_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw!\rYou wakin’ up SNORLAX!\rI was watchin’ from far away, so I\ncouldn’t see exactly.\fThe binoculars was foggy.\rYou played a flute to wake it?\nSHEESH! That’s like magic!\rCall you later!</language>
	</row>
	<row id="msg_0691_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\rYou kickin’ up a crazy ruckus over\nin Kanto!\rWhat a glorious rampage it must be!\nYou go SO hard!\rCall you later!</language>
	</row>
	<row id="msg_0691_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\rYou kickin’ up a crazy ruckus over\nin Kanto!\rWhat a glorious rampage it must be!\nYou go SO hard!\rCall you later!</language>
	</row>
	<row id="msg_0691_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hear gossip about you all over the\nplace.\rIt just make me sigh, {STRVAR_1 3, 0, 0}.\nHow you get so strong?\rGo for the world championship now!\nI’ll ALWAYS be cheerin’ for you!\rCall you later!\f...Is that OK? Please say it’s OK.</language>
	</row>
	<row id="msg_0691_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hear gossip about you all over the\nplace.\rIt just make me sigh, {STRVAR_1 3, 0, 0}.\nHow you get so strong?\rGo for the world championship now!\nI’ll ALWAYS be cheerin’ for you!\rCall you later!\f...Is that OK? Please say it’s OK.</language>
	</row>
	<row id="msg_0691_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m always lookin’ forward to what\nyou do next, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0691_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m always lookin’ forward to what\nyou do next, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0691_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hearin’ about your adventures shake my\nsoul! It sure do!</language>
	</row>
	<row id="msg_0691_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hearin’ about your adventures shake my\nsoul! It sure do!</language>
	</row>
	<row id="msg_0691_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Every time I think about your\nadventures, {STRVAR_1 3, 0, 0}, I’m just so\fdeeply moved!</language>
	</row>
	<row id="msg_0691_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Every time I think about your\nadventures, {STRVAR_1 3, 0, 0}, I’m just so\fdeeply moved!</language>
	</row>
	<row id="msg_0691_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hearin’ about your adventures shake my\nsoul! It sure do!</language>
	</row>
	<row id="msg_0691_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m SO glad you called!\rI was JUST ’bout to call you too!\nI was holdin’ the phone! For an hour!\fWe must be a perfect match!</language>
	</row>
	<row id="msg_0691_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you doin’?\rWhat you doin’?\rWhere you at?\rHow many Chains you got now?\rHow much bread you got stacked?\rHow your mom?\rWhat you eat today?\rIs it gon’ be sunny tomorrow?\rARRGH, there’s SO much I wanna ask!\nThis goin’ nowhere! I love it!</language>
	</row>
</body>
