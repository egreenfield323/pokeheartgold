<?xml version="1.0"?>
<body language="English">
	<row id="msg_0691_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Irwin</language>
	</row>
	<row id="msg_0691_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You the best I EVER scrapped!\rHuh? You the one who saved all\nthe SLOWPOKE?\rWell, no wonder I couldn’t beat you!\nCould I get your number?\rI don’t wanna miss NOTHIN’ you\ndo from now on! {YESNO 0}</language>
	</row>
	<row id="msg_0691_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh! Good looks!\rNow I can call you anytime, whether\nanythin’ goin’ on or not.\rYou know, just to chat!</language>
	</row>
	<row id="msg_0691_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, but...\nI ain’t dangerous!\rI just wanna call and chat about\neverythin’ and nothin’!</language>
	</row>
	<row id="msg_0691_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gon’ gimme your number?{YESNO 0}</language>
	</row>
	<row id="msg_0691_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Wait, ain’t you right nearby?</language>
	</row>
	<row id="msg_0691_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, you heard?\rGoldenrod’s Radio Tower got taken\nover by The Feds!\r...Wait, like the REAL feds?\nI ain’t even do nothin’! I’m hidin’!</language>
	</row>
	<row id="msg_0691_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, you heard?\rGoldenrod’s Radio Tower got taken\nover by The Feds!\r...Wait, like the REAL feds?\nI ain’t even do nothin’! I’m hidin’!</language>
	</row>
	<row id="msg_0691_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\nYou beat Whitney?\rIt make me proud to be your homie!\nCall you later!</language>
	</row>
	<row id="msg_0691_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\nYou beat Whitney?\rIt make me proud to be your homie!\nCall you later!</language>
	</row>
	<row id="msg_0691_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I heard!\rYou beat Morty of Ecruteak Block!\nTh-that’s crazy!\rI actually went to the Block’s\nentrance to cheer you on.\rYou know that? But everybody had\nthese candles on\ftheir heads, it was kinda creepy...\rSo I punked out and ran\nhome...\rCall you later!</language>
	</row>
	<row id="msg_0691_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I heard!\rYou beat Morty of Ecruteak Block!\nTh-that’s crazy!\rI actually went to the Block’s\nentrance to cheer you on.\rYou know that? But everybody had\nthese candles on\ftheir heads, it was kinda creepy...\rSo I punked out and ran\nhome...\rCall you later!</language>
	</row>
	<row id="msg_0691_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, I heard about you!\rYou saved that homie at the\nLighthouse, didn’t you?\r{STRVAR_1 3, 0, 0}, I wish you’d come see me\nwhen I’m sick in bed with a cold!\rCall you later!</language>
	</row>
	<row id="msg_0691_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, I heard about you!\rYou saved that homie at the\nLighthouse, didn’t you?\r{STRVAR_1 3, 0, 0}, I wish you’d come see me\nwhen I’m sick in bed with a cold!\rCall you later!</language>
	</row>
	<row id="msg_0691_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rYou ran up in The Feds’ hideout!\nYou like a movie hero, even!\rBut, um... Was they the REAL feds?\rI deleted my whole search history\njust in case.</language>
	</row>
	<row id="msg_0691_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rYou ran up in The Feds’ hideout!\nYou like a movie hero, even!\rBut, um... Was they the REAL feds?\rI deleted my whole search history\njust in case.</language>
	</row>
	<row id="msg_0691_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rAbout how you freed the\nRadio Tower! You go SO hard!\rI just wanted to make sure you knew\nyou awesome!\rCall you later!</language>
	</row>
	<row id="msg_0691_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard, I heard!\rAbout how you freed the\nRadio Tower! You go SO hard!\rI just wanted to make sure you knew\nyou awesome!\rCall you later!</language>
	</row>
	<row id="msg_0691_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw you, {STRVAR_1 3, 0, 0}!\nI saw you go in the Dragon’s Den!\rI KNOW you passed! Aww, ain’t no need\nto be humble! You can’t fail!\rCall you later!</language>
	</row>
	<row id="msg_0691_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw you, {STRVAR_1 3, 0, 0}!\nI saw you go in the Dragon’s Den!\rI KNOW you passed! Aww, ain’t no need\nto be humble! You can’t fail!\rCall you later!</language>
	</row>
	<row id="msg_0691_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yesterday, I went out to New Bark\nTown. There was a lady who looked\fa lot like you, {STRVAR_1 3, 0, 0}.\rWhat? That lady was your MOM?\nAww, I shoulda introduced myself!\rBet your mom real proud of all\nthat you done.\rCall you later!</language>
	</row>
	<row id="msg_0691_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yesterday, I went out to New Bark\nTown. There was a lady who looked\fa lot like you, {STRVAR_1 3, 0, 0}.\rWhat? That lady was your MOM?\nAww, I shoulda introduced myself!\rBet your mom real proud of all\nthat you done.\rCall you later!</language>
	</row>
	<row id="msg_0691_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw!\rYou walkin’ onto a ship, {STRVAR_1 3, 0, 0}!\rYou look SO good with\nthe sea behind you!\rI HATE havin’ to hang up on you!\nCall you later!</language>
	</row>
	<row id="msg_0691_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw, I saw!\rYou walkin’ onto a ship, {STRVAR_1 3, 0, 0}!\rYou look SO good with\nthe sea behind you!\rI HATE havin’ to hang up on you!\nCall you later!</language>
	</row>
	<row id="msg_0691_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard!\rYou got a Magnet Train Pass!\rWhen I saw you leavin’ on the ship, I\nwas sad I wouldn’t see\fyou for a while.\rBut since you got that Pass, you can\nzip back anytime!\fThat’s a relief!\rWhat? You can Catch Flight back\nanytime?\rWhat’s that?\rCall you later!</language>
	</row>
	<row id="msg_0691_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I heard, I heard!\rYou got a Magnet Train Pass!\rWhen I saw you leavin’ on the ship, I\nwas sad I wouldn’t see\fyou for a while.\rBut since you got that Pass, you can\nzip back anytime!\fThat’s a relief!\rWhat? You can Catch Flight back\nanytime?\rWhat’s that?\rCall you later!</language>
	</row>
	<row id="msg_0691_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw!\rYou wakin’ up SNORLAX!\rI was watchin’ from far away, so I\ncouldn’t tell what you did exactly.\rYou played a flute to wake it?\rSheesh! That’s like magic!\nCall you later!</language>
	</row>
	<row id="msg_0691_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I saw, I saw!\rYou wakin’ up SNORLAX!\rI was watchin’ from far away, so I\ncouldn’t tell what you did exactly.\rYou played a flute to wake it?\rSheesh! That’s like magic!\nCall you later!</language>
	</row>
	<row id="msg_0691_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\rYou kickin’ up a crazy ruckus over\nin Kanto!\rWhat a glorious rampage it must be!\nYou go SO hard!\rCall you later!</language>
	</row>
	<row id="msg_0691_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, I heard!\rYou kickin’ up a crazy ruckus over\nin Kanto!\rWhat a glorious rampage it must be!\nYou go SO hard!\rCall you later!</language>
	</row>
	<row id="msg_0691_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hear gossip about you all over\nthe place.\rIt just make me sigh, {STRVAR_1 3, 0, 0}.\nHow you get so strong?\rGo for the world championship now!\nI’ll ALWAYS be cheerin’ for you!\rCall you later!\f...Is that OK?</language>
	</row>
	<row id="msg_0691_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hear gossip about you all over\nthe place.\rIt just make me sigh, {STRVAR_1 3, 0, 0}.\nHow you get so strong?\rGo for the world championship now!\nI’ll ALWAYS be cheerin’ for you!\rCall you later!\f...Is that OK?</language>
	</row>
	<row id="msg_0691_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m always lookin’ forward to what\nyou do next, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0691_00033" index="33">
