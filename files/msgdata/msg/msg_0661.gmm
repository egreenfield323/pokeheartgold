<?xml version="1.0"?>
<body language="English">
	<row id="msg_0661_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Day-C Man</language>
	</row>
	<row id="msg_0661_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\nOh, wassup. How you doin’?\rKids these days just call even when\nthey right nearby...\rI’d rather talk face-to-face...</language>
	</row>
	<row id="msg_0661_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup?\nOh, it’s you!\r</language>
	</row>
	<row id="msg_0661_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One of the homies we raisin’ is\nholdin’ a Egg!\rBet you wanna know what kinda\nEgg it is, right? Come get it!</language>
	</row>
	<row id="msg_0661_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We ain’t raisin’ no homies for you\nright now...\r</language>
	</row>
	<row id="msg_0661_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your {STRVAR_1 0, 10, 0} doin’ just fine.\r</language>
	</row>
	<row id="msg_0661_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your {STRVAR_1 0, 10, 0} and {STRVAR_1 0, 11, 0}\nis doin’ just fine.\r</language>
	</row>
	<row id="msg_0661_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Them two get along real good.\r</language>
	</row>
	<row id="msg_0661_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Them two get along.\r</language>
	</row>
	<row id="msg_0661_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Them two don’t deadass like each\nother much.\r</language>
	</row>
	<row id="msg_0661_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Them two rather do their own thing\nthan hang with each other...\r</language>
	</row>
	<row id="msg_0661_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stop by anytime, you hear?</language>
	</row>
	<row id="msg_0661_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup? It’s me, the Day-Care Man.\rWe was raisin’ your homies,\nand my goodness, was we surprised!\rYour homie was holdin’ a Egg!\rWe don’t know how it got there,\nbut your homie had it. Don’t ask us.\rBet you wanna know what kinda\nEgg it is, right? Come get it!</language>
	</row>
	<row id="msg_0661_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup? It’s me, the Day-Care Man.\rYour homie holdin’ a Egg!\rBet you wanna know what kinda\nEgg it is, right? Come get it!</language>
	</row>
</body>
