<?xml version="1.0"?>
<body language="English">
	<row id="msg_0386_R34R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, honey. You makin’ a Pokédex?\rYou must be scrappin’ every homie\nin the region. Look at your knuckles.\rTry this TM. It’s like a mixtape\nbut for violence.</language>
	</row>
	<row id="msg_0386_R34R0201_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0386_R34R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s Diss Track.\rUse it and the other homie\ncan only use moves that do damage\fto your homie for a while.</language>
	</row>
	<row id="msg_0386_R34R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BUTTERFREE: Freeh!</language>
	</row>
	<row id="msg_0386_R34R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You seen the shrine for the forest’s\nprotector?\rIt watch the forest across TIME.\nI left it a juice box. Respect.</language>
	</row>
</body>
