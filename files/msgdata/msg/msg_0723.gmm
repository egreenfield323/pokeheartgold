<?xml version="1.0"?>
<body language="English">
	<row id="msg_0723_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here I come! Outta nowhere!</language>
	</row>
	<row id="msg_0723_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YEAH! Didn’t see that comin’!\r</language>
	</row>
	<row id="msg_0723_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BLEAH! I saw that comin’.\r</language>
	</row>
	<row id="msg_0723_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, rookie!\nBring it on!</language>
	</row>
	<row id="msg_0723_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeah, I knew it.\nYou a rookie. Like me. But worse.\r</language>
	</row>
	<row id="msg_0723_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BLEAH!\nBeat by a rookie! I’m movin’ away!\r</language>
	</row>
	<row id="msg_0723_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shorts is the BEST!\nComfy, breezy, and my knees breathe!</language>
	</row>
	<row id="msg_0723_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shorts is the GREATEST!\nThe knees did that!\r</language>
	</row>
	<row id="msg_0723_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll never stop wearin’ shorts.\nNot for ANYBODY. Not even winter.\r</language>
	</row>
	<row id="msg_0723_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s my policy to wear miniskirts!\nIt’s in writin’.</language>
	</row>
	<row id="msg_0723_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miniskirts is the ULTIMATE!\r</language>
	</row>
	<row id="msg_0723_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What’s YOUR policy?\nOh, winnin’? OK. Fair.\r</language>
	</row>
	<row id="msg_0723_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE my miniskirt!\nIt’s got pockets!</language>
	</row>
	<row id="msg_0723_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Caught you snoozin’!\nOn my skirt!\r</language>
	</row>
	<row id="msg_0723_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miniskirts make legs look longer!\nThey ain’t help me win though.\r</language>
	</row>
	<row id="msg_0723_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m on the hunt for cute\nAccessories. You got any? No?</language>
	</row>
	<row id="msg_0723_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lemme know if you find cute\nAccessories! I’ll pay!\r</language>
	</row>
	<row id="msg_0723_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I just wanted to dress up!\nNow I’m sad AND underdressed.\r</language>
	</row>
	<row id="msg_0723_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lemme test out somethin’ I learned\nat private school. $40K a year.</language>
	</row>
	<row id="msg_0723_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES!\nWorth every penny of Daddy’s bread!\r</language>
	</row>
	<row id="msg_0723_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm...\nI’m askin’ for a refund.\r</language>
	</row>
	<row id="msg_0723_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... WROAR!\nThat’s my scary voice.</language>
	</row>
	<row id="msg_0723_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap is about momentum and\nwillpower. And roarin’.\r</language>
	</row>
	<row id="msg_0723_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, so willpower and roarin’\nain’t enough on its own.\r</language>
	</row>
	<row id="msg_0723_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I study EVERY day ’cause I wanna\nwork all over the world.</language>
	</row>
	<row id="msg_0723_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My dream is WORLDWIDE!\nLike the Wi-Fi!\r</language>
	</row>
	<row id="msg_0723_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta study up on scraps.\nI got flashcards. 400 of ’em.\r</language>
	</row>
	<row id="msg_0723_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I grow up, I’m finna be a\nhomie professor! With a coat!</language>
	</row>
	<row id="msg_0723_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Er-hem! Er-hem!\nYou got MUCH to learn, youngster!\r</language>
	</row>
	<row id="msg_0723_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Er-hem! Er-hem!\nI got much to learn still. Ahem.\r</language>
	</row>
	<row id="msg_0723_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When it come to homies, I simply\ndon’t lose! I read a book!</language>
	</row>
	<row id="msg_0723_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a victory of KNOWLEDGE!\nAnd a lil luck.\r</language>
	</row>
	<row id="msg_0723_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m finna review the material!\nAnd come back for revenge!\r</language>
	</row>
	<row id="msg_0723_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you look wimpy.\nI might actually win this one.</language>
	</row>
	<row id="msg_0723_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I SO did it! Finally!\r</language>
	</row>
	<row id="msg_0723_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ouch, that hurt.\nMy feelings too.\r</language>
	</row>
	<row id="msg_0723_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s fine, fine.\nNo need to say nothin’.</language>
	</row>
	<row id="msg_0723_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s fine, fine.\nYou tried your best. It wasn’t good.\r</language>
	</row>
	<row id="msg_0723_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s fine, fine...\nNo need to say nothin’... I’m fine...\r</language>
	</row>
	<row id="msg_0723_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m RICH!</language>
	</row>
	<row id="msg_0723_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, of course.\nI’m RICH. Bread wins.\r</language>
	</row>
	<row id="msg_0723_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What happened?\nI’m RICH, ain’t I? This is a scam.\r</language>
	</row>
	<row id="msg_0723_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. So, you good, huh?\nWe’ll see.</language>
	</row>
	<row id="msg_0723_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. You no big deal.\nHmm.\r</language>
	</row>
	<row id="msg_0723_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. So you ARE good.\nHmm. Hmm. Hmm.\r</language>
	</row>
	<row id="msg_0723_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, yes.\nI shall attack now. Prepare thyself.</language>
	</row>
	<row id="msg_0723_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ve done it!\nWhere’s my tea?\r</language>
	</row>
	<row id="msg_0723_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, how disappointin’.\nI’ll need TWO teas.\r</language>
	</row>
	<row id="msg_0723_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Over, your adventure is.\nCome hither and get whupped!</language>
	</row>
	<row id="msg_0723_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A done deal, it was.\nYoda energy.\r</language>
	</row>
	<row id="msg_0723_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, how vexin’ this so is.\nVerily, good looks.\r</language>
	</row>
	<row id="msg_0723_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How BORIN’...\nWake me when it’s over.</language>
	</row>
	<row id="msg_0723_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So truly borin’...\nI won and I’m still bored.\r</language>
	</row>
	<row id="msg_0723_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was a good way to waste\nsome time. I got nothin’ else.\r</language>
	</row>
	<row id="msg_0723_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hunh?\nWhere is everybody?</language>
	</row>
	<row id="msg_0723_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO, GUYS!\nWhere y’all go?! I won!\r</language>
	</row>
	<row id="msg_0723_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I came to camp, but I got lost...\nAnd now I lost again. Twice.\r</language>
	</row>
	<row id="msg_0723_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh!\nYou got a Pokétch too?</language>
	</row>
	<row id="msg_0723_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was playin’ with my Pokétch\nand STILL won! Multitasking!\r</language>
	</row>
	<row id="msg_0723_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was playin’ with my Pokétch...\nand that’s why I lost. Lesson learned.\r</language>
	</row>
	<row id="msg_0723_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies trained in the FORESTS.\nWith bears.</language>
	</row>
	<row id="msg_0723_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s the power of the forests!\nAnd the bears.\r</language>
	</row>
	<row id="msg_0723_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m goin’ back to the forest.\nThe bears get me.\r</language>
	</row>
	<row id="msg_0723_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll scrap you like I’m on a picnic!\nBring the potato salad!</language>
	</row>
	<row id="msg_0723_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lalala!\nPicnic vibes only!\r</language>
	</row>
	<row id="msg_0723_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pretendin’ it’s a picnic don’t\nlemme win. Ants everywhere.\r</language>
	</row>
	<row id="msg_0723_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh-la-la!\nHere we come!</language>
	</row>
	<row id="msg_0723_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh-la-la!\nSO happy I won!\r</language>
	</row>
	<row id="msg_0723_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh-la-la!\nLosin’ can’t kill my vibe! (It did.)\r</language>
	</row>
	<row id="msg_0723_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll teach you what’s fun about\nscrappin’!</language>
	</row>
	<row id="msg_0723_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ me was FUN, wasn’t it?\nSay yes.\r</language>
	</row>
	<row id="msg_0723_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my, that was inspirin’!\nYou the GREATEST!\r</language>
	</row>
	<row id="msg_0723_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I... I can swim, deadass!\nI don’t need my floatie!</language>
	</row>
	<row id="msg_0723_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It... It’s TRUE!\nI swam! A lil bit!\r</language>
	</row>
	<row id="msg_0723_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I... I ain’t lyin’!\n...Pass me the floatie.\r</language>
	</row>
	<row id="msg_0723_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I like rivers more than the sea.\nWhich one you like?</language>
	</row>
	<row id="msg_0723_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">River water is cold, but it feels\nSUPER. Like winnin’.\r</language>
	</row>
	<row id="msg_0723_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hate the sea ’cause the salt\nburns my eyes! Like losin’!\r</language>
	</row>
	<row id="msg_0723_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GO, GO, GO!\nGo, my homies!</language>
	</row>
	<row id="msg_0723_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s the way!\nWay to go, my homies!\r</language>
	</row>
	<row id="msg_0723_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good effort!\nWay to go, my homies! ...Sorta.\r</language>
	</row>
	<row id="msg_0723_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The beach sand is SO hot! It make\nme go “Ouch, ouch, ouch!”</language>
	</row>
	<row id="msg_0723_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE the sea!\nNot the sand. The sea.\r</language>
	</row>
	<row id="msg_0723_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUCH, OUCH, OUCH!\nThat’s the sand AND the L.\r</language>
	</row>
	<row id="msg_0723_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Splish, splash!</language>
	</row>
	<row id="msg_0723_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ker-splash!\nKer-SPLASH!\r</language>
	</row>
	<row id="msg_0723_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Flip, flop!\n...Flop.\r</language>
	</row>
	<row id="msg_0723_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m a girl in love with her\nfloatie! Nice to meet you!</language>
	</row>
	<row id="msg_0723_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks! I’m a girl in love\nwith her floatie!\r</language>
	</row>
	<row id="msg_0723_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bye-bye! I’m a girl in love with\nher floatie! It’s all I got now!\r</language>
	</row>
	<row id="msg_0723_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, YEAH! I’m feelin’ it!\nI’m tuned into your wavelength!</language>
	</row>
	<row id="msg_0723_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TADAAAAH!\nNo autographs!\r</language>
	</row>
	<row id="msg_0723_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch!\nLosin’ threw off my rhythm! Off-beat!\r</language>
	</row>
	<row id="msg_0723_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock? Jazz? Techno?\nAnything work for my soundtrack!</language>
	</row>
	<row id="msg_0723_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SQUEEEEEAL!\nThat’s my guitar. And me.\r</language>
	</row>
	<row id="msg_0723_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So, yeah... You got me in the\nmood to sing the blues...\r</language>
	</row>
	<row id="msg_0723_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s get this session poppin’!</language>
	</row>
	<row id="msg_0723_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You obviously short on practice.\nScales! Every day!\r</language>
	</row>
	<row id="msg_0723_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My dream of a world tour...\nIt’s a local tour now.\r</language>
	</row>
	<row id="msg_0723_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, wassup...\nWell, ain’t that a CHIC scarf!</language>
	</row>
	<row id="msg_0723_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where you buy that scarf?\nI’m askin’ for a homie. Me.\r</language>
	</row>
	<row id="msg_0723_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you! Fashionable AND good\nwith homies?! How UNFAIR!\r</language>
	</row>
	<row id="msg_0723_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for supportin’ me!\nYou a fan, right?</language>
	</row>
	<row id="msg_0723_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh?\nYou NOT my fan?\fNobody asked you.\r</language>
	</row>
	<row id="msg_0723_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What a horrible way to treat\nan Idol... My manager’s gon’ hear.\r</language>
	</row>
	<row id="msg_0723_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La, lala, lah.</language>
	</row>
	<row id="msg_0723_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La lalala.\nLalalah lah.\r</language>
	</row>
	<row id="msg_0723_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bye-bye, lalah!\n...La.\r</language>
	</row>
	<row id="msg_0723_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s see who love homies more,\nyou or me.</language>
	</row>
	<row id="msg_0723_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FUHAHA! My love for homies\ntrumped yours!\r</language>
	</row>
	<row id="msg_0723_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grr... Your love for homies is\nstronger?! I’m buyin’ ’em gifts.\r</language>
	</row>
	<row id="msg_0723_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I tell ya, my homies is some\nkinda TOUGH.</language>
	</row>
	<row id="msg_0723_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t underestimate me.\nPeople always do. Big mistake.\r</language>
	</row>
	<row id="msg_0723_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You some kinda mighty.\nI’ll tell my homies. They’ll cry.\r</language>
	</row>
	<row id="msg_0723_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, show me your favorite homie.\nDon’t be shy now, c’mon.</language>
	</row>
	<row id="msg_0723_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see...\nCute, but on the weak side.\r</language>
	</row>
	<row id="msg_0723_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see!\nCute, AND tough. Rude.\r</language>
	</row>
	<row id="msg_0723_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies cute, but they\nnot hella tough!</language>
	</row>
	<row id="msg_0723_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh?\nWe WON? Seriously? Huh.\r</language>
	</row>
	<row id="msg_0723_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s OK. I like my homies.\nThat’s all that matters. *sniff*\r</language>
	</row>
	<row id="msg_0723_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been pamperin’ my gang too much\nlately. Can they still do it?</language>
	</row>
	<row id="msg_0723_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, they DID it!\nSpa day tomorrow!\r</language>
	</row>
	<row id="msg_0723_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pamperin’ homies too much is\nno good... Back to boot camp.\r</language>
	</row>
	<row id="msg_0723_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Won’t you join our homie\nFan Club? It’s free!</language>
	</row>
	<row id="msg_0723_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s ALL kinds of fun stuff\nto do if you join!\r</language>
	</row>
	<row id="msg_0723_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Join us!\nBecome a Pokéfan! Please! Members\fneeded!\r</language>
	</row>
	<row id="msg_0723_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">May I take your order, please?</language>
	</row>
	<row id="msg_0723_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, a fine choice.\nOne L, served fresh.\r</language>
	</row>
	<row id="msg_0723_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, a EXCELLENT choice.\nA W, served fresh. Tip appreciated.\r</language>
	</row>
	<row id="msg_0723_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What I REALLY wanted to be\nwas a chef.</language>
	</row>
	<row id="msg_0723_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t mind this job now,\nmind you. It’s fine.\r</language>
	</row>
	<row id="msg_0723_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I just find it hard talkin’ to\nstrangers. Like you.\r</language>
	</row>
	<row id="msg_0723_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">For scraps AND takin’ orders,\nspeed is everythin’!</language>
	</row>
	<row id="msg_0723_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Like, chop-chop!\nYou got SERVED.\r</language>
	</row>
	<row id="msg_0723_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Food is like scrappin’.\nServe it while it’s hot! I didn’t.\r</language>
	</row>
	<row id="msg_0723_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My job is servin’ others.\nBut don’t expect service here.</language>
	</row>
	<row id="msg_0723_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mufufu.\nNo refills.\r</language>
	</row>
	<row id="msg_0723_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why couldn’t you serve ME?\nYou won’t make homies that way!\r</language>
	</row>
	<row id="msg_0723_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t this cute?\nMy uniform! Ironed it myself!</language>
	</row>
	<row id="msg_0723_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s my FAVORITE!\r</language>
	</row>
	<row id="msg_0723_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You messed up my uniform!\nThat’s comin’ outta YOUR pay!\r</language>
	</row>
	<row id="msg_0723_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You good, ain’t you?\nI can tell. You got the walk.</language>
	</row>
	<row id="msg_0723_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oops.\nI’m a lil disappointed. In you.\r</language>
	</row>
	<row id="msg_0723_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I KNEW you was a tough Hustler.\nI could see it in the walk.\r</language>
	</row>
	<row id="msg_0723_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I catch and raise ALL sorts of\nhomies. Even ugly ones.</language>
	</row>
	<row id="msg_0723_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See?\nI raised ’em pretty good. Mostly.\r</language>
	</row>
	<row id="msg_0723_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta raise my homies some more!\nThey need vitamins.\r</language>
	</row>
	<row id="msg_0723_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll snag you with my NET!</language>
	</row>
	<row id="msg_0723_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s in the BAG!\nThe net bag.\r</language>
	</row>
	<row id="msg_0723_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO!\nDon’t run away! ...Come back!\r</language>
	</row>
	<row id="msg_0723_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where I can find a GIANT HERACROSS?\nAsking for a homie. Me.</language>
	</row>
	<row id="msg_0723_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I want a HUGE HERACROSS.\nLike, king size! Like a SUV!\r</language>
	</row>
	<row id="msg_0723_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If only I had a giant HERACROSS...\nI’d ride it to school.\r</language>
	</row>
	<row id="msg_0723_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prepare to LOSE!\nI practiced that line.</language>
	</row>
	<row id="msg_0723_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The enemy is MINE!\r</language>
	</row>
	<row id="msg_0723_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I lie shattered...\nLike my phone screen.\r</language>
	</row>
	<row id="msg_0723_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Behold my FEARSOME ninja technique!\nIt’s called “runnin’ away.”</language>
	</row>
	<row id="msg_0723_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAHAH!\nYou SAW it! Nobody sees it!\r</language>
	</row>
	<row id="msg_0723_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ain’t fall for my fake ninja\nbraggin’! Respect.\r</language>
	</row>
	<row id="msg_0723_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’mma be a REAL ninja when\nI grow up! I got a headband!</language>
	</row>
	<row id="msg_0723_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">EXCELLENT! Excellent!\r</language>
	</row>
	<row id="msg_0723_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So what’s a real ninja supposed\nto DO? Nobody told me.\r</language>
	</row>
	<row id="msg_0723_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Should I torment you?\nMy mama said I can’t.</language>
	</row>
	<row id="msg_0723_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YAY! YAY!\nI’m tellin’ her!\r</language>
	</row>
	<row id="msg_0723_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No!\nNo tormentin’ ME! Not fair!\r</language>
	</row>
	<row id="msg_0723_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My mommy made this outfit for me.\nShe used the curtains.</language>
	</row>
	<row id="msg_0723_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t it cute?\nThe curtains are gone though.\r</language>
	</row>
	<row id="msg_0723_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My mommy is DEADASS good at sewin’.\nShe can’t sew a W though.\r</language>
	</row>
	<row id="msg_0723_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s do our best, everybody!</language>
	</row>
	<row id="msg_0723_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks, everybody!\nTeam effort!\r</language>
	</row>
	<row id="msg_0723_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAAAAAH!\nTeam failure!\r</language>
	</row>
	<row id="msg_0723_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sure we finna scrap, but\ndon’t be over the top about it.</language>
	</row>
	<row id="msg_0723_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, relax, relax.\nIt’s best to be natural, dig?\r</language>
	</row>
	<row id="msg_0723_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gotta loosen up more.\nYou too tight. I’m loose. I lost.\r</language>
	</row>
	<row id="msg_0723_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fish, fish, FISH, that’s what I do!\nI’mma fish it ALL up!</language>
	</row>
	<row id="msg_0723_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KAHAHAH!\nI’m at the TOP of my game!\r</language>
	</row>
	<row id="msg_0723_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, WAAH!\nI let that one get away! Like my wife!\r</language>
	</row>
	<row id="msg_0723_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Explorin’ for relics ain’t all fun\nand games! It’s mostly dirt!</language>
	</row>
	<row id="msg_0723_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your skill level say you prob’ly\nwon’t make a good Ruin Maniac.\r</language>
	</row>
	<row id="msg_0723_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Danger lurks EVERYWHERE in ruins!\nAnd here, apparently.\r</language>
	</row>
	<row id="msg_0723_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">These mates of mine traveled the\nworld with me! Passports and all!</language>
	</row>
	<row id="msg_0723_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you think?\nPretty tough, right? Worldly!\r</language>
	</row>
	<row id="msg_0723_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maybe it’s time we hit the road\nagain... Somewhere you ain’t.\r</language>
	</row>
	<row id="msg_0723_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, check this out!\nMy RARE homie!</language>
	</row>
	<row id="msg_0723_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not just rare.\nMy homies is TOUGH too!\r</language>
	</row>
	<row id="msg_0723_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AIYAH! AYO! WAIT!\nNo! Stop! Don’t touch! It’s mint!\r</language>
	</row>
	<row id="msg_0723_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Be patient.\nI’ll show you my PRIVATE collection!</language>
	</row>
	<row id="msg_0723_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See, see? Wasn’t they AWESOME?\nThe most super of the uber!\r</language>
	</row>
	<row id="msg_0723_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Awawawah... My...\nMy homies... My collection...\r</language>
	</row>
	<row id="msg_0723_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LOOK! My favorite parasol!\nOh, and my fabulous homie!</language>
	</row>
	<row id="msg_0723_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t they BOTH cute?\nThe parasol cuter.\r</language>
	</row>
	<row id="msg_0723_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m only SHOWIN’ you!\nYou can’t have none!\r</language>
	</row>
	<row id="msg_0723_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ever seen a rainbow?\nIt’s free.</language>
	</row>
	<row id="msg_0723_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ever wonder what’s past\na rainbow? Me neither.\r</language>
	</row>
	<row id="msg_0723_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seein’ a rainbow make me think good\nthings comin’. Not today though.\r</language>
	</row>
	<row id="msg_0723_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you was the weather, what would\nyou be right now?</language>
	</row>
	<row id="msg_0723_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Right now? SUNNY.\nNo clouds. No Ls.\r</language>
	</row>
	<row id="msg_0723_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m feelin’ foggy...\nLike a Monday.\r</language>
	</row>
	<row id="msg_0723_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I deadass don’t like WEAK Hustlers!</language>
	</row>
	<row id="msg_0723_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You don’t inspire much trust...\nOr fear.\r</language>
	</row>
	<row id="msg_0723_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Hustler should be tough and\nburstin’ with life! Like you. Ugh.\r</language>
	</row>
	<row id="msg_0723_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lately, I been havin’ a lot to\nworry about... Taxes. Mostly taxes.</language>
	</row>
	<row id="msg_0723_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Winnin’ make all my worries seem\ntiny! Except the taxes.\r</language>
	</row>
	<row id="msg_0723_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You just added to my worries...\nRight under taxes.\r</language>
	</row>
	<row id="msg_0723_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This might hurt a lil, but we’ll\nbe done quick. Hold still!</language>
	</row>
	<row id="msg_0723_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There! Done!\nLollipop?\r</language>
	</row>
	<row id="msg_0723_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, NO!\nThat hurts! I hate needles!\r</language>
	</row>
	<row id="msg_0723_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sniff... Sniffle...</language>
	</row>
	<row id="msg_0723_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sniffle... Snuffle...\nI think I got a cold...\r</language>
	</row>
	<row id="msg_0723_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sniff... Sniffle...\nMy nose is cloggin’ up... Tissue?\r</language>
	</row>
	<row id="msg_0723_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sniff...\nSniff sniff...</language>
	</row>
	<row id="msg_0723_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What could this aroma be?\nIs that... Axe body spray?\r</language>
	</row>
	<row id="msg_0723_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got cologne on?\nYou smell kinda NICE! What is it?\r</language>
	</row>
	<row id="msg_0723_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You finna lose, but you’ll get\nto enjoy a nice aroma!</language>
	</row>
	<row id="msg_0723_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KYAHAHA! That’s what you get for\nswoonin’ to my aroma!\r</language>
	</row>
	<row id="msg_0723_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KIIIIH!\nI’m SO mad! I sprayed so much!\r</language>
	</row>
	<row id="msg_0723_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let my guitar HOWL!\nHear me SCREAM!</language>
	</row>
	<row id="msg_0723_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YEAHEY!\nWe ROCKIN’!\r</language>
	</row>
	<row id="msg_0723_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GIYAAAAH!\nI broke a string!\r</language>
	</row>
	<row id="msg_0723_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You should put your feelings into\nsongs. With sincerity, man.</language>
	</row>
	<row id="msg_0723_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The way I feel now?\nIt’s ROCK!\r</language>
	</row>
	<row id="msg_0723_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The way I feel now is kinda folksy.\nAcoustic. Sad acoustic.\r</language>
	</row>
	<row id="msg_0723_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hear me!\nThe Bird Keeper’s credo number one!</language>
	</row>
	<row id="msg_0723_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Soar high on a W!\r</language>
	</row>
	<row id="msg_0723_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rest your wings on a L!\nThat’s credo number two.\r</language>
	</row>
	<row id="msg_0723_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s both do our best!</language>
	</row>
	<row id="msg_0723_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yup, we BOTH did the best we could!\nI did better.\r</language>
	</row>
	<row id="msg_0723_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good goin’!\nI mean it. Mostly.\r</language>
	</row>
	<row id="msg_0723_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fly, fly, FLY!\nWe finna rule this scrap!</language>
	</row>
	<row id="msg_0723_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ZOOM!\r</language>
	</row>
	<row id="msg_0723_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We gon’ CRASH!\nBrace for impact!\r</language>
	</row>
	<row id="msg_0723_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m the Sailor among Sailors!\nBorn on the high seas!</language>
	</row>
	<row id="msg_0723_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The waves rocked me to sleep!\nThe sea was my MOTHER!\r</language>
	</row>
	<row id="msg_0723_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urp... Gweh... When I get on land,\nI get land-sick... Hold my hat...\r</language>
	</row>
	<row id="msg_0723_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I love the sea after all...</language>
	</row>
	<row id="msg_0723_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... I hear ’em...\nI hear the waves... Or my stomach.\r</language>
	</row>
	<row id="msg_0723_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanna be a BIG man.\nBig like the sea big.\r</language>
	</row>
	<row id="msg_0723_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YAHOO!</language>
	</row>
	<row id="msg_0723_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’mon!\nYou holler too! YAHOO!\r</language>
	</row>
	<row id="msg_0723_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GWEFF! HACK! HACK!\nHollerin’ choked me up!\r</language>
	</row>
	<row id="msg_0723_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You should aspire to the Hiker’s\nway of life! No showers!</language>
	</row>
	<row id="msg_0723_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You see?\nYou LOVE my lifestyle, don’t you?\r</language>
	</row>
	<row id="msg_0723_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’mon now!\nLook up to how I live! Smell aside!\r</language>
	</row>
	<row id="msg_0723_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Me and my homies is IDOLS!</language>
	</row>
	<row id="msg_0723_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Say what you will!\nWe IDOLS! Sign here!\r</language>
	</row>
	<row id="msg_0723_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got us beat on popularity...\nWe got 12 followers.\r</language>
	</row>
	<row id="msg_0723_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WATCH me!\nAll eyes on me!</language>
	</row>
	<row id="msg_0723_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh...\nThis is what I LIVE for...\r</language>
	</row>
	<row id="msg_0723_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I became a Idol ’cause I wanted\nEVERYBODY to see me! Not like this!\r</language>
	</row>
	<row id="msg_0723_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m too into scrappin’...\nThey might fire me as a Idol...</language>
	</row>
	<row id="msg_0723_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ is TOO much fun!\r</language>
	</row>
	<row id="msg_0723_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t help it.\nCan’t NOBODY keep me from scrappin’.\r</language>
	</row>
	<row id="msg_0723_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I run a marathon every mornin’!\nIt’s GREAT! I’m always tired!</language>
	</row>
	<row id="msg_0723_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My buff physique make for easy\nWs! Look at these calves!\r</language>
	</row>
	<row id="msg_0723_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So I lost!\nI can still run marathons! Slowly!\r</language>
	</row>
	<row id="msg_0723_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’mma jog in place while we scrap.\nFor my health.</language>
	</row>
	<row id="msg_0723_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s hear it for GOOD HEALTH!\r</language>
	</row>
	<row id="msg_0723_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GASP!\nMy ankle! I rolled my ANKLE!\r</language>
	</row>
	<row id="msg_0723_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUTTA THE WAY!\nI got deliveries to make!</language>
	</row>
	<row id="msg_0723_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What? You want me to deliver YOU\nsomewhere too? Extra fee.\r</language>
	</row>
	<row id="msg_0723_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">All the deliverin’ I do every day...\nMy back is SHOT.\r</language>
	</row>
	<row id="msg_0723_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I put up ALL the buildings around\nhere. With my bare hands.</language>
	</row>
	<row id="msg_0723_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So what you think?\nCool, huh? Up to code? Kinda.\r</language>
	</row>
	<row id="msg_0723_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My dream is a buildin’ taller than\na mountain! Permit’s pendin’.\r</language>
	</row>
	<row id="msg_0723_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Smell that? That’s HAY clingin’\nto my body.</language>
	</row>
	<row id="msg_0723_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHOA!\r</language>
	</row>
	<row id="msg_0723_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This smell is the sweet scent of hay\nthat homies love. People? Less.\r</language>
	</row>
	<row id="msg_0723_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight, take a run at me!\nMy barrel chest can TAKE it!</language>
	</row>
	<row id="msg_0723_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What? That’s ALL you got?\nTake a harder run at me!\r</language>
	</row>
	<row id="msg_0723_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh... Ow... That hurt... You broke\nmy barrel chest... Call my wife.\r</language>
	</row>
	<row id="msg_0723_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t gettin’ any younger.\nI can’t overdo it. My hip.</language>
	</row>
	<row id="msg_0723_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What I lack in youth, I make up for\nin experience. And naps.\r</language>
	</row>
	<row id="msg_0723_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you good AND young.\nThere’s a sparkle about you. Ugh.\r</language>
	</row>
	<row id="msg_0723_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO! You there, Hustler!\nYou and me, we scrappin’!</language>
	</row>
	<row id="msg_0723_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OWNED!\r</language>
	</row>
	<row id="msg_0723_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">UNBELIEVABLE!\nI need to sit down.\r</language>
	</row>
	<row id="msg_0723_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">These here my homies.\nRaised ’em with my ma and pa.</language>
	</row>
	<row id="msg_0723_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sure right kinda tough, ain’t\nthey? Farm strong!\r</language>
	</row>
	<row id="msg_0723_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, I’ll be!\nWe lost! Ma’s gon’ be mad!\r</language>
	</row>
	<row id="msg_0723_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m finna do my level best.\nYou better keep up!</language>
	</row>
	<row id="msg_0723_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whew! We sure did our best!\r</language>
	</row>
	<row id="msg_0723_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yup! We tried HARD, y’all!\nNow we nap.\r</language>
	</row>
	<row id="msg_0723_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, everybody!\nBig smiles! Say CHEESE!</language>
	</row>
	<row id="msg_0723_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Big smiles!\nC’mon! You look like you lost!\r</language>
	</row>
	<row id="msg_0723_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s a GREAT smile! Your victory\npose is picture perfect, too!\r</language>
	</row>
	<row id="msg_0723_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ZOOM in on you!</language>
	</row>
	<row id="msg_0723_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spot-on focus!\nFrame it!\r</language>
	</row>
	<row id="msg_0723_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zoom out, fade to black...\nDirector’s cut: I lose.\r</language>
	</row>
	<row id="msg_0723_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This camera is pretty hefty, actually.\nI got biceps from it.</language>
	</row>
	<row id="msg_0723_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My shoulder always rock stiff...\nMy camera toughened me up.\r</language>
	</row>
	<row id="msg_0723_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oof...\nI’m feelin’ groggy... Wrong lens.\r</language>
	</row>
	<row id="msg_0723_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup there, Hustler!\nPlease scrap with me!</language>
	</row>
	<row id="msg_0723_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for your help!\nFor the content!\r</language>
	</row>
	<row id="msg_0723_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I appreciate the lesson!\nI’mma post it anyway.\r</language>
	</row>
	<row id="msg_0723_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll do ANYTHING for a good news\nstory! Even this!</language>
	</row>
	<row id="msg_0723_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m relentless about scrappin’,\ntoo! Breaking news!\r</language>
	</row>
	<row id="msg_0723_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stop! Please, STOP!\nYou’ll break my mic! It’s a rental!\r</language>
	</row>
	<row id="msg_0723_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So, the question is, what’s your\nopinion of me?</language>
	</row>
	<row id="msg_0723_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">“What a TOUGH Hustler!” Is that\nwhat you thinkin’? Thought so.\r</language>
	</row>
	<row id="msg_0723_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m doin’ a live report on the\ntopic of... my L. Live. Great.\r</language>
	</row>
	<row id="msg_0723_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’mon!\nWe’ll run! TOGETHER!</language>
	</row>
	<row id="msg_0723_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GOOOOOOOAAAAAL!\r</language>
	</row>
	<row id="msg_0723_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wait!\nDon’t leave me behind! My legs!\r</language>
	</row>
	<row id="msg_0723_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gear change!\nWe attackin’ at TOP speed!</language>
	</row>
	<row id="msg_0723_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">VROOOOOM!\r</language>
	</row>
	<row id="msg_0723_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KABOOM!\nI crashed. Call a tow truck.\r</language>
	</row>
	<row id="msg_0723_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Can you keep up with my homies at\nfull speed? No? Bet.</language>
	</row>
	<row id="msg_0723_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TOO SLOW!\nLike dial-up.\r</language>
	</row>
	<row id="msg_0723_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m takin’ it to a zone beyond\nspeed! The losin’ zone.\r</language>
	</row>
	<row id="msg_0723_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’d rather cruise than go full speed.\nSlow and steady.</language>
	</row>
	<row id="msg_0723_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s take it easy.\nLike Sunday.\r</language>
	</row>
	<row id="msg_0723_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You oughta take things more\ncasual... Chill, bro.\r</language>
	</row>
	<row id="msg_0723_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I only know FULL power,\neven against a youngin!</language>
	</row>
	<row id="msg_0723_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FULL POWER is how I win!\r</language>
	</row>
	<row id="msg_0723_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PLEASE! Lemme call you Master\nHustler from now on!\r</language>
	</row>
	<row id="msg_0723_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My spirit BURNS, my fists is STEEL,\nand my sweat CASCADES!</language>
	</row>
	<row id="msg_0723_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HRRUMPH!\nTowel, please.\r</language>
	</row>
	<row id="msg_0723_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I sweated MORE. That make me\nthe winner! That’s the rule!\r</language>
	</row>
	<row id="msg_0723_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">EN GARDE!</language>
	</row>
	<row id="msg_0723_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m still ready for MORE.\r</language>
	</row>
	<row id="msg_0723_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urgh... Don’t you FORGET this!\nI’ll write it down.\r</language>
	</row>
	<row id="msg_0723_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO! C’mon!</language>
	</row>
	<row id="msg_0723_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nice fight!\nGood hands.\r</language>
	</row>
	<row id="msg_0723_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You not bad, you.\nNot bad AT ALL.\r</language>
	</row>
	<row id="msg_0723_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The ULTIMATE of my techniques!\nExperience it ALL!</language>
	</row>
	<row id="msg_0723_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m the GREATEST!\nGWAHAHAHA!\r</language>
	</row>
	<row id="msg_0723_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ve fallen in defeat?\nGW-GWAAAH!\r</language>
	</row>
	<row id="msg_0723_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO! Lil youngblood!\nA scrap, please!</language>
	</row>
	<row id="msg_0723_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lil youngblood!\nGood looks, real kindly!\r</language>
	</row>
	<row id="msg_0723_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lil youngblood!\nI’m DEADASS upset over this!\r</language>
	</row>
	<row id="msg_0723_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I, um... I never actually learned\nkarate. I watched a movie.</language>
	</row>
	<row id="msg_0723_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You kiddin’?!\nI’m NATURALLY talented?!\r</language>
	</row>
	<row id="msg_0723_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Black Belt is hard, huh?\nSo I just dress like one.\r</language>
	</row>
	<row id="msg_0723_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Five years on the mountain.\nMy hair grew WILD!</language>
	</row>
	<row id="msg_0723_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I bathe EVERY day!\nHow DARE you?\r</language>
	</row>
	<row id="msg_0723_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Another five years...?\nThe hair’s gon’ get worse.\r</language>
	</row>
	<row id="msg_0723_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You smirkin’ at my\neight-pack abs?</language>
	</row>
	<row id="msg_0723_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You don’t appreciate the beauty\nof PURE MUSCLE!\r</language>
	</row>
	<row id="msg_0723_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muscle is the ultimate beauty!\nI’mma flex in the mirror and cry.\r</language>
	</row>
	<row id="msg_0723_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">In love AND in scraps, I never\ntasted defeat!</language>
	</row>
	<row id="msg_0723_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See? We won AGAIN!\r</language>
	</row>
	<row id="msg_0723_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So I lost. I don’t care!\nI got a date soon! ...She cancelled.\r</language>
	</row>
	<row id="msg_0723_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is it! Over the top!\nEVERYBODY CHARGE!</language>
	</row>
	<row id="msg_0723_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The enemy Hustler has FALLEN!\nVictory is OURS!\r</language>
	</row>
	<row id="msg_0723_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RETREAT!\nSound the retreat! RUN!\r</language>
	</row>
	<row id="msg_0723_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been a Hustler 75 years.\nYou think you can win, youngin?</language>
	</row>
	<row id="msg_0723_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here’s a toast to my history!\nPass the prune juice!\r</language>
	</row>
	<row id="msg_0723_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My history of glory...\nEnds today. With a nap.\r</language>
	</row>
	<row id="msg_0723_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Are you prepared?</language>
	</row>
	<row id="msg_0723_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, a SUPERB scrap that was.\r</language>
	</row>
	<row id="msg_0723_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I tip my hat to you.\nIt’s a nice hat. Respect it.\r</language>
	</row>
	<row id="msg_0723_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my...\nSuch an ADORABLE Hustler...</language>
	</row>
	<row id="msg_0723_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Are we disappointed?\nHow adorable...\r</language>
	</row>
	<row id="msg_0723_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see...\nYou more than just adorable. Ugh.\r</language>
	</row>
	<row id="msg_0723_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">EEE-YEAH!</language>
	</row>
	<row id="msg_0723_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A stirrin’ shout, wouldn’t you\nsay? Quite bracin’.</language>
	</row>
	<row id="msg_0723_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gasp... Gasp...\nOh dear... I’m worn out. Too much yell.\r</language>
	</row>
	<row id="msg_0723_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bein’ rich don’t protect me from\nworries...</language>
	</row>
	<row id="msg_0723_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bein’ rich beats bein’ broke,\nbut... I’m still rich.\r</language>
	</row>
	<row id="msg_0723_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lavish parties day after day...\nIt’s EXHAUSTING, honestly.\r</language>
	</row>
	<row id="msg_0723_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come know defeat...\nLearn what it means to scrap...</language>
	</row>
	<row id="msg_0723_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see you gettin’ stronger...\nSlowly. Hella slowly.\r</language>
	</row>
	<row id="msg_0723_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The defeated just slink away...\n*slinks away*\r</language>
	</row>
	<row id="msg_0723_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Look into my EYES!</language>
	</row>
	<row id="msg_0723_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You fell under my SPELL!\r</language>
	</row>
	<row id="msg_0723_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My power of suggestion failed!\nBlink twice if you hypnotized.\r</language>
	</row>
	<row id="msg_0723_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...</language>
	</row>
	<row id="msg_0723_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Did it.\r</language>
	</row>
	<row id="msg_0723_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I focused my mind in silence...\n...It ain’t help.\r</language>
	</row>
	<row id="msg_0723_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My powers!\nThere’s NO trickery about ’em!</language>
	</row>
	<row id="msg_0723_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is PSYCHIC power!\r</language>
	</row>
	<row id="msg_0723_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There deadass is no trickery...\nI’m just bad.\r</language>
	</row>
	<row id="msg_0723_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Take it ALL!</language>
	</row>
	<row id="msg_0723_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AHAHA!\r</language>
	</row>
	<row id="msg_0723_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GAH!\r</language>
	</row>
	<row id="msg_0723_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Close your eyes and count...\nSlow... Slower...</language>
	</row>
	<row id="msg_0723_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was the countdown to my\nvictory!\r</language>
	</row>
	<row id="msg_0723_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch...\nI thought I could put you to sleep.\r</language>
	</row>
	<row id="msg_0723_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I live among homies.\nIn the woods. By choice.</language>
	</row>
	<row id="msg_0723_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I never been much of a scrapper,\nbut...\r</language>
	</row>
	<row id="msg_0723_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m just not much of a scrapper.\nI’m a hugger.\r</language>
	</row>
	<row id="msg_0723_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...These homies I raised with\nmy dad...</language>
	</row>
	<row id="msg_0723_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Dad, you seein’ this?\nI did it...\r</language>
	</row>
	<row id="msg_0723_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dad, I can’t...\nI need to raise ’em more...\r</language>
	</row>
	<row id="msg_0723_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Raisin’ homies take HONEST effort!</language>
	</row>
	<row id="msg_0723_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YAHAHA! Hands-on raisin’!\nLike a farm!\r</language>
	</row>
	<row id="msg_0723_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">URGWAH!\nLook what you did to my homies!\r</language>
	</row>
	<row id="msg_0723_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna see the homies\nI raised?</language>
	</row>
	<row id="msg_0723_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well?\nCute, ain’t they?\r</language>
	</row>
	<row id="msg_0723_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cut a girl some SLACK!\r</language>
	</row>
	<row id="msg_0723_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I specialize in raisin’ CUTE homies!</language>
	</row>
	<row id="msg_0723_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cute, yet strong! Right?\r</language>
	</row>
	<row id="msg_0723_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, but they SO cute!\nThat should count!\r</language>
	</row>
	<row id="msg_0723_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nice to meet you!\nUnderestimate me at your peril!</language>
	</row>
	<row id="msg_0723_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TOLD you!\r</language>
	</row>
	<row id="msg_0723_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I guess I underestimated you...\nPeril received.\r</language>
	</row>
	<row id="msg_0723_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmhm... I like the look\nin your eyes.</language>
	</row>
	<row id="msg_0723_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your eyes stay clear even in\ndefeat. Like jewels!\r</language>
	</row>
	<row id="msg_0723_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your eyes shine brighter than any\ngem I got at home! I got a LOT.\r</language>
	</row>
	<row id="msg_0723_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I was your age, I was\nQUITE the daredevil.</language>
	</row>
	<row id="msg_0723_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Seein’ you remind me of my own\nwild youth.\r</language>
	</row>
	<row id="msg_0723_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I daresay, you QUITE the\ndaredevil yourself!\r</language>
	</row>
	<row id="msg_0723_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna run home to mommy,\nhere’s your chance, punk!</language>
	</row>
	<row id="msg_0723_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GEHEHEH!\r</language>
	</row>
	<row id="msg_0723_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAAH!\nI want my MOMMY!\r</language>
	</row>
	<row id="msg_0723_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scraps achieve NOTHIN’!\nTake my hand! It’s about LOVE!</language>
	</row>
	<row id="msg_0723_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t mean to scrap--but take\nmy hand! It’s about LOVE!\r</language>
	</row>
	<row id="msg_0723_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrappin’ is futile!\nTake my hand! It’s about love!\r</language>
	</row>
	<row id="msg_0723_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I dropped my glasses.\nI can’t see straight.</language>
	</row>
	<row id="msg_0723_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I guess I won.\nI can’t see enough to tell.\r</language>
	</row>
	<row id="msg_0723_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I guess I lost.\nI can’t see enough to tell. Prob’ly.\r</language>
	</row>
	<row id="msg_0723_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steady and sure.\nYou build from the lil things up.</language>
	</row>
	<row id="msg_0723_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steady and sure is how I won!\r</language>
	</row>
	<row id="msg_0723_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">But I did things steady and sure...\nAnd slow. Too slow.\r</language>
	</row>
	<row id="msg_0723_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hehehehe...</language>
	</row>
	<row id="msg_0723_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GEHAHAHAHA!\r</language>
	</row>
	<row id="msg_0723_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sob, sob, sob...\r</language>
	</row>
	<row id="msg_0723_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everybody gather ’round for my\nSTUPENDICULAR homie show!</language>
	</row>
	<row id="msg_0723_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wasn’t that AMUSIN’?\r</language>
	</row>
	<row id="msg_0723_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nrrgh...\nI ain’t amused.\r</language>
	</row>
	<row id="msg_0723_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I shall train with you.</language>
	</row>
	<row id="msg_0723_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Show some SPINE!\nOn your feet!\r</language>
	</row>
	<row id="msg_0723_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FINE!\nThat’ll do!\r</language>
	</row>
	<row id="msg_0723_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why get all intellectual about stuff?\nIf it’s fun, why question it?</language>
	</row>
	<row id="msg_0723_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See, I can still win.\nI don’t see a problem!\r</language>
	</row>
	<row id="msg_0723_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So I lost!\nIf it’s fun, it’s hard!\r</language>
	</row>
	<row id="msg_0723_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I EXPECT you to be good...\nDon’t disappoint me!</language>
	</row>
	<row id="msg_0723_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My hope was misplaced...\r</language>
	</row>
	<row id="msg_0723_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got good things.\nKeep ’em.\r</language>
	</row>
	<row id="msg_0723_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My papa and mama is high-skill\nHustlers too.</language>
	</row>
	<row id="msg_0723_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s in my BLOODLINE!\r</language>
	</row>
	<row id="msg_0723_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papa, Mama!\nI’m SO sorry! Don’t take my phone!\r</language>
	</row>
	<row id="msg_0723_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I go ALL out in scraps,\nno matter what.</language>
	</row>
	<row id="msg_0723_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The inevitable conclusion!\r</language>
	</row>
	<row id="msg_0723_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I concede!\nWith dignity.\r</language>
	</row>
	<row id="msg_0723_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is it! The BIGGEST scrap of my\nlife! I can’t afford to lose!</language>
	</row>
	<row id="msg_0723_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WOOT, YEAH!\r</language>
	</row>
	<row id="msg_0723_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This sets me back to bein’ a Lass...\nDemoted.\r</language>
	</row>
	<row id="msg_0723_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My love of nature and homies\nmade a Ranger outta me!</language>
	</row>
	<row id="msg_0723_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I love to scrap, too!\r</language>
	</row>
	<row id="msg_0723_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh...\nI still love to scrap. Just less.\r</language>
	</row>
	<row id="msg_0723_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO! You ever thought about\nbein’ a Ranger?</language>
	</row>
	<row id="msg_0723_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, you might not make it at\nyour skill level.\r</language>
	</row>
	<row id="msg_0723_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yes, you got the mettle!\nBein’ a Ranger is a LOTTA fun!\r</language>
	</row>
	<row id="msg_0723_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Win or lose, a scrap only happens\nonce!</language>
	</row>
	<row id="msg_0723_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got any regrets?\r</language>
	</row>
	<row id="msg_0723_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got NO regrets!\n...Maybe one.\r</language>
	</row>
	<row id="msg_0723_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s my sworn duty to protect nature\nand the homies in it.</language>
	</row>
	<row id="msg_0723_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a hard life, but there’s a lot\nto enjoy every day.\r</language>
	</row>
	<row id="msg_0723_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a rewardin’ career.\nHow it sound to you? Hiring now!\r</language>
	</row>
	<row id="msg_0723_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My darlin’ homie gon’ put a\nWHOOPIN’ on you!</language>
	</row>
	<row id="msg_0723_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well? Satisfied?\nSay good looks.\r</language>
	</row>
	<row id="msg_0723_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, ain’t you TOUGH?\nI’m a lil stunned. Hold me.\r</language>
	</row>
	<row id="msg_0723_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t sleep tryin’ to come up\nwith this new strategy!</language>
	</row>
	<row id="msg_0723_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My strategy WORKED!\nNow I can sleep!\r</language>
	</row>
	<row id="msg_0723_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, but...\nI REALLY needed to sleep tonight...\r</language>
	</row>
	<row id="msg_0723_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The credo of the Dragon Tamer!\nNumber one!</language>
	</row>
	<row id="msg_0723_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">In victory, ROAR!\nRoar with your dragon!\r</language>
	</row>
	<row id="msg_0723_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Even in defeat, ROAR!\nRoar... quieter... with your dragon...\r</language>
	</row>
	<row id="msg_0723_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MIGHTY! Like a dragon!</language>
	</row>
	<row id="msg_0723_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strong, I’m!\nDragon strong!\r</language>
	</row>
	<row id="msg_0723_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Urf... I wanted to be strong...\nLizard strong.\r</language>
	</row>
	<row id="msg_0723_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See it! Feel it!\nThe ULTIMATE power... Prob’ly!</language>
	</row>
	<row id="msg_0723_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No defeat for me, the\nultimate... Prob’ly!\r</language>
	</row>
	<row id="msg_0723_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The title of ultimate, prob’ly!\nI give it to you. Prob’ly.\r</language>
	</row>
	<row id="msg_0723_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, SHEESH!\nRare homie!</language>
	</row>
	<row id="msg_0723_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hihihi... That’s what you get for\nlettin’ your guard down.\r</language>
	</row>
	<row id="msg_0723_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch.\nCouldn’t fool you. Smart one.\r</language>
	</row>
	<row id="msg_0723_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I hate bein’ cold, but I’m\nREAL good.</language>
	</row>
	<row id="msg_0723_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ch-chatter...\nWa-wahaha. I won! I’m f-f-freezin’!\r</language>
	</row>
	<row id="msg_0723_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ch-chatter... Urr...\nI’m gettin’ sleepy... Don’t lemme nap...\r</language>
	</row>
	<row id="msg_0723_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My ace homies on the go!</language>
	</row>
	<row id="msg_0723_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You surprise me!\nNot too shabby!\r</language>
	</row>
	<row id="msg_0723_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I like the sense you show!\nAnd the drip.\r</language>
	</row>
	<row id="msg_0723_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snow is WONDERFUL!\nEverything turn white.</language>
	</row>
	<row id="msg_0723_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Snow is SO romantic!\nCold. But romantic.\r</language>
	</row>
	<row id="msg_0723_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m whitin’ out...\nCall the ski patrol...\r</language>
	</row>
	<row id="msg_0723_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t this coat CUTE?\nI can’t move my arms though.</language>
	</row>
	<row id="msg_0723_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s toasty warm.\nI’m a burrito.\r</language>
	</row>
	<row id="msg_0723_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I feel snowed under...\nLiterally. Help.\r</language>
	</row>
	<row id="msg_0723_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m THE one! Number one outta ALL\nthe kids in shorts!</language>
	</row>
	<row id="msg_0723_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SEE? That’s what bein’ number one\nis about!\r</language>
	</row>
	<row id="msg_0723_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Darn...\nI’m STILL number one... in shorts.\r</language>
	</row>
	<row id="msg_0723_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m THE one! The ONLY true one\namong shorts-wearin’ kids!</language>
	</row>
	<row id="msg_0723_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SEE? That’s what bein’ the only\none is about!\r</language>
	</row>
	<row id="msg_0723_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ack...\nI’m the only one... who lost.\r</language>
	</row>
	<row id="msg_0723_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um...\nI’m pleased to meet you.</language>
	</row>
	<row id="msg_0723_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Awawa... We WON?\nUm? S-sorry.\r</language>
	</row>
	<row id="msg_0723_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Er, um...\nTh-good looks...\r</language>
	</row>
	<row id="msg_0723_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here goes!</language>
	</row>
	<row id="msg_0723_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BRAVO!\r</language>
	</row>
	<row id="msg_0723_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YELP!\r</language>
	</row>
	<row id="msg_0723_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You learn, too!</language>
	</row>
	<row id="msg_0723_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The harsh realities of scrappin’!\r</language>
	</row>
	<row id="msg_0723_00494" index="494">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The joy of victory!\nFor you. Not me.\r</language>
	</row>
	<row id="msg_0723_00495" index="495">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allow me to study you.</language>
	</row>
	<row id="msg_0723_00496" index="496">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gave me nothin’ new to learn.\nBoring.\r</language>
	</row>
	<row id="msg_0723_00497" index="497">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I get it now. In that spot, I\nshoulda used that move. Noted.\r</language>
	</row>
	<row id="msg_0723_00498" index="498">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My teacher gave me advice on\nscrappin’.</language>
	</row>
	<row id="msg_0723_00499" index="499">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My teacher was RIGHT!\nThat was SO easy!\r</language>
	</row>
	<row id="msg_0723_00500" index="500">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, my teacher was WRONG!\nNone of it worked! I want a refund!\r</language>
	</row>
	<row id="msg_0723_00501" index="501">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why we scrappin’?\nI don’t get it.</language>
	</row>
	<row id="msg_0723_00502" index="502">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why? I don’t understand.\r</language>
	</row>
	<row id="msg_0723_00503" index="503">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why did you win?\nWhat happens now? Am I fired?\r</language>
	</row>
	<row id="msg_0723_00504" index="504">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Homies is just another brand.\nYou know who gon’ win, right?</language>
	</row>
	<row id="msg_0723_00505" index="505">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not interested in a result that\nwas inevitable. Yawn.\r</language>
	</row>
	<row id="msg_0723_00506" index="506">
		<attribute name="window_context_name">used</attribute>
		<language name="English">But how... My... The homies I paid\nfor... I mean raised...\r</language>
	</row>
	<row id="msg_0723_00507" index="507">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t NOTHIN’ I can’t buy.\nBread can buy scraps!</language>
	</row>
	<row id="msg_0723_00508" index="508">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s NOTHIN’ bread can’t buy.\r</language>
	</row>
	<row id="msg_0723_00509" index="509">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll give you my allowance if you\nlemme win. It’s $500 a week.\r</language>
	</row>
	<row id="msg_0723_00510" index="510">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m deadass not cut out for\nthis socialite-lady thing...</language>
	</row>
	<row id="msg_0723_00511" index="511">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GAHAHAHAH!\r</language>
	</row>
	<row id="msg_0723_00512" index="512">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You SWINE! Now I’m HEATED!\nPardon me.\r</language>
	</row>
	<row id="msg_0723_00513" index="513">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll be done with you lickety-split!</language>
	</row>
	<row id="msg_0723_00514" index="514">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lickety-split is how YOU was done!\r</language>
	</row>
	<row id="msg_0723_00515" index="515">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lickety-split is how I’mma\nexcuse myself!\r</language>
	</row>
	<row id="msg_0723_00516" index="516">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Crunch-crunch...\nCrunch-crunch...</language>
	</row>
	<row id="msg_0723_00517" index="517">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE these crunchy Lava\nCookies... Want one? No.\r</language>
	</row>
	<row id="msg_0723_00518" index="518">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What am I standin’ on?\nBusted Nap Sacks?\r</language>
	</row>
	<row id="msg_0723_00519" index="519">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The way of the Bug Catcher!\nBear witness!</language>
	</row>
	<row id="msg_0723_00520" index="520">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is the way of the Bug Catcher!\r</language>
	</row>
	<row id="msg_0723_00521" index="521">
		<attribute name="window_context_name">used</attribute>
		<language name="English">All hail Bug Catchers!\nEven the losers!\r</language>
	</row>
	<row id="msg_0723_00522" index="522">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Feast your eyes on secret techniques\nof the ANCIENTS!</language>
	</row>
	<row id="msg_0723_00523" index="523">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See? What you think?\nAwestruck?\r</language>
	</row>
	<row id="msg_0723_00524" index="524">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s my cue to disappear in a\npuff of smoke. *cough cough*\r</language>
	</row>
	<row id="msg_0723_00525" index="525">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I see it!</language>
	</row>
	<row id="msg_0723_00526" index="526">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Think not ill of me...\r</language>
	</row>
	<row id="msg_0723_00527" index="527">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GYOEEEH!\r</language>
	</row>
	<row id="msg_0723_00528" index="528">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PIKAAA!</language>
	</row>
	<row id="msg_0723_00529" index="529">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PIKAPIKAAAH!\r</language>
	</row>
	<row id="msg_0723_00530" index="530">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pi pika...\n(He’s cryin’.)\r</language>
	</row>
	<row id="msg_0723_00531" index="531">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap, you say?\nI’m NEVER losin’ to you!</language>
	</row>
	<row id="msg_0723_00532" index="532">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YEEHAH! YIPPEE!\nI won, I won!\r</language>
	</row>
	<row id="msg_0723_00533" index="533">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urk...\nWe lost... Never say never.\r</language>
	</row>
	<row id="msg_0723_00534" index="534">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s my JOB to be cute!</language>
	</row>
	<row id="msg_0723_00535" index="535">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Just bein’ cute is bread in\nthe bank!\r</language>
	</row>
	<row id="msg_0723_00536" index="536">
		<attribute name="window_context_name">used</attribute>
		<language name="English">UGAGAAH!\nYou rotten THIEF! You stole my W!\r</language>
	</row>
	<row id="msg_0723_00537" index="537">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can shake my hand!\nIt’d be an HONOR for you!</language>
	</row>
	<row id="msg_0723_00538" index="538">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you won, I woulda even given\nyou my autograph!\r</language>
	</row>
	<row id="msg_0723_00539" index="539">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My management team gon’ have\nsomethin’ to say about this!\r</language>
	</row>
	<row id="msg_0723_00540" index="540">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RUN!\nDon’t think! RUN!</language>
	</row>
	<row id="msg_0723_00541" index="541">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Faster!\nMore! More! FASTER!\r</language>
	</row>
	<row id="msg_0723_00542" index="542">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Run!\nKeep runnin’ for me! I’m tired!\r</language>
	</row>
	<row id="msg_0723_00543" index="543">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hiya.\nNice to meet ya.</language>
	</row>
	<row id="msg_0723_00544" index="544">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight.\nNice seein’ ya.\r</language>
	</row>
	<row id="msg_0723_00545" index="545">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight.\nGood looks for comin’ by.\r</language>
	</row>
	<row id="msg_0723_00546" index="546">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My crew call me the EMPEROR\nof fishin’!</language>
	</row>
	<row id="msg_0723_00547" index="547">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I landed ANOTHER big one today!\r</language>
	</row>
	<row id="msg_0723_00548" index="548">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why the emperor of fishin’?\nI made it up. Nobody calls me that.\r</language>
	</row>
	<row id="msg_0723_00549" index="549">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When you get as good as me, you can\nwin easy, even asleep.</language>
	</row>
	<row id="msg_0723_00550" index="550">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz... Zzz...\n(He won. Asleep.)\r</language>
	</row>
	<row id="msg_0723_00551" index="551">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SSSNORE...\n(He lost. Also asleep.)\r</language>
	</row>
	<row id="msg_0723_00552" index="552">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Me and my mom travel around lookin’\nfor lost treasure.</language>
	</row>
	<row id="msg_0723_00553" index="553">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The rest of the time, we fish and\nfarm EVERY day. It’s a lot.\r</language>
	</row>
	<row id="msg_0723_00554" index="554">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You sure seem busy.\nWe ain’t. We just say we.\r</language>
	</row>
	<row id="msg_0723_00555" index="555">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WIN! That’s what I’mma do today!\nI’ll win tomorrow too!</language>
	</row>
	<row id="msg_0723_00556" index="556">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NAHAHA! NAHAHA!\nI ain’t losin’ my WHOLE life!\r</language>
	</row>
	<row id="msg_0723_00557" index="557">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NOOOO! No way!\nI DIDN’T lose! You lost! Somehow!\r</language>
	</row>
	<row id="msg_0723_00558" index="558">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Allow me to examine your prowess\nas a collector.</language>
	</row>
	<row id="msg_0723_00559" index="559">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You still lackin’.\nKeep at it.\r</language>
	</row>
	<row id="msg_0723_00560" index="560">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s QUITE the collection.\nI’ll take it off your hands. All of it.\r</language>
	</row>
	<row id="msg_0723_00561" index="561">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There! There! And THERE!</language>
	</row>
	<row id="msg_0723_00562" index="562">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yes, SIR!\r</language>
	</row>
	<row id="msg_0723_00563" index="563">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OWOWOWOOOH!\r</language>
	</row>
	<row id="msg_0723_00564" index="564">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I want you to HEAR it!\nA shout from the HEART!</language>
	</row>
	<row id="msg_0723_00565" index="565">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE music!\r</language>
	</row>
	<row id="msg_0723_00566" index="566">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s hear it for an ENCORE!\nAn encore of me losin’.\r</language>
	</row>
	<row id="msg_0723_00567" index="567">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Scrap?\nI’m down.</language>
	</row>
	<row id="msg_0723_00568" index="568">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SHEESH.\nGood stuff.\r</language>
	</row>
	<row id="msg_0723_00569" index="569">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks much.\r</language>
	</row>
	<row id="msg_0723_00570" index="570">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWOOM!</language>
	</row>
	<row id="msg_0723_00571" index="571">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Flap! Flap!\r</language>
	</row>
	<row id="msg_0723_00572" index="572">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’mma PLUCK you for that!\r</language>
	</row>
	<row id="msg_0723_00573" index="573">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sure, let’s duke it out!</language>
	</row>
	<row id="msg_0723_00574" index="574">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s scrap again!\r</language>
	</row>
	<row id="msg_0723_00575" index="575">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You not half bad!\nThree quarters bad. Kiddin’.\r</language>
	</row>
	<row id="msg_0723_00576" index="576">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lookin’ out at the waves...\nIt bring back memories.</language>
	</row>
	<row id="msg_0723_00577" index="577">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WROAAAAAR!\nDADDY!\r</language>
	</row>
	<row id="msg_0723_00578" index="578">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WROAAAAR!\nMOMMY!\r</language>
	</row>
	<row id="msg_0723_00579" index="579">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C’mon! Take a run at me!\nI can TAKE it!</language>
	</row>
	<row id="msg_0723_00580" index="580">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So what you think?\nToo burly for you?\r</language>
	</row>
	<row id="msg_0723_00581" index="581">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good job!\nWay to get past my SIZE!\r</language>
	</row>
	<row id="msg_0723_00582" index="582">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAAH! Wait! Wait a second!\nMy mind ain’t in this yet!</language>
	</row>
	<row id="msg_0723_00583" index="583">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hunh? It’s over already?\nWhat? I WON?\r</language>
	</row>
	<row id="msg_0723_00584" index="584">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Hah? It’s over already?\nWhat? I LOST?\r</language>
	</row>
	<row id="msg_0723_00585" index="585">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My favorite drink is Moomoo Milk.\nGot some?</language>
	</row>
	<row id="msg_0723_00586" index="586">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAHAHA! I get the W!\nLet’s celebrate over Moomoo Milk!\r</language>
	</row>
	<row id="msg_0723_00587" index="587">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GWAAH! Moomoo Milk!\nBring me some Moomoo Milk! STAT!\r</language>
	</row>
	<row id="msg_0723_00588" index="588">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You under ARREST!\nYou under ARREST!</language>
	</row>
	<row id="msg_0723_00589" index="589">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TAKEDOWN!\nYou have the right to remain silent!\r</language>
	</row>
	<row id="msg_0723_00590" index="590">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OFFICER DOWN!\nWait, I ain’t even a real cop.\r</language>
	</row>
	<row id="msg_0723_00591" index="591">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t a real Policeman.\nI’m a uniform collector.</language>
	</row>
	<row id="msg_0723_00592" index="592">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A uniform would suit you.\nFind one you like. Not mine.\r</language>
	</row>
	<row id="msg_0723_00593" index="593">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I must say, scrappin’ is\nWONDERFUL. Better than costumes.\r</language>
	</row>
	<row id="msg_0723_00594" index="594">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who knows what happen tomorrow?</language>
	</row>
	<row id="msg_0723_00595" index="595">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You lose one day, win the next.\nThat’s how it go.\r</language>
	</row>
	<row id="msg_0723_00596" index="596">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I might win tomorrow.\nThat’s what I believe.\r</language>
	</row>
	<row id="msg_0723_00597" index="597">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m throwin’ my ALL into this!</language>
	</row>
	<row id="msg_0723_00598" index="598">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YEAH! YAHOO!\r</language>
	</row>
	<row id="msg_0723_00599" index="599">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s OVER!\nGood game.\r</language>
	</row>
	<row id="msg_0723_00600" index="600">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The UNSTOPPABLE Camper\nmakes his stand!</language>
	</row>
	<row id="msg_0723_00601" index="601">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can be my follower if\nyou want. I got merch.\r</language>
	</row>
	<row id="msg_0723_00602" index="602">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wish I could be YOUR follower.\nI’ll buy your merch.\r</language>
	</row>
	<row id="msg_0723_00603" index="603">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t think I got any chance,\nbut sure, I’ll scrap.</language>
	</row>
	<row id="msg_0723_00604" index="604">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SHEESH, I wasn’t expectin’ to win.\nI ain’t got a speech.\r</language>
	</row>
	<row id="msg_0723_00605" index="605">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I knew I’d lose.\nI’m SO sorry for this.\r</language>
	</row>
	<row id="msg_0723_00606" index="606">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I think you real interested in\nme, ain’t you?</language>
	</row>
	<row id="msg_0723_00607" index="607">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You lost ’cause you was starin’\nat me too much.\r</language>
	</row>
	<row id="msg_0723_00608" index="608">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why you win?\nI thought you liked me!\r</language>
	</row>
	<row id="msg_0723_00609" index="609">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Win or lose, no grudges.</language>
	</row>
	<row id="msg_0723_00610" index="610">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YAY, YAY, YAY!\nWe did it!\r</language>
	</row>
	<row id="msg_0723_00611" index="611">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, YOU! Don’t EVER forget this!\nGrudge activated!\r</language>
	</row>
	<row id="msg_0723_00612" index="612">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Homies is for grown-ups too...\nLemme show you...</language>
	</row>
	<row id="msg_0723_00613" index="613">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you think?\nAm I deep like a old blues man?\r</language>
	</row>
	<row id="msg_0723_00614" index="614">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Though it cut me deep, it’s a man’s\nlot to endure the pain... *sips tea*\r</language>
	</row>
	<row id="msg_0723_00615" index="615">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What I got here ain’t\nactually a guitar.</language>
	</row>
	<row id="msg_0723_00616" index="616">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beep, boop, BZZT...\r</language>
	</row>
	<row id="msg_0723_00617" index="617">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This a keyboard synth.\nIt’s still payin’ off.\r</language>
	</row>
	<row id="msg_0723_00618" index="618">
		<attribute name="window_context_name">used</attribute>
		<language name="English">For work, I play a Swimmer\nor a Beauty sometimes.</language>
	</row>
	<row id="msg_0723_00619" index="619">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Idol can be ANYBODY!\r</language>
	</row>
	<row id="msg_0723_00620" index="620">
		<attribute name="window_context_name">used</attribute>
		<language name="English">But the REAL me...\nI’m still a Lass in a miniskirt!\r</language>
	</row>
	<row id="msg_0723_00621" index="621">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s have fun.\nI hate ANYTHING with pain!</language>
	</row>
	<row id="msg_0723_00622" index="622">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh! That was FUN!\r</language>
	</row>
	<row id="msg_0723_00623" index="623">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YOWCH! Watch it!\nYou play too ROUGH!\r</language>
	</row>
	<row id="msg_0723_00624" index="624">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll END this!\nWith my favorite homie!</language>
	</row>
	<row id="msg_0723_00625" index="625">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The love I got for my homies is\nCOMPLETE and perfectly strong...\r</language>
	</row>
	<row id="msg_0723_00626" index="626">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why? WHY?!\nWhy I LOSE?!\r</language>
	</row>
	<row id="msg_0723_00627" index="627">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Livin’ with homies...\nEvery day is the greatest.</language>
	</row>
	<row id="msg_0723_00628" index="628">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ehehe...\nHomies is the best...\r</language>
	</row>
	<row id="msg_0723_00629" index="629">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It ain’t a problem if I lose.\nI still got my homies...\r</language>
	</row>
	<row id="msg_0723_00630" index="630">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got my homies.\nI don’t need NOTHIN’ else.</language>
	</row>
	<row id="msg_0723_00631" index="631">
		<attribute name="window_context_name">used</attribute>
		<language name="English">With my homies, I’m happy every day.\r</language>
	</row>
	<row id="msg_0723_00632" index="632">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t that the same for you?\nAin’t it? AIN’T IT?\r</language>
	</row>
	<row id="msg_0723_00633" index="633">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wouldn’t guess, but I was a\nPARTY girl in my day.</language>
	</row>
	<row id="msg_0723_00634" index="634">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, I still GOT it, you know.\r</language>
	</row>
	<row id="msg_0723_00635" index="635">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I feel nostalgic for them days...\nThe ’70s was WILD.\r</language>
	</row>
	<row id="msg_0723_00636" index="636">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do your best!\nMy beloved babies!</language>
	</row>
	<row id="msg_0723_00637" index="637">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAHAHA! Well done!\nMama’s PROUD of you!\r</language>
	</row>
	<row id="msg_0723_00638" index="638">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies is my beloved family.\nWe’ll eat ice cream about it.\r</language>
	</row>
	<row id="msg_0723_00639" index="639">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lil boy? Lil girl? Don’t matter.\nLet’s do this!</language>
	</row>
	<row id="msg_0723_00640" index="640">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lil boy? Lil girl?\nDon’t matter, but sorry.\r</language>
	</row>
	<row id="msg_0723_00641" index="641">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lil boy? Lil girl? Don’t matter,\nyou TOUGH!\r</language>
	</row>
	<row id="msg_0723_00642" index="642">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your ride ends here.</language>
	</row>
	<row id="msg_0723_00643" index="643">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TOLD you it’s over.\r</language>
	</row>
	<row id="msg_0723_00644" index="644">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Too much for me to handle!\r</language>
	</row>
	<row id="msg_0723_00645" index="645">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We goin’ for the W!\nAyo-ho, let’s go!</language>
	</row>
	<row id="msg_0723_00646" index="646">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YAY! Vavavoom!\r</language>
	</row>
	<row id="msg_0723_00647" index="647">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, we lost...\nSniffle...\r</language>
	</row>
	<row id="msg_0723_00648" index="648">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lemme introduce you to\nmy cherished partners!</language>
	</row>
	<row id="msg_0723_00649" index="649">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you like ’em?\nMy cherished partners.\r</language>
	</row>
	<row id="msg_0723_00650" index="650">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Awawa...\nMy partners...\r</language>
	</row>
	<row id="msg_0723_00651" index="651">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Winnin’ and losin’ ain’t all\nthere is to scrappin’.</language>
	</row>
	<row id="msg_0723_00652" index="652">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, sure, winnin’ make me happy.\r</language>
	</row>
	<row id="msg_0723_00653" index="653">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The effort you put in is what’s\nimportant. Or so they tell me.\r</language>
	</row>
	<row id="msg_0723_00654" index="654">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t be too harsh...\nBut don’t spoil ’em either...</language>
	</row>
	<row id="msg_0723_00655" index="655">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bein’ a homie Breeder is deep\nand complex.\r</language>
	</row>
	<row id="msg_0723_00656" index="656">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Balance is key for raisin’ good\nhomies. Like parentin’. I got neither.\r</language>
	</row>
	<row id="msg_0723_00657" index="657">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll check how your homies grew\nfor you.</language>
	</row>
	<row id="msg_0723_00658" index="658">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not good enough!\nYour trainin’ ain’t up to par.\r</language>
	</row>
	<row id="msg_0723_00659" index="659">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This IMPRESSIVE! You raised your\nhomies DEADASS thorough.\r</language>
	</row>
	<row id="msg_0723_00660" index="660">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll win.\nNo cap.</language>
	</row>
	<row id="msg_0723_00661" index="661">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See?\nNo cap.\r</language>
	</row>
	<row id="msg_0723_00662" index="662">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh!\nSome cap.\r</language>
	</row>
	<row id="msg_0723_00663" index="663">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAAH! FWAAH!\nYou think you can beat me?</language>
	</row>
	<row id="msg_0723_00664" index="664">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAAH! FWAAH!\nI win!\r</language>
	</row>
	<row id="msg_0723_00665" index="665">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAAH!\r</language>
	</row>
	<row id="msg_0723_00666" index="666">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I caught you now.\nGive up.</language>
	</row>
	<row id="msg_0723_00667" index="667">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wasn’t bad.\nLet’s meet again.\r</language>
	</row>
	<row id="msg_0723_00668" index="668">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How could this be...?\r</language>
	</row>
	<row id="msg_0723_00669" index="669">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, yo!\nLet’s have a fun time!</language>
	</row>
	<row id="msg_0723_00670" index="670">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks!\nLet’s play again!\r</language>
	</row>
	<row id="msg_0723_00671" index="671">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks!\nPlay with me again!\r</language>
	</row>
	<row id="msg_0723_00672" index="672">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You no good at ALL.\nI better teach you.</language>
	</row>
	<row id="msg_0723_00673" index="673">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, no, this won’t do.\nOn your feet. Never give up!\r</language>
	</row>
	<row id="msg_0723_00674" index="674">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got good skills.\nYou tried hard too. EXCELLENT!\r</language>
	</row>
	<row id="msg_0723_00675" index="675">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m jackin’ the power to MAX!\nAll the way to ELEVEN!</language>
	</row>
	<row id="msg_0723_00676" index="676">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, YEAH! I’m feelin’ ELECTRIC!\r</language>
	</row>
	<row id="msg_0723_00677" index="677">
		<attribute name="window_context_name">used</attribute>
		<language name="English">EEYOW! I got ZAPPED!\nMy hair!\r</language>
	</row>
	<row id="msg_0723_00678" index="678">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, bring it!</language>
	</row>
	<row id="msg_0723_00679" index="679">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAH! Too weak!\nKeep tryin’!\r</language>
	</row>
	<row id="msg_0723_00680" index="680">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HOH! You TOUGH!\nGimme a rematch!\r</language>
	</row>
	<row id="msg_0723_00681" index="681">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You gotta be SERIOUS with me!</language>
	</row>
	<row id="msg_0723_00682" index="682">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh? That’s IT?\r</language>
	</row>
	<row id="msg_0723_00683" index="683">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK...\nQuite remarkable...\r</language>
	</row>
	<row id="msg_0723_00684" index="684">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AHAHA! Too bad for you!\nI’m your opponent!</language>
	</row>
	<row id="msg_0723_00685" index="685">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AHAHA!\r</language>
	</row>
	<row id="msg_0723_00686" index="686">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aha...\nAhaha... ha.\r</language>
	</row>
	<row id="msg_0723_00687" index="687">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You nervous?\nLeave it to the DUDE!</language>
	</row>
	<row id="msg_0723_00688" index="688">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That was a good scrap.\nThe dude approves.\r</language>
	</row>
	<row id="msg_0723_00689" index="689">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whew...\nThe dude wasn’t expectin’ to lose.\r</language>
	</row>
	<row id="msg_0723_00690" index="690">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The power of NATURE!\nLemme show you!</language>
	</row>
	<row id="msg_0723_00691" index="691">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is the power of nature!\nAnd sunscreen.\r</language>
	</row>
	<row id="msg_0723_00692" index="692">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Protect the natural environment...\nAnd my feelings.</language>
	</row>
	<row id="msg_0723_00693" index="693">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap with me? I don’t know\nwhat you talkin’ about.</language>
	</row>
	<row id="msg_0723_00694" index="694">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See?\nI thought this would happen.\r</language>
	</row>
	<row id="msg_0723_00695" index="695">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BOO! BOO!\nThis ain’t RIGHT!\r</language>
	</row>
	<row id="msg_0723_00696" index="696">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FUHAHAHA!\nYour next challenge is ME!</language>
	</row>
	<row id="msg_0723_00697" index="697">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FUHAHAHA! You seriously thought\nyou could beat me?\r</language>
	</row>
	<row id="msg_0723_00698" index="698">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FUHAHAHA!\nLet us meet again! ...Please?\r</language>
	</row>
	<row id="msg_0723_00699" index="699">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Off you go! Face my team of\nTOTALLY trained homies!</language>
	</row>
	<row id="msg_0723_00700" index="700">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BRAVO!\nI KNEW my homies would do it!\r</language>
	</row>
	<row id="msg_0723_00701" index="701">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, NO! That’s AWFUL!\nWhat you did to my homies?!\r</language>
	</row>
	<row id="msg_0723_00702" index="702">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap is DEADLY serious!\nNot one moment of slackin’!</language>
	</row>
	<row id="msg_0723_00703" index="703">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NEVER let your guard down!\r</language>
	</row>
	<row id="msg_0723_00704" index="704">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I seem to have let my mind\nwander... To lunch.\r</language>
	</row>
	<row id="msg_0723_00705" index="705">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO!</language>
	</row>
	<row id="msg_0723_00706" index="706">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HEEEY!\r</language>
	</row>
	<row id="msg_0723_00707" index="707">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo...\nquieter ayo...\r</language>
	</row>
	<row id="msg_0723_00708" index="708">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m tough, that’s all.</language>
	</row>
	<row id="msg_0723_00709" index="709">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I won, that’s all.\r</language>
	</row>
	<row id="msg_0723_00710" index="710">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I lost, that’s all.\r</language>
	</row>
	<row id="msg_0723_00711" index="711">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SHAAH!</language>
	</row>
	<row id="msg_0723_00712" index="712">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HWOOH!\r</language>
	</row>
	<row id="msg_0723_00713" index="713">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAWAH!\r</language>
	</row>
	<row id="msg_0723_00714" index="714">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I been here for YEARS, but I never\nget tired of this.</language>
	</row>
	<row id="msg_0723_00715" index="715">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You might not think so, but I’m\nstill a kid. Same grade as you.\r</language>
	</row>
	<row id="msg_0723_00716" index="716">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanna keep scrappin’ homies\neven when my hair is gray.\r</language>
	</row>
	<row id="msg_0723_00717" index="717">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lemme make one thing clear...\nYou ain’t capable of beatin’ me.</language>
	</row>
	<row id="msg_0723_00718" index="718">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Didn’t I say? There’s NO chance\nof you beatin’ me.\r</language>
	</row>
	<row id="msg_0723_00719" index="719">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How could this be...? Only that\nfloatie girl ever beat me...\r</language>
	</row>
	<row id="msg_0723_00720" index="720">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my, a mere child.</language>
	</row>
	<row id="msg_0723_00721" index="721">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kids these days...\nSo careless.\r</language>
	</row>
	<row id="msg_0723_00722" index="722">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kids these days...\nQuite energetic, methinks.\r</language>
	</row>
	<row id="msg_0723_00723" index="723">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I want my kids to be strong and\ndistinguished Hustlers.</language>
	</row>
	<row id="msg_0723_00724" index="724">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It wouldn’t do if my kids was\nonly as good as you...\r</language>
	</row>
	<row id="msg_0723_00725" index="725">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’d be nice if they was as\nskilled as you... I’ll trade ’em.\r</language>
	</row>
	<row id="msg_0723_00726" index="726">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Behold you shall!\nPsychic-mystifyin’ POWER!</language>
	</row>
	<row id="msg_0723_00727" index="727">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You see?\nPsychic-mystifyin’ power!\r</language>
	</row>
	<row id="msg_0723_00728" index="728">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, but...\nPsychic-mystifyin’ power...\r</language>
	</row>
	<row id="msg_0723_00729" index="729">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My family gon’ show you a GOOD time!</language>
	</row>
	<row id="msg_0723_00730" index="730">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hold up, my family!\nThat’s ENOUGH already!\r</language>
	</row>
	<row id="msg_0723_00731" index="731">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My beloved family...\nGroup hug. Now.\r</language>
	</row>
	<row id="msg_0723_00732" index="732">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twirl, twirl, twirl...</language>
	</row>
	<row id="msg_0723_00733" index="733">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You feelin’ dizzy?\nI’m.\r</language>
	</row>
	<row id="msg_0723_00734" index="734">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooorgh...\nMy head’s spinnin’...\r</language>
	</row>
	<row id="msg_0723_00735" index="735">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My big brother told me!\nEYES! Aim for the EYES!</language>
	</row>
	<row id="msg_0723_00736" index="736">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YAY! I did it!\nMy big brother’s plan WORKED!</language>
	</row>
	<row id="msg_0723_00737" index="737">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My big brother said to lower\nthe foe’s accuracy! He lied!</language>
	</row>
	<row id="msg_0723_00738" index="738">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HOY! You look pretty tough.\nThis gon’ be fun!</language>
	</row>
	<row id="msg_0723_00739" index="739">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I THOUGHT so!\nYou tough!\r</language>
	</row>
	<row id="msg_0723_00740" index="740">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yup, you sure tough.\nKeep it up!\r</language>
	</row>
	<row id="msg_0723_00741" index="741">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, welcome!\nI’m your server today!</language>
	</row>
	<row id="msg_0723_00742" index="742">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Would you care to settle\nyour bill? Tip included.\r</language>
	</row>
	<row id="msg_0723_00743" index="743">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks SO much!\r</language>
	</row>
	<row id="msg_0723_00744" index="744">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup.\nWhatchu havin’?</language>
	</row>
	<row id="msg_0723_00745" index="745">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks a MILLION!\r</language>
	</row>
	<row id="msg_0723_00746" index="746">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Be seein’ ya!\r</language>
	</row>
	<row id="msg_0723_00747" index="747">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I LOVE cute customers like you!\nI’ll serve you RIGHT!</language>
	</row>
	<row id="msg_0723_00748" index="748">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, was you happy with how\nI served you?\r</language>
	</row>
	<row id="msg_0723_00749" index="749">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, but...\nI ain’t done servin’ you. Dessert?\r</language>
	</row>
	<row id="msg_0723_00750" index="750">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stare...</language>
	</row>
	<row id="msg_0723_00751" index="751">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got somethin’ on your nose.\nRight there. No, other side.\r</language>
	</row>
	<row id="msg_0723_00752" index="752">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You hard, aight.\nI HAD to stare.\r</language>
	</row>
	<row id="msg_0723_00753" index="753">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I waited a LONG time for a Hustler\nlike you to come along.</language>
	</row>
	<row id="msg_0723_00754" index="754">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yup, as tough as I thought.\nYou even had me sweatin’!\r</language>
	</row>
	<row id="msg_0723_00755" index="755">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I KNEW it!\nYou a TOUGH Hustler!\r</language>
	</row>
	<row id="msg_0723_00756" index="756">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Now how should I run\nthis offensive?</language>
	</row>
	<row id="msg_0723_00757" index="757">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, I need a better effort\nthan THAT outta you.\r</language>
	</row>
	<row id="msg_0723_00758" index="758">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you done and happy?\nOK, another time then.\r</language>
	</row>
	<row id="msg_0723_00759" index="759">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies got a different taste\nfrom the usual bunch.</language>
	</row>
	<row id="msg_0723_00760" index="760">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Notice the difference?\nMy squad got RICH depth.\r</language>
	</row>
	<row id="msg_0723_00761" index="761">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Notice the difference?\nMy squad is refreshingly dry. Like wine.\r</language>
	</row>
	<row id="msg_0723_00762" index="762">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HIYA!\nTough-lookin’ Hustler, ain’t you!</language>
	</row>
	<row id="msg_0723_00763" index="763">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This feelin’ of joy is bubblin’\nup in me!\r</language>
	</row>
	<row id="msg_0723_00764" index="764">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooch...\nYou too much to handle.\r</language>
	</row>
	<row id="msg_0723_00765" index="765">
		<attribute name="window_context_name">used</attribute>
		<language name="English">VARRROOOOM!\nWatch me go FULL THROTTLE!</language>
	</row>
	<row id="msg_0723_00766" index="766">
		<attribute name="window_context_name">used</attribute>
		<language name="English">VAVAVAROOOOM!\nNot even close to redlinin’!\r</language>
	</row>
	<row id="msg_0723_00767" index="767">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vrrr... Vrruuu...\nI’m flat OUTTA gas...\r</language>
	</row>
	<row id="msg_0723_00768" index="768">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jingle, jingle!</language>
	</row>
	<row id="msg_0723_00769" index="769">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SKREEEECH!\r</language>
	</row>
	<row id="msg_0723_00770" index="770">
		<attribute name="window_context_name">used</attribute>
		<language name="English">THUD!\r</language>
	</row>
	<row id="msg_0723_00771" index="771">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s my dream to ride bikes with\nmy boyfriend.</language>
	</row>
	<row id="msg_0723_00772" index="772">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No ridin’ double, though!\nHelmet laws.\r</language>
	</row>
	<row id="msg_0723_00773" index="773">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wish I HAD a boyfriend!\r</language>
	</row>
	<row id="msg_0723_00774" index="774">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What’s your motive?\nWhat brought you here?</language>
	</row>
	<row id="msg_0723_00775" index="775">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You lose.\nNow what you gon’ do?\r</language>
	</row>
	<row id="msg_0723_00776" index="776">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Play it again.\r</language>
	</row>
	<row id="msg_0723_00777" index="777">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We’ll keep this match dry.</language>
	</row>
	<row id="msg_0723_00778" index="778">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I admire your technique.\r</language>
	</row>
	<row id="msg_0723_00779" index="779">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I remain humbled...\r</language>
	</row>
	<row id="msg_0723_00780" index="780">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You serious? A scrap?\nAgainst ME?</language>
	</row>
	<row id="msg_0723_00781" index="781">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CACKLE!\nYou shouldn’t have tried!\r</language>
	</row>
	<row id="msg_0723_00782" index="782">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DOUBLE SHEESH!\r</language>
	</row>
	<row id="msg_0723_00783" index="783">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll dance and sing and GRAB\nyour attention!</language>
	</row>
	<row id="msg_0723_00784" index="784">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, BABY!\r</language>
	</row>
	<row id="msg_0723_00785" index="785">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So much for grabbin’ your attention.\nYou grabbed my homies instead!\r</language>
	</row>
	<row id="msg_0723_00786" index="786">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ready, START!</language>
	</row>
	<row id="msg_0723_00787" index="787">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First across the finish line!\r</language>
	</row>
	<row id="msg_0723_00788" index="788">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WAAH! Wait for me!\r</language>
	</row>
	<row id="msg_0723_00789" index="789">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Can you explain why I’m here?</language>
	</row>
	<row id="msg_0723_00790" index="790">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I mean, who ARE you?\r</language>
	</row>
	<row id="msg_0723_00791" index="791">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why am I scrappin’ here?\nI came for a sandwich.\r</language>
	</row>
	<row id="msg_0723_00792" index="792">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My fishin’ rod technique is the BEST\nin all Sinnoh. Check it out!</language>
	</row>
	<row id="msg_0723_00793" index="793">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See it?\nSurprised, I bet!\r</language>
	</row>
	<row id="msg_0723_00794" index="794">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How I handle my rod got nothin’\nto do with scrappin’... I see that now.\r</language>
	</row>
	<row id="msg_0723_00795" index="795">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The two loves of my life is fishin’\nand scrappin’.</language>
	</row>
	<row id="msg_0723_00796" index="796">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I feel FANTASTIC when I land a big\nfish or win a big scrap.\r</language>
	</row>
	<row id="msg_0723_00797" index="797">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I was born to fish AND scrap!\nTwo hobbies. Zero wins today.\r</language>
	</row>
	<row id="msg_0723_00798" index="798">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I come here on a ship.\nBig ship it was.</language>
	</row>
	<row id="msg_0723_00799" index="799">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sinnoh, I like.\nHella nice place.\r</language>
	</row>
	<row id="msg_0723_00800" index="800">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You want go to sea? My ship, we\nsee wonderful things.\r</language>
	</row>
	<row id="msg_0723_00801" index="801">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? YOU my opponent?\nThis kinda unnervin’...</language>
	</row>
	<row id="msg_0723_00802" index="802">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m surprised...\nI ain’t think I’d win.\r</language>
	</row>
	<row id="msg_0723_00803" index="803">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See, I told you...\nI THOUGHT you was tough.\r</language>
	</row>
	<row id="msg_0723_00804" index="804">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAHAH! Howdy!</language>
	</row>
	<row id="msg_0723_00805" index="805">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HAHAH! Keep it comin’!\r</language>
	</row>
	<row id="msg_0723_00806" index="806">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for your time!\r</language>
	</row>
	<row id="msg_0723_00807" index="807">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s be good sports!\nBig smile!</language>
	</row>
	<row id="msg_0723_00808" index="808">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AHAHA! AHAHA!\nC’mon, you laugh too!\r</language>
	</row>
	<row id="msg_0723_00809" index="809">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m cheerful even in defeat!\nAHAHA! AHAHA! *cries*\r</language>
	</row>
	<row id="msg_0723_00810" index="810">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buck up.</language>
	</row>
	<row id="msg_0723_00811" index="811">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not bad.\r</language>
	</row>
	<row id="msg_0723_00812" index="812">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You good.\r</language>
	</row>
	<row id="msg_0723_00813" index="813">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The sweetest part of scrappin’?\nThe FINISHIN’ blow!</language>
	</row>
	<row id="msg_0723_00814" index="814">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Take THAT!\nThat’s my finisher!\r</language>
	</row>
	<row id="msg_0723_00815" index="815">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oof...\nI feel your final shots...\r</language>
	</row>
	<row id="msg_0723_00816" index="816">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you lookin’ NIFTY!</language>
	</row>
	<row id="msg_0723_00817" index="817">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you TRIED, right?\r</language>
	</row>
	<row id="msg_0723_00818" index="818">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you kinda tough.\r</language>
	</row>
	<row id="msg_0723_00819" index="819">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Listen! This my chorus group.\nMe and my homies!</language>
	</row>
	<row id="msg_0723_00820" index="820">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shooby-dooby DOOWOP!\r</language>
	</row>
	<row id="msg_0723_00821" index="821">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, wait!\nWe ain’t done singin’! Second verse!\r</language>
	</row>
	<row id="msg_0723_00822" index="822">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got tips from my online homies\non how to raise my squad.</language>
	</row>
	<row id="msg_0723_00823" index="823">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta thank my online homies.\nI don’t know who they though.\r</language>
	</row>
	<row id="msg_0723_00824" index="824">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, this BLOWS! My online homies lemme\ndown! Unfollowed!\r</language>
	</row>
	<row id="msg_0723_00825" index="825">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Can I have a moment?\nI’m tryna write a email.</language>
	</row>
	<row id="msg_0723_00826" index="826">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta get home quick and check\nmy email.\r</language>
	</row>
	<row id="msg_0723_00827" index="827">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you think you DOIN’?\nI wanna go already. My inbox.\r</language>
	</row>
	<row id="msg_0723_00828" index="828">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Father... Mother...\nPlease watch over me...</language>
	</row>
	<row id="msg_0723_00829" index="829">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Father... Mother...\nWas you watchin’...?\r</language>
	</row>
	<row id="msg_0723_00830" index="830">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Father... Mother...\nPlease forgive me...\r</language>
	</row>
	<row id="msg_0723_00831" index="831">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Can’t rightly say I much like\nscrappin’, I tell you.</language>
	</row>
	<row id="msg_0723_00832" index="832">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I won, but...\nI’m still SHAKIN’...\r</language>
	</row>
	<row id="msg_0723_00833" index="833">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grr...\nI’m so mad I could cry...\r</language>
	</row>
	<row id="msg_0723_00834" index="834">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s the power of SCIENCE!</language>
	</row>
	<row id="msg_0723_00835" index="835">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You see? Was you amazed?\nThat’s the power of SCIENCE!\r</language>
	</row>
	<row id="msg_0723_00836" index="836">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s inconceivable... How could\nSCIENCE lose?! Peer review needed!\r</language>
	</row>
	<row id="msg_0723_00837" index="837">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Charge, my homies! Show the\nfruits of our experiments!</language>
	</row>
	<row id="msg_0723_00838" index="838">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES, my homies proved my theory!\nI’ll get tenure now!\r</language>
	</row>
	<row id="msg_0723_00839" index="839">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What kinda experiments?\nThat’s classified.</language>
	</row>
	<row id="msg_0723_00840" index="840">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I shall regress to my childhood\nfor this scrap.</language>
	</row>
	<row id="msg_0723_00841" index="841">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Googoo gagga.\r</language>
	</row>
	<row id="msg_0723_00842" index="842">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gagga...\n*cries like a baby*\r</language>
	</row>
	<row id="msg_0723_00843" index="843">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAHAHAHA!\nYou come a LONG way!</language>
	</row>
	<row id="msg_0723_00844" index="844">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAHAHAHAHA!\r</language>
	</row>
	<row id="msg_0723_00845" index="845">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FWAHAHAHA!\nYou blessed to have your homies!\r</language>
	</row>
	<row id="msg_0723_00846" index="846">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll scrap you.</language>
	</row>
	<row id="msg_0723_00847" index="847">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll RECYCLE you.\r</language>
	</row>
	<row id="msg_0723_00848" index="848">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Think ecology. Think green.\nThink about my L.\r</language>
	</row>
	<row id="msg_0723_00849" index="849">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why, sure! Sound GREAT!\nWe gotta do this!</language>
	</row>
	<row id="msg_0723_00850" index="850">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BAM! All done!\r</language>
	</row>
	<row id="msg_0723_00851" index="851">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap while workin’... Good way to\ntake a break. Don’t tell my boss.\r</language>
	</row>
	<row id="msg_0723_00852" index="852">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll try to do my best!\nPlease gimme this chance!</language>
	</row>
	<row id="msg_0723_00853" index="853">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I DID it!\nI achieved my goal!\r</language>
	</row>
	<row id="msg_0723_00854" index="854">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I tried the best I could!\nGood looks for the encouragement!\r</language>
	</row>
	<row id="msg_0723_00855" index="855">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap is... a love letter\nwritten in sand.</language>
	</row>
	<row id="msg_0723_00856" index="856">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You understand what I’m sayin’?\nI guess you wouldn’t.\r</language>
	</row>
	<row id="msg_0723_00857" index="857">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You understand what I’m sayin’?\nI guess you wouldn’t. Deep stuff.\r</language>
	</row>
	<row id="msg_0723_00858" index="858">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WASSUP, YOU THERE! Yes, you!\nHold up. FREEZE!</language>
	</row>
	<row id="msg_0723_00859" index="859">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kids shouldn’t be out right now.\nGo home, and be quick about it.\r</language>
	</row>
	<row id="msg_0723_00860" index="860">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You shouldn’t mess with a police\nofficer like that. I’m callin’ backup.\r</language>
	</row>
	<row id="msg_0723_00861" index="861">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sssnork... Zzz...</language>
	</row>
	<row id="msg_0723_00862" index="862">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CLEFAIRY... Mumble...\nWait for me... Sssnork...\r</language>
	</row>
	<row id="msg_0723_00863" index="863">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mutter...\nEhehe... Ssssnore...\r</language>
	</row>
	<row id="msg_0723_00864" index="864">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s keep this ELEGANT!</language>
	</row>
	<row id="msg_0723_00865" index="865">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mmm, YES!\r</language>
	</row>
	<row id="msg_0723_00866" index="866">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You QUITE the Hustler yourself!\r</language>
	</row>
	<row id="msg_0723_00867" index="867">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A scrap ain’t somethin’ you\ncan calculate.</language>
	</row>
	<row id="msg_0723_00868" index="868">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What I tell you?\nYou win when you win.\r</language>
	</row>
	<row id="msg_0723_00869" index="869">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What I say, huh?\nYou lose when you lose.\r</language>
	</row>
	<row id="msg_0723_00870" index="870">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lotta stuff in life don’t go\nthe way you want.</language>
	</row>
	<row id="msg_0723_00871" index="871">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YIPPEE!\nThings went MY way!\r</language>
	</row>
	<row id="msg_0723_00872" index="872">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See...?\nTold you.\r</language>
	</row>
	<row id="msg_0723_00873" index="873">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t NOWHERE to run or hide!</language>
	</row>
	<row id="msg_0723_00874" index="874">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This was a foregone conclusion!\r</language>
	</row>
	<row id="msg_0723_00875" index="875">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Farewell!\n*runs and hides*\r</language>
	</row>
	<row id="msg_0723_00876" index="876">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wait for tough Hustlers here,\nrain or shine.</language>
	</row>
	<row id="msg_0723_00877" index="877">
		<attribute name="window_context_name">used</attribute>
		<language name="English">’Cause of that, I got so\nHELLA strong...\r</language>
	</row>
	<row id="msg_0723_00878" index="878">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Won’t a tough... No, forget that.\nI need a HARD Hustler to come...\r</language>
	</row>
	<row id="msg_0723_00879" index="879">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This for keepin’ the sun off.</language>
	</row>
	<row id="msg_0723_00880" index="880">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m strong at scrappin’, but I can’t\ntake sunlight...\r</language>
	</row>
	<row id="msg_0723_00881" index="881">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t wanna roast my skin.\nSPF 100. Every day.\r</language>
	</row>
	<row id="msg_0723_00882" index="882">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well...\nThose is RARE homies...</language>
	</row>
	<row id="msg_0723_00883" index="883">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I never caught those...\nYour homies is different, aight.\r</language>
	</row>
	<row id="msg_0723_00884" index="884">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you a Hustler?\nYou ain’t a homie?\r</language>
	</row>
	<row id="msg_0723_00885" index="885">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ready?</language>
	</row>
	<row id="msg_0723_00886" index="886">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cool.\r</language>
	</row>
	<row id="msg_0723_00887" index="887">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bye.\r</language>
	</row>
	<row id="msg_0723_00888" index="888">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beat me?\nTry again in ten years!</language>
	</row>
	<row id="msg_0723_00889" index="889">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No SPINE!\r</language>
	</row>
	<row id="msg_0723_00890" index="890">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You TOUGH!\nYou inspire me!\r</language>
	</row>
	<row id="msg_0723_00891" index="891">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Smellin’ sweet scents make me\nso drowsy...</language>
	</row>
	<row id="msg_0723_00892" index="892">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Yawn...\nOh? We done already?\r</language>
	</row>
	<row id="msg_0723_00893" index="893">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Yawn...\nOh, deadass? I lost?\r</language>
	</row>
	<row id="msg_0723_00894" index="894">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You sure you can handle me?\nI’m a ULTRASTELLAR talent.</language>
	</row>
	<row id="msg_0723_00895" index="895">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t feel bad!\nI’m a ultrastellar talent!\r</language>
	</row>
	<row id="msg_0723_00896" index="896">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You in the MIRACLE-STAR class!\r</language>
	</row>
	<row id="msg_0723_00897" index="897">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I live only for scraps.\nOnly Ws gimme hope.</language>
	</row>
	<row id="msg_0723_00898" index="898">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Naturally.\r</language>
	</row>
	<row id="msg_0723_00899" index="899">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who ARE you...?\r</language>
	</row>
