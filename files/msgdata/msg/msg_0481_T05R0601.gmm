<?xml version="1.0"?>
<body language="English">
	<row id="msg_0481_T05R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mr. Fuji: Welcome.\rHmm... You raisin’ your homies with a\nlot of love. I can feel it.\rPeople who love homies come here to\npay respect.\rPlease pay respect to the spirits.\nThey watchin’. Always.</language>
	</row>
	<row id="msg_0481_T05R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who let you in?! You got five\nseconds before I call my cousin.\rThere’s other homie restin’ places\nin here.\rThere’s rooms only Mr. Fuji can go\nin. I don’t ask. I don’t WANT to\fknow.</language>
	</row>
	<row id="msg_0481_T05R0601_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I came with my mama to visit homie\nrestin’ places... I’m scared. I’m SO\fscared.</language>
	</row>
	<row id="msg_0481_T05R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The homies that lived with me so\nlong...\rI ain’t treat ’em like homies!\fI loved ’em like my GRANDBABIES...\fBetter than my grandbabies,\nhonestly.</language>
	</row>
</body>
