<?xml version="1.0"?>
<body language="English">
	<row id="msg_0385_R34R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Grandma!\rLemme introduce my homie.\nThis {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahhh, so THIS your lil boyfriend...\nI mean “homie.” Mm-hmm.\fI see you, baby. I SEE you.\r</language>
	</row>
	<row id="msg_0385_R34R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: What? Grandma...!\nWhat you talkin’ about?!\rHe just live down the street...\r</language>
	</row>
	<row id="msg_0385_R34R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grandma: Hahaha. I know. I know.\rIf you brought him to MEET me, Lyra,\nhe must be special.\rRight, {STRVAR_1 3, 0, 0}? You eat? You look\nthin. Come see us anytime, baby!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Aight, I gotta go now...\nLater!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Oh! I almost forgot!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Here!\nThis my Pokégear number!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Lyra’s number\nin the Pokégear!\r</language>
	</row>
	<row id="msg_0385_R34R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: You know you can talk to your\nhomie while it follow you?\rThey do all kinda cute stuff on the\nroad and in town.\rI take notes every time they do\nsomethin’ funny.\rHit my line and I’ll tell you\nsome of ’em.\r</language>
	</row>
	<row id="msg_0385_R34R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Grandma!\rDon’t say NOTHIN’.\rWe both Hustlers, we supposed\nto swap numbers.\fThat’s it.\r</language>
	</row>
