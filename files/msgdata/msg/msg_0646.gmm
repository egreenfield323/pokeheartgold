<?xml version="1.0"?>
<body language="English">
	<row id="msg_0646_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika</language>
	</row>
	<row id="msg_0646_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? I can’t hear you. The\nconnection trash.\rCall back from somewhere else!</language>
	</row>
	<row id="msg_0646_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup...\nOh, hiya, what’s good?\fThings sweet over here!\r</language>
	</row>
	<row id="msg_0646_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a lotta Block Bosses who\nway stronger than me.\fWe both gotta work harder!</language>
	</row>
	<row id="msg_0646_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My schedule pretty open Sunday\nmornings.\rTry callin’ me then, OK?</language>
	</row>
	<row id="msg_0646_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got some free time right now.\nWanna link up for a\fscrap or somethin’? {YESNO 0}</language>
	</row>
	<row id="msg_0646_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yay, I’m happy! I got somethin’ else\nto look forward to now.\rI’ll be waitin’ at the Saffron Dojo.</language>
	</row>
	<row id="msg_0646_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, I see...</language>
	</row>
	<row id="msg_0646_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nWait, didn’t you already make enough\fother plans before you called?</language>
	</row>
	<row id="msg_0646_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll be waitin’ at the Saffron Dojo.\nDon’t forget!</language>
	</row>
	<row id="msg_0646_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Erika.\nHow you doin’?\r</language>
	</row>
	<row id="msg_0646_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m waitin’ at the Saffron Dojo...\fYou ain’t forget, did you?</language>
	</row>
	<row id="msg_0646_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You like plants?\nPlants is so delicate.\rHow much water,\nthe soil,\fthe temperature,\fthe weather...\fAll them lil things we don’t think\fabout can have a HUGE effect.\fI’m talkin’ ’bout flowers. Mostly.</language>
	</row>
	<row id="msg_0646_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You like tellin’ fortunes?\rMe...\nI don’t deadass like the kind where you\fpull petals off flowers...\rOh, but it ain’t that I don’t like the\nfortune-teller in Lavender Town.</language>
	</row>
	<row id="msg_0646_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you do on your days off?\rI like to tend the plants in my\nBlock, transplantin’ ’em and dustin’\fthe flowers and leaves with a brush.\fIt keep me pretty busy...</language>
	</row>
</body>
