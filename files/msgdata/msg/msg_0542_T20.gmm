<?xml version="1.0"?>
<body language="English">
	<row id="msg_0542_T20_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh, that Pokégear clean!</language>
	</row>
	<row id="msg_0542_T20_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}! Hold up!</language>
	</row>
	<row id="msg_0542_T20_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}! Hold up!</language>
	</row>
	<row id="msg_0542_T20_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where you think you goin’?\r</language>
	</row>
	<row id="msg_0542_T20_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t leave the block with\nno homie! You crazy?\rOpps be jumpin’ out the grass\non the way to the next town.</language>
	</row>
	<row id="msg_0542_T20_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, your lil homie is cute!\nI want one!</language>
	</row>
	<row id="msg_0542_T20_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\nLeavin’ again?\rTell your mama before you dip.\nShe been through enough.</language>
	</row>
	<row id="msg_0542_T20_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\nLeavin’ again?\rTell your mama before you dip.\nShe been through enough.</language>
	</row>
	<row id="msg_0542_T20_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Call your mama on the Pokégear.\nLet her know you still alive.</language>
	</row>
	<row id="msg_0542_T20_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That Bag fire, ngl!</language>
	</row>
	<row id="msg_0542_T20_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, wait a sec!\r</language>
	</row>
	<row id="msg_0542_T20_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You left your Pokégear at the crib?\rGo ask your mama.</language>
	</row>
	<row id="msg_0542_T20_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, {STRVAR_1 3, 0, 0}!\rWord is Elm cooked up some\nnew kinda Pokémon in there.</language>
	</row>
	<row id="msg_0542_T20_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\rSo this the famous Elm lab...\nSmells like a trap house.\r</language>
	</row>
	<row id="msg_0542_T20_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Tf you lookin’ at?\r</language>
	</row>
	<row id="msg_0542_T20_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Aye pimp! {STRVAR_1 3, 0, 0}!\rSo you rollin’ with...\n{STRVAR_1 0, 1, 0}!\rThat’s a hard lil homie, ngl!\rWalk it around the block. It’ll\nstart ridin’ for you real quick.\rTurn around and dap it up\nsometimes, too. Loyalty matters.\rOh, and go show your mama.\nShe could use some good news.\fBet, I’m out!\r</language>
	</row>
	<row id="msg_0542_T20_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Ayo! {STRVAR_1 3, 0, 0}!\rSo you rollin’ with...\n{STRVAR_1 0, 1, 0}!\rThat’s a hard lil homie, ngl!\rWalk it around the block. It’ll\nstart ridin’ for you real quick.\rTurn around and dap it up\nsometimes, too. Loyalty matters.\rOh, and go show your mama.\nShe could use some good news.\fBet, I’m out!\r</language>
	</row>
	<row id="msg_0542_T20_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Professor Elm: Wait! Wait wait wait!\r</language>
	</row>
	<row id="msg_0542_T20_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I almost forgot, my brain is...\nwhere was I. Oh! My number.\fCall me. Day or night. Mostly night.\r</language>
	</row>
	<row id="msg_0542_T20_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Professor Elm\nin the Pokégear as “Do Not Answer”!</language>
	</row>
	<row id="msg_0542_T20_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Professor Elm: I’ll hit you up\nif anything comes up. Or goes down.\r</language>
	</row>
	<row id="msg_0542_T20_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}! Where you goin’?\r</language>
	</row>
	<row id="msg_0542_T20_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elm been waitin’ on you.\fHe say he got somethin’ for you.\r</language>
	</row>
	<row id="msg_0542_T20_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You deaf? I said Elm\nwaitin’ on you!\r</language>
	</row>
	<row id="msg_0542_T20_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t make me take off my chancla!\r</language>
	</row>
	<row id="msg_0542_T20_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: What a Kimono Girl want\nwith you? You in trouble or nah?</language>
	</row>
	<row id="msg_0542_T20_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: What a Kimono Girl want\nwith you? You in trouble or nah?</language>
	</row>
	<row id="msg_0542_T20_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Aye pimp! {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0542_T20_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Wassup, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0542_T20_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where you think you goin’,\n{STRVAR_1 3, 0, 0}?\r</language>
	</row>
	<row id="msg_0542_T20_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Where you think you goin’,\n{STRVAR_1 3, 0, 0}?\r</language>
	</row>
	<row id="msg_0542_T20_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Hmm... My homie gettin’ a lil\nthick lately. Too much Takis...</language>
	</row>
	<row id="msg_0542_T20_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Hmm... My homie gettin’ a lil\nthick lately. Too much Takis...</language>
	</row>
	<row id="msg_0542_T20_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MARILL: Murfu. (Wassup.)\r</language>
	</row>
	<row id="msg_0542_T20_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">New Bark Town\nWhere Every Daddy Leaves</language>
	</row>
	<row id="msg_0542_T20_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}’s Crib</language>
	</row>
	<row id="msg_0542_T20_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elm’s “Lab”</language>
	</row>
	<row id="msg_0542_T20_00037" index="37">
