<?xml version="1.0"?>
<body language="English">
	<row id="msg_0259_P01R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua is on the way\nto Vermilion City.\rWe’ll announce when we\npull up.</language>
	</row>
	<row id="msg_0259_P01R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\nis on the way to Olivine City.\rWe’ll announce when we\npull up.</language>
	</row>
	<row id="msg_0259_P01R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\njust pulled up to Vermilion City.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\njust pulled up to Vermilion City.</language>
	</row>
	<row id="msg_0259_P01R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nWe already in Vermilion City.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\njust pulled up to Olivine City.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Fast Ship S.S. Aqua\njust pulled up to Olivine City.</language>
	</row>
	<row id="msg_0259_P01R0301_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHOA! My bad. I was in a hurry!\rMy granddaughter MISSIN’!\rShe just a lil girl. If you see her,\nlemme know! She bite!\r</language>
	</row>
	<row id="msg_0259_P01R0301_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here’s your cabin.\rIf your homies hurt, take a nap in\nthe bed. Don’t look under it.</language>
	</row>
	<row id="msg_0259_P01R0301_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here’s your cabin.\rYou can heal your homies\nby nappin’ in the bed.\rThe ship gon’ pull up while\nyou sleep.</language>
	</row>
	<row id="msg_0259_P01R0301_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Most passengers is Hustlers.\rThey all itchin’ to scrap in their\ncabins. It’s a fight cruise.</language>
	</row>
</body>
