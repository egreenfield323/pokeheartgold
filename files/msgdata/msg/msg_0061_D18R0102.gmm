<?xml version="1.0"?>
<body language="English">
	<row id="msg_0061_D18R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: You SEEN that?!\rSUICUNE flew by like a BLUR!\rTen YEARS I been chasin’ it, and I\nain’t never been this close! I’m\femotional!\fI’m gon’ frame the air it touched!\r</language>
	</row>
	<row id="msg_0061_D18R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By the way... SUICUNE noticed you.\nIt LOOKED at you. It never look at ME.\rThey say these homies only come to\npeople they see somethin’ in...\rMaybe I need to be more aggressive.\nMore binoculars. More bushes.\rAnyway, {STRVAR_1 3, 0, 0}, we gon’ link up again!\nWhether you like it or not!\r</language>
	</row>
</body>
