<?xml version="1.0"?>
<body language="English">
	<row id="msg_0623_T28GYM0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pryce a OG who been trainin’ homies\nfor like 50 years. He remember\fdinosaurs.\rHis attacks gon’ have you shiverin’\nin this freezer of a Block.\rYou ready to get ICED OUT?\rI mean--keep that fire goin’ against\nthe ice! Bring a coat!</language>
	</row>
	<row id="msg_0623_T28GYM0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pryce is somethin’, but you\nsomethin’ ELSE!\rThat was a HOT scrap across the\ngenerations! Grandpa got COOKED!</language>
	</row>
	<row id="msg_0623_T28GYM0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mahogany Town Block\nSlippery When Wet. And Dry.</language>
	</row>
	<row id="msg_0623_T28GYM0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mahogany Town Block\rBoss: Pryce\nGot Ran Through By:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
