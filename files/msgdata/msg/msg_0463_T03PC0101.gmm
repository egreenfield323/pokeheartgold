<?xml version="1.0"?>
<body language="English">
	<row id="msg_0463_T03PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Yeah, and the Block in Cinnabar\nGONE. I was SHOOK.\r...Yes? I’m on the PHONE. Go AWAY!</language>
	</row>
	<row id="msg_0463_T03PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">JIGGLYPUFF: Puu pupuu.</language>
	</row>
	<row id="msg_0463_T03PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Most homies get sleepy when a\nJIGGLYPUFF sing. It’s like a lullaby\fbut violent.\rSome moves only work while a homie\nsleep.</language>
	</row>
	<row id="msg_0463_T03PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aw... If only I had a HAUNTER...\rIf you got a HAUNTER, you’ll trade it\nfor my XATU, RIGHT? Say right. {YESNO 0}</language>
	</row>
	<row id="msg_0463_T03PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How wonderful! You made my day!\rThanks to you, I finally got the\nhomie I been lookin’ for...\fsince forever!</language>
	</row>
	<row id="msg_0463_T03PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It GOTTA be a HAUNTER!\rHAUNTER!! Not a GASTLY! Not a\nGENGAR! HAUNTER!</language>
	</row>
	<row id="msg_0463_T03PC0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You’d never turn down a trade\nif you had a HAUNTER.\rSo you must not have one.\nThat gotta be it...</language>
	</row>
	<row id="msg_0463_T03PC0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you like the HARD XATU I traded\nyou?\rIt’s SO hard, ’cause it used to be\nwith hard ME!</language>
	</row>
</body>
