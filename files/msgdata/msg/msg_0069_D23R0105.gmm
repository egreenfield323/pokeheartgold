<?xml version="1.0"?>
<body language="English">
	<row id="msg_0069_D23R0105_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahem, can y’all hear me?\r...I’m the Director. Fr fr.\nDefinitely not a Fed. No cap.\rWe gon’ broadcast fire\nshows glazin’ The Feds 24/7!\rI don’t wanna hear NOBODY\ncomplain. Just do good work...\r</language>
	</row>
	<row id="msg_0069_D23R0105_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yikes!\nI’m busy impersonatin’ the...\fWho you?!\r</language>
	</row>
	<row id="msg_0069_D23R0105_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Bruh. It’s you AGAIN, {STRVAR_1 3, 0, 0}?\nYou EVERYWHERE, like a ankle monitor!\r</language>
	</row>
	<row id="msg_0069_D23R0105_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Petrel: Nah, nah, NAH! I was posin’ as\nthe Director so the whole region\fride with The Feds!\rMy disguise was flawless! I got\nthe glasses AND the mustache!\rThis time I ain’t holdin’ back!\nRun me EVERYTHING you got!\r</language>
	</row>
	<row id="msg_0069_D23R0105_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Petrel: Aight, aight, I’ll snitch.\rWe got the real Director locked in\nthe underground warehouse.\rIt’s at the far end of the\nGoldenrod Tunnel.\rI’m a real one tho. Here go the\nBasement Key to the\funderground warehouse.\fDon’t tell nobody I folded!\r</language>
	</row>
	<row id="msg_0069_D23R0105_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Petrel: We got the Director in\nthe underground warehouse.\rIt’s at the far end of the\nGoldenrod Tunnel.\rHahaha...\nA lil kid like you ain’t makin’ it.</language>
	</row>
	<row id="msg_0069_D23R0105_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Director: Wassup, it’s you! You know,\nI deadass love homies.\rI built this Radio Tower just to\nshow how much I love homies.\rIt’d be nice if people enjoyed our\nshows.</language>
	</row>
	<row id="msg_0069_D23R0105_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">5F Director’s Office</language>
	</row>
	<row id="msg_0069_D23R0105_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Go Up for the Observation Deck</language>
	</row>
</body>
