<?xml version="1.0"?>
<body language="English">
	<row id="msg_0610_T26R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-uh. Not in MY house.\nState your business. Quick.\rOlivine on the SEA!\rAnd if it’s on the sea, there’s gotta\nbe somethin’ to catch!\rI been fishin’ here 30 years. Caught\nthree fish and a toilet seat.\rWanna face the sea and fish? {YESNO 0}</language>
	</row>
	<row id="msg_0610_T26R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AH, HAHAH!\nWe got ourselves a new fisherman!\fWelcome to a life of disappointment!</language>
	</row>
	<row id="msg_0610_T26R0601_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0610_T26R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Water homies ain’t just in the sea.\fThey go wherever there’s water.\fI found one in my toilet.</language>
	</row>
	<row id="msg_0610_T26R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHAAAT? You don’t like fishin’?!\fI can’t even COMPREHEND that!\fGet out my house!</language>
	</row>
	<row id="msg_0610_T26R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How it’s goin’? Land the big one yet?\nMe neither. 30 years.</language>
	</row>
</body>
