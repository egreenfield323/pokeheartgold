<?xml version="1.0"?>
<body language="English">
	<row id="msg_0456_T02R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You put thought into your homies’\nnames?\rGood nicknames make tradin’ more fun.\nBad nicknames make it hilarious.</language>
	</row>
	<row id="msg_0456_T02R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s Speary--a SPEAROW--and\nRattey--a RATTATA.\rI’m not creative. I know. I KNOW.</language>
	</row>
	<row id="msg_0456_T02R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Speary: Ch-chun!</language>
	</row>
	<row id="msg_0456_T02R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rattey: Kikiii!</language>
	</row>
</body>
