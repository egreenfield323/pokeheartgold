<?xml version="1.0"?>
<body language="English">
	<row id="msg_0597_T25R1006_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You listen to the radio?\rI LOVE Buena’s Password!\rI write down every password so I don’t\nforget.\rMy whole Pokégear covered in Sharpie.\nI can’t see the screen no more.</language>
	</row>
	<row id="msg_0597_T25R1006_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Even The Feds gotta admit the radio\nhit different up here. Fresh air.\fClear signal.\fGreat for wiretaps.</language>
	</row>
	<row id="msg_0597_T25R1006_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you tired, try somethin’ from the\nVendin’ Machine.\rIt’s mostly sugar. Your homies gon’\nbe bouncin’ off the walls.</language>
	</row>
	<row id="msg_0597_T25R1006_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Feds...\rGrab a drink from the vendin’ machine\nand take a break.\rIt’s time you think about what you\ndoin’ with your life. Go back to\fschool.</language>
	</row>
	<row id="msg_0597_T25R1006_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Take a Break from Shoppin’!\n6F Rooftop Atrium</language>
	</row>
	<row id="msg_0597_T25R1006_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a vendin’ machine.\nWhat you want? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clunk!\rA can of {STRVAR_1 8, 0, 0} dropped down.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clunk!\rBONUS! Another can of {STRVAR_1 8, 0, 0}!\nThis machine BROKE! Don’t tell nobody!\r</language>
	</row>
	<row id="msg_0597_T25R1006_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not enough bread...</language>
	</row>
	<row id="msg_0597_T25R1006_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Decided not to buy nothin’.</language>
	</row>
	<row id="msg_0597_T25R1006_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The MUST-TRY of the Goldenrod\nDept. Store!\fWelcome to the Daily Drawin’ Corner!\rIt’s $300 a try, and the prizes\nis HARD! Mostly Berries!\rYou wanna try? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight. Draw one!\r...\n...\r</language>
	</row>
	<row id="msg_0597_T25R1006_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sheesh!\nYou hit the no. {STRVAR_1 50, 0, 0} prize!\rHere you go.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00013" index="13">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0597_T25R1006_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my... Better luck tomorrow.\nThat’s what everybody hear. Every day.</language>
	</row>
	<row id="msg_0597_T25R1006_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my...\nYour Bag full.\rWe’ll give you your bread back.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh my...\nYou short on bread.\rCome back now.</language>
	</row>
	<row id="msg_0597_T25R1006_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back now.</language>
	</row>
	<row id="msg_0597_T25R1006_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunday’s prizes:\rNo. 1, TM02!\nNo. 2, Drip Ball!\fOr No. 3, a Berry!</language>
	</row>
	<row id="msg_0597_T25R1006_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monday’s prizes:\rNo. 1, TM65!\nNo. 2, Crib Ball!\fOr No. 3, a Berry!</language>
	</row>
	<row id="msg_0597_T25R1006_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuesday’s prizes:\rNo. 1, TM91!\nNo. 2, Re-Up Ball!\fOr No. 3, a Berry!</language>
	</row>
	<row id="msg_0597_T25R1006_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wednesday’s prizes:\rNo. 1, TM57!\nNo. 2, Trap Ball!\fOr No. 3, a Berry!</language>
	</row>
	<row id="msg_0597_T25R1006_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Thursday’s prizes:\rNo. 1, TM60!\nNo. 2, Dash Ball!\fOr No. 3, a Berry!</language>
	</row>
	<row id="msg_0597_T25R1006_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Friday’s prizes:\rNo. 1, TM42!\nNo. 2, Night Ball!\fOr No. 3, a Berry!</language>
	</row>
	<row id="msg_0597_T25R1006_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saturday’s prizes:\rNo. 1, TM62!\nNo. 2, Late Ball!\fOr No. 3, a Berry!</language>
	</row>
	<row id="msg_0597_T25R1006_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Ayo, what a coincidence!\nThis gotta be FATE.\rWanna swap numbers?\nPleeease? I’ll cry if you don’t. {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Whitney’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0597_T25R1006_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: I’m free around noon\non Saturdays.\rHit my line when you got time.</language>
	</row>
	<row id="msg_0597_T25R1006_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Don’t be so MEAN.\nI’m ’bout to cry. I’m cryin’.</language>
	</row>
	<row id="msg_0597_T25R1006_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: You want my number\nnow? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Let’s take a\npic together! {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: OK!\nStand right next to me, right here!\r</language>
	</row>
	<row id="msg_0597_T25R1006_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: We look SO good together.\nI’m postin’ this. Tag yourself.</language>
	</row>
	<row id="msg_0597_T25R1006_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: That’s a shame!\n*sniff* It’s fine. I’m fine.</language>
	</row>
	<row id="msg_0597_T25R1006_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete\nsome pics.</language>
	</row>
</body>
