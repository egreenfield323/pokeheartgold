<?xml version="1.0"?>
<body language="English">
	<row id="msg_0120_D37R0105_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Director: Who? WHAT? You came to\nrescue me?! GOOD LOOKS!\rThey locked me in here with NO\nsnacks!\rThe Radio Tower! What’s goin’ on?\rThe FEDS took it over?! Over WHAT?\nWe play smooth jazz!\rHere. Take this Card Key. Go get my\ntower back!\r</language>
	</row>
	<row id="msg_0120_D37R0105_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0120_D37R0105_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Director: Use that to open the\nshutters on 3F.\r</language>
	</row>
	<row id="msg_0120_D37R0105_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m BEGGIN’ you, help.\rIf they control the transmitter,\nthey could control homies with a\fsignal!\rOr worse, play COUNTRY MUSIC!\rYou the only one I can call. Please\nsave the Radio Tower...\fand every homie in the country!</language>
	</row>
</body>
