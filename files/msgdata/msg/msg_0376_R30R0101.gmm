<?xml version="1.0"?>
<body language="English">
	<row id="msg_0376_R30R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People always knock on my door\nlookin’ for Mr. Pokémon’s spot.\fBut you came to see ME, right?\rThat’s love!\nYou got any...Apricorns?\fThe trees drop ’em once a day.\fI got one of them trees too!\rApricorns hard, ngl.\nYou can make Hood Balls and\fall kinda stuff.\rThey mad useful.\rI feel like this meant to be.\nI’m so happy I’ma give you this!\r</language>
	</row>
	<row id="msg_0376_R30R0101_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0376_R30R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">With that Apricorn Box, you can carry\na whole lotta Apricorns.\fYou gon’ be a real Apricorn plug!</language>
	</row>
	<row id="msg_0376_R30R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, Apricorn plug!\rYou notice the Apricorn colors\nchange from tree to tree?\rRemember which tree got\nwhich color. That’s game.</language>
	</row>
</body>
