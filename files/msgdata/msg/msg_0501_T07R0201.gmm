<body language="English">
	<row id="msg_0501_T07R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You need somethin’? I’m the manager\nof the condos.\rIt’s mad safe round here, so I ain’t\ngot much to do. I just walk my\fhomies.\rBy the way, we got TWO elevators.\fDon’t get confused. Everybody get\nconfused.</language>
	</row>
	<row id="msg_0501_T07R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MEOWTH: Meow!</language>
	</row>
	<row id="msg_0501_T07R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CLEFAIRY: Clef cleff!</language>
	</row>
	<row id="msg_0501_T07R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIDORAN♀: Kya kyaoo!</language>
	</row>
	<row id="msg_0501_T07R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Take this elevator\nto go to the third floor.</language>
	</row>
</body>
