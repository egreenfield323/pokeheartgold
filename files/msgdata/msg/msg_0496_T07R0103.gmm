<?xml version="1.0"?>
<body language="English">
	<row id="msg_0496_T07R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can’t decide which homie gets this\nTM... I been standin’ here for a hour.\fThey closin’ soon.</language>
	</row>
	<row id="msg_0496_T07R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh-oh! I traded my homie without\ntakin’ the Up-Grade off it. It’s GONE.\fMy Up-Grade!</language>
	</row>
	<row id="msg_0496_T07R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YEAH! I’m FINALLY gettin’ a PORYGON!\rI’m TRASH at the Coin game, so I could\nnever get enough Coins...\r...Huh?\rI traded PORYGON, and it turned into a\ndifferent homie?! That’s a SCAM!</language>
	</row>
	<row id="msg_0496_T07R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The TM Shop sell some RARE moves.\nAt RARE prices.</language>
	</row>
	<row id="msg_0496_T07R0103_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Make Your Homies Stronger!\n3F: TM Shop</language>
	</row>
</body>
