<?xml version="1.0"?>
<body language="English">
	<row id="msg_0509_T07R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanted PORYGON, but I was short\n100 Coins... 100! After TWO WEEKS!</language>
	</row>
	<row id="msg_0509_T07R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whew...\rGotta stay calm and collected...\rIf I spend all my time here, I’ma be\nin trouble at home. Too late. I’m\falready\fin trouble.</language>
	</row>
	<row id="msg_0509_T07R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I woke up and saw my potential!\rSo what potential woke up in me?\nWhat’s my hidden power, you ask?\rIt’s a power that lemme see the\nHidden Strap of a homie.\rWhen they learn that move, I can\ntell what type it’s gon’ be.\rSo, want me to use my hidden power?\rI’ll tell you what type your\nhomie’s Hidden Strap gon’ be. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll tell you what type your homie’s\nHidden Strap gon’ be.\rMy own hidden power lemme\ndo that. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If this homie learned\nHidden Strap, the move’s type\fwould be {STRVAR_1 15, 0, 0}.</language>
	</row>
	<row id="msg_0509_T07R0501_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This homie’s Hidden Strap is the\n{STRVAR_1 15, 0, 0} type.</language>
	</row>
	<row id="msg_0509_T07R0501_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you wanna know, ask me, and I’ll\nactivate my hidden power for you.</language>
	</row>
	<row id="msg_0509_T07R0501_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A move a Egg can learn?!\nThat’s flat-out impossible.</language>
	</row>
	<row id="msg_0509_T07R0501_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, no. This homie can’t learn the\nmove Hidden Strap in the first place.</language>
	</row>
	<row id="msg_0509_T07R0501_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome!\rWe trade your Coins for hard prizes!\nDon’t ask how much you spent. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight. Save your Coins and come back!\nThey always come back.</language>
	</row>
	<row id="msg_0509_T07R0501_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sorry! You need more coins. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 0, 0}.\nThat right? {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here you go!\r</language>
	</row>
	<row id="msg_0509_T07R0501_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sorry. You can’t carry no more.\r</language>
	</row>
	<row id="msg_0509_T07R0501_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your crew full!\nMake some room\fbefore you come back.</language>
	</row>
	<row id="msg_0509_T07R0501_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You want {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} got\nthe {STRVAR_1 0, 1, 0}! {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome!\rWe trade your coins for\nhard prizes! {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You put the {STRVAR_1 8, 0, 0}\nin the {STRVAR_1 18, 1, 0} Pocket. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00020" index="20">
