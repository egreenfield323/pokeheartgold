<?xml version="1.0"?>
<body language="English">
	<row id="msg_0079_D24R0211_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a replica of an ancient homie.</language>
	</row>
	<row id="msg_0079_D24R0211_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm.\nWhen did this show up...?\rWhat these symbols mean...\f..................\r</language>
	</row>
	<row id="msg_0079_D24R0211_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, you!\nBack to the Research Center!\r</language>
	</row>
	<row id="msg_0079_D24R0211_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The symbols on the stone panel\nlooked like this...\r</language>
	</row>
	<row id="msg_0079_D24R0211_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OUR HOMIES LOOK\nUP AND SHOW US\fMAD LOVE\r</language>
	</row>
	<row id="msg_0079_D24R0211_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What that even mean?\nWe gotta check the ruins again.\r</language>
	</row>
	<row id="msg_0079_D24R0211_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} opened the UNOWN Report\nand took notes!</language>
	</row>
</body>
