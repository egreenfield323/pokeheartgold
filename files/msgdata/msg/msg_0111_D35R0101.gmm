<?xml version="1.0"?>
<body language="English">
	<row id="msg_0111_D35R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\rYou hear wind blowin’ in here?\nThat’s...just me whistlin’.\rEnough about that.\nWhy don’t you buy somethin’? {YESNO 0}</language>
	</row>
	<row id="msg_0111_D35R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arrgh...\nYou found the secret stairs...\rHOW?! We got these registered\nwith the city as a BROOM CLOSET!</language>
	</row>
	<row id="msg_0111_D35R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heheh! The experiment worked like\na charm, bruh.\rMAGIKARP worth nothin’, but\nGYARADOS? That’s a BAG.\fCash only. No taxes. We the Feds!</language>
	</row>
	<row id="msg_0111_D35R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urrgh...\rThat cape guy’s Dragon-type homies\nis TOUGH...</language>
	</row>
	<row id="msg_0111_D35R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: DRAGONITE, Full Auto.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What took you so long, {STRVAR_1 3, 0, 0}?\rJust like I thought, that weird radio\nsignal comin’ from here.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What took you so long, {STRVAR_1 3, 0, 0}?\rJust like I thought, that weird radio\nsignal comin’ from here.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The stairs right here.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: {STRVAR_1 3, 0, 0}, let’s split up\nand check this place. I’ll go first.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: {STRVAR_1 3, 0, 0}, let’s split up\nand check this place. I’ll go first.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">*whistle*...*whistle*...\rThat noise botherin’ you? That’s\nme. My false teeth don’t fit right,\fand the gap make that noise.\rEnough about that.\nWhy don’t you buy somethin’?\r</language>
	</row>
	<row id="msg_0111_D35R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The radio on.\rThe variety show playin’\nThe Pokémon Search Party!</language>
	</row>
	<row id="msg_0111_D35R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The radio on.\rThe variety show playin’\nThe Radio Miniseries!</language>
	</row>
	<row id="msg_0111_D35R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The radio on.\rThe variety show playin’\nBuena’s Password!</language>
	</row>
	<row id="msg_0111_D35R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Feds announcin’ their comeback\non the radio! Press conference style!</language>
	</row>
	<row id="msg_0111_D35R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You hear somethin’ weird...!</language>
	</row>
</body>
