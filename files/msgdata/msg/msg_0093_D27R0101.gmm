<?xml version="1.0"?>
<body language="English">
	<row id="msg_0093_D27R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People train in this Lighthouse.\rIt’s mad hard to climb with all the\nHustlers. And the STAIRS. Who built\fthis?\fNo elevator for the poor.</language>
	</row>
	<row id="msg_0093_D27R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Back in the day, homies lit up the sea\nround Olivine every night.\rNow we got a Lighthouse. Progress.\nThe homies got laid off.</language>
	</row>
</body>
