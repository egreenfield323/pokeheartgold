<?xml version="1.0"?>
<body language="English">
	<row id="msg_0485_T06GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: AYO, YOU LIL TYKE!\rIt ain’t real smart to run up on me,\nbut it take GUTS!\rWhen it come to Electric homies, I’m\nNUMBER ONE!\rI ain’t NEVER lost on the battlefield!\nNot to nobody! Except twice!\rI’ma zap you like I zap all my enemies!\nHOO-RAH!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: ARRRGH! You STRONG,\nprivate!\rAight, youngblood. You get the Thunder\nChain!\fAt ease!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} got\nthe Thunder Chain from Lt. Surge!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: That Thunder Chain is for\nthe ones who beat me!\fTake care of it, soldier!\rOne more thing.\nHere’s a hard TM for you!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: That TM is\nStatic Shock... ZZZAP!\rUse it to move like lightnin’!\rGo north, and you’ll see\na big city called Saffron!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lt. Surge: Ayo, youngblood! Still\ngrindin’?\rGo north, you’ll see Saffron! DROP AND\nGIMME TWENTY! ...Just kiddin’.\fUnless?</language>
	</row>
	<row id="msg_0485_T06GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Future legend! You got lucky this\ntime.\rThe traps in this Block been broke a\nwhile. But they BACK now!\fWhy is that lucky? ’Cause pain build\fcharacter!\rLock in and go get Lt. Surge!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whew! That scrap was ELECTRIC! My\nnerves still tinglin’. My hair standin’\fup.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nope! Nothin’ here but trash.\nAnd a sandwich. Old sandwich.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\nOh, you found a secret switch at the\fbottom of the trash can!\fBetter press it.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nope! Nothin’ here but trash.\nOh NO, the electric fence locked again!\fWho DESIGNED this?!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The first electric fence is unlocked!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The second electric fence is unlocked!\rNow the electric fences gone, and\nthe path to the Boss is clear!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vermilion City Block\nTrash Cans Are Load-Bearing</language>
	</row>
	<row id="msg_0485_T06GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vermilion City Block\rBlock Boss: Lt. Surge\nGot Ran Through By:\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
