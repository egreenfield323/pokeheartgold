<?xml version="1.0"?>
<body language="English">
	<row id="msg_0072_D24R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hm? That’s a Pokédex, ain’t it?\nLemme see it?\rDang, that’s a lotta homies.\nHm? What’s this?\rWhat kinda homie is THAT?\nIt look like the weird writin’ on the\fwalls of the ruins.\rIf them drawings deadass homies,\nthere gotta be way more.\rI got it! Lemme upgrade your Pokédex.\nFollow me.\r</language>
	</row>
	<row id="msg_0072_D24R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ow! My shin!\r</language>
	</row>
	<row id="msg_0072_D24R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You good?\nI was in a rush and...\fMy bad, did I hurt you?\r</language>
	</row>
	<row id="msg_0072_D24R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No way!\nCould it be a homie from Sinnoh...\fThe one they call ARCEUS...?\r</language>
	</row>
	<row id="msg_0072_D24R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wait, could it be...?\nARCEUS behind all this...?\rI can’t explain it no other way...\r</language>
	</row>
	<row id="msg_0072_D24R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ARCEUS might be the key to crackin’\nthe mystery of the UNOWN and the\fRuins of Alph...?\r</language>
	</row>
	<row id="msg_0072_D24R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come to the Ruins of Alph with me?\nPlease! You gotta!\rI’m shakin’, I’m so hype.\nSomethin’ bout to happen, I feel it!\r</language>
	</row>
	<row id="msg_0072_D24R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruins of Alph.\rNerds Who Like Old Rocks\nWelcome.</language>
	</row>
	<row id="msg_0072_D24R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruins of Alph.\rExplore the Ruins and Become a\nFossil Professor! Not Accredited.</language>
	</row>
	<row id="msg_0072_D24R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruins Research Center\nNerd HQ</language>
	</row>
	<row id="msg_0072_D24R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This a mysterious hall.\nWatch your step, fam.</language>
	</row>
</body>
