<?xml version="1.0"?>
<body language="English">
	<row id="msg_0102_D32PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The karate gi is the uniform\nof fighters!\rAin’t NOTHIN’ better to wear to the\nBattle Frontier than this!</language>
	</row>
	<row id="msg_0102_D32PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Some people shocked to see a lil\ngirl like me at the Battle Frontier\fall by herself.\rIt ain’t like I gotta scrap myself,\nyou know?\n</language>
	</row>
	<row id="msg_0102_D32PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My lifelong hobby is\nscrappin’ with homies.\rA scrap after breakfast,\na scrap after lunch,\fand after dinner...\fI just take a bath and go to bed.</language>
	</row>
</body>
