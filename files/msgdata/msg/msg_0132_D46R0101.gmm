<?xml version="1.0"?>
<body language="English">
	<row id="msg_0132_D46R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: I came to Kanto lookin’ for\nBug homies! Kanto bugs hit\fDIFFERENT!\rAyo, why don’t we swap numbers? I’ll\ntell you about bugs. All day. {YESNO 0}</language>
	</row>
	<row id="msg_0132_D46R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Bugsy’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0132_D46R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: We can scrap around lunch\non Thursdays!\fHit me up!</language>
	</row>
	<row id="msg_0132_D46R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: Oh, well... That’s OK...\nI’ll just tell the bugs instead.</language>
	</row>
	<row id="msg_0132_D46R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bugsy: You gon’ gimme your phone\nnumber? {YESNO 0}</language>
	</row>
</body>
