<?xml version="1.0"?>
<body language="English">
	<row id="msg_0690_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beverly</language>
	</row>
	<row id="msg_0690_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your homie SO cute and adorable!\nYou love homies just like me!\rWanna swap numbers?\nLet’s chat! It’s gon’ be fun!{YESNO 0}</language>
	</row>
	<row id="msg_0690_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Honestly, I want a MARILL.\nBut I make do with my cute SNUBBULL.\rAw! I’m just playin’!\nI’m just playin’, SNUBBULL! You the\fcutest homie EVER, fr!</language>
	</row>
	<row id="msg_0690_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... That’s disappointin’...</language>
	</row>
	<row id="msg_0690_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got such cute and adorable\nhomies with you!\rWe should DEFINITELY swap\nnumbers, don’t you think?{YESNO 0}</language>
	</row>
	<row id="msg_0690_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, my bad for the wait,\n{STRVAR_1 3, 0, 0}. Here, take this.\r</language>
	</row>
	<row id="msg_0690_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Let’s see... You in the National\nPark, ain’t you?\rWell, you should come talk to me in\nperson, don’t you think?</language>
	</row>
	<row id="msg_0690_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I glowed up my {STRVAR_1 0, 10, 0} and made\nit even cuter than before!\rI ran into a wild\nSNUBBULL recently.\rMy SNUBBULL, I promise you, was WAY\ncuter than the wild one.\rExpect a call from me.</language>
	</row>
	<row id="msg_0690_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I glowed up my {STRVAR_1 0, 10, 0} and\nmade it even cuter than before!\rI saw a wild MARILL the\nother day. Or so I thought.\rA closer look showed it was\n{STRVAR_1 0, 11, 0}. I was SO heated.\rExpect a call from me.</language>
	</row>
	<row id="msg_0690_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My husband got some Gold Grills.\rIf you want, you can have one as\ngood looks for helpin’ me out.\rI’ll be at {STRVAR_1 4, 3, 0}.\nCome see me when you can.</language>
	</row>
	<row id="msg_0690_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">’Scuse me?\nOh, the Gold Grill?\rIt’s aight! Ain’t no need\nto rush. Come see me in\f{STRVAR_1 4, 3, 0} when you can.</language>
	</row>
	<row id="msg_0690_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your homies in prime form?\nLet’s chat about homies again.</language>
	</row>
</body>
