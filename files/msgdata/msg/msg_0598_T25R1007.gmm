<?xml version="1.0"?>
<body language="English">
	<row id="msg_0598_T25R1007_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for shoppin’ with us.\nI’m the elevator guy. 22 years.\fWhat floor? {YESNO 0}</language>
	</row>
	<row id="msg_0598_T25R1007_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Can’t wait to push buttons for you\nagain.</language>
	</row>
	<row id="msg_0598_T25R1007_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bet.\nGoin’ up.\r</language>
	</row>
	<row id="msg_0598_T25R1007_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bet.\nGoin’ down.\r</language>
	</row>
	<row id="msg_0598_T25R1007_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We ALREADY on that floor!\nI been doin’ this 22 years, baby.</language>
	</row>
	<row id="msg_0598_T25R1007_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First floor got the Service Counter\nand the main entrance.</language>
	</row>
	<row id="msg_0598_T25R1007_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Second floor got the Hustler’s Market,\nwith all kinda useful stuff.</language>
	</row>
	<row id="msg_0598_T25R1007_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Third floor got the Battle Collection\nfor buildin’ strong, tough homies.</language>
	</row>
	<row id="msg_0598_T25R1007_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fourth floor got the Medicine Box\nto unlock your homie’s potential.</language>
	</row>
	<row id="msg_0598_T25R1007_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fifth floor got the TM Corner\nto give your homie a new edge.</language>
	</row>
	<row id="msg_0598_T25R1007_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sixth floor got the Rooftop Atrium.\nDon’t miss the Daily Drawing Corner!</language>
	</row>
	<row id="msg_0598_T25R1007_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The basement the warehouse.\nCustomers ain’t allowed. A kid got\fbanned for life.</language>
	</row>
</body>
