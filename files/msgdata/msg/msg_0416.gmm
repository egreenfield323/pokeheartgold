<?xml version="1.0"?>
<body language="English">
	<row id="msg_0416_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Homie Music</language>
	</row>
	<row id="msg_0416_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben</language>
	</row>
	<row id="msg_0416_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben: This your DJ Ben, bringin’ you the\nHomie Music Channel! Smooth vibes only!</language>
	</row>
	<row id="msg_0416_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today a happy Sunday! This a FIRE album\nof classics that take me back to my\nbest homie! ...He moved to Sinnoh.\nWe don’t talk. This song’s for him!</language>
	</row>
	<row id="msg_0416_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Monday, and you know what that\nmean, right? It mean it’s time to\nwake your homies up with a march!</language>
	</row>
	<row id="msg_0416_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Tuesday! Time to put your\nhomies to sleep with a smooth homie\nlullaby! Works on babies too.</language>
	</row>
	<row id="msg_0416_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Wednesday, and you know what\nthat mean, right? It mean it’s time to\nwake your homies up with a march!</language>
	</row>
	<row id="msg_0416_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Thursday! Time to put your\nhomies to sleep with a smooth homie\nlullaby! Not while drivin’.</language>
	</row>
	<row id="msg_0416_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Friday, and you know what that\nmean, right? It mean it’s time to\nwake your homies up with a march!</language>
	</row>
	<row id="msg_0416_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Saturday! Time to put your\nhomies to sleep with a smooth homie\nlullaby! Party’s over, y’all.</language>
	</row>
	<row id="msg_0416_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wednesday’s Homie Music is the Hoenn\nSound with a hint of that Hoenn\nflavor! The Hoenn music might just pull\na bunch of homies to follow you!</language>
	</row>
	<row id="msg_0416_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Thursday’s Homie Music is the Sinnoh\nSound with a hint of that Sinnoh\natmosphere! The Sinnoh music, the\nsound of the great land up north,\nmight just pull a bunch of homies to\nfollow you!</language>
	</row>
	<row id="msg_0416_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Today Sunday, and you know what that\nmean, right? It mean it’s time to\nwake your homies up with a march!</language>
	</row>
</body>
