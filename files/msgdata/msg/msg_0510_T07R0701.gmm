<?xml version="1.0"?>
<body language="English">
	<row id="msg_0510_T07R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO!\rWe havin’ a EATATHON contest!\nWe can’t serve you right now.\fThe contestants ate the menu.</language>
	</row>
	<row id="msg_0510_T07R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huff... Huff... *munch*... *munch*...\rWhen it come to eatin’ contests, I’m\nCONFIDENT.\rBut I can’t handle hot food.\fAnd they serve hot wings...\fHot, hot, HOT! MY TONGUE!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">*chomp*, *chew*, *munch*...\n(Don’t talk to me right now!)\r*chomp*, *chew*, *cough*...\n(Food finna come back up...)\r</language>
	</row>
	<row id="msg_0510_T07R0701_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">*munch munch munch*...\n...What? This the EATATHON?\rOUCH!\rI thought it was the SPEED-eatin’\ncontest... I been pacin’ myself wrong!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">*crunch*... *crunch*...\rI can keep eatin’! More, chef! MORE!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">*crunch*... *crunch*...\rI can keep eatin’! More, chef! MORE!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maylene: *munch munch munch*...\nThe EATATHON contest!\rI NEVER dreamed of somethin’ this\nwonderful.\rAfter a strict trainin’ diet, I can eat\nlike a HIPPOWDON.\rAnd the winner eat FREE!\nThis is my Super Bowl!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eatathon Contest!\nNo Time Limit!\fA Scrap That Never Ends!\rThe Biggest Eater Get It\nAll Free!</language>
	</row>
</body>
