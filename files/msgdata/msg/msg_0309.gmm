<?xml version="1.0"?>
<body language="English">
	<row id="msg_0309_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WELCOME to the Pokéathlon!\rToday’s event--\nthe {STRVAR_4 1, 0, 0}!\rWho gon’ shine brightest? Who gon’\ntrip? Let’s meet the competitors!\r</language>
	</row>
	<row id="msg_0309_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team {STRVAR_1 3, 0, 0}: {STRVAR_1 1, 1, 0},\n{STRVAR_1 1, 2, 0}, and {STRVAR_1 1, 3, 0}!\r</language>
	</row>
	<row id="msg_0309_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AIGHT, we READY!\nAim for the top! Let’s\r{ALN_CENTER}{SIZE 200}POKéATHLON!\r</language>
	</row>
	<row id="msg_0309_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GREAT job, athletes!\rWhich team went the hardest?\nWe got the results!\rBut first...\nwho overflowin’ with fightin’ spirit?\r</language>
	</row>
	<row id="msg_0309_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Challenge Bonus for\nthe homies AND the team!\r</language>
	</row>
	<row id="msg_0309_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 52, 1, 0} points for Team {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Movin’ on, the individual prizes...\nParticipation trophies NOT included.\r</language>
	</row>
	<row id="msg_0309_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The No-Miss Bonus!\nFor not messin’ up. Basic stuff.\r</language>
	</row>
	<row id="msg_0309_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team {STRVAR_1 3, 0, 0}’s {STRVAR_1 0, 1, 0}!</language>
	</row>
	<row id="msg_0309_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There wasn’t one this time.\nEverybody messed up. Beautiful.\r</language>
	</row>
	<row id="msg_0309_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s all!\r</language>
	</row>
	<row id="msg_0309_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Movin’ on...\nthe points leader! The GOAT!\r</language>
	</row>
	<row id="msg_0309_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team {STRVAR_1 3, 0, 0}’s {STRVAR_1 0, 1, 0}!</language>
	</row>
	<row id="msg_0309_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s all!\r</language>
	</row>
	<row id="msg_0309_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Next up...\nthe prize for effort! For tryin’!\r</language>
	</row>
	<row id="msg_0309_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The homie that jumped the most...\nLike it owe somebody bread...\r</language>
	</row>
	<row id="msg_0309_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The homie that hit the most...\nViolence! In sports! Love it!\r</language>
	</row>
	<row id="msg_0309_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The homie that failed the most...\nWe still love you. Barely.\r</language>
	</row>
	<row id="msg_0309_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The homie that dashed the most...\nWhere it goin’? Nobody know!\r</language>
	</row>
	<row id="msg_0309_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The homie that missed collectin’\nthe most points... It tried. Kinda.\r</language>
	</row>
	<row id="msg_0309_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team {STRVAR_1 3, 0, 0}’s {STRVAR_1 0, 1, 0}!</language>
	</row>
	<row id="msg_0309_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s all!\r</language>
	</row>
	<row id="msg_0309_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Finally...\nwe add up the event points! Math!\r</language>
	</row>
	<row id="msg_0309_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Event {STRVAR_1 50, 0, 0}!</language>
	</row>
	<row id="msg_0309_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHAT? A TIE!?\nWe settle ties by a drawin’!\rNo, no, hmm...\n...\r...\nRock, paper, scissors. Got it!\r</language>
	</row>
	<row id="msg_0309_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The overall winner, with {STRVAR_1 52, 0, 0} points...\nDrumroll... I ain’t got drums...\r</language>
	</row>
	<row id="msg_0309_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}{SIZE 200}Team {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team {STRVAR_1 3, 0, 0} was awarded\nthe {STRVAR_4 3, 1, 0}!\r</language>
	</row>
	<row id="msg_0309_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team {STRVAR_1 3, 0, 0} was awarded\n{STRVAR_4 3, 1, 0} and {STRVAR_4 3, 2, 0}!\r</language>
	</row>
	<row id="msg_0309_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team {STRVAR_1 3, 0, 0} beat its personal\nbest at the {STRVAR_4 1, 1, 0}!\r</language>
	</row>
	<row id="msg_0309_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You did well on the\n{STRVAR_4 1, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CONGRATULATIONS!\nThat was a WONDERFUL Performance!\rKeep aimin’ to be the top Pokéathlete!\rThat is...\nPokéathlon\r{ALN_CENTER}{SIZE 200}FOREVER!\r</language>
	</row>
	<row id="msg_0309_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Joined {STRVAR_1 55, 1, 0} times!\nThe new kid on the block!\r</language>
	</row>
	<row id="msg_0309_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Joined {STRVAR_1 55, 1, 0} times!\nA Pokéathlete shootin’ star!\r</language>
	</row>
	<row id="msg_0309_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Joined {STRVAR_1 55, 1, 0} times!\nA Pokéathlete supernova!\r</language>
	</row>
	<row id="msg_0309_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Joined {STRVAR_1 55, 1, 0} times!\nTouch grass. Respectfully.\r</language>
	</row>
	<row id="msg_0309_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aim for the championship!\nOn a Pokéathlon shootin’ star!\r</language>
	</row>
	<row id="msg_0309_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Overall victory, {STRVAR_1 55, 1, 0} times!\nThe Pokéathlon is YOURS!\r</language>
	</row>
	<row id="msg_0309_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Overall victory, {STRVAR_1 55, 1, 0} times!\nTomorrow? Run it back!\r</language>
	</row>
	<row id="msg_0309_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Overall victory, {STRVAR_1 55, 1, 0} times!\nThe Pokéathlon belong to ME!\r</language>
	</row>
	<row id="msg_0309_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Try your best and don’t mess up...\nyou’ll do better! That’s science!\r</language>
	</row>
	<row id="msg_0309_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Last Place, {STRVAR_1 55, 1, 0} times!\nThat’s aight. I’ll keep tryin’!\r</language>
	</row>
	<row id="msg_0309_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Last Place, {STRVAR_1 55, 1, 0} times!\nIt don’t matter! (It matters.)\r</language>
	</row>
	<row id="msg_0309_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Last Place, {STRVAR_1 55, 1, 0} times!\nNobody ever seen my back! Ever!\r</language>
	</row>
	<row id="msg_0309_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aim for number one!\nIt start TODAY!\r</language>
	</row>
	<row id="msg_0309_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First Place, {STRVAR_1 55, 1, 0} times!\nAight! You comin’ with me?\r</language>
	</row>
	<row id="msg_0309_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First Place, {STRVAR_1 55, 1, 0} times!\nY’all still countin’? I ain’t.\r</language>
	</row>
	<row id="msg_0309_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">First Place, {STRVAR_1 55, 1, 0} times!\nAnother one?! Leave some for us!\r</language>
	</row>
	<row id="msg_0309_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t trip about failure!\nFallin’ down ain’t the end!\r</language>
	</row>
	<row id="msg_0309_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Last Place, {STRVAR_1 55, 1, 0} times!\nFall down seven. Get up eight!\r</language>
	</row>
	<row id="msg_0309_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Last Place, {STRVAR_1 55, 1, 0} times!\nThat’s my signature move!\r</language>
	</row>
	<row id="msg_0309_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Last Place, {STRVAR_1 55, 1, 0} times!\nI’m FAMOUS for this record!\r</language>
	</row>
	<row id="msg_0309_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Winnin’ with true strength?\nOr just lucky?! We’ll never know!\r</language>
	</row>
	<row id="msg_0309_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Closin’-ceremony bonus awards. Lucky\n{STRVAR_1 55, 1, 0} times?! Buy a lottery ticket!\r</language>
	</row>
	<row id="msg_0309_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Closin’-ceremony bonus awards.\n{STRVAR_1 55, 1, 0} times. That’s TRUE strength!\r</language>
	</row>
	<row id="msg_0309_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Closin’-ceremony bonus awards.\n{STRVAR_1 55, 1, 0} times. Luck AND strength!\r</language>
	</row>
	<row id="msg_0309_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Always yellin’ at your homie!\nHowl for a heap of championships!\r</language>
	</row>
	<row id="msg_0309_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Will that teamwork be enough to\nchange history? Or just Tuesday?\r</language>
	</row>
	<row id="msg_0309_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Look at this TEAMWORK! It’s\nAMAZIN’! You can feel the friendship!\r</language>
	</row>
	<row id="msg_0309_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s right. We can read\neach other’s minds! Mostly!\r</language>
	</row>
	<row id="msg_0309_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It don’t end when you fall! As long\nas there’s a championship!\r</language>
	</row>
	<row id="msg_0309_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Failed {STRVAR_1 55, 1, 0} times! Only thing goin’\nup is how many times you fainted!\r</language>
	</row>
	<row id="msg_0309_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Failed {STRVAR_1 55, 1, 0} times!\nFailure is just a shortcut to success!\r</language>
	</row>
	<row id="msg_0309_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Failed {STRVAR_1 55, 1, 0} times!\nThe GOAT of messin’ up!\r</language>
	</row>
	<row id="msg_0309_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Always aim sky high!\nAim for anythin’ in the sky!\r</language>
	</row>
	<row id="msg_0309_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fly high!\nYou can fly anywhere! Legally!\r</language>
	</row>
	<row id="msg_0309_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a tomorrow only you can see.\nLeap for it! Don’t trip!\r</language>
	</row>
	<row id="msg_0309_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The other side of the sky is a shiny\ntomorrow! You was born to catch it!\r</language>
	</row>
	<row id="msg_0309_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Them points and these points--\nlet’s go GET ’em!\r</language>
	</row>
	<row id="msg_0309_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">One point ain’t useless! It’s the\nshortcut to success! Or a point!\r</language>
	</row>
	<row id="msg_0309_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t sleep on one point! Always be\nlookin’ one step ahead!\r</language>
	</row>
	<row id="msg_0309_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AIGHT! The Pokéathlon Point King!\nAll points is MINE!\r</language>
	</row>
	<row id="msg_0309_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Take that! And THAT! I’ll tackle\nanythin’ that come my way!\r</language>
	</row>
	<row id="msg_0309_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AIGHT AIGHT! The tackle fiend!\nTackles: {STRVAR_1 55, 1, 0}! Somebody call a medic!\r</language>
	</row>
	<row id="msg_0309_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strike for victory!\n{STRVAR_1 55, 1, 0} times, that is!\r</language>
	</row>
	<row id="msg_0309_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NOTHIN’ can stand in my way!\nTackled {STRVAR_1 55, 1, 0} times!\r</language>
	</row>
	<row id="msg_0309_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why you fall down so far?! Is there\na hole over there or somethin’?\r</language>
	</row>
	<row id="msg_0309_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To fall from such heights!\nThat thrillin’ feelin’ got me!\r</language>
	</row>
	<row id="msg_0309_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Pokéathlete that fights even on the\nedge of the ring! Locked in!\r</language>
	</row>
	<row id="msg_0309_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s always a last stand!\nThat’s why I’m always locked in!\r</language>
	</row>
	<row id="msg_0309_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Such runnin’ ability! Dash around the\nPokéathlon! Cardio KING!\r</language>
	</row>
	<row id="msg_0309_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Run! Seize victory!\nGo for it! Seize tomorrow!\r</language>
	</row>
	<row id="msg_0309_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Think you can keep up?\nFast... faster... gone!\r</language>
	</row>
	<row id="msg_0309_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Runnin’ fast as lightnin’!\nCan your eyes keep up?!\r</language>
	</row>
	<row id="msg_0309_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strength ain’t everythin’! Strategy\nis a big part of success!\r</language>
	</row>
	<row id="msg_0309_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everything come down to BRAINS!\nBig brain moves only!\r</language>
	</row>
	<row id="msg_0309_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Always be prepared! That strategy\ncan get flipped!\r</language>
	</row>
	<row id="msg_0309_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If you know EVERYTHING about your\nhomie, you get the best Performance!\r</language>
	</row>
	<row id="msg_0309_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You ain’t alone!\nEverybody here is against you!\r</language>
	</row>
	<row id="msg_0309_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You always competin’ against\neverybody! That’s TRUE strength!\r</language>
	</row>
	<row id="msg_0309_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You get stronger fightin’ others,\nso use their strength! Steal it!\r</language>
	</row>
	<row id="msg_0309_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Within you is many homies,\nand many MORE homies!\r</language>
	</row>
	<row id="msg_0309_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When you face a TRUE warrior,\nvictory is within your grasp!\r</language>
	</row>
	<row id="msg_0309_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Out there is MAD strong homies!\nThey came to compete!\r</language>
	</row>
	<row id="msg_0309_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You can’t lose to them! You won too\nmany times! Don’t get humbled!\r</language>
	</row>
	<row id="msg_0309_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aim to be a stronger Pokéathlete!\nThen you’ll win more! Simple!\r</language>
	</row>
	<row id="msg_0309_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Ls prove your strength!\nThey show you faced real ones!\r</language>
	</row>
	<row id="msg_0309_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s MAD strong people out there.\nYou know that better than anybody!\r</language>
	</row>
	<row id="msg_0309_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Always compete with somebody!\nShare the competition! And snacks!\r</language>
	</row>
	<row id="msg_0309_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I don’t care about winnin’ or losin’,\njust facin’ the best! (I care.)\r</language>
	</row>
	<row id="msg_0309_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leave Hurdles to me! I’m a Pokéathlete\nthat LOVE Hurdles more than anythin’!\r</language>
	</row>
	<row id="msg_0309_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No Hurdle I can’t jump! Watch\nmy beautiful footwork!\r</language>
	</row>
	<row id="msg_0309_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can climb any obstacle, I can\njump any Hurdle! I can’t do taxes.\r</language>
	</row>
	<row id="msg_0309_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hurdles ain’t obstacles! You can\njust run around ’em! Big brain!\r</language>
	</row>
	<row id="msg_0309_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Born to snatch Pennants! I’m\nthe ruler of this beach!\r</language>
	</row>
	<row id="msg_0309_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">See Pennants? Think of ME!\nThe Pennant-snatchin’ hero!\r</language>
	</row>
	<row id="msg_0309_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The sandy beach is MY field!\nI run around it freely!\r</language>
	</row>
	<row id="msg_0309_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No Pennant I can’t capture!\nI’ll capture the championship too!\r</language>
	</row>
	<row id="msg_0309_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Push! Push! PUSH!\nPush it to the side!\r</language>
	</row>
	<row id="msg_0309_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nothin’ I can’t push! I’ll push you\noutta the Circle and you’ll be alone!\r</language>
	</row>
	<row id="msg_0309_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A whole new dimension of pushin’!\nI was BORN to push!\r</language>
	</row>
	<row id="msg_0309_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You feelin’ intimidated? Good.\nI can push without touchin’!\r</language>
	</row>
	<row id="msg_0309_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Smash! Crash! Shatter!\nI was born to smash Blocks!\r</language>
	</row>
	<row id="msg_0309_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nothin’ I can’t smash! I’m the\nPokéathlon Destruction King!\r</language>
	</row>
	<row id="msg_0309_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a huge wall over there!\nIt’s just there for me to smash!\r</language>
	</row>
	<row id="msg_0309_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Keep breakin’ Blocks... and you’ll\nnotice the mountain over there.\r</language>
	</row>
	<row id="msg_0309_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My body just automatically catches\nany Disc that come my way!\r</language>
	</row>
	<row id="msg_0309_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I came to catch Discs AND catch the\nPokéathlon!\r</language>
	</row>
	<row id="msg_0309_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Disc you caught is tomorrow’s\nshootin’ star!\r</language>
	</row>
	<row id="msg_0309_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bring it on. I’ll catch it! I’ll catch\nany Disc that come my way!\r</language>
	</row>
	<row id="msg_0309_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The jump was like the WIND!\nThe form was like a CLOUD!\r</language>
	</row>
	<row id="msg_0309_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jump high to the sky!\nThe form is weightless!\r</language>
	</row>
	<row id="msg_0309_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Pokéathlete that can read the\nwind and control the air!\r</language>
	</row>
	<row id="msg_0309_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No border between the ground\nand the sky inside me!\r</language>
	</row>
	<row id="msg_0309_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Can’t NOBODY stop me!\nI was born to run! Mostly late!\r</language>
	</row>
	<row id="msg_0309_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Never seen stamina like this!\nJust runnin’ all day long!\r</language>
	</row>
	<row id="msg_0309_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Once I get movin’, I can’t stop!\nNo brakes! Perpetual Pokéathlon!\r</language>
	</row>
	<row id="msg_0309_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My engine is friendship, and my\nmotor is VICTORY!\r</language>
	</row>
	<row id="msg_0309_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No chance! I’ll knock down ALL\nthe competition!\r</language>
	</row>
	<row id="msg_0309_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gettin’ in the Ring is the end! Fight\nto be the last homie standin’!\r</language>
	</row>
	<row id="msg_0309_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruler of the Ring!\nEnter my Ring at your own risk!\r</language>
	</row>
	<row id="msg_0309_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What exactly ARE you anyway?\nThe Ring gon’ tell you!\r</language>
	</row>
	<row id="msg_0309_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Best Snow thrower in the WORLD!\nWith that aim, you can win!\r</language>
	</row>
	<row id="msg_0309_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Snowballs we throwin’ is\nrolled-up balls of friendship!\r</language>
	</row>
	<row id="msg_0309_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Such rapid-fire throwin’! Who that\nSnowball for?! YOU!\r</language>
	</row>
	<row id="msg_0309_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t know where it’s comin’ from\nnext! The Snowballs is splittin’!\r</language>
	</row>
	<row id="msg_0309_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nobody can stop this ball! It hit\nany Goal I aim for!\r</language>
	</row>
	<row id="msg_0309_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Use that teamwork and\nmake the Goal!\r</language>
	</row>
	<row id="msg_0309_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Such SPLENDID footwork!\nAim for success!\r</language>
	</row>
	<row id="msg_0309_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Live with the ball.\nBE the ball!\r</language>
	</row>
	<row id="msg_0309_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Give the points as a gift.\nThat’s fair play. Or bad play.\r</language>
	</row>
	<row id="msg_0309_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Smile even when you miss! The\nPokéathlon ain’t just about winnin’!\r</language>
	</row>
	<row id="msg_0309_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You don’t hesitate to aim for\nyour OWN Goal! Bold!\r</language>
	</row>
	<row id="msg_0309_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t fight over who rolled it in\nyour Goal! It’s friendship!\r</language>
	</row>
	<row id="msg_0309_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why you stand out like that?\nWinnin’ ain’t everythin’! Mostly is.\r</language>
	</row>
	<row id="msg_0309_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here it is! What y’all been waitin’\nfor! Autographs after! $5 each!\r</language>
	</row>
	<row id="msg_0309_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wanna see me win? I’ll show you\nexactly how I win! Watch close!\r</language>
	</row>
	<row id="msg_0309_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I do my best and win, I make\neverybody happy! Except y’all!\r</language>
	</row>
