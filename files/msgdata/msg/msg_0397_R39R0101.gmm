<?xml version="1.0"?>
<body language="English">
	<row id="msg_0397_R39R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you get past the dog?!\nAight. Hands where I can see ’em.\rMy MILTANK ain’t givin’ no milk no more.\nShe on strike.\rThis farm FAMOUS for milk. Chocolate\nmilk. Don’t ask how.\rShe’d gimme more if I fed her\nBerries. She want a raise. In snacks.</language>
	</row>
	<row id="msg_0397_R39R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You try my Chocolate Milk?\rStraight from the cow. Chocolate.\nDon’t ask questions.\rIt heal your homies’ HP!\rJust $500. That’s a family discount. {YESNO 0}</language>
	</row>
	<row id="msg_0397_R39R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Here you go! Drink up!\nIt’s chocolate. From the cow. Science.\r</language>
	</row>
	<row id="msg_0397_R39R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My bad. No bread, no milk!\nThis a business, baby!</language>
	</row>
	<row id="msg_0397_R39R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Bag full, I reckon.</language>
	</row>
	<row id="msg_0397_R39R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You don’t want it? Your loss.\nCome back now, hear?</language>
	</row>
	<row id="msg_0397_R39R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta go do my milkin’.\nIt’s a whole process. Don’t watch.</language>
	</row>
	<row id="msg_0397_R39R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bro picked the lock...\nYou got some nerve, kid.\rOur milk ship all the way to Kanto.\rSo if our own MILTANK won’t give milk,\nwe broke. Like, BROKE broke.</language>
	</row>
	<row id="msg_0397_R39R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You fixed our MILTANK, baby!\nShe givin’ milk again! We RICH!\rHere’s somethin’ for your trouble.</language>
	</row>
	<row id="msg_0397_R39R0101_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0397_R39R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That’s Fruit Throw.\rIts type and Power depend on\nthe Berry your homie holdin’.\rUse it once and the Berry gone.\nThink about how you gon’\fuse it, baby.</language>
	</row>
	<row id="msg_0397_R39R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Bag full, I reckon.</language>
	</row>
	<row id="msg_0397_R39R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}1 BOTTLE</language>
	</row>
	<row id="msg_0397_R39R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}1 DOZEN</language>
	</row>
	<row id="msg_0397_R39R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}NAH</language>
	</row>
</body>
