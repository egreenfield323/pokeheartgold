	<row id="msg_0127_D42R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WHOA! You scared me!\rI had my BlackGlasses on, so I ain’t\nsee you. It’s DARK in here. Why I wear\fsunglasses?\fI don’t know. Looks cool.\rWhat am I doin’ here? Don’t worry\nabout it. Here, take some\fBlackGlasses.\fForget you saw me, OK? I wasn’t here.\r</language>
	</row>
