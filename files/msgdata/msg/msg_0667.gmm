	<row id="msg_0667_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This gotta be the first time I done\nsomethin’ like this from so close!\rI mean talkin’ on the phone!\fYou standin’ RIGHT there. Wave!</language>
	</row>
	<row id="msg_0667_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh ayo, {STRVAR_1 3, 0, 0}!\nThis Warden Baoba.\rMy bad for the wait!\nWe FINALLY opened the Safari Zone!\fEight months late! On schedule!\rYou know the Gate inside the cave in\nCianwood City?\rGo through there and walk a lil bit,\nand you’ll see the Safari Zone!\rWe kinda out the way, but come\nthrough! Bring cash!</language>
	</row>
	<row id="msg_0667_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh ayo, {STRVAR_1 3, 0, 0}!\nThis Warden Baoba.\rMy bad for the wait!\nWe FINALLY opened the Safari Zone!\fEight months late! On schedule!\rYou know the Gate inside the cave in\nCianwood City?\rGo through there and walk a lil bit,\nand you’ll see the Safari Zone!\rWe kinda out the way, but come\nthrough! Bring cash!</language>
	</row>
