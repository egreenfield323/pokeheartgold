<?xml version="1.0"?>
<body language="English">
	<row id="msg_0495_T07R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I just became a Hustler.\fMy son PUSHED me to do it.\rI’m 67. I’m learnin’.\nThe Nap Sack is the red one, right?</language>
	</row>
	<row id="msg_0495_T07R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My dad havin’ a HARD time learnin’ the\nnames of stuff...\rHe called a Hennessy “the brown juice.”\nHe ain’t wrong.</language>
	</row>
	<row id="msg_0495_T07R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Top Tier Stuff for Hustlers!\n2F: Hustler’s Market</language>
	</row>
	<row id="msg_0495_T07R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Hmm... Hmm... Humm...\r</language>
	</row>
	<row id="msg_0495_T07R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Ha! This one crazy mask...\r</language>
	</row>
	<row id="msg_0495_T07R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Huh? You talkin’ to ME?\rYour eyes...on my CRASHER WAKE MASK?\rNo, no, NO! I can NEVER let it go!\nIt’s my FACE!\r...\nHuh? That ain’t it?\fYou want the OTHER mask?\rHmm. Aight.\r</language>
	</row>
	<row id="msg_0495_T07R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: What? That ain’t ENOUGH?\rYou a real negotiator for your age...\nAight, take this too!\r</language>
	</row>
	<row id="msg_0495_T07R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: ...\rARRR, aight, AIGHT! I’ll give you this\nprecious one too! You drive a HARD\fbargain!\r</language>
	</row>
	<row id="msg_0495_T07R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: It’s OK. I already paid for you.\rGifts from the one who wear masks the\nBEST. Like a wrestler. ’cause I’m one.\fDon’t be shy. HA HA HA!\r</language>
	</row>
	<row id="msg_0495_T07R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Hmm... Hmm... Humm...\rHa! This one crazy mask...</language>
	</row>
</body>
