<?xml version="1.0"?>
<body language="English">
	<row id="msg_0099_D31R0207_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pick a partner from the Hustlers\nposted up in here.\r</language>
	</row>
	<row id="msg_0099_D31R0207_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, you still ain’t got\na partner for your tag team.\rYou wanna quit lookin’ and go\nback to the front desk? {YESNO 0}</language>
	</row>
	<row id="msg_0099_D31R0207_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for pickin’ a partner.\rAight, I’ll walk you to your\nMulti Battle Room.\r</language>
	</row>
	<row id="msg_0099_D31R0207_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Riley: My partners right now?\rWell, my {STRVAR_1 0, 0, 0} NASTY with\n{STRVAR_1 6, 1, 0}.\rAnd my {STRVAR_1 0, 2, 0} got\n{STRVAR_1 6, 3, 0} on lock.\rYou wanna team up with me? {YESNO 0}</language>
	</row>
	<row id="msg_0099_D31R0207_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Riley: ...Oh, word?\nThat’s too bad.</language>
	</row>
	<row id="msg_0099_D31R0207_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Riley: Ahaha, good looks.\nI’ll be waitin’ on you.\r</language>
	</row>
	<row id="msg_0099_D31R0207_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cheryl: I got a {STRVAR_1 0, 0, 0} that\nis real good with {STRVAR_1 6, 1, 0}\rand a {STRVAR_1 0, 2, 0} that love to\nshow off its {STRVAR_1 6, 3, 0}.\rYou gon’ team up with me? {YESNO 0}</language>
	</row>
	<row id="msg_0099_D31R0207_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cheryl: Oh...\nToo bad...</language>
	</row>
	<row id="msg_0099_D31R0207_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cheryl: I’ll go ahead, then.\r</language>
	</row>
	<row id="msg_0099_D31R0207_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buck: Ayo, you tryna team up?\nLemme tell you what I’m workin’ with.\rMy {STRVAR_1 0, 0, 0} top-tier\nwith {STRVAR_1 6, 1, 0}.\rAnd my {STRVAR_1 0, 2, 0} the GOAT when\nit come to {STRVAR_1 6, 3, 0}.\rYou wanna roll with me, right? {YESNO 0}</language>
	</row>
	<row id="msg_0099_D31R0207_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buck: Huh? What?\nThat’s COLD, bro!</language>
	</row>
	<row id="msg_0099_D31R0207_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buck: Hehehe! Smart choice!\nAin’t no problems when I’m around!\r</language>
	</row>
	<row id="msg_0099_D31R0207_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marley: ...My {STRVAR_1 0, 0, 0} use\n{STRVAR_1 6, 1, 0} good...\rAnd my {STRVAR_1 0, 2, 0} like to use\n{STRVAR_1 6, 3, 0}.\r...What you want?\nI’m supposed to roll with you? {YESNO 0}</language>
	</row>
	<row id="msg_0099_D31R0207_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marley: ...Whatever...</language>
	</row>
	<row id="msg_0099_D31R0207_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marley: ...I’ll go ahead...\r</language>
	</row>
	<row id="msg_0099_D31R0207_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mira: Ayo, hi!\nI’m with my {STRVAR_1 0, 0, 0}!\fIt’s SO good with {STRVAR_1 6, 1, 0}!\rThe other one my {STRVAR_1 0, 2, 0}.\nIts {STRVAR_1 6, 3, 0} is fire!\rYou wanna roll with me? {YESNO 0}</language>
	</row>
	<row id="msg_0099_D31R0207_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mira: Oh, OK.\nNext time then!</language>
	</row>
	<row id="msg_0099_D31R0207_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mira: OK! I’ll wait on you!\n{STRVAR_1 3, 0, 0}, don’t take forever!\r</language>
	</row>
</body>
