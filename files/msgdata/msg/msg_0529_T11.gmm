<?xml version="1.0"?>
<body language="English">
	<row id="msg_0529_T11_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Our city got featured on a radio show.\rNice hearin’ your city praised, but\nit’s kinda corny. They called us\f“vibrant.”</language>
	</row>
	<row id="msg_0529_T11_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I went to the Block ready to scrap...\rTurns out I walked into the EMPTY\nBlock next door. I scrapped a broom.\fMan, I was SO embarrassed.</language>
	</row>
	<row id="msg_0529_T11_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This the Copycat girl’s house.\rShe copy how people talk SO good,\nshe’ll confuse you. She did my voice\fto my\fwife. Now I’m divorced.</language>
	</row>
	<row id="msg_0529_T11_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Copycat girl look SAD.\rShe lost her favorite Poké\nDoll--CLEFAIRY. She cryin’ in\feverybody’s voice.</language>
	</row>
	<row id="msg_0529_T11_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walkin’ down a alley the first time\nmake me nervous. Second time too.\fEvery time.</language>
	</row>
	<row id="msg_0529_T11_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">*chomp*... *chew*...\rThe Power Plant manager used to be a\nrepairman in a lil factory.\r*chew*... *chew*...\rHard work took him all the way up to\nmanager of the Power Plant.\f*chew*... *gulp*...\rImpressive, right? Haaah, I’m full!\nThat was my third burger.</language>
	</row>
	<row id="msg_0529_T11_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Silph Co., famous for homie\nmerchandise.\rBack in the day The Feds tried to take\nthe company. Hostile takeover.\fLiteral.</language>
	</row>
	<row id="msg_0529_T11_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a spot called Hustler House in\nViridian where Hustlers pull up from\feverywhere. It’s like a gym. With\nbeef.</language>
	</row>
	<row id="msg_0529_T11_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You came out from Johto?\rZip back home on the Magnet Train.\nIt float. It’s magic. Don’t ask.</language>
	</row>
	<row id="msg_0529_T11_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kanto-Johto Magnet Train Line\nSaffron City Station</language>
	</row>
	<row id="msg_0529_T11_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saffron City\nThe Big City. Bigger Than Goldenrod.</language>
	</row>
	<row id="msg_0529_T11_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Everybody Welcome!\nFighting Dojo</language>
	</row>
	<row id="msg_0529_T11_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saffron City Block\nBoss: Sabrina\fShe Already Know You Comin’.</language>
	</row>
	<row id="msg_0529_T11_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Silph Co.\nOffice Building</language>
	</row>
	<row id="msg_0529_T11_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t Call Me Uncle Psychic!\nMr. Psychic’s House</language>
	</row>
</body>
