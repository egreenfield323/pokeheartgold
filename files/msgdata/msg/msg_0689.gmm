<?xml version="1.0"?>
<body language="English">
	<row id="msg_0689_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Alan</language>
	</row>
	<row id="msg_0689_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When I’m readin’ and walkin’,\nI gotta look down, so I notice stuff\fon the ground.\rNext time I find somethin’, I’ll give\nit to you.\rCan I get your number? {YESNO 0}</language>
	</row>
	<row id="msg_0689_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll call you as soon as I find\nsomethin’. Bet on it!</language>
	</row>
	<row id="msg_0689_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh... I thought it’d be a nice\nbreak to call you while I study...</language>
	</row>
	<row id="msg_0689_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If I find somethin’, it’s yours.\nSo can I get your number? {YESNO 0}</language>
	</row>
	<row id="msg_0689_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This, this! This yours! Ta-da!\r</language>
	</row>
	<row id="msg_0689_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nWait. Don’t tell me you right nearby?\rYou ain’t notice ’cause you was\ntoo busy lookin’ at the ground too?</language>
	</row>
	<row id="msg_0689_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} gettin’ stronger,\nexactly like I calculated!\rBy the way, we knocked out a wild\n{STRVAR_1 0, 11, 0} just the other day.\rStudyin’ ahead of time worked!\rLater!</language>
	</row>
	<row id="msg_0689_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0} gettin’ stronger,\nexactly like I calculated!\rBy the way, a wild {STRVAR_1 0, 11, 0} dipped\non me yesterday.\rA math error on my part...\rLater!</language>
	</row>
	<row id="msg_0689_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I studied a lot since then, and\nI got WAY better!\rI’m hangin’ on {STRVAR_1 4, 3, 0}.\nCan you come through for a scrap?</language>
	</row>
	<row id="msg_0689_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">If we don’t scrap soon, I’mma\nforget my strategy!\rI’m waitin’ on {STRVAR_1 4, 3, 0}!</language>
	</row>
	<row id="msg_0689_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I ain’t picked up nothin’ yet.\nI’ll call you if I find somethin’.</language>
	</row>
	<row id="msg_0689_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heh heh. I found somethin’ REAL\nfire earlier!\rI’ll give it to you. Can you come to\n{STRVAR_1 4, 3, 0} and grab it?</language>
	</row>
	<row id="msg_0689_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I gotta do my homework, so can you\ncome get your gift right now?\rI’m waitin’ on {STRVAR_1 4, 3, 0}!</language>
	</row>
</body>
