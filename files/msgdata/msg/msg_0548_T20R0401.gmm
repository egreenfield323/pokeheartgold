<?xml version="1.0"?>
<body language="English">
	<row id="msg_0548_T20R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Breaking and entering, huh?\nYou picked the wrong crib.\rAyo, {STRVAR_1 3, 0, 0}!\nLyra upstairs.\rShe up there playin’ 2K with her\nPokémon. As usual.\rYou ain’t got no...Pokémon?\n...Oh. My bad.\rYou ain’t got a homie yet.\rI ain’t mean to hurt your\nfeelings, {STRVAR_1 3, 0, 0}. Mostly.</language>
	</row>
	<row id="msg_0548_T20R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\nEthan upstairs.\rHe up there playin’ 2K with his\nPokémon. As usual.\rYou ain’t got no...Pokémon?\n...Oh. My bad.\rYou ain’t got a homie yet.\rI ain’t mean to hurt your\nfeelings, {STRVAR_1 3, 0, 0}. Mostly.</language>
	</row>
	<row id="msg_0548_T20R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\nLyra ain’t here.\rShe been runnin’ errands for\nthat professor.\fI don’t ask questions no more.</language>
	</row>
	<row id="msg_0548_T20R0401_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\nEthan ain’t here.\rHe been runnin’ errands for\nthat professor.\fI don’t ask questions no more.</language>
	</row>
	<row id="msg_0548_T20R0401_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\nLyra upstairs.\rShe up there playin’ 2K with her\nPokémon. As usual.</language>
