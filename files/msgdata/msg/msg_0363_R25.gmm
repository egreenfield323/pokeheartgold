<?xml version="1.0"?>
<body language="English">
	<row id="msg_0363_R25_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: AWW! Why you had to show up and\nbug us NOW?! We was on a DATE!\rYou know what they call people like\nyou?\rPESTS! You heard me, PEST!\r...\r...Oh? Those Chains you got... Johto?\rIf you got eight, you must be good.\rAight. Come to the Cerulean Block. I’ll\ntake you on. After my date.\rI’m Misty, Block Boss in Cerulean.\nRemember that, pest.\r</language>
	</row>
	<row id="msg_0363_R25_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: I LOVE the sunset here!\nIt gimme courage, you know?\rRight! Why don’t we swap numbers?\nDon’t make it weird. {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Misty’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0363_R25_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Hit me up Wednesday\nmornin’ if you want another\fscrap with me!</language>
	</row>
	<row id="msg_0363_R25_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: That’s a shame!</language>
	</row>
	<row id="msg_0363_R25_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: So you DO want\nmy number? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Ah! You got a hard\nWater-type homie!\fCan I take a pic with it? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Way to go!\rLet’s see a big smile!\r</language>
	</row>
	<row id="msg_0363_R25_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: We look good!\nI deadass like Water-type homies!</language>
	</row>
	<row id="msg_0363_R25_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: What a LETDOWN... Pest.</language>
	</row>
	<row id="msg_0363_R25_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete\nsome pics.</language>
	</row>
	<row id="msg_0363_R25_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You took on one more scrap than you\nexpected, but you STILL won.\rLike we promised, you get a prize!\nThis the Gold Grill Bridge, baby!\r</language>
	</row>
	<row id="msg_0363_R25_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0363_R25_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">But after seein’ how you scrap, I\nwanna see how I do. Lemme take you on.\fI’m the prize guy, but I’m ALSO a\nfighter.\r</language>
	</row>
	<row id="msg_0363_R25_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I never had a scrap this WONDERFUL!\rYou and your homies is DEADASS strong!\nI’m gon’ go sit on the bridge and\fthink.</language>
	</row>
	<row id="msg_0363_R25_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sea Cottage\nBill’s House</language>
	</row>
	<row id="msg_0363_R25_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: Huff, huff... I’m...no match\nfor you.\f...Like I predicted. In my diary.\r.................. ...Go ’head.\rEver since the Burned Tower in\nEcruteak, I kinda knew SUICUNE would\fpick you.\fI’m not cryin’. It’s the wind.\r</language>
	</row>
	<row id="msg_0363_R25_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: Look at it!\nSUICUNE waitin’ on you!\fIt been waitin’ for a scrap\fwith a worthy Hustler it\fcan trust itself to!</language>
	</row>
	<row id="msg_0363_R25_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: {STRVAR_1 3, 0, 0}...\nY’all two are truly amazin’...\rI ain’t never seen a scrap\nthis intense!\fI got no regrets...\rFarewell, SUICUNE!\nFarewell...{STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0363_R25_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: {STRVAR_1 3, 0, 0}... Ain’t nothin’ to be\nashamed of.\rNobody can clown you just ’cause you\nran from SUICUNE.\rSUICUNE just that AMAZIN’. That’s all.\fAnyway, SUICUNE gone again.\fBack to square one... Back to the\nbushes...\r</language>
	</row>
</body>
