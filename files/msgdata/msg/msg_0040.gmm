		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0040_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“When the universe was created,\nits shards became this Plate.”\r</language>
	</row>
	<row id="msg_0040_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“The power of defeated giants\ninfuses this Plate.”\r</language>
	</row>
	<row id="msg_0040_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“Two beings of time and space set\nfree from the Original One.”\r</language>
	</row>
	<row id="msg_0040_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“Three beings were born to bind\ntime and space.”\r</language>
	</row>
	<row id="msg_0040_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“Two make matter, and three make\nspirit, shapin’ the world.”\r</language>
	</row>
	<row id="msg_0040_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“The Original One breathed alone\nbefore the universe came.”\r</language>
	</row>
	<row id="msg_0040_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“The powers of Plates are shared\namong Pokémon.”\r</language>
	</row>
	<row id="msg_0040_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is text engraved in the back\nof the obtained Plate...\r“The rightful bearer of a Plate\ndraws from the Plate it holds.”\r</language>
	</row>
	<row id="msg_0040_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sack Patches can’t be used ’cause\nyou don’t have any Seals.\r</language>
	</row>
