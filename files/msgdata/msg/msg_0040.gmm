		<language name="English">Wassup, welcome to the Trap House.\rWe patch your homies up, no\nquestions asked.\rWant us to fix up your crew? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00085" index="85">
		<attribute name="window_context_name">used</attribute>
