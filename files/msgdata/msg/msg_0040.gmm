		<language name="日本語">XXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0040_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My bad.\rWe workin’ underground right now.\nOff-limits. Hard hats only.\rTry later. Like, much later.</language>
	</row>
	<row id="msg_0040_00069" index="69">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
