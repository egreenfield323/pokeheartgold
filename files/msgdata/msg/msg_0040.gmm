<?xml version="1.0"?>
<body language="English">
	<row id="msg_0040_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, welcome to the Trap House.\rWe patch your homies up, no\nquestions asked.\rWant us to fix up your crew? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight, gimme your homies for a sec.\nDon’t look at what I’m doin’.</language>
	</row>
	<row id="msg_0040_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for waitin’.\rYour homies is back to full health. No\ninsurance needed. No questions asked.\r</language>
	</row>
	<row id="msg_0040_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back anytime, baby!\nWe ALWAYS open. We never close.</language>
	</row>
	<row id="msg_0040_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wassup, welcome to the Trap House.\rWe patch your homies up, no\nquestions asked.\rWant us to...\r</language>
	</row>
	<row id="msg_0040_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Th-that Trainer Card!\rThat GORGEOUS shade! All them stars!\rI seen a few Hustlers with Violet\ncards...\rBut you the first one to TOP ’em. You a\nCELEBRITY in here.\rPlease, {STRVAR_1 3, 0, 0}, can I heal your\nhomies? It would be an HONOR. {YESNO 0}</language>
	</row>
	<row id="msg_0040_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayy, {STRVAR_1 3, 0, 0}! My favorite customer!\nYou want the usual, right? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bet. Gimme your homies real quick.\nI’ll treat ’em like VIPs.</language>
	</row>
	<row id="msg_0040_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks for waitin’. VIP service.</language>
	</row>
	<row id="msg_0040_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stay safe out there, baby.</language>
	</row>
	<row id="msg_0040_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your homies might be infected with\nPokérus.\rNobody know much about it, except it’s\nlil microscopic stuff that stick to\fhomies.\rInfected homies grow EXTRA fast. It’s\nlike steroids. But a virus.</language>
	</row>
	<row id="msg_0040_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} ain’t got no homies left\nstandin’!\r{STRVAR_1 3, 0, 0} got JUMPED and blacked out!</language>
	</row>
	<row id="msg_0040_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0040_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Would you like to save the game? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is already a saved file.\nIs it OK to overwrite it? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saving...\nDon’t turn off the power.</language>
	</row>
	<row id="msg_0040_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved the game.</language>
	</row>
	<row id="msg_0040_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
