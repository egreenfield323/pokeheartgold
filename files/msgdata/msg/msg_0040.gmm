		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0040_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Save error.</language>
	</row>
	<row id="msg_0040_00019" index="19">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0040_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There is already a saved game file.\nIt is impossible to save.\rPlease refer to the Instruction\nBooklet for details.\rPress Up + SELECT + B Button on\nthe title screen if you wanna erase\fthe current saved game file.</language>
	</row>
	<row id="msg_0040_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saving a lotta data...\nDon’t turn off the power.</language>
	</row>
