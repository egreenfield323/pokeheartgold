<?xml version="1.0"?>
<body language="English">
	<row id="msg_0484_T06FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Feds ain’t in Kanto no more.\nThat alone make me happy.\fI can finally do my taxes in peace.</language>
	</row>
	<row id="msg_0484_T06FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m thinkin’ ’bout goin’ shoppin’ in\nSaffron.\rTake the north route. Watch for the\nguards. They thirsty.</language>
	</row>
</body>
