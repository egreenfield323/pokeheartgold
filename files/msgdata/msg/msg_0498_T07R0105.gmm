<?xml version="1.0"?>
<body language="English">
	<row id="msg_0498_T07R0105_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I wanna buy stuff that raise homie\nstats, but I ain’t got enough\fbread...\fStory of my life.</language>
	</row>
	<row id="msg_0498_T07R0105_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know Extended Mags?\rThey raise Max PP. They don’t sell\n’em here. ILLEGAL to sell,\fI guess. Black market only.</language>
	</row>
	<row id="msg_0498_T07R0105_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Usin’ stuff on homies make ’em\nhappy.\rThey HATE some stuff though. Mine\nhate kale. Same.</language>
	</row>
	<row id="msg_0498_T07R0105_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bring Out Your Homies’ Potential\n5F: Battle Collection</language>
	</row>
</body>
