<?xml version="1.0"?>
<body language="English">
	<row id="msg_0447_T01R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AYO!\rRed been GONE. He ain’t called. He\nain’t texted. He ain’t even liked my\fposts.\rThey say no news is good news, but\nI’m his MAMA. I need NEWS.</language>
	</row>
	<row id="msg_0447_T01R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I worry Red gettin’ hurt or sick.\rBut he a boy. He out doin’ what he\nwant. On a MOUNTAIN. In a T-SHIRT.\fI raised a idiot. A strong idiot.</language>
	</row>
	<row id="msg_0447_T01R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">They got shows that ain’t on in\nJohto... Red used to watch ’em. Now\fI watch ’em\ffor him. Alone.</language>
	</row>
</body>
