<?xml version="1.0"?>
<body language="English">
	<row id="msg_0472_T04R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How you get past the dog?!\nAight. Hands where I can see ’em.\rI heard that some shady character is\nskulking about.\rI won’t stand for it if he turns out\nto be a thief.</language>
	</row>
	<row id="msg_0472_T04R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ain’t nobody invite you in!\nTouch my TV and it’s over.\rWe were held up by robbers before.</language>
	</row>
	<row id="msg_0472_T04R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DIGLETT: Dug dug.</language>
	</row>
</body>
