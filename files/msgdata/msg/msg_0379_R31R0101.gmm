	<row id="msg_0379_R31R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: I KNEW that was you, {STRVAR_1 3, 0, 0}!\rHow you get past me?\nHere, take this for\fsneakin’ up on me, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0379_R31R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: I KNEW that was you, {STRVAR_1 3, 0, 0}!\rHow you get past me?\nHere, take this for\fsneakin’ up on me, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0379_R31R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Vs. Recorder record your scraps\nso you can watch ’em back.\rI gotta dip!\fYou ain’t passin’ me again!\r</language>
	</row>
	<row id="msg_0379_R31R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Vs. Recorder record your scraps\nso you can watch ’em back.\rI gotta dip!\fYou ain’t passin’ me again!\r</language>
