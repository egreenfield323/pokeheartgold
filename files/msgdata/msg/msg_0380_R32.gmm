<?xml version="1.0"?>
<body language="English">
	<row id="msg_0380_R32_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wait up!\nWhat’s the rush?\r</language>
	</row>
	<row id="msg_0380_R32_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, right?\nSome guy in glasses was lookin’\ffor you.\rGo see. He waitin’ on you\nat the Corner Store.</language>
	</row>
	<row id="msg_0380_R32_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, right?\nSome guy in glasses was lookin’\ffor you.\rGo see. He waitin’ on you\nat the Corner Store.\r</language>
	</row>
	<row id="msg_0380_R32_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You hit up the block yet?\rYou can test your homies and\nyourself there.\rEvery Hustler gotta go through it!</language>
	</row>
	<row id="msg_0380_R32_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You hit up the block yet?\rYou can test your homies and\nyourself there.\rEvery Hustler gotta go through it!\r</language>
	</row>
	<row id="msg_0380_R32_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You got some hard homies.\rMust be from all that work you\nput in around Violet City.\rThat block musta been real\nhelpful too.\rHere, a lil souvenir from Violet.\rIt power up Grass-type moves.\r</language>
	</row>
	<row id="msg_0380_R32_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0380_R32_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What you learned in Violet City\ngon’ help you out there.</language>
	</row>
	<row id="msg_0380_R32_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, your Bag is packed.</language>
	</row>
	<row id="msg_0380_R32_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, your Bag is packed.\r</language>
	</row>
	<row id="msg_0380_R32_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WROOOOAR!\rPEOPLE RUN WHEN I YELL WOOP!\nBUT YOU CAME LOOKIN’!\rTHAT’S RESPECT!\nNOW TAKE THIS!\r</language>
	</row>
	<row id="msg_0380_R32_00011" index="11">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0380_R32_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WROOOAR!\nIT’S YELL WOOP!\rEVEN HOMIES RUN\nFROM A GOOD WOOP!</language>
	</row>
	<row id="msg_0380_R32_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WROOOAR! YOUR BAG IS FULL!</language>
	</row>
	<row id="msg_0380_R32_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Psst. You want a tasty,\nnutritious SlowpokeTail?\rFor you? Just $1,000,000!\nIt’s legit, I swear! {YESNO 0}</language>
	</row>
	<row id="msg_0380_R32_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch! I thought kids these days\nhad bread...</language>
	</row>
	<row id="msg_0380_R32_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You don’t want it?\nThen beat it. Shoo! I ain’t here.</language>
	</row>
	<row id="msg_0380_R32_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rt. 32\nSouth to Azalea. Watch Your Pockets.</language>
	</row>
	<row id="msg_0380_R32_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruins of Alph\nEast Entrance. Old Rocks. Free.</language>
	</row>
	<row id="msg_0380_R32_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Union Cave ahead\nNo Union Reps Inside</language>
	</row>
</body>
