	<row id="msg_0346_R11_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There’s a BIG homie sleepin’\npeaceful.\fIt look SO comfortable. It’s\nsnorin’.\fIt’s blockin’ the whole road.</language>
