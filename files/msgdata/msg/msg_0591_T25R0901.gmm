<?xml version="1.0"?>
<body language="English">
	<row id="msg_0591_T25R0901_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Who let you in?! You got five\nseconds before I call my cousin.\rWASSUP, WASSUP! I’m the official\nName Rater! I roast names for a\flivin’!\rWant me to rate your homies’\nnicknames? I’m brutal. {YESNO 0}</language>
	</row>
	<row id="msg_0591_T25R0901_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Which homie’s name should I ROAST?</language>
	</row>
	<row id="msg_0591_T25R0901_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}, huh? Hmm... That’s MID.\nReal mid. Who named this?\rI can give it a BETTER name. What\nyou think? {YESNO 0}</language>
	</row>
	<row id="msg_0591_T25R0901_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aight. What’s the new name gon’ be?\nDon’t disappoint me AGAIN.\r</language>
	</row>
	<row id="msg_0591_T25R0901_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Done! How ’bout that?\rFrom now on, this homie go by\n{STRVAR_1 1, 0, 0}!\rWAY better than before!\nYou finally did somethin’ right!</language>
	</row>
	<row id="msg_0591_T25R0901_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah, aight. Keep that mid name then.\nCome back when you got taste.</language>
	</row>
	<row id="msg_0591_T25R0901_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Done! From now on, this homie go by\n{STRVAR_1 1, 0, 0}!\rIt’s the SAME name?\nNah, it hit different now.\fThat’ll be $40.</language>
	</row>
	<row id="msg_0591_T25R0901_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}, huh? That name is FIRE. No\nnotes! I’m jealous!\rTake care of {STRVAR_1 1, 0, 0}!</language>
	</row>
	<row id="msg_0591_T25R0901_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bro. That’s a EGG.\nIt ain’t even born yet. Let it live.</language>
	</row>
</body>
