<?xml version="1.0"?>
<body language="English">
	<row id="msg_0311_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SHEESH, you energetic AND hardworkin’!\nI won’t fall for your cuteness!\r</language>
	</row>
	<row id="msg_0311_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don’t eat the grass on the road of\nlife! That’s my personal slogan!\r</language>
	</row>
	<row id="msg_0311_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">With these three homies I’mma get\nstronger! I’mma get BIGGER!\r</language>
	</row>
	<row id="msg_0311_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Think you can keep up with me?\nThey call me “Victorious Victor”!\r</language>
	</row>
	<row id="msg_0311_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jump! Fight! Be like the wind!\nSomeday I wanna fly! On a plane!\r</language>
	</row>
	<row id="msg_0311_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Behind that cute face is hidden\nPOWER! You’ll see it with your eyes!\r</language>
	</row>
	<row id="msg_0311_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This is our team!\nThis is our POWER! Our snack budget!\r</language>
	</row>
	<row id="msg_0311_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Power is strength! Strength is power!\nI’m usin’ that power to get to the top!\r</language>
	</row>
	<row id="msg_0311_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know me!? You know what kinda\nhidden talents I got?! I can juggle!\r</language>
	</row>
	<row id="msg_0311_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A homie’s strength and power...\nI’ll show ’em to you! Up close!\r</language>
	</row>
	<row id="msg_0311_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Friendship and love between homies!\nGot that? You’ll never lose!\r</language>
	</row>
	<row id="msg_0311_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies always protectin’ me!\nSo ain’t no way we losin’!\r</language>
	</row>
	<row id="msg_0311_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The accuracy of Bug-type homies!\nI’m the man who knows ALL about ’em!\r</language>
	</row>
	<row id="msg_0311_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skill like a well-oiled machine!\nThe result of the calculation is...!\r</language>
	</row>
	<row id="msg_0311_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know the skill of\nthese homies?! Watch and learn!\r</language>
	</row>
	<row id="msg_0311_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Never crumble, no matter what!\nThat’s the friendship we got!\r</language>
	</row>
	<row id="msg_0311_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That kinda grit is in everybody!\nThat spirit! That GUTS!\r</language>
	</row>
	<row id="msg_0311_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Five years together on the mountain...\nFriendship forever! The smell too!\r</language>
	</row>
	<row id="msg_0311_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Master fightin’! Live for fightin’!\nAnd live for the Pokéathlon!\r</language>
	</row>
	<row id="msg_0311_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can SEE victory! ’Cause I don’t\nthink there’s any way I’ll lose!\r</language>
	</row>
	<row id="msg_0311_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I can fly SO far with these homies!\nOver the rainbow! Prob’ly!\r</language>
	</row>
	<row id="msg_0311_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jump to victory!\nJump PAST victory!\r</language>
	</row>
	<row id="msg_0311_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Why you jump that high?!\nSimple. It’s all I know how to do.\r</language>
	</row>
	<row id="msg_0311_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We ain’t done. We just gettin’ started!\nWe’ll show you how far we jump!\r</language>
	</row>
	<row id="msg_0311_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Flyin’ is like breathin’ to me!\nThat’s only natural, if you ask me.\r</language>
	</row>
	<row id="msg_0311_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That speed can’t even be measured!\nA LEGENDARY team known for speed!\r</language>
	</row>
	<row id="msg_0311_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FINALLY here! The amazingly stubborn\nBlock Boss! How much power she got?\r</language>
	</row>
	<row id="msg_0311_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cuteness, strength, AND speed!\nA girl with SPARKLE!\r</language>
	</row>
	<row id="msg_0311_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nothin’ in front of this guy...\nEven lightnin’ come from BEHIND him!\r</language>
	</row>
	<row id="msg_0311_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Run! What’s past the finish line--\nis called FRIENDSHIP!\r</language>
	</row>
	<row id="msg_0311_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The famous guy from TV ALL the time\nis competin’ in the Pokéathlon!\r</language>
	</row>
	<row id="msg_0311_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">AIGHT! The cute and energetic\nBlock Boss from the Sinnoh region!\r</language>
	</row>
	<row id="msg_0311_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Power... IS cuteness!\nCan you believe that power?\r</language>
	</row>
	<row id="msg_0311_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Throw away common sense!\nThis is REALITY!\r</language>
	</row>
	<row id="msg_0311_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Power is everythin’! Power is right!\nPower is proof of friendship!\r</language>
	</row>
	<row id="msg_0311_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I got natural talent! This genius\ngon’ snatch the victory!\r</language>
	</row>
	<row id="msg_0311_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Friendship? We don’t need it.\n’Cause we already ONE.\r</language>
	</row>
	<row id="msg_0311_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homies always protectin’ me,\nso ain’t no way we can lose!\r</language>
	</row>
	<row id="msg_0311_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Such splendid dancin’ and splendid\nwinnin’! Straight outta Ecruteak!\r</language>
	</row>
	<row id="msg_0311_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is this a illusion? The most\nskilled Pokéathlete in the buildin’!\r</language>
	</row>
	<row id="msg_0311_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Block Boss of STEEL is here!\nShe gon’ show you steely determination!\r</language>
	</row>
	<row id="msg_0311_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’m SO full of energy! Fatigue? Who?\nWhere this stamina comin’ from?!\r</language>
	</row>
	<row id="msg_0311_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chance of victory: 100%! No doubt!\nI just made up that calculation!\r</language>
	</row>
	<row id="msg_0311_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mornin’ is practice, noon is practice,\nand evenin’... is trainin’!\r</language>
	</row>
	<row id="msg_0311_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">He said it...\nTired ain’t in our vocabulary!\r</language>
	</row>
	<row id="msg_0311_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The world we aimin’ for is the\nchampionship! THAT world!\r</language>
	</row>
	<row id="msg_0311_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Flyin’... Even gravity\nkeepin’ its distance from her!\r</language>
	</row>
	<row id="msg_0311_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Block Boss of flight is here!\nHis DAD’S homie deadass soar!\r</language>
	</row>
	<row id="msg_0311_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We can go as far as we want...\nC’mon, let’s go together!\r</language>
	</row>
	<row id="msg_0311_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">There ain’t no sky above him!\nThe sky is BELOW him!\r</language>
	</row>
</body>
