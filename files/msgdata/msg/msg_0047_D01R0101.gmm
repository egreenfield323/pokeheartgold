<?xml version="1.0"?>
<body language="English">
	<row id="msg_0047_D01R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A WHOLE bunch of DIGLETT popped outta\nthe ground! I screamed. Out loud. In\fpublic.</language>
	</row>
	<row id="msg_0047_D01R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Lil spaces surrounded by rocks\nmake you feel peaceful, right?\fNo? Just me? I’m a rock guy.\rAnyway, wanna swap numbers? I give my\nnumber to EVERYBODY. {YESNO 0}\n</language>
	</row>
	<row id="msg_0047_D01R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} saved Brock’s number\nin the Pokégear!</language>
	</row>
	<row id="msg_0047_D01R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: I’d LOVE to scrap you!\fHit me up Saturday nights! I’m always\nfree.\fALWAYS.</language>
	</row>
	<row id="msg_0047_D01R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: I see... That’s disappointin’.\nStory of my life, honestly...\fI’d love to scrap...</language>
	</row>
	<row id="msg_0047_D01R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Can we swap numbers? {YESNO 0}</language>
	</row>
	<row id="msg_0047_D01R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Ayo, you! Why don’t you\ntake a pic with me? {YESNO 0}</language>
	</row>
	<row id="msg_0047_D01R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Aight!\nStand next to me and relax!\r</language>
	</row>
	<row id="msg_0047_D01R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: YES! Another great memory! For\nthe scrapbook. I’m makin’ a\fscrapbook.</language>
	</row>
	<row id="msg_0047_D01R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Well... That’s OK.\nI’m used to rejection.</language>
	</row>
	<row id="msg_0047_D01R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Photo Album full.\rGo on your PC and delete\nsome pics.</language>
	</row>
	<row id="msg_0047_D01R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Ayo, {STRVAR_1 3, 0, 0}!\nYou seen a homie called BONSLY?\rThey say you gotta get it from\na Egg...\rI’m havin’ a hard time findin’ one.\nIf you got a BONSLY,\fcould you trade it for my RHYHORN? {YESNO 0}</language>
	</row>
	<row id="msg_0047_D01R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Ayo, {STRVAR_1 3, 0, 0}!\nYou seen a homie called BONSLY?\rThey say you gotta get it from a\nEgg...\rI’m havin’ a hard time findin’ one.\nIf you got a BONSLY,\fcould you trade it for my RHYHORN? {YESNO 0}</language>
	</row>
	<row id="msg_0047_D01R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Aight!\nLet’s trade!\r</language>
	</row>
	<row id="msg_0047_D01R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: I thought you might have one,\nbut I guess it ain’t that easy...\rIf you find one, remember to trade\nwith me, OK?</language>
	</row>
	<row id="msg_0047_D01R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: I’m lookin’ for BONSLY.\nYou sayin’ you’ll trade\fit for my RHYHORN? {YESNO 0}</language>
	</row>
	<row id="msg_0047_D01R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Good looks!\nI been lookin’ for BONSLY!\rThe RHYHORN I gave you know the move\nJump Start! I raised it from a Egg.\rI’m so proud of it, ’cause it can\ntake down Water-type homies, which\fis usually a tough matchup.\rTake good care of it for me!</language>
	</row>
	<row id="msg_0047_D01R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: That RHYHORN I gave you know\nJump Start! I raised it from a Egg.\rI’m so proud of it, ’cause it can\ntake down Water-type homies, which\fis usually a tough matchup.\rTake good care of it for me!\n\n</language>
	</row>
	<row id="msg_0047_D01R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Ayo, now!\nThat ain’t no BONSLY! That’s a ROCK!\fI know rocks!</language>
	</row>
</body>
