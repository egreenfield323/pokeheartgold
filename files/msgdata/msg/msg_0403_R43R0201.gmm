<?xml version="1.0"?>
<body language="English">
	<row id="msg_0403_R43R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">HOLD IT, kiddo!\rFederal road toll. $1,000.\nNon-refundable. Non-negotiable.\fNon-legal, but don’t worry about\nthat.\r</language>
	</row>
	<row id="msg_0403_R43R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Good looks, taxpayer!\nYour contribution is appreciated!\fBy me. Personally.\r</language>
	</row>
	<row id="msg_0403_R43R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Then run me what you got.\rAnybody with NO bread, hmm...\ngo through free! We got heart!\fWe also got your wallet.\r</language>
	</row>
	<row id="msg_0403_R43R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">He-he-he. We makin’ a KILLIN’.\rEverybody wanna see the lake. All\nlegal. Totally. Look at my badge.\fIt’s real. It’s from a cereal box.</language>
	</row>
	<row id="msg_0403_R43R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Them Fed thugs ran me off my own\npost! Took my chair! My good\fchair!\rThen they vanished. Word is\nsomebody wrecked their hideout.\r...One more thing! I found this\nunder the counter. It make me\funcomfortable.\fIt smell. Can I give it to you?\r</language>
	</row>
	<row id="msg_0403_R43R0201_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0403_R43R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s got Stink Bomb!\rIt hit ’em AND sometimes\npoisons ’em.\fSee!\rDon’t that make you feel\nuncomfortable too?</language>
	</row>
</body>
