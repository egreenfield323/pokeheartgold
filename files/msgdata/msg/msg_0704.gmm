<?xml version="1.0"?>
<body language="English">
	<row id="msg_0704_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jack</language>
	</row>
	<row id="msg_0704_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your knowledge IMPRESSIVE!\nI fw that!\rWanna swap scrap tips?\nI’ll call if I get good info.\rYou gon’ tell me your number? {YESNO 0}</language>
	</row>
	<row id="msg_0704_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I’ll call you if I hear anythin’!</language>
	</row>
	<row id="msg_0704_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, OK. Too bad...\rWell, if you ever want my number,\ncome see me, OK?</language>
	</row>
	<row id="msg_0704_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wanna swap scrap tips?\nI’ll call if I get good info.\rYou gon’ tell me your number?{YESNO 0}</language>
	</row>
	<row id="msg_0704_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0704_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What’s goin’ on?\nWe pretty close... Why not just come\fand talk in person?</language>
	</row>
	<row id="msg_0704_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My {STRVAR_1 0, 10, 0}’s IQ keep risin’.\nMight be smarter than yours!\fMight be smarter than ME.\rLater!</language>
	</row>
	<row id="msg_0704_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The other day, I EASILY beat a wild\n{STRVAR_1 0, 11, 0}.\rI think swappin’ tips with you\nstartin’ to pay off.\rLater!</language>
	</row>
	<row id="msg_0704_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I just BARELY missed catchin’ a wild\n{STRVAR_1 0, 11, 0}.\rIf I had better info, I KNOW I woulda\ncaught it...\rLater!</language>
	</row>
	<row id="msg_0704_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rWhen it’s rainin’, Power Line\nALWAYS hit.</language>
	</row>
	<row id="msg_0704_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf you use Fetal Pos., Roll Out’s\npower go WAY up.</language>
	</row>
	<row id="msg_0704_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf the sun is harsh, Solarbeam\ndon’t need to charge up.</language>
	</row>
	<row id="msg_0704_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf the opp use Duck Down, your\nCurb Stomp get more powerful.</language>
	</row>
	<row id="msg_0704_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf your opp is Flyin’, your Fan Blast\nget WAY more powerful.</language>
	</row>
	<row id="msg_0704_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf your opp is Flyin’, your\nTornado get more powerful.</language>
	</row>
	<row id="msg_0704_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf your opp use Lay Low, your\nBass Drop get more powerful.</language>
	</row>
	<row id="msg_0704_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf your opp use Lay Low, your\nBig Bass get more powerful.</language>
	</row>
	<row id="msg_0704_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rRock, Ground, and Steel types\ncan’t get hurt by Dust Up.</language>
	</row>
	<row id="msg_0704_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rIf the sun is harsh, Water-type\nmoves get WAY weaker.</language>
	</row>
	<row id="msg_0704_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You know...?\rWhen it’s rainin’, Fire-type moves\nget WAY weaker than usual.</language>
	</row>
	<row id="msg_0704_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You wanna scrap? I’ll show you how to\nscrap LOGICALLY.\rI’ll be in {STRVAR_1 4, 3, 0}.\rHolla if you nearby. Bring a notebook.</language>
	</row>
	<row id="msg_0704_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\rYou remember your promise?\nWe gotta scrap soon!\rI’ll be at {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0704_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, {STRVAR_1 3, 0, 0}!\rYou remember your promise?\nWe gotta scrap soon!\rI’ll be at {STRVAR_1 4, 3, 0}.</language>
	</row>
	<row id="msg_0704_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My homie heard some FIRE tips.\nHe finna put me on.\rWhen he tell me, I’ll call you.\fHe’s a PORYGON. It’s on the internet.</language>
	</row>
</body>
