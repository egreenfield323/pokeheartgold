<?xml version="1.0"?>
<body language="English">
	<row id="msg_0149_D52R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KYOGRE: Gyararoooah!\r</language>
	</row>
	<row id="msg_0149_D52R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KYOGRE disappeared...</language>
	</row>
	<row id="msg_0149_D52R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well, wassup!\nThat’s somethin’ you don’t see\fevery day!\rThat homie is KYOGRE,\na legendary homie in the Hoenn myth\fabout how that region got shaped.\rI see...\fI see.\rThe Embedded Tower was built\nby people from Hoenn.\r</language>
	</row>
	<row id="msg_0149_D52R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Tower that tie together\nthe sea, the land, and the sky...\rKYOGRE wasn’t the only homie\nin the Hoenn myth...\rThis place might still be hidin’\nsome secrets.\r</language>
	</row>
	<row id="msg_0149_D52R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The smart homie Professor\nmight tell you more when you\fshow him KYOGRE.\rPhew!\rSo many connections between\nhomies and myths.\rSee you around.\r</language>
	</row>
</body>
