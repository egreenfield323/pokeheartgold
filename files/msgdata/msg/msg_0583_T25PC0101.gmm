<?xml version="1.0"?>
<body language="English">
	<row id="msg_0583_T25PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Colosseum upstairs is for link\nscraps.\rYour record go on the back of your\nTrainer Card. Like a rap sheet.</language>
	</row>
	<row id="msg_0583_T25PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh, you a Fed...</language>
	</row>
	<row id="msg_0583_T25PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">How many kinds of homies is there?\rProfessor Oak said 150 back in the day.\nNow it’s almost 500.\rThey keep findin’ more. I think\nthey just makin’ ’em up now.</language>
	</row>
	<row id="msg_0583_T25PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Feds...!</language>
	</row>
	<row id="msg_0583_T25PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A higher-level homie don’t always win.\nType matchups matter.\rThere ain’t nobody toughest homie.\nExcept my grandma.</language>
	</row>
	<row id="msg_0583_T25PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I feel like I met you before...\rYou must got a reason for\nlookin’ like that...?</language>
	</row>
	<row id="msg_0583_T25PC0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ayo, I’ll heal anybody’s homie, even\nThe Feds’... I took a oath.\rBut touch NOTHIN’ else in here.\nI’m watchin’ your hands.</language>
	</row>
</body>
